---
/**
 * ContactView — Multilingual Contact & Feedback View
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { getLocalizedPath, type SupportedLang, defaultLang } from '../i18n/config';
import { contactPageTranslations } from '../i18n/contactPage';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const c = contactPageTranslations[lang] || contactPageTranslations.en;

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: c.breadcrumb }
];

const pageUrl = getLocalizedPath('/contact/', lang);
const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: c.metaTitle,
  description: c.metaDescription,
  url: `https://mylocationlab.com${pageUrl}`,
};
---

<BaseLayout
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  activeSection="contact"
  jsonLd={[contactSchema]}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />

    <section class="page-header" style="text-align: center; margin-bottom: var(--space-8);">
      <h1>{c.titlePrefix} <span class="text-gradient">{c.titleHighlight}</span></h1>
      <p class="page-header-desc" style="max-width: 650px; margin: 0 auto;">
        {c.subtitle}
      </p>
    </section>

    <div class="grid grid-2" style="max-width: var(--max-width-narrow); margin: 0 auto var(--space-16); gap: var(--space-8); align-items: start;">
      <!-- Contact Details -->
      <div class="card card-flat" style="padding: var(--space-6);">
        <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-4); color: var(--color-text-heading);">{c.h2Inquiries}</h2>
        
        <div style="margin-bottom: var(--space-4);">
          <div style="font-size: var(--text-xs); color: var(--color-accent-primary); font-weight: 700; text-transform: uppercase;">{c.techSupportLabel}</div>
          <div style="font-size: var(--text-base); color: var(--color-text-primary); font-family: var(--font-mono); margin-top: var(--space-1);">
            support@mylocationlab.com
          </div>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <div style="font-size: var(--text-xs); color: var(--color-accent-primary); font-weight: 700; text-transform: uppercase;">{c.editorialLabel}</div>
          <div style="font-size: var(--text-base); color: var(--color-text-primary); font-family: var(--font-mono); margin-top: var(--space-1);">
            editorial@mylocationlab.com
          </div>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <div style="font-size: var(--text-xs); color: var(--color-accent-primary); font-weight: 700; text-transform: uppercase;">{c.privacyLabel}</div>
          <div style="font-size: var(--text-base); color: var(--color-text-primary); font-family: var(--font-mono); margin-top: var(--space-1);">
            privacy@mylocationlab.com
          </div>
        </div>

        <hr style="border-color: var(--color-border); margin: var(--space-6) 0;" />
        
        <p style="font-size: var(--text-xs); color: var(--color-text-tertiary); line-height: 1.6; margin: 0;">
          {c.responseTime}
        </p>
      </div>

      <!-- Interactive Feedback Form -->
      <div class="card card-highlight" style="padding: var(--space-6);">
        <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-4); color: var(--color-text-heading);">{c.h2SendMessage}</h2>
        
        <form id="contact-form">
          <div style="margin-bottom: var(--space-4);">
            <label for="cf-name" style="display: block; font-size: var(--text-xs); font-weight: 600; margin-bottom: var(--space-1); color: var(--color-text-secondary);">{c.nameLabel}</label>
            <input type="text" id="cf-name" class="input" placeholder={c.namePlaceholder} required style="width: 100%;" />
          </div>

          <div style="margin-bottom: var(--space-4);">
            <label for="cf-email" style="display: block; font-size: var(--text-xs); font-weight: 600; margin-bottom: var(--space-1); color: var(--color-text-secondary);">{c.emailLabel}</label>
            <input type="email" id="cf-email" class="input" placeholder="alex@example.com" required style="width: 100%;" />
          </div>

          <div style="margin-bottom: var(--space-4);">
            <label for="cf-topic" style="display: block; font-size: var(--text-xs); font-weight: 600; margin-bottom: var(--space-1); color: var(--color-text-secondary);">{c.topicLabel}</label>
            <select class="input" id="cf-topic" style="width: 100%; cursor: pointer;">
              <option value="bug">{c.optBug}</option>
              <option value="tool">{c.optTool}</option>
              <option value="privacy">{c.optPrivacy}</option>
              <option value="editorial">{c.optEditorial}</option>
              <option value="other">{c.optOther}</option>
            </select>
          </div>

          <div style="margin-bottom: var(--space-4);">
            <label for="cf-message" style="display: block; font-size: var(--text-xs); font-weight: 600; margin-bottom: var(--space-1); color: var(--color-text-secondary);">{c.messageLabel}</label>
            <textarea class="input" id="cf-message" rows="4" placeholder={c.messagePlaceholder} required style="width: 100%; resize: vertical;"></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%;">
            {c.submitBtn}
          </button>
          <p style="font-size: var(--text-xs); color: var(--color-text-tertiary); margin: var(--space-3) 0 0;">
            {c.submitDisclaimer}
          </p>
        </form>

        <div id="contact-success" style="display: none; text-align: center; padding: var(--space-6) 0;">
          <div style="font-size: 2.5rem; margin-bottom: var(--space-2);">✅</div>
          <h3 style="font-size: var(--text-lg); margin-bottom: var(--space-1);">{c.successTitle}</h3>
          <p style="font-size: var(--text-sm); color: var(--color-text-secondary);">{c.successDesc}</p>
          <button type="button" class="btn btn-secondary btn-sm" id="contact-reopen" style="margin-top: var(--space-4);">{c.reopenBtn}</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successBox = document.getElementById('contact-success');
    const reopenBtn = document.getElementById('contact-reopen');
    const SUPPORT_EMAIL = 'support@mylocationlab.com';

    if (form && successBox) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (document.getElementById('cf-name') as HTMLInputElement).value.trim();
        const email = (document.getElementById('cf-email') as HTMLInputElement).value.trim();
        const topicSelect = document.getElementById('cf-topic') as HTMLSelectElement;
        const topic = topicSelect.options[topicSelect.selectedIndex]?.text || 'Feedback';
        const message = (document.getElementById('cf-message') as HTMLTextAreaElement).value.trim();

        const subject = `[${topic}] Message from ${name || 'MyLocationLab visitor'}`;
        const body = `Name: ${name}\nReply-to: ${email}\nTopic: ${topic}\n\n${message}\n`;

        window.location.href = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

        form.style.display = 'none';
        successBox.style.display = 'block';
      });
    }

    if (reopenBtn && form && successBox) {
      reopenBtn.addEventListener('click', () => {
        form.style.display = 'block';
        successBox.style.display = 'none';
      });
    }
  </script>
</BaseLayout>
