    scenarios: [
      { scenario: "E-Commerce & Pengiriman", verdict: "Gunakan Forward Geocoding", desc: "Memvalidasi alamat pembeli dan menghitung jarak pengiriman kurir." },
      { scenario: "Aplikasi Ojek & Taksi Online", verdict: "Gunakan Reverse Geocoding", desc: "Mengubah sinyal GPS ponsel pengemudi menjadi titik jemput dengan nama jalan yang jelas." },
      { scenario: "Layanan Darurat (112)", verdict: "Integrasi Keduanya", desc: "Melacak lokasi penelpon dari koordinat lalu menghitung rute ambulans." },
      { scenario: "Pelacakan Armada Logistik", verdict: "Gunakan Reverse Geocoding", desc: "Mencatat lokasi pemberhentian truk sebagai nama gudang atau alamat jalan." }
    ],

