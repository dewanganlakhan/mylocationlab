    row3: ["Algoritma Utama", "Normalisasi teks, pencocokan fonetik", "Pencarian spasial k-NN (tetangga terdekat), tes Point-in-Polygon"],
    row4: ["Tantangan", "Nama jalan ganda di berbagai wilayah, salah ketik", "Koordinat pedesaan terpencil yang jauh dari jalan terdata"],
    row5: ["Alat Interaktif", "Forward Geocoder", "Reverse Geocoder & Pencari Alamat"],

    h2Forward: "Cara Kerja Forward Geocoding (Teks → Koordinat)",
    pForward: "Forward geocoding berfungsi seperti mesin pencari spasial:",
    step1Title: "Tokenisasi & Penguraian Alamat",
    step1Desc: "Teks dipisah menjadi komponen nomor, nama jalan, jenis jalan, dan wilayah administrasi.",
    step2Title: "Pencocokan Indeks Peta",
