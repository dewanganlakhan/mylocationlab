      { title: "पता खोजक उपकरण", href: "/tools/address-finder/", desc: "विश्व भर में किसी भी पते के निर्देशांक और सीमाएं देखें।" },
      { title: "फॉरवर्ड जियोकोडर", href: "/tools/geocoding/", desc: "स्थान के नाम से अक्षांश और देशांतर प्राप्त करें।" }
    ],

    connectedGuides: "🔗 जुड़े उपकरण और मार्गदर्शक",
    tool1Title: "फॉरवर्ड जियोकोडर",
    tool1Desc: "पते से निर्देशांक",
    tool2Title: "रिवर्स जियोकोडर",
    tool2Desc: "निर्देशांक से पता",
    tool3Title: "पता खोजक",
    tool3Desc: "लाइव पता खोज",
