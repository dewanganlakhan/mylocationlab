    myths: [
      { myth: "Mitos: Reverse geocoding hanya sekadar mencari tabel di spreadsheet.", fact: "Fakta: Koordinat bersifat kontinu; server harus melakukan perhitungan geometri rumit pada gigabyte data peta jalan." },
      { myth: "Mitos: Hasilnya selalu tepat di depan pintu rumah.", fact: "Fakta: Tanpa data denah bangunan lengkap, sebagian besar layanan menginterpolasi nomor di sepanjang garis jalan." }
    ],

    faqs: [
      { question: "Mengapa hasil nomor rumah terkadang sedikit bergeser?", answer: "Tidak semua rumah terpetakan secara individual. Sistem memperkirakan nomor rumah melalui interpolasi matematis di antara persimpangan jalan terdekat." },
      { question: "Layanan apa yang digunakan di MyLocationLab?", answer: "Kami memanfaatkan OpenStreetMap Nominatim. Koordinat Anda hanya dikirim untuk menampilkan teks alamat dan tidak pernah disimpan." },
      { question: "Bisakah reverse geocoding bekerja tanpa internet?", answer: "Bisa, asalkan perangkat menyimpan basis data peta jalan dan poligon wilayah berukuran ratusan megabita secara luring." }
    ],

    nextStepsTitle: "Langkah Berikutnya",
    nextSteps: [
      { title: "Uji Reverse Geocoding", href: "/tools/reverse-geocoding/", desc: "Ubah koordinat GPS menjadi alamat jalan lengkap dengan kode pos." },
      { title: "Buka Pencari Alamat", href: "/tools/address-finder/", desc: "Cari alamat apa pun di dunia dan dapatkan koordinatnya." },
      { title: "Forward Geocoder", href: "/tools/geocoding/", desc: "Dapatkan angka lintang dan bujur dari nama jalan atau tempat." }
    ],

    connectedGuides: "🔗 Panduan & Alat Terkait",
    tool1Title: "Forward Geocoder",
    tool1Desc: "Alamat ke koordinat",
    tool2Title: "Reverse Geocoder",
    tool2Desc: "Koordinat ke alamat",
    tool3Title: "Pencari Alamat",
    tool3Desc: "Pencarian alamat langsung",
    tool4Title: "Pahami Lintang Bujur",
    tool4Desc: "Dasar sistem koordinat"
  }
};

const c = translations[lang] || translations.en;
---

<ContentLayout
  lang={lang}
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
  section="comparisons"
  sectionLabel={lang === 'es' ? 'Comparativas Técnicas' : lang === 'fr' ? 'Comparatifs Techniques' : lang === 'de' ? 'Technische Vergleiche' : lang === 'pt' ? 'Comparações Técnicas' : lang === 'hi' ? 'तकनीकी तुलना' : lang === 'id' ? 'Perbandingan Teknis' : 'Technical Comparisons'}
  readTime="6 min"
  publishDate="2026-09-15"
  modifiedDate="2026-09-22"
>
  {c.inShort && (
    <div class="callout-box" style="margin-bottom: var(--space-6); background: var(--color-bg-secondary); border-left: 4px solid var(--color-accent-primary); padding: var(--space-4) var(--space-5); border-radius: var(--radius-md);">
      <p style="margin: 0; font-weight: 500; font-size: var(--text-base); color: var(--color-text-primary); line-height: 1.75;">
        {c.inShort}
      </p>
    </div>
  )}

  <p set:html={localizeHtml(c.p1, lang)}></p>
  <p set:html={localizeHtml(c.p2, lang)}></p>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.calloutBadge}</span>
      <h3 class="tool-callout-title">{c.calloutTitle}</h3>
      <p class="tool-callout-desc">{c.calloutDesc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/tools/reverse-geocoding/', lang)} class="btn btn-primary">{c.calloutBtn}</a>
    </div>
  </div>

  <h2>{c.matrixHeading}</h2>
  <table>
    <thead>
      <tr>
        <th>{c.thFeature}</th>
        <th>{c.thForward}</th>
        <th>{c.thReverse}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>{c.row1[0]}</strong></td>
        <td>{c.row1[1]}</td>
        <td>{c.row1[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row2[0]}</strong></td>
        <td>{c.row2[1]}</td>
        <td>{c.row2[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row3[0]}</strong></td>
        <td>{c.row3[1]}</td>
        <td>{c.row3[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row4[0]}</strong></td>
        <td>{c.row4[1]}</td>
        <td>{c.row4[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row5[0]}</strong></td>
        <td><a href={getLocalizedPath('/tools/geocoding/', lang)}>{c.row5[1]}</a></td>
        <td><a href={getLocalizedPath('/tools/reverse-geocoding/', lang)}>{c.row5[2]}</a></td>
      </tr>
    </tbody>
  </table>

  <h2>{c.h2Forward}</h2>
  <p>{c.pForward}</p>

  <div class="step-container">
    <div class="step-card">
      <div class="step-number">1</div>
      <div class="step-body">
        <h4 class="step-title">{c.step1Title}</h4>
        <p class="step-desc">{c.step1Desc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">2</div>
      <div class="step-body">
        <h4 class="step-title">{c.step2Title}</h4>
        <p class="step-desc">{c.step2Desc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">3</div>
      <div class="step-body">
        <h4 class="step-title">{c.step3Title}</h4>
        <p class="step-desc">{c.step3Desc}</p>
      </div>
    </div>
  </div>

  <h2>{c.h2Reverse}</h2>
  <p>{c.pReverse}</p>
  <ul>
    <li>{c.revBullet1}</li>
    <li>{c.revBullet2}</li>
    <li>{c.revBullet3}</li>
  </ul>

  {c.h2Scenarios && (
    <div style="margin: var(--space-10) 0;">
      <h2>⚖️ {c.h2Scenarios}</h2>
      <div style="display: grid; gap: var(--space-4); margin-top: var(--space-4);">
        {c.scenarios.map((s: any) => (
          <div class="card card-flat" style="padding: var(--space-4) var(--space-5); border-left: 3px solid var(--color-accent-primary);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1);">
              <strong style="color: var(--color-text-primary); font-size: var(--text-base);">{s.scenario}</strong>
              <span class="badge badge-primary">{s.verdict}</span>
            </div>
            <p style="margin: 0; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.75;">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  {c.h2Myths && (
    <div style="margin: var(--space-10) 0;">
      <h2>🔍 {c.h2Myths}</h2>
      <div style="display: grid; gap: var(--space-4); margin-top: var(--space-4);">
        {c.myths.map((m: any) => (
          <div class="card card-flat" style="padding: var(--space-4) var(--space-5); border-left: 3px solid var(--color-accent-warning);">
            <strong style="display: block; color: var(--color-text-primary); margin-bottom: var(--space-1); font-size: var(--text-base);">{m.myth}</strong>
            <p style="margin: 0; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.75;">{m.fact}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  {c.faqs && c.faqs.length > 0 && (
    <div style="margin-top: var(--space-10);">
      <h2>❓ FAQ: Geocoding & Reverse Geocoding</h2>
      <FAQAccordion items={c.faqs} includeSchema={true} />
    </div>
  )}

  {c.nextSteps && (
    <div class="card card-flat" style="margin: var(--space-10) 0; padding: var(--space-6); background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
      <h3 style="margin-top: 0; margin-bottom: var(--space-4); font-size: var(--text-lg); display: flex; align-items: center; gap: var(--space-2);">
        <span>🚀</span> {c.nextStepsTitle || "Next Steps"}
      </h3>
      <div style="display: grid; gap: var(--space-3);">
        {c.nextSteps.map((step: any) => (
          <a href={getLocalizedPath(step.href, lang)} class="card card-flat" style="display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-3) var(--space-4); text-decoration: none; border-left: 3px solid var(--color-accent-primary); background: var(--color-bg-card); transition: transform 0.15s ease;">
            <strong style="color: var(--color-text-primary); font-size: var(--text-base);">{step.title} →</strong>
            <span style="color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6;">{step.desc}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="contextual-next-box">
    <h3 class="contextual-next-title">{c.connectedGuides}</h3>
    <div class="contextual-next-grid">
      <a href={getLocalizedPath('/tools/geocoding/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool1Title}</div>
          <div class="contextual-link-sub">{c.tool1Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/tools/reverse-geocoding/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool2Title}</div>
          <div class="contextual-link-sub">{c.tool2Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/tools/address-finder/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool3Title}</div>
          <div class="contextual-link-sub">{c.tool3Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/latitude-and-longitude-explained/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool4Title}</div>
          <div class="contextual-link-sub">{c.tool4Desc}</div>
        </div>
      </a>
    </div>
  </div>
</ContentLayout>
