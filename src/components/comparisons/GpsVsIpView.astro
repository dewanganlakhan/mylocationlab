      { myth: "Mitos: Situs web dapat mengambil lokasi GPS diam-diam.", fact: "Fakta: Peramban modern mengunci akses sensor hingga pengguna secara aktif menekan Izinkan." },
      { myth: "Mitos: Geolokasi IP dapat menemukan nomor pintu rumah Anda.", fact: "Fakta: Basis data IP hanya mengetahui pusat perutean ISP yang berjarak 5 hingga 50 km." }
    ],

    faqs: [
      { question: "Mengapa lokasi IP saya menunjukkan kota lain?", answer: "Penyedia internet menyalurkan koneksi Anda melalui router gateway terpusat di kota besar terdekat." },
      { question: "Apakah VPN memengaruhi lokasi GPS ponsel?", answer: "Tidak. VPN hanya mengalihkan jaringan internet. Sensor GPS ponsel tetap membaca sinyal satelit secara langsung." },
      { question: "Bisakah situs web melacak ketinggian saya lewat IP?", answer: "Tidak. IP hanya dua dimensi; ketinggian hanya bisa dibaca lewat satelit GNSS atau sensor barometer." }
