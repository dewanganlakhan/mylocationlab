    calloutBtn: "Periksa Lokasi IP →",

    matrixHeading: "Matriks Perbandingan Langsung",
    thAttr: "Atribut",
    thGps: "Posisi GPS (GNSS)",
    thIp: "Geolokasi Alamat IP",
    row1: ["Akurasi Tipikal", "3 hingga 5 meter di luar ruangan", "5 hingga 50 km (tingkat kota atau gateway ISP)"],
    row2: ["Teknologi Dasar", "Trilaterasi waktu tempuh sinyal radio satelit", "Tabel basis data ASN penyedia internet"],
