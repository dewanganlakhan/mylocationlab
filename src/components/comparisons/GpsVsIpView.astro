    row4: ["Kebutuhan Perangkat Keras", "Antena GNSS & chipset khusus (ponsel, tablet)", "Semua perangkat berinternet (PC, server)"],
    row5: ["Keandalan di Dalam Ruangan", "Lemah (Terhalang atap beton atau logam)", "100% berfungsi di dalam ruangan"],
