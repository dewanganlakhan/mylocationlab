      { myth: "भ्रम: वेबसाइटें बिना पूछे आपका जीपीएस डेटा चुरा सकती हैं।", fact: "वास्तविकता: आधुनिक ब्राउज़र अनुमति दिए बिना जीपीएस हार्डवेयर को पूरी तरह लॉक रखते हैं।" },
      { myth: "भ्रम: आईपी लोकेशन से आपके मकान का नंबर पता चल सकता है।", fact: "वास्तविकता: आईपी केवल इंटरनेट कंपनी के क्षेत्रीय स्विचिंग केंद्र को दर्शाती है जो 5 से 50 किमी दूर होता है।" }
    ],

    faqs: [
      { question: "मेरी आईपी लोकेशन दूसरा शहर क्यों दिखाती है?", answer: "आपका प्रदाता इंटरनेट ट्रैफिक को मुख्य रीजनल सर्वर से जोड़ता है, और डेटाबेस उसी सर्वर का स्थान दिखाता है।" },
      { question: "क्या वीपीएन से जीपीएस लोकेशन बदल जाती है?", answer: "नहीं। वीपीएन केवल आईपी बदलता है, जबकि मोबाइल का जीपीएस चिपसेट सीधे आकाश से उपग्रह सिग्नल लेता है।" },
      { question: "क्या वेबसाइटें आईपी से मेरी ऊंचाई जान सकती हैं?", answer: "नहीं। आईपी केवल द्वि-आयामी होती है; ऊंचाई केवल जीएनएसएस उपग्रहों या बैरोमीटर सेंसर से पता चलती है।" }
    ],

    nextStepsTitle: "अगले कदम",
    nextSteps: [
      { title: "जीपीएस एंटीना जांचें", href: "/gps/", desc: "अपने लाइव उपग्रह निर्देशांक और त्रुटि दायरा देखें।" },
      { title: "आईपी नेटवर्क जांचें", href: "/ip/", desc: "अपना सार्वजनिक आईपी, आईएसपी का नाम और शहर देखें।" },
      { title: "गलत लोकेशन सुधारें", href: "/guides/wrong-location/", desc: "वीपीएन और वाई-फाई विसंगतियों को ठीक करना सीखें।" }
    ],

    connectedGuides: "🔗 जुड़े मार्गदर्शक और उपकरण",
    tool1Title: "जीपीएस निर्देशांक खोजक",
    tool1Desc: "सटीक उपग्रह स्थिति",
    tool2Title: "आईपी सटीकता सीमाएं",
    tool2Desc: "GeoIP डेटाबेस कार्यप्रणाली",
    tool3Title: "गलत लोकेशन सुधारें",
    tool3Desc: "आईएसपी और वीपीएन समस्याएं हल करें",
    tool4Title: "जीपीएस सटीकता मॉनिटर",
    tool4Desc: "लाइव त्रुटि दायरा परीक्षण"
  },
  id: {
    title: "GPS vs Lokasi IP: Akurasi dan Privasi | MyLocationLab",
    description: "Singkatnya: GPS membaca sinyal gelombang mikro satelit dengan akurasi 3-5 meter, sedangkan geolokasi IP memeriksa basis data perutean ISP dalam radius 5-50 km.",
