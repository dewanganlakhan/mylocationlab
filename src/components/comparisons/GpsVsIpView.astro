};

const c = translations[lang] || translations.en;
---

<ContentLayout
  lang={lang}
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
  section="comparisons"
  sectionLabel={lang === 'es' ? 'Comparativas Técnicas' : lang === 'fr' ? 'Comparatifs Techniques' : lang === 'de' ? 'Technische Vergleiche' : lang === 'pt' ? 'Comparações Técnicas' : lang === 'hi' ? 'तकनीकी तुलना' : lang === 'id' ? 'Perbandingan Teknis' : 'Technical Comparisons'}
  readTime="7 min"
  publishDate="2026-09-15"
  modifiedDate="2026-09-22"
>
  {c.inShort && (
    <div class="callout-box" style="margin-bottom: var(--space-6); background: var(--color-bg-secondary); border-left: 4px solid var(--color-accent-primary); padding: var(--space-4) var(--space-5); border-radius: var(--radius-md);">
      <p style="margin: 0; font-weight: 500; font-size: var(--text-base); color: var(--color-text-primary); line-height: 1.75;">
        {c.inShort}
      </p>
    </div>
  )}

  <p set:html={localizeHtml(c.pGps1, lang)}></p>
  <p set:html={localizeHtml(c.pGps2, lang)}></p>

  <!-- Live Split-Screen GPS vs IP Diagnostic Engine -->
  <div class="live-test-card" id="gps-ip-test-card">
    <div class="live-test-header">
      <span class="badge badge-success">{c.calloutBadge}</span>
      <h3 style="margin: var(--space-2) 0 var(--space-1); font-size: var(--text-lg); font-weight: 700;">{c.calloutTitle}</h3>
      <p style="color: var(--color-text-secondary); margin: 0; font-size: var(--text-sm);">{c.calloutDesc}</p>
    </div>

    <div class="live-test-grid">
      <!-- IP Col -->
      <div class="test-col">
        <div class="test-col-header">
          <span class="dot dot-ip"></span>
          <strong>IP Geolocation</strong>
          <span class="badge badge-secondary" id="ip-status-badge">Detecting...</span>
        </div>
        <div class="metric-row">
          <span class="metric-lbl">Public IP:</span>
          <span class="metric-val" id="ip-val">—</span>
        </div>
        <div class="metric-row">
          <span class="metric-lbl">City / Region:</span>
          <span class="metric-val" id="ip-city">—</span>
        </div>
        <div class="metric-row">
          <span class="metric-lbl">Est. Coordinates:</span>
          <span class="metric-val" id="ip-coords">—</span>
        </div>
        <div class="metric-row">
          <span class="metric-lbl">Typical Accuracy:</span>
          <span class="metric-val" id="ip-acc">~5 to 50 km</span>
        </div>
      </div>

      <!-- GPS Col -->
      <div class="test-col">
        <div class="test-col-header">
          <span class="dot dot-gps"></span>
          <strong>Hardware GPS Fix</strong>
          <span class="badge badge-secondary" id="gps-status-badge">Standby</span>
        </div>
        <div class="metric-row">
          <span class="metric-lbl">Receiver Status:</span>
          <span class="metric-val" id="gps-state">Click Below to Query</span>
        </div>
        <div class="metric-row">
          <span class="metric-lbl">Exact Lat / Long:</span>
          <span class="metric-val" id="gps-coords">—</span>
        </div>
        <div class="metric-row">
          <span class="metric-lbl">Elevation:</span>
          <span class="metric-val" id="gps-elev">—</span>
        </div>
        <div class="metric-row">
          <span class="metric-lbl">Precision Radius:</span>
          <span class="metric-val text-success" id="gps-acc">—</span>
        </div>
      </div>
    </div>

    <div style="margin-top: var(--space-4); display: flex; gap: var(--space-3); flex-wrap: wrap;">
      <button class="btn btn-primary" id="btn-run-gps">
        Query Hardware GPS Satellites
      </button>
      <a href={getLocalizedPath('/ip/', lang)} class="btn btn-secondary">
        {c.calloutBtn}
      </a>
    </div>

    <!-- Live Discrepancy Calculator -->
    <div class="discrepancy-card" id="discrepancy-box" style="display: none; margin-top: var(--space-4); padding: var(--space-4); background: var(--color-bg-secondary); border-radius: var(--radius-md); border-left: 4px solid var(--color-accent-primary);">
      <div style="font-size: var(--text-sm); font-weight: 700; color: var(--color-accent-primary); margin-bottom: var(--space-1);">
        🎯 Spatial Error Discrepancy Calculated
      </div>
      <div style="font-size: var(--text-2xl); font-weight: 800; color: var(--color-text-primary);" id="discrepancy-dist">
        —
      </div>
      <p style="font-size: var(--text-xs); color: var(--color-text-secondary); margin: var(--space-2) 0 0;">
        This real-time discrepancy proves how IP databases locate regional ISP gateways, while your GNSS antenna measures true orbital satellite geometry.
      </p>
    </div>
  </div>

  <h2>{c.matrixHeading}</h2>
  <table>
    <thead>
      <tr>
        <th>{c.thAttr}</th>
        <th>{c.thGps}</th>
        <th>{c.thIp}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>{c.row1[0]}</strong></td>
        <td><strong>{c.row1[1]}</strong></td>
        <td>{c.row1[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row2[0]}</strong></td>
        <td>{c.row2[1]}</td>
        <td>{c.row2[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row3[0]}</strong></td>
        <td><strong>{c.row3[1]}</strong></td>
        <td>{c.row3[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row4[0]}</strong></td>
        <td>{c.row4[1]}</td>
        <td>{c.row4[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row5[0]}</strong></td>
        <td>{c.row5[1]}</td>
        <td>{c.row5[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row6[0]}</strong></td>
        <td>{c.row6[1]}</td>
        <td>{c.row6[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row7[0]}</strong></td>
        <td>{c.row7[1]}</td>
        <td>{c.row7[2]}</td>
      </tr>
    </tbody>
  </table>

  <h2>{c.h2Gps}</h2>
  <p set:html={localizeHtml(c.pGps1, lang)}></p>
  <p set:html={localizeHtml(c.pGps2, lang)}></p>

  <h2>{c.h2Ip}</h2>
  <p set:html={localizeHtml(c.pIp1, lang)}></p>
  <ul>
    <li>{c.ipBullet1}</li>
    <li>{c.ipBullet2}</li>
  </ul>
  <p set:html={localizeHtml(c.pIp2, lang)}></p>

  <h2>{c.h2Privacy}</h2>
  <h3>{c.h3GpsPrivacy}</h3>
  <p>{c.pGpsPrivacy}</p>

  <h3>{c.h3IpPrivacy}</h3>
  <p>{c.pIpPrivacy}</p>

  <h2>{c.h2Which}</h2>
  <ul>
    <li><strong>{c.useGpsWhen}</strong></li>
    <li><strong>{c.useIpWhen}</strong></li>
  </ul>

  {c.h2Scenarios && (
    <div style="margin: var(--space-10) 0;">
      <h2>⚖️ {c.h2Scenarios}</h2>
      <div style="display: grid; gap: var(--space-4); margin-top: var(--space-4);">
        {c.scenarios.map((s: any) => (
          <div class="card card-flat" style="padding: var(--space-4) var(--space-5); border-left: 3px solid var(--color-accent-primary);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1);">
              <strong style="color: var(--color-text-primary); font-size: var(--text-base);">{s.scenario}</strong>
              <span class="badge badge-primary">{s.verdict}</span>
            </div>
            <p style="margin: 0; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.75;">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  {c.h2Myths && (
    <div style="margin: var(--space-10) 0;">
      <h2>🔍 {c.h2Myths}</h2>
      <div style="display: grid; gap: var(--space-4); margin-top: var(--space-4);">
        {c.myths.map((m: any) => (
          <div class="card card-flat" style="padding: var(--space-4) var(--space-5); border-left: 3px solid var(--color-accent-warning);">
            <strong style="display: block; color: var(--color-text-primary); margin-bottom: var(--space-1); font-size: var(--text-base);">{m.myth}</strong>
            <p style="margin: 0; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.75;">{m.fact}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  {c.faqs && c.faqs.length > 0 && (
    <div style="margin-top: var(--space-10);">
      <h2>❓ FAQ: GPS vs. IP Geolocation</h2>
      <FAQAccordion items={c.faqs} includeSchema={true} lang={lang} />
    </div>
  )}

  {c.nextSteps && (
    <div class="card card-flat" style="margin: var(--space-10) 0; padding: var(--space-6); background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
      <h3 style="margin-top: 0; margin-bottom: var(--space-4); font-size: var(--text-lg); display: flex; align-items: center; gap: var(--space-2);">
        <span>🚀</span> {c.nextStepsTitle || "Next Steps"}
      </h3>
      <div style="display: grid; gap: var(--space-3);">
        {c.nextSteps.map((step: any) => (
          <a href={getLocalizedPath(step.href, lang)} class="card card-flat" style="display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-3) var(--space-4); text-decoration: none; border-left: 3px solid var(--color-accent-primary); background: var(--color-bg-card); transition: transform 0.15s ease;">
            <strong style="color: var(--color-text-primary); font-size: var(--text-base);">{step.title} →</strong>
            <span style="color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6;">{step.desc}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="contextual-next-box">
    <h3 class="contextual-next-title">{c.connectedGuides}</h3>
    <div class="contextual-next-grid">
      <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🛰️</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool1Title}</div>
          <div class="contextual-link-sub">{c.tool1Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/ip-geolocation-accuracy/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool2Title}</div>
          <div class="contextual-link-sub">{c.tool2Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/wrong-location/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool3Title}</div>
