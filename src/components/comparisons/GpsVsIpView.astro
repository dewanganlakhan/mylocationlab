    useGpsWhen: "Gunakan GPS Saat: Membutuhkan navigasi jalan, alamat rumah yang akurat, atau perhitungan ketinggian dan jarak.",
    useIpWhen: "Gunakan IP Saat: Berada di PC desktop tanpa GPS, mengecek cuaca regional, atau preferensi mata uang toko online.",

    h2Scenarios: "Rekomendasi Berdasarkan Skenario",
    scenarios: [
      { scenario: "Navigasi Jalan & Mendaki", verdict: "Gunakan GPS", desc: "Memerlukan akurasi meter yang hanya dapat disediakan oleh satelit." },
      { scenario: "Cuaca Regional & Toko Online", verdict: "Gunakan IP", desc: "Akurasi tingkat kota sudah cukup tanpa perlu meminta izin ke pengguna." },
      { scenario: "PC Desktop di Kantor", verdict: "Gunakan IP", desc: "Komputer kerja tidak memiliki antena satelit dan berada di dalam gedung." },
      { scenario: "Geofencing Keamanan", verdict: "Gunakan GPS", desc: "Memverifikasi batas wilayah fisik secara nyata." }
    ],

