      { title: "Periksa Antena GPS", href: "/gps/", desc: "Lihat koordinat satelit langsung dan radius galat saat ini." },
      { title: "Periksa Jaringan IP", href: "/ip/", desc: "Lihat IP publik, nama ISP, dan kota perutean jaringan." },
      { title: "Atasi Lokasi Salah", href: "/guides/wrong-location/", desc: "Pelajari cara mengatasi selisih lokasi akibat VPN atau perutean ISP." }
    ],

    connectedGuides: "🔗 Panduan & Alat Terkait",
    tool1Title: "Pencari Koordinat GPS",
    tool1Desc: "Titik satelit langsung",
    tool2Title: "Batas Akurasi IP",
    tool2Desc: "Cara kerja GeoIP",
    tool3Title: "Perbaiki Lokasi Salah",
    tool3Desc: "Atasi konflik ISP & VPN",
    tool4Title: "Monitor Akurasi GPS",
    tool4Desc: "Uji radius galat langsung"
