---

<ContentLayout
  lang={lang}
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
  section="comparisons"
  sectionLabel={lang === 'es' ? 'Comparativas Técnicas' : lang === 'fr' ? 'Comparatifs Techniques' : lang === 'de' ? 'Technische Vergleiche' : lang === 'pt' ? 'Comparações Técnicas' : 'Technical Comparisons'}
  readTime="6 min"
  publishDate="2026-09-15"
  modifiedDate="2026-09-22"
>
  <p>{c.p1}</p>
  <p>{c.p2}</p>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.calloutBadge}</span>
      <h3 class="tool-callout-title">{c.calloutTitle}</h3>
      <p class="tool-callout-desc">{c.calloutDesc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} class="btn btn-primary">{c.calloutBtn}</a>
    </div>
  </div>

  <h2>{c.matrixHeading}</h2>
  <table>
    <thead>
      <tr>
        <th>{c.thAttr}</th>
        <th>{c.thDd}</th>
        <th>{c.thDms}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>{c.row1[0]}</strong></td>
        <td><code>{c.row1[1]}</code></td>
        <td><code>{c.row1[2]}</code></td>
      </tr>
      <tr>
        <td><strong>{c.row2[0]}</strong></td>
        <td>{c.row2[1]}</td>
        <td>{c.row2[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row3[0]}</strong></td>
        <td>{c.row3[1]}</td>
        <td>{c.row3[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row4[0]}</strong></td>
        <td>{c.row4[1]}</td>
        <td>{c.row4[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row5[0]}</strong></td>
        <td>{c.row5[1]}</td>
        <td>{c.row5[2]}</td>
      </tr>
      <tr>
        <td><strong>{c.row6[0]}</strong></td>
        <td>{c.row6[1]}</td>
        <td>{c.row6[2]}</td>
      </tr>
    </tbody>
  </table>

  <h2>{c.h2Formulas}</h2>

  <div class="step-container">
    <div class="step-card">
      <div class="step-number">1</div>
      <div class="step-body">
        <h4 class="step-title">{c.step1Title}</h4>
        <p class="step-desc">
          <code>{c.step1Formula}</code><br />
          <em>{c.step1Note}</em>
        </p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">2</div>
      <div class="step-body">
        <h4 class="step-title">{c.step2Title}</h4>
        <p class="step-desc">
          {c.step2_1}<br />
          {c.step2_2}<br />
          {c.step2_3}
        </p>
      </div>
    </div>
  </div>

  <h2>{c.h2Why}</h2>
  <p>{c.pWhy1}</p>
  <p>{c.pWhy2}</p>

  <div class="contextual-next-box">
    <h3 class="contextual-next-title">{c.connectedGuides}</h3>
    <div class="contextual-next-grid">
      <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🧭</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool1Title}</div>
          <div class="contextual-link-sub">{c.tool1Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/latitude-and-longitude-explained/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🌐</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool2Title}</div>
          <div class="contextual-link-sub">{c.tool2Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/utm-coordinates-and-datums/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🗺️</span>
