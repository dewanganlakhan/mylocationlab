      { title: "Panduan UTM & Datum", href: "/guides/utm-coordinates-and-datums/", desc: "Pahami proyeksi kisi metrik yang banyak dipakai dalam pemetaan teknik." }
    ],

    connectedGuides: "🔗 Panduan & Alat Terkait",
    tool1Title: "Konverter Koordinat",
    tool1Desc: "Konversi DD, DMS & UTM",
    tool2Title: "Lintang & Bujur",
    tool2Desc: "Dasar geodesi koordinat",
    tool3Title: "Panduan UTM & Datum",
