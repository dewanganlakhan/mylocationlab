      { title: "अक्षांश और देशांतर गाइड", href: "/guides/latitude-and-longitude-explained/", desc: "सीखें कि भूगणितीय डेटम पृथ्वी पर सटीक स्थिति कैसे तय करते हैं।" },
      { title: "UTM निर्देशांक और डेटम", href: "/guides/utm-coordinates-and-datums/", desc: "इंजीनियरिंग और सर्वेक्षण में प्रयुक्त मीट्रिक ग्रिड प्रणालियों को समझें।" }
    ],

    connectedGuides: "🔗 जुड़े मार्गदर्शक और उपकरण",
