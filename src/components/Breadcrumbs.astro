---
/**
 * Breadcrumbs — Navigation breadcrumb trail with Google Rich Results compliant BreadcrumbList schema
 */
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const siteUrl = 'https://mylocationlab.netlify.app';
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => {
    let itemUrl = item.href 
      ? (item.href.startsWith('http') ? item.href : `${siteUrl}${item.href}`)
      : `${siteUrl}${currentPath}`;
    return {
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: itemUrl,
    };
  }),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs-list" style="display: flex; align-items: center; flex-wrap: wrap; list-style: none; padding: 0; margin: 0; gap: var(--space-2);">
    {items.map((item, index) => (
      <li class="breadcrumbs-item" style="display: inline-flex; align-items: center; gap: var(--space-2);">
        {index > 0 && <span class="breadcrumbs-separator" aria-hidden="true" style="color: var(--color-text-tertiary);">›</span>}
        {item.href ? (
          <a href={item.href} class="breadcrumbs-link" style="color: var(--color-text-secondary); text-decoration: none; transition: color var(--transition-fast);">
            {index === 0 && <span aria-hidden="true" style="margin-right: 4px;">🏠</span>}
            {item.label}
          </a>
        ) : (
          <span class="breadcrumbs-current" aria-current="page" style="color: var(--color-text-primary); font-weight: 500;">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>

