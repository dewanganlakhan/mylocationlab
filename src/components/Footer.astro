---
/**
 * Footer — Stitch GeoPrecision System Architecture
 * Brand, active GNSS indicator, 4-column structured SILO directory, and zero-log trust badge.
 */
import { getLangFromUrl, getLocalizedPath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: string;
}

const { lang: customLang } = Astro.props;
const lang = customLang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const homePath = getLocalizedPath('/', lang);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Telemetry Status -->
      <div class="footer-brand">
        <a href={homePath} class="footer-logo" aria-label="MyLocationLab Home">
          <span class="footer-logo-icon">
            <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="32" height="32" rx="9" fill="#2563EB"/>
              <circle cx="16" cy="16" r="8" stroke="#93C5FD" stroke-width="2"/>
              <circle cx="16" cy="16" r="4" stroke="white" stroke-width="2"/>
              <circle cx="16" cy="16" r="1.5" fill="white"/>
              <line x1="16" y1="4.5" x2="16" y2="7.5" stroke="#93C5FD" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="16" y1="24.5" x2="16" y2="27.5" stroke="#93C5FD" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="4.5" y1="16" x2="7.5" y2="16" stroke="#93C5FD" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="24.5" y1="16" x2="27.5" y2="16" stroke="#93C5FD" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="footer-logo-text">MyLocationLab</span>
        </a>
        <p class="footer-brand-desc">
          {t('footer.brandDesc')}
        </p>
        <div class="footer-telemetry-status">
          <span class="pulse-dot-emerald"></span>
          <span class="footer-status-label">{t('footer.statusLabel')}</span>
        </div>
      </div>

      <!-- Column 1: My Location -->
      <div class="footer-column">
        <h4 class="footer-col-header">{t('footer.colMyLocation')}</h4>
        <ul class="footer-links">
          <li><a href={getLocalizedPath('/my-location/gps/', lang)} class="footer-link-item">{t('footer.link.gpsCoords')}</a></li>
          <li><a href={getLocalizedPath('/my-location/address/', lang)} class="footer-link-item">{t('footer.link.address')}</a></li>
          <li><a href={getLocalizedPath('/my-location/coordinates/', lang)} class="footer-link-item">{t('footer.link.coordinatesHub')}</a></li>
          <li><a href={getLocalizedPath('/my-location/ip/', lang)} class="footer-link-item">{t('footer.link.ipLocation')}</a></li>
        </ul>
      </div>

      <!-- Column 2: About & Trust -->
      <div class="footer-column">
        <h4 class="footer-col-header">{t('footer.colTrust')}</h4>
        <ul class="footer-links">
          <li><a href={getLocalizedPath('/about/', lang)} class="footer-link-item">{t('footer.link.about')}</a></li>
          <li><a href={getLocalizedPath('/contact/', lang)} class="footer-link-item">{t('footer.link.contact')}</a></li>
          <li><a href={getLocalizedPath('/editorial-policy/', lang)} class="footer-link-item">{t('footer.link.editorial')}</a></li>
          <li><a href={getLocalizedPath('/privacy/', lang)} class="footer-link-item">{t('footer.link.privacy')}</a></li>
          <li><a href={getLocalizedPath('/terms/', lang)} class="footer-link-item">{t('footer.link.terms')}</a></li>
          <li><a href={getLocalizedPath('/disclaimer/', lang)} class="footer-link-item">{t('footer.link.disclaimer')}</a></li>
          <li><a href={getLocalizedPath('/faq/', lang)} class="footer-link-item">{t('footer.link.faq')}</a></li>
          <li><a href={getLocalizedPath('/glossary/', lang)} class="footer-link-item">{t('footer.link.glossary') || 'Geospatial Glossary'}</a></li>
          <li>
            <a href="https://github.com/dewanganlakhan/mylocationlab" target="_blank" rel="noopener noreferrer" class="footer-link-item" aria-label="GitHub Repository (opens in new tab)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="margin-right: 5px; vertical-align: -2px;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              GitHub (Open Source)
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-bottom-trust">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-shield-icon">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>{t('footer.trust')}</span>
      </div>

      <nav class="footer-bottom-nav" aria-label="Trust & Legal Directory">
        <a href={getLocalizedPath('/about/', lang)} class="footer-bottom-link">{t('footer.link.about')}</a>
        <a href={getLocalizedPath('/contact/', lang)} class="footer-bottom-link">{t('footer.link.contact')}</a>
        <a href={getLocalizedPath('/privacy/', lang)} class="footer-bottom-link">{t('footer.link.privacy')}</a>
        <a href={getLocalizedPath('/terms/', lang)} class="footer-bottom-link">{t('footer.link.terms')}</a>
        <a href={getLocalizedPath('/editorial-policy/', lang)} class="footer-bottom-link">{t('footer.link.editorial')}</a>
        <a href={getLocalizedPath('/disclaimer/', lang)} class="footer-bottom-link">{t('footer.link.disclaimer')}</a>
        <a href="https://github.com/dewanganlakhan/mylocationlab" target="_blank" rel="noopener noreferrer" class="footer-bottom-link" aria-label="GitHub Repository (opens in new tab)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      </nav>

      <div class="footer-bottom-copy">
        &copy; {year} MyLocationLab. {t('footer.copyright')}
      </div>
    </div>
  </div>
</footer>
