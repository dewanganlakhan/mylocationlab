---
/**
 * Footer — Stitch GeoPrecision System Architecture
 * Brand, active GNSS indicator, 4-column structured SILO directory, and zero-log trust badge.
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Telemetry Status -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="MyLocationLab Home">
          <span class="footer-logo-icon">
            <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="32" height="32" rx="9" fill="#2563EB"/>
              <circle cx="16" cy="16" r="8" stroke="#93C5FD" stroke-width="2"/>
              <circle cx="16" cy="16" r="4" stroke="white" stroke-width="2"/>
              <circle cx="16" cy="16" r="1.5" fill="white"/>
              <line x1="16" y1="4.5" x2="16" y2="7.5" stroke="#93C5FD" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="16" y1="24.5" x2="16" y2="27.5" stroke="#93C5FD" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="4.5" y1="16" x2="7.5" y2="16" stroke="#93C5FD" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="24.5" y1="16" x2="27.5" y2="16" stroke="#93C5FD" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="footer-logo-text">MyLocationLab</span>
        </a>
        <p class="footer-brand-desc">
          Authoritative telemetry, datum transformation, and client-side browser positioning diagnostics.
        </p>
        <div class="footer-telemetry-status">
          <span class="pulse-dot-emerald"></span>
          <span class="footer-status-label">GNSS CONSTELLATION ACTIVE</span>
        </div>
      </div>

      <!-- Column 1: My Location -->
      <div class="footer-column">
        <h4 class="footer-col-header">MY LOCATION</h4>
        <ul class="footer-links">
          <li><a href="/my-location/gps/" class="footer-link-item">Instant GPS Coordinates</a></li>
          <li><a href="/guides/improve-gps-accuracy/" class="footer-link-item">Precision & Accuracy Radius</a></li>
          <li><a href="/tools/elevation-finder/" class="footer-link-item">Barometric & Elevation Scan</a></li>
          <li><a href="/tools/coordinate-converter/" class="footer-link-item">Export NMEA & GeoJSON</a></li>
        </ul>
      </div>

      <!-- Column 2: Geospatial Tools -->
      <div class="footer-column">
        <h4 class="footer-col-header">GEOSPATIAL TOOLS</h4>
        <ul class="footer-links">
          <li><a href="/tools/coordinate-converter/" class="footer-link-item">Datum Converter (WGS84 / UTM)</a></li>
          <li><a href="/tools/distance-calculator/" class="footer-link-item">Haversine Distance Calculator</a></li>
          <li><a href="/tools/coordinate-converter/" class="footer-link-item">MGRS & USNG Grid Engine</a></li>
          <li><a href="/comparisons/gps-vs-ip-location/" class="footer-link-item">IP vs True GNSS Resolver</a></li>
        </ul>
      </div>

      <!-- Column 3: Knowledge & Guides -->
      <div class="footer-column">
        <h4 class="footer-col-header">KNOWLEDGE & GUIDES</h4>
        <ul class="footer-links">
          <li><a href="/guides/how-gps-location-works/" class="footer-link-item">Browser Geolocation API Spec</a></li>
          <li><a href="/guides/improve-gps-accuracy/" class="footer-link-item">Understanding HDOP / VDOP</a></li>
          <li><a href="/guides/wrong-location/" class="footer-link-item">Location Permissions Hardening</a></li>
          <li><a href="/faq/" class="footer-link-item">Frequently Asked Questions</a></li>
        </ul>
      </div>

      <!-- Column 4: Comparisons & Ref -->
      <div class="footer-column">
        <h4 class="footer-col-header">COMPARISONS & REF</h4>
        <ul class="footer-links">
          <li><a href="/guides/how-gps-location-works/" class="footer-link-item">GNSS vs Cellular Triangulation</a></li>
          <li><a href="/guides/improve-gps-accuracy/" class="footer-link-item">Dual-Frequency L1/L5 Chips</a></li>
          <li><a href="/comparisons/gps-vs-ip-location/" class="footer-link-item">Mobile OS Accuracy Matrix</a></li>
          <li><a href="/guides/utm-coordinates-and-datums/" class="footer-link-item">EPSG Geodetic Parameter Registry</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-bottom-trust">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer-shield-icon">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Zero Server Logs • W3C Standard Geolocation API • HTTPS TLS 1.3</span>
      </div>
      <div class="footer-bottom-copy">
        &copy; {year} MyLocationLab. All rights reserved. Open Geodetic Architecture.
      </div>
    </div>
  </div>
</footer>
