    fr: [
      { question: "Quel nombre est la latitude, quel nombre la longitude ?", answer: "La latitude vient en premier (ex. 51.5007, -0.1246 pour Big Ben). Elle s'étend de -90° à +90° (sud vers nord) ; la longitude de -180° à +180° (ouest vers est du méridien de Greenwich)." },
      { question: "Que signifient les lettres N, S, E et O ?", answer: "Elles remplacent le signe : N/S indique si vous êtes au nord ou au sud de l'Équateur, E/O à l'est ou à l'ouest du méridien d'origine. 40,7128° N équivaut à +40.7128." },
      { question: "Que vaut la précision de six décimales ?", answer: "Environ 11 centimètres, bien plus fin que n'importe quel GPS de smartphone. Cinq décimales (~1,1 m) suffisent à désigner une place de parking ; au-delà, ce sont des chiffres parasites." }
    ],
    de: [
      { question: "Welche Zahl ist Breite, welche Länge?", answer: "Der Breitengrad steht zuerst (z. B. 51.5007, -0.1246 für den Big Ben). Die Breite läuft von -90° bis +90° (Süd nach Nord), die Länge von -180° bis +180° (West nach Ost von Greenwich)." },
      { question: "Was bedeuten N, S, E und W?", answer: "Sie ersetzen das Vorzeichen: N/S sagt, ob Sie nördlich oder südlich des Äquators sind, E/W ob östlich oder westlich des Nullmeridians. 40.7128° N entspricht +40.7128." },
      { question: "Wie genau sind sechs Nachkommastellen?", answer: "Rund 11 Zentimeter — deutlich feiner als jedes Handy-GPS. Fünf Stellen (~1,1 m) genügen bereits, um einen Parkplatz zu markieren; darüber hinaus sind die Ziffern Rauschen." }
    ],
    pt: [
      { question: "Qual número é latitude e qual é longitude?", answer: "A latitude vem primeiro no par (ex. 51.5007, -0.1246 para o Big Ben). A latitude vai de -90° a +90° (sul a norte); a longitude de -180° a +180° (oeste a leste de Greenwich)." },
      { question: "O que significam as letras N, S, L e O?", answer: "Elas substituem o sinal: N/S indica se você está ao norte ou ao sul do Equador; L/O se está a leste ou a oeste do meridiano de Greenwich. 40.7128° N equivale a +40.7128." },
      { question: "Qual a precisão de seis casas decimais?", answer: "Cerca de 11 centímetros, muito além do que qualquer GPS de celular alcança. Cinco casas (~1,1 m) já marcam uma vaga de estacionamento; além disso, são ruído." }
    ],
    hi: [
      { question: "कौन सी संख्या अक्षांश है और कौन सी देशांतर?", answer: "जोड़ी में अक्षांश पहले आता है (जैसे बिग बेन के लिए 51.5007, -0.1246)। अक्षांश -90° से +90° (दक्षिण से उत्तर) तक चलता है; देशांतर -180° से +180° (ग्रीनविच के पश्चिम से पूर्व) तक।" },
      { question: "N, S, E, W अक्षरों का क्या अर्थ है?", answer: "ये चिह्न (+/-) की जगह लेते हैं: N/S बताता है कि आप भूमध्य रेखा के उत्तर या दक्षिण में हैं, E/W बताता है कि आप प्रधान मध्याह्न रेखा के पूर्व या पश्चिम में हैं। 40.7128° N वही है जो +40.7128 है।" },
      { question: "छह दशमलव स्थान कितने सटीक होते हैं?", answer: "लगभग 11 सेंटीमीटर — किसी भी फ़ोन GPS से कहीं बारीक। पाँच दशमलव (~1.1 मीटर) पहले से ही एक पार्किंग स्थल चिह्नित कर देते हैं; उससे आगे के अंक केवल शोर हैं।" }
    ],
    id: [
      { question: "Angka mana lintang dan mana bujur?", answer: "Lintang mendahului dalam pasangan (mis. 51.5007, -0.1246 untuk Big Ben). Lintang berjalan dari -90° hingga +90° (selatan ke utara); bujur dari -180° hingga +180° (barat ke timur dari Greenwich)." },
      { question: "Apa arti huruf arah seperti N, S, E, W?", answer: "Huruf-huruf itu menggantikan tanda positif/negatif: N/S menunjukkan apakah Anda di utara atau selatan Khatulistiwa, E/W menunjukkan timur atau barat Meridian Utama. 40.7128° N sama dengan +40.7128. Di Indonesia arah ini ditulis U (Utara), S (Selatan), T (Timur), dan B (Barat)." },
      { question: "Seberapa presisi enam tempat desimal?", answer: "Sekitar 11 sentimeter — jauh lebih halus daripada GPS ponsel mana pun. Lima desimal (~1,1 m) sudah cukup menandai satu tempat parkir; lebih dari itu, digitnya hanyalah derau." }
    ]
  },
  address: {
    en: [
      { question: "Why is my address missing a house number?", answer: "OpenStreetMap may lack building-level data in some areas, so the nearest street segment is returned instead. This is common in rural areas and newer developments." },
      { question: "Why does it show a neighboring street?", answer: "Reverse geocoding snaps your coordinates to the closest mapped address point. With GPS accuracy of ±10–30 m, the algorithm sometimes picks the other side of the street or the next doorway." },
      { question: "Is my address lookup private?", answer: "Your coordinates are sent directly from your browser to OpenStreetMap's public geocoding service to resolve the address. MyLocationLab stores nothing — no address, no coordinates, no logs." },
      { question: "Can I find the address of another place?", answer: "Yes — use the Address Finder tool to enter any coordinates and get their street address, or paste an address into the Geocoder to get coordinates." }
    ],
    es: [
      { question: "¿Por qué falta el número de la calle?", answer: "OpenStreetMap puede carecer de datos a nivel de edificio en algunas zonas y devuelve el tramo de vía más cercano. Es habitual en zonas rurales y urbanizaciones nuevas." },
      { question: "¿Por qué aparece una calle vecina?", answer: "La geocodificación inversa ajusta sus coordenadas al punto de dirección mapeado más próximo. Con una precisión GPS de ±10–30 m, a veces se elige la acera de enfrente o el portal contiguo." },
      { question: "¿Es privada la consulta de mi dirección?", answer: "Sus coordenadas viajan directamente desde su navegador al servicio público de geocodificación de OpenStreetMap. MyLocationLab no almacena nada: ni dirección, ni coordenadas, ni registros." },
      { question: "¿Puedo obtener la dirección de otro lugar?", answer: "Sí: use la herramienta Buscador de Dirección para introducir cualquier coordenada y obtener su dirección, o el Geocodificador para convertir una dirección en coordenadas." }
    ],
    fr: [
      { question: "Pourquoi le numéro de rue manque-t-il ?", answer: "OpenStreetMap peut ne pas disposer de données au niveau du bâtiment dans certaines zones ; le tronçon de voie le plus proche est alors renvoyé. C'est fréquent en zone rurale et dans les lotissements récents." },
      { question: "Pourquoi une rue voisine s'affiche-t-elle ?", answer: "Le géocodage inverse rattache vos coordonnées au point d'adresse cartographié le plus proche. Avec une précision GPS de ±10–30 m, l'algorithme choisit parfois le trottoir d'en face ou la porte voisine." },
      { question: "Ma recherche d'adresse est-elle privée ?", answer: "Vos coordonnées sont envoyées directement depuis votre navigateur au service public de géocodage d'OpenStreetMap. MyLocationLab ne stocke rien : ni adresse, ni coordonnées, ni journaux." },
      { question: "Puis-je obtenir l'adresse d'un autre lieu ?", answer: "Oui — utilisez le Localisateur d'Adresse pour saisir des coordonnées quelconques, ou le Géocodeur pour convertir une adresse en coordonnées." }
    ],
    de: [
      { question: "Warum fehlt die Hausnummer?", answer: "OpenStreetMap verfügt nicht überall über gebäudescharfe Daten; dann wird der nächstgelegene Straßenabschnitt ausgegeben. Häufig in ländlichen Gebieten und Neubaugebieten." },
      { question: "Warum wird eine Nachbarstraße angezeigt?", answer: "Beim Reverse-Geocoding wird Ihre Position auf den nächstgelegenen erfassten Adresspunkt gesetzt. Bei ±10–30 m GPS-Genauigkeit landet der Algorithmus manchmal auf der gegenüberliegenden Straßenseite." },
      { question: "Ist die Adressabfrage privat?", answer: "Ihre Koordinaten werden direkt von Ihrem Browser an den öffentlichen Geokodierungsdienst von OpenStreetMap gesendet. MyLocationLab speichert nichts — keine Adresse, keine Koordinaten, keine Protokolle." },
      { question: "Kann ich die Adresse eines anderen Ortes finden?", answer: "Ja — mit dem Adressen-Finder geben Sie beliebige Koordinaten ein und erhalten die Straßenadresse; der Geocoder wandelt eine Adresse in Koordinaten um." }
    ],
    pt: [
      { question: "Por que falta o número da casa?", answer: "O OpenStreetMap pode não ter dados no nível do edifício em algumas áreas, retornando o trecho de via mais próximo. É comum em zonas rurais e loteamentos novos." },
      { question: "Por que aparece uma rua vizinha?", answer: "A geocodificação reversa ajusta suas coordenadas ao ponto de endereço mapeado mais próximo. Com precisão de ±10–30 m, o algoritmo às vezes escolhe a calçada oposta ou o portão ao lado." },
      { question: "A consulta do meu endereço é privada?", answer: "Suas coordenadas vão diretamente do seu navegador para o serviço público de geocodificação do OpenStreetMap. O MyLocationLab não armazena nada: nem endereço, nem coordenadas, nem registros." },
      { question: "Posso descobrir o endereço de outro lugar?", answer: "Sim — use o Localizador de Endereço para inserir quaisquer coordenadas e obter o endereço, ou o Geocodificador para converter um endereço em coordenadas." }
    ],
    hi: [
      { question: "मेरे पते में मकान नंबर क्यों नहीं दिखता?", answer: "कुछ इलाकों में OpenStreetMap में भवन-स्तरीय डेटा नहीं हो सकता, इसलिए सबसे नज़दीकी सड़क खंड दिखाया जाता है। यह ग्रामीण इलाकों और नई कॉलोनियों में आम है।" },
      { question: "यह पड़ोस की गली क्यों दिखाता है?", answer: "रिवर्स जियोकोडिंग आपके निर्देशांकों को सबसे नज़दीकी मैप किए गए पता बिंदु से जोड़ती है। ±10–30 मीटर GPS सटीकता के साथ एल्गोरिद्म कभी-कभी सड़क की दूसरी ओर या अगला दरवाज़ा चुन लेता है।" },
      { question: "क्या मेरी पता खोज निजी है?", answer: "आपके निर्देशांक सीधे आपके ब्राउज़र से OpenStreetMap की सार्वजनिक जियोकोडिंग सेवा को पता निकालने के लिए भेजे जाते हैं। MyLocationLab कुछ भी सहेजता नहीं — न पता, न निर्देशांक, न लॉग।" },
      { question: "क्या मैं किसी दूसरी जगह का पता जान सकता हूं?", answer: "हां — कोई भी निर्देशांक दर्ज करके उनका सड़क पता पाने के लिए पता खोजक (Address Finder) टूल उपयोग करें, या पते से निर्देशांक पाने के लिए जियोकोडर में पता पेस्ट करें।" }
    ],
    id: [
      { question: "Mengapa alamat saya tidak memiliki nomor bangunan?", answer: "OpenStreetMap mungkin tidak memiliki data tingkat bangunan di beberapa area, sehingga segmen jalan terdekat yang dikembalikan. Ini umum terjadi di daerah pedesaan dan perumahan baru." },
      { question: "Mengapa jalan tetangga yang ditampilkan?", answer: "Reverse geocoding menempelkan koordinat Anda ke titik alamat terpetakan terdekat. Dengan akurasi GPS ±10–30 m, algoritme terkadang memilih sisi jalan seberang atau pintu berikutnya." },
      { question: "Apakah pencarian alamat saya privat?", answer: "Koordinat Anda dikirim langsung dari peramban Anda ke layanan geocoding publik OpenStreetMap untuk menyelesaikan alamat. MyLocationLab tidak menyimpan apa pun — tidak ada alamat, koordinat, atau log." },
      { question: "Bisakah saya mencari alamat tempat lain?", answer: "Bisa — gunakan alat Pencari Alamat untuk memasukkan koordinat apa pun dan mendapatkan alamat jalannya, atau tempelkan alamat ke Geocoder untuk mendapatkan koordinatnya." }
    ]
  }
};

/** Localized labels for the cross-silo related-link list. */
const relatedLinkLabels: Record<string, Record<string, string>> = {
  en: { gps: 'My GPS Coordinates', address: 'My Current Address', coordinates: 'My Coordinates', latLong: 'My Latitude & Longitude', city: 'What City Am I In?', state: 'What State Am I In?', country: 'What Country Am I In?', converter: 'Coordinate Converter (DD/DMS/UTM)', addressFinder: 'Address Finder (any coordinates)' },
  es: { gps: 'Mis Coordenadas GPS', address: 'Mi Dirección Actual', coordinates: 'Mis Coordenadas', latLong: 'Mi Latitud y Longitud', city: '¿En Qué Ciudad Estoy?', state: '¿En Qué Estado Estoy?', country: '¿En Qué País Estoy?', converter: 'Conversor de Coordenadas (DD/GMS/UTM)', addressFinder: 'Buscador de Dirección (cualquier coordenada)' },
  fr: { gps: 'Mes Coordonnées GPS', address: 'Mon Adresse Actuelle', coordinates: 'Mes Coordonnées', latLong: 'Ma Latitude et Longitude', city: 'Dans Quelle Ville Suis-Je ?', state: 'Dans Quel Département Suis-Je ?', country: 'Dans Quel Pays Suis-Je ?', converter: 'Convertisseur de Coordonnées (DD/DMS/UTM)', addressFinder: "Localisateur d'Adresse (toute coordonnée)" },
  de: { gps: 'Meine GPS-Koordinaten', address: 'Meine Aktuelle Adresse', coordinates: 'Meine Koordinaten', latLong: 'Mein Breiten- & Längengrad', city: 'In Welcher Stadt Bin Ich?', state: 'In Welchem Bundesland Bin Ich?', country: 'In Welchem Land Bin Ich?', converter: 'Koordinaten-Umrechner (DD/GMS/UTM)', addressFinder: 'Adressen-Finder (beliebige Koordinaten)' },
  pt: { gps: 'Minhas Coordenadas GPS', address: 'Meu Endereço Atual', coordinates: 'Minhas Coordenadas', latLong: 'Minha Latitude e Longitude', city: 'Em Que Cidade Estou?', state: 'Em Que Estado Estou?', country: 'Em Que País Estou?', converter: 'Conversor de Coordenadas (DD/GMS/UTM)', addressFinder: 'Localizador de Endereço (quaisquer coordenadas)' },
  hi: { gps: 'मेरे GPS निर्देशांक', address: 'मेरा वर्तमान पता', coordinates: 'मेरे निर्देशांक', latLong: 'मेरा अक्षांश और देशांतर', city: 'मैं किस शहर में हूं?', state: 'मैं किस राज्य में हूं?', country: 'मैं किस देश में हूं?', converter: 'कोऑर्डिनेट कनवर्टर (DD/DMS/UTM)', addressFinder: 'पता खोजक (कोई भी निर्देशांक)' },
  id: { gps: 'Koordinat GPS Saya', address: 'Alamat Saya Saat Ini', coordinates: 'Koordinat Saya', latLong: 'Lintang & Bujur Saya', city: 'Saya di Kota Mana?', state: 'Saya di Provinsi Mana?', country: 'Saya di Negara Mana?', converter: 'Konverter Koordinat (DD/DMS/UTM)', addressFinder: 'Pencari Alamat (koordinat apa pun)' }
};

const c = dict[attribute]?.[lang] || dict[attribute]?.en;
const linkLabels = relatedLinkLabels[lang] || relatedLinkLabels.en;
const faq = c.faq ?? faqBank[attribute]?.[lang] ?? faqBank[attribute]?.en;

const relatedLinks = [
  { label: linkLabels.gps, href: getLocalizedPath('/my-location/gps/', lang) },
  { label: linkLabels.address, href: getLocalizedPath('/my-location/address/', lang) },
  { label: linkLabels.coordinates, href: getLocalizedPath('/my-location/coordinates/', lang) },
  { label: linkLabels.latLong, href: getLocalizedPath('/my-location/latitude-longitude/', lang) },
  { label: linkLabels.city, href: getLocalizedPath('/my-location/city/', lang) },
  { label: linkLabels.state, href: getLocalizedPath('/my-location/state/', lang) },
  { label: linkLabels.country, href: getLocalizedPath('/my-location/country/', lang) },
  { label: linkLabels.converter, href: getLocalizedPath('/tools/coordinate-converter/', lang) },
  ...(attribute === 'address' ? [{ label: linkLabels.addressFinder, href: getLocalizedPath('/tools/address-finder/', lang) }] : [])
];

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: t('nav.myLocation'), href: '/my-location/' },
  { label: `${c.h1Prefix} ${c.h1Accent}` }
];

const faqSchema = faq ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]*>?/gm, '')
    }
  }))
} : undefined;
---

<BaseLayout
  leaflet
  lang={lang}
  title={c.title}
  description={c.description}
  activeSection="my-location"
  jsonLd={faqSchema ? [faqSchema] : undefined}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />
    <SiloNav silo="my-location" lang={lang} title={c.h3Related} />

    <section class="page-header">
      <h1>{c.h1Prefix} <span class="text-gradient">{c.h1Accent}</span></h1>
      <p class="page-header-desc">{c.subtitle}</p>
    </section>

    <LocationFinder emphasisField={c.emphasisField} lang={lang} />

    <section class="section">
      <div class="prose" style="max-width: var(--max-width-narrow);">
        <h2>{c.h2How}</h2>
        <p>{c.pHow1}</p>
        <p>{c.pHow2}</p>

        <h2>{c.h2What}</h2>
        <ul>
          {c.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>

        {faq && faq.length > 0 && (
          <div style="margin-top: var(--space-8);">
            <h2>FAQ</h2>
            <FAQAccordion items={faq} includeSchema={false} />
          </div>
        )}

        <h3>{c.h3Related}</h3>
        <ul>
          {relatedLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
