        "Legislação e Trânsito — Conheça as normas de tráfego e regras estaduais de circulação",
        "Tributação — Verifique alíquotas de ICMS e regulamentações fiscais locais",
        "Serviços de Emergência — Direcione chamadas para as centrais de polícia e bombeiros do estado",
        "Administração Pública — Acesse serviços e portais do governo estadual correspondente"
      ],
      h3Related: "Ferramentas Relacionadas"
    }
  }
};

const c = dict[attribute]?.[lang] || dict[attribute]?.en;

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: t('nav.myLocation'), href: '/my-location/' },
  { label: `${c.h1Prefix} ${c.h1Accent}` }
];

const faqSchema = c.faq ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]*>?/gm, '')
    }
  }))
} : undefined;
---

<BaseLayout
  leaflet
  lang={lang}
  title={c.title}
  description={c.description}
  activeSection="my-location"
  jsonLd={faqSchema ? [faqSchema] : undefined}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />
    <SiloNav silo="my-location" lang={lang} title={c.h3Related} />

    <section class="page-header">
      <h1>{c.h1Prefix} <span class="text-gradient">{c.h1Accent}</span></h1>
      <p class="page-header-desc">{c.subtitle}</p>
    </section>

    <LocationFinder emphasisField={c.emphasisField} lang={lang} />

    <section class="section">
      <div class="prose" style="max-width: var(--max-width-narrow);">
        <h2>{c.h2How}</h2>
        <p>{c.pHow1}</p>
        <p>{c.pHow2}</p>

        <h2>{c.h2What}</h2>
        <ul>
          {c.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>

        {c.faq && c.faq.length > 0 && (
          <div style="margin-top: var(--space-8);">
            <h2>FAQ</h2>
            <FAQAccordion items={c.faq} />
          </div>
        )}

        <h3>{c.h3Related}</h3>
        <ul>
          <li><a href={getLocalizedPath('/my-location/gps/', lang)}>{t('footer.link.gpsCoords')}</a></li>
          <li><a href={getLocalizedPath('/my-location/address/', lang)}>{t('footer.link.address')}</a></li>
          <li><a href={getLocalizedPath('/my-location/coordinates/', lang)}>{t('nav.tools')}</a></li>
          <li><a href={getLocalizedPath('/my-location/city/', lang)}>City Finder</a></li>
          <li><a href={getLocalizedPath('/my-location/state/', lang)}>State Finder</a></li>
          <li><a href={getLocalizedPath('/my-location/country/', lang)}>Country Finder</a></li>
          <li><a href={getLocalizedPath('/tools/coordinate-converter/', lang)}>{t('footer.link.converter')}</a></li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
