      { question: "¿Por qué aparece una calle vecina?", answer: "La geocodificación inversa ajusta sus coordenadas al punto de dirección mapeado más próximo. Con una precisión GPS de ±10–30 m, a veces se elige la acera de enfrente o el portal contiguo." },
      { question: "¿Es privada la consulta de mi dirección?", answer: "Sus coordenadas viajan directamente desde su navegador al servicio público de geocodificación de OpenStreetMap. MyLocationLab no almacena nada: ni dirección, ni coordenadas, ni registros." },
      { question: "¿Puedo obtener la dirección de otro lugar?", answer: "Sí: use la herramienta Buscador de Dirección para introducir cualquier coordenada y obtener su dirección, o el Geocodificador para convertir una dirección en coordenadas." }
    ],
    fr: [
      { question: "Pourquoi le numéro de rue manque-t-il ?", answer: "OpenStreetMap peut ne pas disposer de données au niveau du bâtiment dans certaines zones ; le tronçon de voie le plus proche est alors renvoyé. C'est fréquent en zone rurale et dans les lotissements récents." },
      { question: "Pourquoi une rue voisine s'affiche-t-elle ?", answer: "Le géocodage inverse rattache vos coordonnées au point d'adresse cartographié le plus proche. Avec une précision GPS de ±10–30 m, l'algorithme choisit parfois le trottoir d'en face ou la porte voisine." },
      { question: "Ma recherche d'adresse est-elle privée ?", answer: "Vos coordonnées sont envoyées directement depuis votre navigateur au service public de géocodage d'OpenStreetMap. MyLocationLab ne stocke rien : ni adresse, ni coordonnées, ni journaux." },
      { question: "Puis-je obtenir l'adresse d'un autre lieu ?", answer: "Oui — utilisez le Localisateur d'Adresse pour saisir des coordonnées quelconques, ou le Géocodeur pour convertir une adresse en coordonnées." }
    ],
    de: [
      { question: "Warum fehlt die Hausnummer?", answer: "OpenStreetMap verfügt nicht überall über gebäudescharfe Daten; dann wird der nächstgelegene Straßenabschnitt ausgegeben. Häufig in ländlichen Gebieten und Neubaugebieten." },
      { question: "Warum wird eine Nachbarstraße angezeigt?", answer: "Beim Reverse-Geocoding wird Ihre Position auf den nächstgelegenen erfassten Adresspunkt gesetzt. Bei ±10–30 m GPS-Genauigkeit landet der Algorithmus manchmal auf der gegenüberliegenden Straßenseite." },
      { question: "Ist die Adressabfrage privat?", answer: "Ihre Koordinaten werden direkt von Ihrem Browser an den öffentlichen Geokodierungsdienst von OpenStreetMap gesendet. MyLocationLab speichert nichts — keine Adresse, keine Koordinaten, keine Protokolle." },
      { question: "Kann ich die Adresse eines anderen Ortes finden?", answer: "Ja — mit dem Adressen-Finder geben Sie beliebige Koordinaten ein und erhalten die Straßenadresse; der Geocoder wandelt eine Adresse in Koordinaten um." }
    ],
    pt: [
      { question: "Por que falta o número da casa?", answer: "O OpenStreetMap pode não ter dados no nível do edifício em algumas áreas, retornando o trecho de via mais próximo. É comum em zonas rurais e loteamentos novos." },
      { question: "Por que aparece uma rua vizinha?", answer: "A geocodificação reversa ajusta suas coordenadas ao ponto de endereço mapeado mais próximo. Com precisão de ±10–30 m, o algoritmo às vezes escolhe a calçada oposta ou o portão ao lado." },
      { question: "A consulta do meu endereço é privada?", answer: "Suas coordenadas vão diretamente do seu navegador para o serviço público de geocodificação do OpenStreetMap. O MyLocationLab não armazena nada: nem endereço, nem coordenadas, nem registros." },
      { question: "Posso descobrir o endereço de outro lugar?", answer: "Sim — use o Localizador de Endereço para inserir quaisquer coordenadas e obter o endereço, ou o Geocodificador para converter um endereço em coordenadas." }
    ]
  }
};

/** Localized labels for the cross-silo related-link list. */
const relatedLinkLabels: Record<string, Record<string, string>> = {
  en: { gps: 'My GPS Coordinates', address: 'My Current Address', coordinates: 'My Coordinates', latLong: 'My Latitude & Longitude', city: 'What City Am I In?', state: 'What State Am I In?', country: 'What Country Am I In?', converter: 'Coordinate Converter (DD/DMS/UTM)', addressFinder: 'Address Finder (any coordinates)' },
  es: { gps: 'Mis Coordenadas GPS', address: 'Mi Dirección Actual', coordinates: 'Mis Coordenadas', latLong: 'Mi Latitud y Longitud', city: '¿En Qué Ciudad Estoy?', state: '¿En Qué Estado Estoy?', country: '¿En Qué País Estoy?', converter: 'Conversor de Coordenadas (DD/GMS/UTM)', addressFinder: 'Buscador de Dirección (cualquier coordenada)' },
  fr: { gps: 'Mes Coordonnées GPS', address: 'Mon Adresse Actuelle', coordinates: 'Mes Coordonnées', latLong: 'Ma Latitude et Longitude', city: 'Dans Quelle Ville Suis-Je ?', state: 'Dans Quel Département Suis-Je ?', country: 'Dans Quel Pays Suis-Je ?', converter: 'Convertisseur de Coordonnées (DD/DMS/UTM)', addressFinder: "Localisateur d'Adresse (toute coordonnée)" },
  de: { gps: 'Meine GPS-Koordinaten', address: 'Meine Aktuelle Adresse', coordinates: 'Meine Koordinaten', latLong: 'Mein Breiten- & Längengrad', city: 'In Welcher Stadt Bin Ich?', state: 'In Welchem Bundesland Bin Ich?', country: 'In Welchem Land Bin Ich?', converter: 'Koordinaten-Umrechner (DD/GMS/UTM)', addressFinder: 'Adressen-Finder (beliebige Koordinaten)' },
  pt: { gps: 'Minhas Coordenadas GPS', address: 'Meu Endereço Atual', coordinates: 'Minhas Coordenadas', latLong: 'Minha Latitude e Longitude', city: 'Em Que Cidade Estou?', state: 'Em Que Estado Estou?', country: 'Em Que País Estou?', converter: 'Conversor de Coordenadas (DD/GMS/UTM)', addressFinder: 'Localizador de Endereço (quaisquer coordenadas)' }
};

const c = dict[attribute]?.[lang] || dict[attribute]?.en;
const linkLabels = relatedLinkLabels[lang] || relatedLinkLabels.en;
const faq = c.faq ?? faqBank[attribute]?.[lang] ?? faqBank[attribute]?.en;

const relatedLinks = [
  { label: linkLabels.gps, href: getLocalizedPath('/my-location/gps/', lang) },
  { label: linkLabels.address, href: getLocalizedPath('/my-location/address/', lang) },
  { label: linkLabels.coordinates, href: getLocalizedPath('/my-location/coordinates/', lang) },
  { label: linkLabels.latLong, href: getLocalizedPath('/my-location/latitude-longitude/', lang) },
  { label: linkLabels.city, href: getLocalizedPath('/my-location/city/', lang) },
  { label: linkLabels.state, href: getLocalizedPath('/my-location/state/', lang) },
  { label: linkLabels.country, href: getLocalizedPath('/my-location/country/', lang) },
  { label: linkLabels.converter, href: getLocalizedPath('/tools/coordinate-converter/', lang) },
  ...(attribute === 'address' ? [{ label: linkLabels.addressFinder, href: getLocalizedPath('/tools/address-finder/', lang) }] : [])
];

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: t('nav.myLocation'), href: '/my-location/' },
  { label: `${c.h1Prefix} ${c.h1Accent}` }
];

const faqSchema = faq ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]*>?/gm, '')
    }
  }))
} : undefined;
---

<BaseLayout
  leaflet
  lang={lang}
  title={c.title}
  description={c.description}
  activeSection="my-location"
  jsonLd={faqSchema ? [faqSchema] : undefined}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />
    <SiloNav silo="my-location" lang={lang} title={c.h3Related} />

    <section class="page-header">
      <h1>{c.h1Prefix} <span class="text-gradient">{c.h1Accent}</span></h1>
      <p class="page-header-desc">{c.subtitle}</p>
    </section>

    <LocationFinder emphasisField={c.emphasisField} lang={lang} />

    <section class="section">
      <div class="prose" style="max-width: var(--max-width-narrow);">
        <h2>{c.h2How}</h2>
        <p>{c.pHow1}</p>
        <p>{c.pHow2}</p>

        <h2>{c.h2What}</h2>
        <ul>
          {c.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>

        {faq && faq.length > 0 && (
          <div style="margin-top: var(--space-8);">
            <h2>FAQ</h2>
            <FAQAccordion items={faq} includeSchema={false} />
          </div>
        )}

        <h3>{c.h3Related}</h3>
        <ul>
          {relatedLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
