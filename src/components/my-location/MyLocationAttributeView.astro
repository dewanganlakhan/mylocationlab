  { key: 'gps', label: linkLabels.gps, href: getLocalizedPath('/gps/', lang), icon: '🛰️' },
  { key: 'address', label: linkLabels.address, href: getLocalizedPath('/address/', lang), icon: '🏠' },
  { key: 'coordinates', label: linkLabels.coordinates, href: getLocalizedPath('/coordinates/', lang), icon: '🧭' },
  { key: 'latLong', label: linkLabels.latLong, href: getLocalizedPath('/latitude-longitude/', lang), icon: '🌐' },
  { key: 'city', label: linkLabels.city, href: getLocalizedPath('/city/', lang), icon: '🏙️' },
  { key: 'state', label: linkLabels.state, href: getLocalizedPath('/state/', lang), icon: '🏛️' },
  { key: 'country', label: linkLabels.country, href: getLocalizedPath('/country/', lang), icon: '🗺️' },
  { key: 'gpsFinder', label: linkLabels.gpsFinder, href: getLocalizedPath('/tools/gps-coordinates/', lang), icon: '📍' },
  { key: 'converter', label: linkLabels.converter, href: getLocalizedPath('/tools/coordinate-converter/', lang), icon: '🔀' },
  { key: 'addressFinder', label: linkLabels.addressFinder, href: getLocalizedPath('/tools/address-finder/', lang), icon: '🔍' },
  { key: 'reverseGeo', label: linkLabels.reverseGeo, href: getLocalizedPath('/tools/reverse-geocoding/', lang), icon: '🔄' },
  { key: 'accuracy', label: linkLabels.accuracy, href: getLocalizedPath('/tools/gps-accuracy/', lang), icon: '🎯' },
  { key: 'elevation', label: linkLabels.elevation, href: getLocalizedPath('/tools/elevation-finder/', lang), icon: '⛰️' },
  { key: 'distance', label: linkLabels.distance, href: getLocalizedPath('/tools/distance-calculator/', lang), icon: '📏' },
  { key: 'qr', label: linkLabels.qr, href: getLocalizedPath('/tools/location-qr-code/', lang), icon: '📱' },
];
const relatedLinks = allRelatedLinks.filter(l => l.key !== attribute);

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: t('nav.myLocation'), href: '/location/' },
  { label: `${c.h1Prefix} ${c.h1Accent}` }
];

const faqSchema = faq ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]*>?/gm, '')
    }
  }))
} : undefined;
---

<BaseLayout
  leaflet
  lang={lang}
  title={c.title}
  description={c.description}
  activeSection="my-location"
  jsonLd={faqSchema ? [faqSchema] : undefined}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />

    <section class="page-header">
      <h1>{c.h1Prefix} <span class="text-gradient">{c.h1Accent}</span></h1>
      <p class="page-header-desc">{c.subtitle}</p>
    </section>

    <LocationFinder emphasisField={c.emphasisField} lang={lang} />

    {attribute === 'gps' && (
      <div class="custom-attr-panel" style="margin: var(--space-6) 0; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-6);">
        <h3 style="margin-top:0; font-size: var(--text-lg); color: var(--color-text-primary);">🛰️ GPS Sensor & Accuracy Classification</h3>
        <p style="font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.75;">
          GPS accuracy depends heavily on how your device acquires its position fix. Below is the standard geodetic accuracy scale for modern positioning:
        </p>
        <div style="overflow-x: auto; margin-top: var(--space-4);">
          <table style="width: 100%; border-collapse: collapse; font-size: var(--text-xs);">
            <thead>
              <tr style="background: var(--color-bg-tertiary); text-align: left;">
                <th style="padding: 8px 12px; border: 1px solid var(--color-border);">Accuracy Tier</th>
                <th style="padding: 8px 12px; border: 1px solid var(--color-border);">Radius Range</th>
                <th style="padding: 8px 12px; border: 1px solid var(--color-border);">Primary Signal Source</th>
                <th style="padding: 8px 12px; border: 1px solid var(--color-border);">Typical Environment</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-weight: 700; color: #10b981;">Survey Grade / RTK</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">± 0.01 – 0.1 m</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Dual-frequency GNSS + Base Station</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Land surveying, autonomous farming</td>
              </tr>
              <tr>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-weight: 700; color: #2563eb;">Smartphone Outdoor GPS</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">± 3 – 5 m</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">L1/L5 Multi-GNSS satellites</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Clear sky, outdoors, highways</td>
              </tr>
              <tr>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-weight: 700; color: #f59e0b;">Wi-Fi Triangulation</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">± 15 – 50 m</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Nearby Wi-Fi router BSSIDs</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Indoors, malls, urban offices</td>
              </tr>
              <tr>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-weight: 700; color: #ef4444;">IP-Based Lookup</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">± 5 – 40 km</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Internet service provider routing</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Desktop PC with no GPS/Wi-Fi</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    )}

    {attribute === 'coordinates' && (
      <div class="custom-attr-panel" style="margin: var(--space-6) 0; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-6);">
        <h3 style="margin-top:0; font-size: var(--text-lg); color: var(--color-text-primary);">🗺️ Coordinate Systems Comparison & Usage</h3>
        <p style="font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.75;">
          Different fields and applications use different coordinate formats. Here is when and why to use each:
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-4); margin-top: var(--space-4);">
          <div style="background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4);">
            <div style="font-weight: 700; font-size: var(--text-sm); color: var(--color-text-primary); margin-bottom: 4px;">Decimal Degrees (DD)</div>
            <p style="font-size: var(--text-xs); color: var(--color-text-secondary); margin: 0; line-height: 1.6;">Example: <code>28.6139, 77.2090</code>. Best for: Web APIs, Google Maps, GPS navigation apps, and programmatic geocoding.</p>
          </div>
          <div style="background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4);">
            <div style="font-weight: 700; font-size: var(--text-sm); color: var(--color-text-primary); margin-bottom: 4px;">Degrees Minutes Seconds (DMS)</div>
            <p style="font-size: var(--text-xs); color: var(--color-text-secondary); margin: 0; line-height: 1.6;">Example: <code>28°36'50"N 77°12'32"E</code>. Best for: Marine navigation, aviation charts, paper maps, and traditional surveying.</p>
          </div>
          <div style="background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4);">
            <div style="font-weight: 700; font-size: var(--text-sm); color: var(--color-text-primary); margin-bottom: 4px;">Universal Transverse Mercator (UTM)</div>
            <p style="font-size: var(--text-xs); color: var(--color-text-secondary); margin: 0; line-height: 1.6;">Example: <code>Zone 43R 716492 3166882</code>. Best for: Topographic hiking maps, military grid (MGRS), and engineering surveys measured in meters.</p>
          </div>
          <div style="background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4);">
            <div style="font-weight: 700; font-size: var(--text-sm); color: var(--color-text-primary); margin-bottom: 4px;">Plus Codes (Open Location Code)</div>
            <p style="font-size: var(--text-xs); color: var(--color-text-secondary); margin: 0; line-height: 1.6;">Example: <code>7JWVHCP+RP</code>. Best for: Street-less addresses, emergency deliveries, and offline global digital addressing.</p>
          </div>
        </div>
      </div>
    )}

    {attribute === 'latitude-longitude' && (
      <div class="custom-attr-panel" style="margin: var(--space-6) 0; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-6);">
        <h3 style="margin-top:0; font-size: var(--text-lg); color: var(--color-text-primary);">🌐 Latitude & Longitude Precision Scale</h3>
        <p style="font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.75;">
          How much real-world ground distance does each decimal place in latitude and longitude represent?
        </p>
        <div style="overflow-x: auto; margin-top: var(--space-4);">
          <table style="width: 100%; border-collapse: collapse; font-size: var(--text-xs);">
            <thead>
              <tr style="background: var(--color-bg-tertiary); text-align: left;">
                <th style="padding: 8px 12px; border: 1px solid var(--color-border);">Decimal Places</th>
                <th style="padding: 8px 12px; border: 1px solid var(--color-border);">Approximate Ground Distance</th>
                <th style="padding: 8px 12px; border: 1px solid var(--color-border);">What it Identifies</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-family: var(--font-mono);">0 decimals (1.0°)</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">~ 111 km</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Large region, state, or country</td>
              </tr>
              <tr>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-family: var(--font-mono);">1 decimal (0.1°)</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">~ 11.1 km</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Large city or metropolitan district</td>
              </tr>
              <tr>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-family: var(--font-mono);">2 decimals (0.01°)</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">~ 1.11 km</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Town, village, or neighborhood</td>
              </tr>
              <tr>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-family: var(--font-mono);">3 decimals (0.001°)</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">~ 111 m</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Agricultural field or large estate</td>
              </tr>
              <tr>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-family: var(--font-mono); font-weight:700; color: #10b981;">4 decimals (0.0001°)</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-weight:700; color: #10b981;">~ 11.1 m</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Individual land parcel or residential building</td>
              </tr>
              <tr>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-family: var(--font-mono);">5 decimals (0.00001°)</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">~ 1.11 m</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Single room, entrance door, or parking bay</td>
              </tr>
              <tr>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border); font-family: var(--font-mono);">6 decimals (0.000001°)</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">~ 0.11 m (11 cm)</td>
                <td style="padding: 8px 12px; border: 1px solid var(--color-border);">Survey pin, human footsteps</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    )}

    <section class="section">
      <div class="prose" style="max-width: var(--max-width-narrow);">
        {c.inShort && (
          <div class="callout-box" style="margin-bottom: var(--space-6); background: var(--color-bg-secondary); border-left: 4px solid var(--color-accent-primary); padding: var(--space-4) var(--space-5); border-radius: var(--radius-md);">
            <p style="margin: 0; font-weight: 500; font-size: var(--text-base); color: var(--color-text-primary); line-height: 1.75;">
              {c.inShort}
            </p>
          </div>
        )}

        <h2>{c.h2How}</h2>
        <p set:html={localizeHtml(c.pHow1, lang)} />
        <p set:html={localizeHtml(c.pHow2, lang)} />

        <h2>{c.h2What}</h2>
        <ul>
          {c.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>

        {c.whenToUse && (
          <div style="margin: var(--space-8) 0;">
            <h2>🧭 {c.h2WhenToUse || "When to Use This Page"}</h2>
            <div style="display: grid; gap: var(--space-3); margin-top: var(--space-4);">
              {c.whenToUse.map((w: any) => (
                <div class="card card-flat" style="padding: var(--space-4) var(--space-5); border-left: 3px solid var(--color-accent-primary);">
                  <strong style="display: block; color: var(--color-text-primary); margin-bottom: var(--space-1);">{w.title}</strong>
                  <span style="color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6;">{w.desc}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {faq && faq.length > 0 && (
          <div style="margin-top: var(--space-8);">
            <h2>FAQ</h2>
            <FAQAccordion items={faq} includeSchema={false} />
          </div>
        )}

        {c.nextSteps && (
          <div class="card card-flat" style="margin: var(--space-10) 0; padding: var(--space-6); background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
            <h3 style="margin-top: 0; margin-bottom: var(--space-4); font-size: var(--text-lg); display: flex; align-items: center; gap: var(--space-2);">
              <span>🚀</span> {c.nextStepsTitle || "Next Steps"}
            </h3>
            <div style="display: grid; gap: var(--space-3);">
              {c.nextSteps.map((step: any) => (
                <a href={getLocalizedPath(step.href, lang)} class="card card-flat" style="display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-3) var(--space-4); text-decoration: none; border-left: 3px solid var(--color-accent-primary); background: var(--color-bg-card); transition: transform 0.15s ease;">
                  <strong style="color: var(--color-text-primary); font-size: var(--text-base);">{step.title} →</strong>
                  <span style="color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6;">{step.desc}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="contextual-next-box" style="margin-top: var(--space-8);">
        <h3 style="margin-top: 0; margin-bottom: var(--space-2);">{c.h3Related}</h3>
        <p style="font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: var(--space-4);">
          {lang === 'es' ? 'Explora herramientas relacionadas de geolocalización y análisis de coordenadas:' :
           lang === 'fr' ? 'Découvrez les outils géographiques et de conversion associés :' :
           lang === 'de' ? 'Entdecken Sie verwandte Geotools und Koordinaten-Konverter:' :
           lang === 'pt' ? 'Explore ferramentas relacionadas de geolocalização e coordenadas:' :
           lang === 'hi' ? 'संबंधित भौगोलिक उपकरण और निर्देशांक विश्लेषक देखें:' :
           lang === 'id' ? 'Jelajahi alat geolokasi dan analisis koordinat terkait:' :
           'Explore related geolocation tools and coordinate utilities:'}
        </p>
        <div class="contextual-next-grid">
          {relatedLinks.map((l) => (
            <a href={l.href} class="contextual-link-card">
              <span class="contextual-link-icon">{l.icon}</span>
              <div class="contextual-link-info">
                <div class="contextual-link-title">{l.label}</div>
                <div class="contextual-link-sub">
                  {['gps', 'address', 'coordinates', 'latLong', 'city', 'state', 'country'].includes(l.key) 
                    ? (lang === 'es' ? 'Lectura directa' : lang === 'fr' ? 'Mesure en direct' : lang === 'de' ? 'Live-Erkennung' : lang === 'pt' ? 'Leitura direta' : lang === 'hi' ? 'लाइव पहचान' : lang === 'id' ? 'Deteksi langsung' : 'Live Detection')
                    : (lang === 'es' ? 'Herramienta de precisión' : lang === 'fr' ? 'Outil de précision' : lang === 'de' ? 'Präzisionswerkzeug' : lang === 'pt' ? 'Ferramenta de precisão' : lang === 'hi' ? 'सटीक उपकरण' : lang === 'id' ? 'Alat presisi' : 'Precision Utility')}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
