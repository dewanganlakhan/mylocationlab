---

<BaseLayout
  leaflet
  lang={lang}
  title={c.title}
  description={c.description}
  activeSection="my-location"
  jsonLd={[breadcrumbSchema, webAppSchema]}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />
    <SiloNav silo="my-location" lang={lang} title={c.siloTitle} />

    <section class="page-header">
      <h1>{c.h1Prefix} <span class="text-gradient">{c.h1Accent}</span></h1>
      <p class="page-header-desc">{c.subtitle}</p>
    </section>

    <!-- Interactive Location Finder with Address Emphasis & 1-Click Copy/Share -->
    <LocationFinder emphasisField="address" lang={lang} />

    <section class="section" style="padding-top: var(--space-8);">
      <article class="prose address-article-content" style="max-width: var(--max-width-narrow); margin: 0 auto;">
        
        <h2>{c.h2Steps}</h2>
        <p>{c.pStepsIntro}</p>

        <div class="step-guide-grid">
          {c.steps.map((step) => (
            <div class="step-guide-card">
              <span class="step-badge">{step.badge}</span>
              <h4>{step.title}</h4>
              <p>{step.desc}</p>
            </div>
          ))}
        </div>

        <div class="callout-box">
