const c = contentData[lang] || contentData.en;

const homePath = lang === 'en' ? '/' : `/${lang}/`;
const myLocPath = getLocalizedPath('/my-location/', lang);

const breadcrumbs = [
  { label: lang === 'en' ? 'Home' : (lang === 'es' ? 'Inicio' : (lang === 'fr' ? 'Accueil' : (lang === 'de' ? 'Startseite' : (lang === 'pt' ? 'Início' : (lang === 'hi' ? 'होम' : 'Beranda'))))), href: homePath },
  { label: lang === 'en' ? 'My Location' : (lang === 'es' ? 'Mi Ubicación' : (lang === 'fr' ? 'Ma Position' : (lang === 'de' ? 'Mein Standort' : (lang === 'pt' ? 'Minha Localização' : (lang === 'hi' ? 'मेरी लोकेशन' : 'Lokasi Saya'))))), href: myLocPath },
  { label: c.breadcrumbLabel }
];

const currentUrl = `https://mylocationlab.com${getLocalizedPath('/my-location/address/', lang)}`;

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: c.h1Prefix + ' ' + c.h1Accent,
  url: currentUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: lang === 'pt' ? 'BRL' : (lang === 'es' || lang === 'fr' || lang === 'de' ? 'EUR' : (lang === 'hi' ? 'INR' : (lang === 'id' ? 'IDR' : 'USD')))
  },
  description: c.description
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.label,
    ...(b.href ? { item: `https://mylocationlab.com${b.href}` } : {})
  }))
};

