---
/**
 * ToolCard — Reusable card for tool grids with icon, title, description, and hover animation
 */
import { getLangFromUrl, getLocalizedPath } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  icon: string;
  url: string;
  class?: string;
  lang?: string;
}

const { title, description, icon, url, class: className = '', lang: customLang } = Astro.props;
const lang = customLang || getLangFromUrl(Astro.url);
const resolvedUrl = url.startsWith('/') ? getLocalizedPath(url, lang) : url;

// Extract slug to determine clean SVG icon
const slug = url.replace(/^\/tools\//, '').replace(/\/$/, '');
---

<a href={resolvedUrl} class={`tool-card ${className}`}>
  <div class="tool-card-icon">
    {slug === 'gps-coordinates' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <line x1="22" y1="12" x2="18" y2="12"/>
        <line x1="6" y1="12" x2="2" y2="12"/>
        <line x1="12" y1="6" x2="12" y2="2"/>
        <line x1="12" y1="22" x2="12" y2="18"/>
      </svg>
    )}
    {slug === 'latitude-longitude' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <line x1="22" y1="12" x2="18" y2="12"/>
        <line x1="6" y1="12" x2="2" y2="12"/>
        <line x1="12" y1="2" x2="12" y2="2"/>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
      </svg>
    )}
    {slug === 'address-finder' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
    )}
    {slug === 'reverse-geocoding' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="1 4 1 10 7 10"/>
        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
      </svg>
    )}
    {slug === 'geocoding' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    )}
    {slug === 'distance-calculator' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0z"/>
        <line x1="14.5" y1="7.5" x2="12.5" y2="9.5"/>
        <line x1="11.5" y1="10.5" x2="9.5" y2="12.5"/>
        <line x1="8.5" y1="13.5" x2="6.5" y2="15.5"/>
      </svg>
    )}
    {slug === 'coordinate-converter' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m16 3 4 4-4 4"/>
        <path d="M20 7H4"/>
        <path d="m8 21-4-4 4-4"/>
        <path d="M4 17h16"/>
      </svg>
    )}
    {slug === 'elevation-finder' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m8 3 4 8 5-5 5 15H2L8 3z"/>
      </svg>
    )}
    {slug === 'gps-accuracy' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"/>
        <circle cx="12" cy="12" r="3"/>
      </svg>
    )}
    {slug === 'location-qr-code' && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="6" height="6" x="3" y="3" rx="1"/>
        <rect width="6" height="6" x="15" y="3" rx="1"/>
        <rect width="6" height="6" x="3" y="15" rx="1"/>
        <path d="M21 15h-3a1 1 0 0 0-1 1v3"/>
        <path d="M21 21v.01"/>
        <path d="M12 7v3a1 1 0 0 1-1 1H7"/>
        <path d="M3 12h.01"/>
        <path d="M12 3h.01"/>
        <path d="M12 16v.01"/>
        <path d="M16 12h1"/>
        <path d="M21 12v.01"/>
        <path d="M12 21v-1"/>
      </svg>
    )}
    {!['gps-coordinates', 'latitude-longitude', 'address-finder', 'reverse-geocoding', 'geocoding', 'distance-calculator', 'coordinate-converter', 'elevation-finder', 'gps-accuracy', 'location-qr-code'].includes(slug) && (
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="3 11 22 2 13 21 11 13 3 11" fill="currentColor" stroke="none" />
      </svg>
    )}
  </div>
  <h3 class="tool-card-title">{title}</h3>
  <p class="tool-card-desc">{description}</p>
</a>
