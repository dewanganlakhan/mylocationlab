const t = translations[lang] || translations.en;
---

<ToolLayout leaflet toolId="geocoding" title={t.title} description={t.description} h1={t.h1} subtitle={t.subtitle} lang={lang}>
  <div class="tool-interface">
    <label class="label">{t.labelInput}</label>
    <div class="input-group" style="margin-bottom: var(--space-4);">
      <input type="text" class="input" id="gc-input" placeholder={t.placeholder} />
      <button class="btn btn-primary" id="gc-btn" type="button">{t.btnFind}</button>
    </div>
    <div id="gc-results" style="display: none;">
      <h3 style="font-size: var(--text-base); margin-bottom: var(--space-4);">{t.h3Results}</h3>
      <div id="gc-list"></div>
    </div>
  </div>
  <div class="map-container" id="gc-map" style="margin-top: var(--space-6); display: none; min-height: 380px;"></div>
  
  <div class="prose" style="margin-top: var(--space-12); line-height: 1.8;">
    <h2>{t.h2What}</h2>
    <p set:html={t.pWhat}></p>
    <h3>{t.h3Related}</h3>
    <ul>
      <li><a href={getLocalizedPath('/tools/reverse-geocoding/', lang)}>{t.linkRev}</a></li>
      <li><a href={getLocalizedPath('/tools/address-finder/', lang)}>{t.linkAddr}</a></li>
      <li><a href={getLocalizedPath('/comparisons/geocoding-vs-reverse-geocoding/', lang)}>{t.linkComp}</a></li>
      <li><a href={getLocalizedPath('/glossary/', lang)}>{t.linkGlossary}</a></li>
    </ul>
  </div>

  <script define:vars={{ tData: t }}>
    async function runGeocodeSearch(query) {
      if (!query) { alert(tData.alertEmpty); return; }
      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=5&addressdetails=1`, {
          headers: { 'User-Agent': 'MyLocationLab/1.0' }
        });
        if (!res.ok) throw new Error('Geocoding service unavailable');
        const data = await res.json();
        const list = document.getElementById('gc-list');
        const container = document.getElementById('gc-results');
        if (!list || !container) return;

        list.innerHTML = '';
        if (data.length === 0) {
          list.innerHTML = `<p style="color: var(--color-text-tertiary);">${tData.noResults}</p>`;
          container.style.display = 'block';
          return;
        }

        data.forEach(r => {
          const lat = parseFloat(r.lat);
          const lng = parseFloat(r.lon);
          const div = document.createElement('div');
          div.className = 'tool-result';
          div.style.marginBottom = 'var(--space-3)';
          div.style.cursor = 'pointer';
          div.innerHTML = `<div class="tool-result-row"><span class="tool-result-label">${tData.lblLocation}</span><span class="tool-result-value" style="font-family:var(--font-sans);font-size:var(--text-sm);">${r.display_name}</span></div><div class="tool-result-row"><span class="tool-result-label">${tData.lblCoords}</span><span class="tool-result-value" style="color:var(--color-accent-primary); font-family:var(--font-mono); font-weight:700;">${lat.toFixed(6)}, ${lng.toFixed(6)}</span></div>`;
          div.addEventListener('click', () => {
            navigator.clipboard.writeText(`${lat.toFixed(6)}, ${lng.toFixed(6)}`).then(() => {
              const prevBg = div.style.background;
              div.style.background = 'rgba(0, 212, 255, 0.15)';
              setTimeout(() => { div.style.background = prevBg; }, 1000);
            });
            const mapEl = document.getElementById('gc-map');
            if (mapEl) mapEl.style.display = 'block';
            // @ts-ignore
            if (typeof L !== 'undefined') {
              // @ts-ignore
              if (window._gcMap) window._gcMap.remove();
              // @ts-ignore
              window._gcMap = L.map('gc-map').setView([lat, lng], 14);
              // @ts-ignore
              L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(window._gcMap);
              // @ts-ignore
              L.marker([lat, lng]).addTo(window._gcMap).bindPopup(r.display_name).openPopup();

              // @ts-ignore
              if (typeof window.addMapLocateControl === 'function') {
                // @ts-ignore
                window.addMapLocateControl(window._gcMap, {
                  title: tData.locateTitle || 'Zoom to my current location',
                  zoom: 16,
                });
              }
            }
          });
          list.appendChild(div);
        });
        container.style.display = 'block';
      } catch {
        alert(tData.alertFailed);
      }
    }

    document.getElementById('gc-btn')?.addEventListener('click', () => {
      const query = document.getElementById('gc-input')?.value.trim();
      runGeocodeSearch(query);
    });

    document.getElementById('gc-input')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') document.getElementById('gc-btn')?.click();
    });

    const urlQuery = new URLSearchParams(window.location.search).get('q');
    if (urlQuery && urlQuery.trim()) {
      const input = document.getElementById('gc-input');
      if (input) input.value = urlQuery.trim();
      runGeocodeSearch(urlQuery.trim());
    }
  </script>
</ToolLayout>
