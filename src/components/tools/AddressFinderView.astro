    btnSearch: "Cari Alamat",
    labelFull: "Alamat Lengkap",
    labelStreet: "Jalan",
    labelCity: "Kota",
    labelState: "Provinsi / Negara Bagian",
    labelPostcode: "Kode Pos",
    labelCountry: "Negara",
    labelCoords: "Koordinat",
    btnCopy: "📋 Salin Alamat",
    alertUnable: "Tidak dapat menemukan alamat untuk koordinat ini.",
