const t = translations[lang] || translations.en;
---

<ToolLayout leaflet toolId="address-finder" title={t.title} description={t.description} h1={t.h1} subtitle={t.subtitle} lang={lang}>
  <div class="tool-interface">
    <div class="flex gap-4 flex-wrap" style="margin-bottom: var(--space-4);">
      <button class="btn btn-primary" id="af-gps" type="button">{t.btnGps}</button>
      <span style="color: var(--color-text-tertiary); align-self: center;">{t.orEnterCoords}</span>
    </div>
    <div class="input-group" style="margin-bottom: var(--space-4);">
      <input type="text" class="input" id="af-input" placeholder={t.placeholder} />
      <button class="btn btn-secondary" id="af-search" type="button">{t.btnSearch}</button>
    </div>
    <div class="tool-result" id="af-result" style="display: none;">
      <div class="tool-result-row"><span class="tool-result-label">{t.labelFull}</span><span class="tool-result-value" id="af-full" style="font-family: var(--font-sans); font-size: var(--text-sm);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.labelStreet}</span><span class="tool-result-value" id="af-street" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.labelCity}</span><span class="tool-result-value" id="af-city" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.labelState}</span><span class="tool-result-value" id="af-state" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.labelPostcode}</span><span class="tool-result-value" id="af-zip">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.labelCountry}</span><span class="tool-result-value" id="af-country" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.labelCoords}</span><span class="tool-result-value" id="af-coords">—</span></div>
    </div>
    <div id="af-actions" style="margin-top: var(--space-4); display: none;">
      <button class="btn btn-secondary btn-sm" id="af-copy" type="button">{t.btnCopy}</button>
    </div>
  </div>
  <div class="map-container" id="af-map" style="margin-top: var(--space-6); display: none; min-height: 380px;"></div>
  
  <div class="prose" style="margin-top: var(--space-12); line-height: 1.8;">
    <h2>{t.h2How}</h2>
    <p set:html={t.pHow1}></p>
    <p set:html={t.pHow2}></p>
    <h3>{t.h3Related}</h3>
    <ul>
      <li><a href={getLocalizedPath('/tools/reverse-geocoding/', lang)}>{t.linkRev}</a></li>
      <li><a href={getLocalizedPath('/tools/geocoding/', lang)}>{t.linkGeo}</a></li>
      <li><a href={getLocalizedPath('/my-location/address/', lang)}>{t.linkMyAddr}</a></li>
    </ul>
  </div>

  <script define:vars={{ tData: t }}>
    let currentAddress = '';

    async function findAddress(lat, lng) {
      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`, {
          headers: { 'User-Agent': 'MyLocationLab/1.0' }
        });
        if (!res.ok) throw new Error('Geocoding service unavailable');
        const data = await res.json();
        const addr = data.address || {};

        currentAddress = data.display_name || '';
        document.getElementById('af-full').textContent = data.display_name || '—';
        document.getElementById('af-street').textContent = [addr.house_number, addr.road].filter(Boolean).join(' ') || '—';
        document.getElementById('af-city').textContent = addr.city || addr.town || addr.village || '—';
        document.getElementById('af-state').textContent = addr.state || '—';
        document.getElementById('af-zip').textContent = addr.postcode || '—';
        document.getElementById('af-country').textContent = addr.country ? `${addr.country} (${(addr.country_code || '').toUpperCase()})` : '—';
        document.getElementById('af-coords').textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
        document.getElementById('af-result').style.display = 'block';
        document.getElementById('af-actions').style.display = 'block';

        const mapEl = document.getElementById('af-map');
        mapEl.style.display = 'block';
        const waitL = () => {
          // @ts-ignore
          if (typeof L !== 'undefined') {
            // @ts-ignore
            if (window._afMap) window._afMap.remove();
            // @ts-ignore
            window._afMap = L.map('af-map').setView([lat, lng], 16);
            // @ts-ignore
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(window._afMap);
            // @ts-ignore
            L.marker([lat, lng]).addTo(window._afMap).bindPopup(data.display_name).openPopup();

            // @ts-ignore
            if (typeof window.addMapLocateControl === 'function') {
              // @ts-ignore
              window.addMapLocateControl(window._afMap, {
                title: tData.locateTitle || 'Zoom to my current location',
                zoom: 16,
                onLocate: (uLat, uLng) => findAddress(uLat, uLng),
              });
            }
          } else setTimeout(waitL, 100);
        };
        waitL();
      } catch {
        alert(tData.alertUnable);
      }
    }

    document.getElementById('af-gps')?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          findAddress(pos.coords.latitude, pos.coords.longitude);
        },
        (err) => {
          alert(err.message);
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    });

    document.getElementById('af-search')?.addEventListener('click', () => {
      const val = document.getElementById('af-input').value.trim();
      const parts = val.split(/[\s,]+/).map(Number);
      if (parts.length >= 2 && !isNaN(parts[0]) && !isNaN(parts[1]) && Math.abs(parts[0]) <= 90 && Math.abs(parts[1]) <= 180) {
        findAddress(parts[0], parts[1]);
      } else {
        alert(tData.alertInvalid);
      }
    });

    document.getElementById('af-copy')?.addEventListener('click', function() {
      if (currentAddress) {
        navigator.clipboard.writeText(currentAddress).then(() => {
          const orig = this.textContent;
          this.textContent = '✓ Copied!';
          setTimeout(() => { this.textContent = orig; }, 2000);
        });
      }
    });
  </script>
</ToolLayout>
