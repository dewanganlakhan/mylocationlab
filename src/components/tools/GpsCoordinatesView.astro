---
/**
 * GpsCoordinatesView — Multilingual GPS Coordinates Finder Tool
 * Powers: /tools/gps-coordinates/ across en, es, fr, de, pt
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import FAQAccordion from '../FAQAccordion.astro';
import { getLocalizedPath, defaultLang, type SupportedLang } from '../../i18n/config';

interface Props {
  lang?: SupportedLang | string;
}

const { lang: customLang = defaultLang } = Astro.props;
const lang = (customLang || defaultLang) as SupportedLang;

const translations: Record<string, any> = {
  en: {
    title: "GPS Coordinates Finder — Exact Location | MyLocationLab",
    description: "Find your exact GPS coordinates instantly. Get your current latitude, longitude, accuracy, and altitude from GPS satellites.",
    h1: "GPS Coordinates Finder",
    subtitle: "Get your precise GPS coordinates in real-time. Shows latitude, longitude, accuracy, and altitude from satellite signals.",
    promptText: "Detecting your GPS coordinates automatically — no click needed.",
    btnFind: "📍 Find My GPS Coordinates",
    loadingText: "Connecting to GPS satellites...",
    lblLat: "Latitude",
    lblLng: "Longitude",
    lblLatDms: "Latitude (DMS)",
    lblLngDms: "Longitude (DMS)",
    lblAccuracy: "Accuracy",
