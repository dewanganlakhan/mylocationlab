    pHow2: "Sistem GPS bekerja dengan trilaterasi sinyal dari banyak satelit yang mengorbit bumi pada ketinggian sekitar 20.200 km. Perangkat Anda memerlukan sinyal dari minimal 4 satelit untuk menghitung posisi 3D presisi (lintang, bujur, dan ketinggian).",
    h2Results: "Memahami Hasil",
    resLi1: "Lintang & Bujur — Posisi tepat Anda dalam derajat desimal dan format DMS",
    resLi2: "Akurasi — Perkiraan radius galat. Semakin kecil angkanya, semakin presisi",
    resLi3: "Ketinggian — Ketinggian Anda di atas permukaan laut (elipsoid WGS84), jika tersedia",
    h2Tips: "Tips untuk Akurasi GPS Lebih Baik",
    tipLi1: "Ke luar ruangan dengan pandangan langit yang jelas",
    tipLi2: "Tunggu 10-30 detik agar GPS mengunci lebih banyak satelit",
    tipLi3: "Aktifkan mode 'Akurasi Tinggi' di pengaturan lokasi perangkat Anda",
    tipLi4: "Hindari area dekat gedung tinggi atau pohon yang lebat",
    faqItems: [
      { question: 'Bagaimana cara menemukan koordinat GPS saya?', answer: 'Alat ini mendeteksi koordinat GPS Anda <strong>secara otomatis</strong> saat halaman dimuat — peramban akan meminta izin lokasi pada saat pertama. Jika deteksi gagal atau Anda menolak izin, tombol akan muncul agar Anda dapat mencoba lagi secara manual.' },
      { question: 'Dalam format apa koordinat GPS ditampilkan?', answer: 'Secara bawaan, koordinat ditampilkan dalam format <strong>derajat desimal</strong> (DD), format yang paling banyak digunakan untuk aplikasi digital. Anda dapat mengonversinya ke DMS, UTM, atau format lain.' },
      { question: 'Seberapa akurat koordinat GPS ini?', answer: 'Akurasi bergantung pada perangkat dan lingkungan Anda. Ponsel modern memberikan akurasi 3-5 meter di luar ruangan. Di dalam ruangan, akurasi bisa turun ke 10-50 meter. Radius akurasi ditampilkan bersama koordinat Anda.' }
    ]
  }
};

const c = translations[lang] || translations.en;

const locateTitle = ({
  en: "Zoom to my current location",
  es: "Centrar y ampliar en mi ubicación",
  fr: "Zoomer sur ma position actuelle",
  de: "Auf meinen aktuellen Standort zoomen",
  pt: "Aproximar da minha localização atual",
  hi: "मेरी वर्तमान लोकेशन पर ज़ूम करें",
  id: "Perbesar ke lokasi saya saat ini"
})[lang] || "Zoom to my current location";
---

<ToolLayout
  leaflet
  lang={lang}
  toolId="gps-coordinates"
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
>
  <div class="tool-interface">
    <!-- Place / Address Search Bar to Look up GPS for Any Location -->
    <div style="display: flex; gap: var(--space-2); margin-bottom: var(--space-4); flex-wrap: wrap;">
      <input
        type="text"
        id="gps-search-input"
        class="input"
        placeholder={c.searchPlaceholder || "Search any address, city, or landmark..."}
        style="flex: 1; min-width: 200px; padding: 8px 12px; font-size: var(--text-sm);"
      />
      <button class="btn btn-secondary btn-sm" id="gps-search-btn" type="button">{c.searchBtn || "Lookup GPS"}</button>
    </div>

    <div style="text-align: center; padding: var(--space-4) 0;" id="gps-prompt">
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4);">{c.promptText}</p>
      <button class="btn btn-primary btn-lg" id="gps-btn" type="button">{c.btnFind}</button>
    </div>

    <div id="gps-loading" style="display: none; text-align: center; padding: var(--space-6);">
      <div class="spinner" style="margin: 0 auto var(--space-3);"></div>
      <p style="color: var(--color-text-secondary); margin: 0;">{c.loadingText}</p>
    </div>

    <p id="gps-error" data-nosnippet style="display: none; margin: var(--space-3) 0 0; text-align: center; color: var(--color-accent-error, #ef4444); font-size: var(--text-sm);" role="alert" aria-live="polite"></p>

    <div class="tool-result" id="gps-result" style="display: none;">
      <div class="tool-result-row">
        <span class="tool-result-label">{c.lblLat}</span>
        <span class="tool-result-value" id="gps-lat" style="color: var(--color-accent-primary);">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{c.lblLng}</span>
        <span class="tool-result-value" id="gps-lng" style="color: var(--color-accent-primary);">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{c.lblLatDms}</span>
        <span class="tool-result-value" id="gps-lat-dms">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{c.lblLngDms}</span>
        <span class="tool-result-value" id="gps-lng-dms">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{c.lblAccuracy}</span>
        <span class="tool-result-value" id="gps-acc">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{c.lblAltitude}</span>
        <span class="tool-result-value" id="gps-alt">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{c.lblTimestamp}</span>
        <span class="tool-result-value" id="gps-time" style="font-size: var(--text-sm);">—</span>
      </div>
    </div>

    <div class="action-buttons" id="gps-actions" style="margin-top: var(--space-4); display: none;">
      <button class="btn btn-secondary btn-sm" id="gps-copy" type="button">{c.btnCopy}</button>
      <button class="btn btn-secondary btn-sm" id="gps-share" type="button">{c.btnShare}</button>
      <a class="btn btn-secondary btn-sm" id="gps-maps" href="#" target="_blank" rel="noopener noreferrer">{c.btnMaps}</a>
      <button class="btn btn-ghost btn-sm" id="gps-refresh" type="button">{c.btnRefresh}</button>
    </div>
  </div>

  <div class="map-container" id="gps-map" data-locate-title={locateTitle} style="margin-top: var(--space-6); display: none;"></div>

  <!-- Content -->
  <div class="prose" style="margin-top: var(--space-12);">
    <h2>{c.h2How}</h2>
    <p>{c.pHow1}</p>
    <p>{c.pHow2}</p>

    <h2>{c.h2Results}</h2>
    <ul>
      <li>{c.resLi1}</li>
      <li>{c.resLi2}</li>
      <li>{c.resLi3}</li>
    </ul>

    <h2>{c.h2Tips}</h2>
    <ol>
      <li>{c.tipLi1}</li>
      <li>{c.tipLi2}</li>
      <li>{c.tipLi3}</li>
      <li>{c.tipLi4}</li>
    </ol>

    <div class="callout-box" style="margin-top: var(--space-6); line-height: 1.8;">
      <p style="margin: 0; font-size: var(--text-sm);">
        {lang === 'fr' ? (
          <>
            <strong>Outils d'approfondissement géodésique :</strong> Besoin de convertir vos coordonnées en degrés-minutes-secondes ou en UTM militaire ? Utilisez notre <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Convertisseur de Coordonnées</a> et consultez la <a href={getLocalizedPath('/comparisons/decimal-degrees-vs-dms/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">comparaison Degrés Décimaux vs DMS</a>. Pour identifier l'adresse physique liée à vos coordonnées, consultez le <a href={getLocalizedPath('/tools/address-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Localisateur d'Adresse</a> et le <a href={getLocalizedPath('/tools/reverse-geocoding/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Géocodage Inverse</a>. Surveillez la réception satellite avec le <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Testeur de Précision GPS</a>, mesurez l'altitude avec le <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Localisateur d'Altitude</a> ou partagez un repère via <a href={getLocalizedPath('/tools/location-qr-code/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">QR Code de Localisation</a>.
          </>
        ) : lang === 'es' ? (
          <>
            <strong>Herramientas de análisis geodésico :</strong> ¿Desea convertir sus coordenadas a grados, minutos y segundos o UTM militar? Utilice nuestro <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Conversor de Coordenadas</a> y consulte la <a href={getLocalizedPath('/comparisons/decimal-degrees-vs-dms/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">comparativa grados decimales vs DMS</a>. Para resolver la dirección de calle exacta, use el <a href={getLocalizedPath('/tools/address-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Buscador de Dirección</a> y el <a href={getLocalizedPath('/tools/reverse-geocoding/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Geocodificador Inverso</a>. Monitoree su señal satelital en el <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Comprobador de Precisión GPS</a>, mida alturas con el <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Buscador de Altitud</a> o genere un pin en <a href={getLocalizedPath('/tools/location-qr-code/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Código QR de Ubicación</a>.
          </>
        ) : lang === 'de' ? (
          <>
            <strong>Weiterführende Geodaten-Werkzeuge :</strong> Möchten Sie Ihre Koordinaten in GMS oder das militärische UTM-Gitter umrechnen? Nutzen Sie unseren <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Koordinaten-Konverter</a> und den Leitfaden <a href={getLocalizedPath('/comparisons/decimal-degrees-vs-dms/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Dezimalgrad vs. GMS</a>. Zur Ermittlung der Postadresse für diese Koordinaten stehen der <a href={getLocalizedPath('/tools/address-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Adressen-Finder</a> und der <a href={getLocalizedPath('/tools/reverse-geocoding/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Rückwärts-Geocoder</a> bereit. Prüfen Sie Empfangsfehler im <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS-Genauigkeitsprüfer</a>, messen Sie Geländehöhen mit dem <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Höhenfinder</a> oder teilen Sie Wegpunkte per <a href={getLocalizedPath('/tools/location-qr-code/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Standort-QR-Code</a>.
          </>
        ) : lang === 'pt' ? (
          <>
            <strong>Ferramentas de análise geodésica :</strong> Deseja converter coordenadas para graus-minutos-segundos ou projeção UTM? Use nosso <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Conversor de Coordenadas</a> e veja o comparativo de <a href={getLocalizedPath('/comparisons/decimal-degrees-vs-dms/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">graus decimais vs DMS</a>. Para resolver o endereço postal destas coordenadas, utilize o <a href={getLocalizedPath('/tools/address-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Localizador de Endereço</a> e o <a href={getLocalizedPath('/tools/reverse-geocoding/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Geocodificador Reverso</a>. Acompanhe a margem de erro com o <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Verificador de Precisão GPS</a>, meça altitude com o <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Localizador de Altitude</a> ou gere um ponto via <a href={getLocalizedPath('/tools/location-qr-code/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">QR Code de Localização</a>.
          </>
        ) : lang === 'hi' ? (
          <>
            <strong>संबंधित भूस्थानिक टूल :</strong> अपने निर्देशांकों को DMS या UTM में बदलने के लिए हमारे <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">निर्देशांक कनवर्टर</a> का उपयोग करें। इन निर्देशांकों से सड़क का पता जानने के लिए <a href={getLocalizedPath('/tools/address-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">सड़क पता खोजक</a> और <a href={getLocalizedPath('/tools/reverse-geocoding/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">रिवर्स जियोकोडर</a> देखें। सिग्नल त्रुटि जांचने के लिए <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS सटीकता चेकर</a>, ऊंचाई जानने के लिए <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">ऊंचाई खोजक</a> या मोबाइल साझा करने के लिए <a href={getLocalizedPath('/tools/location-qr-code/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">लोकेशन QR कोड</a> देखें।
          </>
        ) : lang === 'id' ? (
          <>
            <strong>Alat Analisis Geodesi Terkait :</strong> Butuh mengubah format koordinat ke DMS atau kisi UTM militer? Gunakan <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Konverter Koordinat</a> dan baca <a href={getLocalizedPath('/comparisons/decimal-degrees-vs-dms/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">perbandingan derajat desimal vs DMS</a>. Untuk menemukan alamat jalan untuk koordinat ini, gunakan <a href={getLocalizedPath('/tools/address-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Pencari Alamat</a> dan <a href={getLocalizedPath('/tools/reverse-geocoding/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Reverse Geocoder</a>. Pantau margin kesalahan di <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Pemeriksa Akurasi GPS</a>, cek ketinggian dengan <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Pencari Elevasi</a>, atau buat pin via <a href={getLocalizedPath('/tools/location-qr-code/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">QR Code Lokasi</a>.
          </>
        ) : (
          <>
            <strong>Advanced Geodesy Tools:</strong> Need to reformat coordinates into nautical DMS or military UTM grids? Use our <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Coordinate Converter</a> and explore <a href={getLocalizedPath('/comparisons/decimal-degrees-vs-dms/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Decimal Degrees vs DMS</a>. To translate coordinates into a street address, explore our <a href={getLocalizedPath('/tools/address-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Address Finder</a> and <a href={getLocalizedPath('/tools/reverse-geocoding/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Reverse Geocoder</a>. Monitor live receiver quality with our <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS Accuracy Checker</a>, verify vertical ground height with the <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Elevation Finder</a>, or create a mobile pin using the <a href={getLocalizedPath('/tools/location-qr-code/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Location QR Code Generator</a>.
          </>
        )}
      </p>
    </div>

    <!-- Related Tools Grid -->
    <div class="contextual-next-box" style="margin-top: var(--space-8);">
      <h3 class="contextual-next-title">
        <span>🛠️</span>
        <span>{lang === 'fr' ? 'Outils Géographiques Liés' : lang === 'es' ? 'Herramientas de Coordenadas Relacionadas' : lang === 'de' ? 'Verwandte Geodaten-Tools' : lang === 'pt' ? 'Ferramentas Geográficas Relacionadas' : lang === 'hi' ? 'संबंधित निर्देशांक टूल' : lang === 'id' ? 'Alat Terkait' : 'Connected Coordinate Tools'}</span>
      </h3>
      <div class="contextual-next-grid">
        <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon">🔀</span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Conversor de Coordenadas' : lang === 'fr' ? 'Convertisseur de Coordonnées' : lang === 'de' ? 'Koordinaten-Konverter' : lang === 'pt' ? 'Conversor de Coordenadas' : lang === 'hi' ? 'निर्देशांक कनवर्टर' : lang === 'id' ? 'Konverter Koordinat' : 'Coordinate Converter'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'DD, DMS, UTM y MGRS' : lang === 'fr' ? 'DD, DMS, UTM et MGRS' : lang === 'de' ? 'DD, GMS, UTM und MGRS' : 'DD, DMS, UTM, MGRS'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/address-finder/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon">🏠</span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Buscador de Dirección' : lang === 'fr' ? "Localisateur d'Adresse" : lang === 'de' ? 'Adressen-Finder' : lang === 'pt' ? 'Localizador de Endereço' : lang === 'hi' ? 'सड़क पता खोजक' : lang === 'id' ? 'Pencari Alamat' : 'Street Address Finder'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Dirección para estas coordenadas' : lang === 'fr' ? 'Adresse pour ces coordonnées' : lang === 'de' ? 'Adresse für diese Koordinaten' : 'Street address for coordinates'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/latitude-longitude/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon">🌐</span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Buscador de Latitud y Longitud' : lang === 'fr' ? 'Latitude et Longitude' : lang === 'de' ? 'Breiten- & Längengrad' : lang === 'pt' ? 'Latitude e Longitude' : lang === 'hi' ? 'अक्षांश और देशांतर खोजक' : lang === 'id' ? 'Lintang dan Bujur' : 'Latitude Longitude Finder'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Selección en mapa interactivo' : lang === 'fr' ? 'Sélection sur carte' : lang === 'de' ? 'Interaktive Karte' : 'Interactive map pinpoint'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/elevation-finder/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon">⛰️</span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Buscador de Altitud' : lang === 'fr' ? "Localisateur d'Altitude" : lang === 'de' ? 'Höhenfinder' : lang === 'pt' ? 'Localizador de Altitude' : lang === 'hi' ? 'ऊंचाई खोजक' : lang === 'id' ? 'Pencari Elevasi' : 'Elevation Finder'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Altitud sobre el nivel del mar' : lang === 'fr' ? 'Altitude au-dessus de la mer' : lang === 'de' ? 'Höhe über dem Meeresspiegel' : 'Height above sea level'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon">🎯</span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Comprobador de Precisión GPS' : lang === 'fr' ? 'Testeur de Précision GPS' : lang === 'de' ? 'GPS-Genauigkeitsprüfer' : lang === 'pt' ? 'Verificador de Precisão GPS' : lang === 'hi' ? 'GPS सटीकता परीक्षक' : lang === 'id' ? 'Pemeriksa Akurasi GPS' : 'GPS Accuracy Checker'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Margen de error satelital' : lang === 'fr' ? 'Rayon d\'incertitude en mètres' : lang === 'de' ? 'Fehlerradius in Metern' : 'Satellite error radius in meters'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/location-qr-code/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon">📱</span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Código QR de Ubicación' : lang === 'fr' ? 'QR Code de Localisation' : lang === 'de' ? 'Standort-QR-Code' : lang === 'pt' ? 'QR Code de Localização' : lang === 'hi' ? 'लोकेशन QR कोड' : lang === 'id' ? 'QR Code Lokasi' : 'Location QR Code'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Pin escaneable para móviles' : lang === 'fr' ? 'Pin scannable mobile' : lang === 'de' ? 'Mobiler Wegpunkt-Code' : 'Scannable coordinate pin'}</div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div style="margin-top: var(--space-12);">
    <h2 class="mb-8">FAQ</h2>
    <FAQAccordion items={c.faqItems} />
  </div>

  <script>
    import GeoLocation from '../../scripts/geolocation.js';
    import CoordUtils from '../../scripts/coordinates.js';
    import Sharing from '../../scripts/sharing.js';
    import MapUtils from '../../scripts/map.js';
    import Geocoding from '../../scripts/geocoding.js';

    const locateTitles: Record<string, string> = {
      en: "Zoom to my current location",
      es: "Centrar y ampliar en mi ubicación",
      fr: "Zoomer sur ma position actuelle",
      de: "Auf meinen aktuellen Standort zoomen",
      pt: "Aproximar da minha localização atual",
      hi: "मेरी वर्तमान लोकेशन पर ज़ूम करें",
      id: "Perbesar ke lokasi saya saat ini"
    };
    const currentDocLang = document.documentElement.lang || 'en';
    const locateTitle = document.getElementById('gps-map')?.getAttribute('data-locate-title') || locateTitles[currentDocLang] || locateTitles.en;

    let lat: any = null, lng: any = null;

    async function findGPS(isAuto = false) {
      const prompt = document.getElementById('gps-prompt');
      const loading = document.getElementById('gps-loading');
      const errorEl = document.getElementById('gps-error');
      const result = document.getElementById('gps-result');
      const actions = document.getElementById('gps-actions');
      const mapEl = document.getElementById('gps-map');

      if (prompt) prompt.style.display = 'none';
      if (errorEl) errorEl.style.display = 'none';
      if (loading) loading.style.display = 'block';
      if (result) result.style.display = 'none';

      try {
        const position = await GeoLocation.getCurrentPosition();
        const pos = GeoLocation.formatPosition(position);
        lat = pos.latitude;
        lng = pos.longitude;

        const latEl = document.getElementById('gps-lat');
        const lngEl = document.getElementById('gps-lng');
        const latDmsEl = document.getElementById('gps-lat-dms');
        const lngDmsEl = document.getElementById('gps-lng-dms');
        const accEl = document.getElementById('gps-acc');
        const altEl = document.getElementById('gps-alt');
        const timeEl = document.getElementById('gps-time');
        const mapsLink = document.getElementById('gps-maps') as HTMLAnchorElement;

        if (latEl) latEl.textContent = pos.formattedLat;
        if (lngEl) lngEl.textContent = pos.formattedLng;
        if (latDmsEl) latDmsEl.textContent = CoordUtils.formatDMS(lat, true);
        if (lngDmsEl) lngDmsEl.textContent = CoordUtils.formatDMS(lng, false);
        if (accEl) accEl.textContent = pos.formattedAccuracy;
        if (altEl) altEl.textContent = pos.altitude ? `${pos.altitude.toFixed(1)} m` : 'Not available';
        if (timeEl) timeEl.textContent = new Date(pos.timestamp).toLocaleString();
        if (mapsLink) mapsLink.href = `https://www.google.com/maps?q=${lat},${lng}`;

        if (loading) loading.style.display = 'none';
        if (result) result.style.display = 'block';
        if (actions) actions.style.display = 'flex';
        if (mapEl) mapEl.style.display = 'block';

        const waitL = () => {
          if (typeof (window as any).L !== 'undefined') {
            const L = (window as any).L;
            if ((window as any)._gpsMap) (window as any)._gpsMap.remove();
            const m = L.map('gps-map').setView([lat, lng], 16);
            (window as any)._gpsMap = m;
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(m);
            const icon = L.divIcon({ html: '<div class="user-pulse-dot"></div>', className: 'user-pulse-marker', iconSize: [18,18], iconAnchor: [9,9] });
            L.marker([lat, lng], { icon }).addTo(m);
            if (pos.accuracy > 0) L.circle([lat, lng], { radius: pos.accuracy, color: '#00d4ff', fillColor: '#00d4ff', fillOpacity: 0.08, weight: 1 }).addTo(m);

            MapUtils.addLocateControl(m, {
              title: locateTitle,
              zoom: 16,
              onLocate: () => findGPS(false),
            });
          } else setTimeout(waitL, 100);
        };
        waitL();
      } catch (error) {
        if (loading) loading.style.display = 'none';
        if (prompt) prompt.style.display = 'block';
        if (!isAuto) {
          if (errorEl) {
            errorEl.textContent = GeoLocation.getErrorMessage(error, document.documentElement.lang);
            errorEl.style.display = 'block';
          }
        } else {
          if (errorEl) errorEl.style.display = 'none';
        }
      }
    }

    function renderGpsMap(targetLat: number, targetLng: number, accuracy: number) {
      const waitL = () => {
        if (typeof (window as any).L !== 'undefined') {
          const L = (window as any).L;
          if ((window as any)._gpsMap) (window as any)._gpsMap.remove();
          const m = L.map('gps-map').setView([targetLat, targetLng], 16);
          (window as any)._gpsMap = m;
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(m);
          const icon = L.divIcon({ html: '<div class="user-pulse-dot"></div>', className: 'user-pulse-marker', iconSize: [18,18], iconAnchor: [9,9] });
          L.marker([targetLat, targetLng], { icon }).addTo(m);
          if (accuracy > 0) L.circle([targetLat, targetLng], { radius: accuracy, color: '#00d4ff', fillColor: '#00d4ff', fillOpacity: 0.08, weight: 1 }).addTo(m);

          MapUtils.addLocateControl(m, {
            title: locateTitle,
            zoom: 16,
            onLocate: () => findGPS(false),
          });
        } else setTimeout(waitL, 100);
      };
      waitL();
    }

    async function searchGPS() {
      const input = document.getElementById('gps-search-input') as HTMLInputElement;
      const q = input?.value?.trim();
      if (!q) return;

      const prompt = document.getElementById('gps-prompt');
      const loading = document.getElementById('gps-loading');
      const errorEl = document.getElementById('gps-error');
      const result = document.getElementById('gps-result');
      const actions = document.getElementById('gps-actions');
      const mapEl = document.getElementById('gps-map');

      if (prompt) prompt.style.display = 'none';
      if (errorEl) errorEl.style.display = 'none';
      if (loading) loading.style.display = 'block';

      try {
        const results = await Geocoding.searchAddress(q);
        if (results && results.length > 0) {
          lat = parseFloat(results[0].lat);
          lng = parseFloat(results[0].lon);

          const latEl = document.getElementById('gps-lat');
          const lngEl = document.getElementById('gps-lng');
          const latDmsEl = document.getElementById('gps-lat-dms');
          const lngDmsEl = document.getElementById('gps-lng-dms');
          const accEl = document.getElementById('gps-acc');
          const altEl = document.getElementById('gps-alt');
          const timeEl = document.getElementById('gps-time');
          const mapsLink = document.getElementById('gps-maps') as HTMLAnchorElement;

          if (latEl) latEl.textContent = lat.toFixed(6) + '°';
          if (lngEl) lngEl.textContent = lng.toFixed(6) + '°';
          if (latDmsEl) latDmsEl.textContent = CoordUtils.formatDMS(lat, true);
          if (lngDmsEl) lngDmsEl.textContent = CoordUtils.formatDMS(lng, false);
          if (accEl) accEl.textContent = 'Global Geodetic Reference';
          if (altEl) altEl.textContent = 'Ellipsoidal Datum WGS84';
          if (timeEl) timeEl.textContent = new Date().toLocaleString();
          if (mapsLink) mapsLink.href = `https://www.google.com/maps?q=${lat},${lng}`;

          if (loading) loading.style.display = 'none';
          if (result) result.style.display = 'block';
          if (actions) actions.style.display = 'flex';
          if (mapEl) mapEl.style.display = 'block';

          renderGpsMap(lat, lng, 0);
        } else {
          if (loading) loading.style.display = 'none';
          if (prompt) prompt.style.display = 'block';
          if (errorEl) {
            errorEl.textContent = 'Location not found. Please try a different query.';
            errorEl.style.display = 'block';
          }
        }
      } catch (err) {
        if (loading) loading.style.display = 'none';
        if (prompt) prompt.style.display = 'block';
        if (errorEl) {
          errorEl.textContent = 'Search failed. Please try again.';
          errorEl.style.display = 'block';
        }
      }
    }

    document.getElementById('gps-search-btn')?.addEventListener('click', searchGPS);
    document.getElementById('gps-search-input')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') searchGPS();
    });

    document.getElementById('gps-btn')?.addEventListener('click', () => findGPS(false));
    document.getElementById('gps-refresh')?.addEventListener('click', () => findGPS(false));

    (async () => {
      if (await GeoLocation.checkPermission() === 'denied') {
        const p = document.getElementById('gps-prompt');
        if (p) p.style.display = 'block';
        return;
      }
      findGPS(true);
    })();

    document.getElementById('gps-copy')?.addEventListener('click', function(this: HTMLElement) {
      if (lat) Sharing.copyToClipboard(`${lat}, ${lng}`, this);
    });
    document.getElementById('gps-share')?.addEventListener('click', () => {
      if (lat) Sharing.shareNative({ title: 'GPS Coordinates', text: `${lat}, ${lng}`, url: `https://www.google.com/maps?q=${lat},${lng}` });
    });
  </script>
</ToolLayout>
