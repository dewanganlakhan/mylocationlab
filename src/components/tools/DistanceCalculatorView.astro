    hintInit: "Klicken Sie auf die Karte, um <strong>Punkt A</strong> zu setzen, und erneut für <strong>Punkt B</strong> — die Linie erscheint automatisch.",
    hintPointAPlaced: "Punkt A gesetzt — nun <strong>erneut klicken</strong>, um <strong>Punkt B</strong> zu platzieren.",
    hintDone: "Messung bereit — Marker verschieben zum Anpassen oder <strong>Kartenklick</strong> für neue Messung.",
    alertMissing: "Bitte gültige Koordinaten für beide Punkte eingeben oder zwei Punkte auf der Karte anklicken.",
    h2Calc: "So wird die Entfernung berechnet",
    pCalc1: "Dieses Tool nutzt die <strong>Haversine-Formel</strong> zur Berechnung der Großkreisdistanz (Orthodrome) zwischen zwei Koordinaten auf einer Kugelfläche.",
    pCalc2: "Die Erdkrümmung wird exakt berücksichtigt, was insbesondere bei mittleren und langen Strecken entscheidend für präzise Ergebnisse ist.",
    h2Map: "Messen durch Klick auf die Karte",
    pMap1: "Klicken Sie auf die Karte für <strong>Punkt A</strong> und dann für <strong>Punkt B</strong>. Die Verbindungslinie und alle Einheiten werden umgehend errechnet.",
    locateTitle: "Auf meinen aktuellen Standort zoomen"
  },
  pt: {
    title: "Calculadora de Distância — Entre Dois Pontos | MyLocationLab",
    description: "Calcule a distância exata entre duas coordenadas GPS ou locais no mapa utilizando a fórmula de Haversine.",
    h1: "Calculadora de Distância",
    subtitle: "Clique em dois pontos no mapa ou digite coordenadas para calcular a distância exata em qualquer lugar do planeta.",
    pointA: "Ponto A",
    pointB: "Ponto B",
    latitude: "Latitude",
    longitude: "Longitude",
    useMyLocationA: "📍 Usar Minha Localização para o Ponto A",
    calculate: "Calcular Distância",
    reset: "Redefinir",
    distanceKm: "Distância (km)",
    distanceMi: "Distância (milhas)",
    distanceM: "Distância (metros)",
    distanceNm: "Distância (milhas náuticas)",
    bearing: "Rumo de A para B",
    copyResult: "📋 Copiar Resultado",
    hintInit: "Clique no mapa abaixo para marcar o <strong>Ponto A</strong> e depois clique novamente para o <strong>Ponto B</strong> — a linha é exibida automaticamente.",
    hintPointAPlaced: "Ponto A marcado — agora <strong>clique novamente</strong> para posicionar o <strong>Ponto B</strong>.",
    hintDone: "Medição pronta — arraste os marcadores para ajustar ou <strong>clique no mapa</strong> para recomeçar.",
    alertMissing: "Por favor, insira coordenadas válidas para ambos os pontos ou clique em dois locais do mapa.",
    h2Calc: "Como a Distância é Calculada",
    pCalc1: "Esta ferramenta aplica a <strong>fórmula de Haversine</strong> para calcular a distância ortodrômica de círculo máximo entre dois pontos na superfície esférica da Terra.",
    pCalc2: "O cálculo considera a curvatura terrestre, proporcionando precisão superior a medições cartesianas simples.",
    h2Map: "Meça Distâncias Clicando no Mapa",
    pMap1: "Clique em qualquer local do mapa para marcar o <strong>Ponto A</strong> e depois em outro destino para o <strong>Ponto B</strong>. As métricas são calculadas instantaneamente.",
    locateTitle: "Aproximar da minha localização atual"
  }
};

const t = translations[lang] || translations.en;
---

<ToolLayout leaflet toolId="distance-calculator" title={t.title} description={t.description} h1={t.h1} subtitle={t.subtitle} lang={lang}>
  <div class="tool-interface">
    <h3 style="font-size: var(--text-base); margin-bottom: var(--space-4);">{t.pointA}</h3>
    <div class="grid grid-2" style="margin-bottom: var(--space-4);">
      <div><label class="label">{t.latitude}</label><input type="number" step="any" class="input" id="dc-lat1" placeholder="e.g. 28.6139" /></div>
      <div><label class="label">{t.longitude}</label><input type="number" step="any" class="input" id="dc-lng1" placeholder="e.g. 77.2090" /></div>
    </div>
    <button class="btn btn-ghost btn-sm" id="dc-gps1" type="button" style="margin-bottom: var(--space-6);">{t.useMyLocationA}</button>
    <h3 style="font-size: var(--text-base); margin-bottom: var(--space-4);">{t.pointB}</h3>
    <div class="grid grid-2" style="margin-bottom: var(--space-4);">
      <div><label class="label">{t.latitude}</label><input type="number" step="any" class="input" id="dc-lat2" placeholder="e.g. 40.7128" /></div>
      <div><label class="label">{t.longitude}</label><input type="number" step="any" class="input" id="dc-lng2" placeholder="e.g. -74.0060" /></div>
    </div>
    <button class="btn btn-primary" id="dc-calc" type="button">{t.calculate}</button>
    <button class="btn btn-ghost" id="dc-reset" type="button" style="margin-left: var(--space-2);">{t.reset}</button>
    <div class="tool-result" id="dc-result" style="display: none; margin-top: var(--space-6);">
      <div class="tool-result-row"><span class="tool-result-label">{t.distanceKm}</span><span class="tool-result-value" id="dc-km" style="color: var(--color-accent-primary);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.distanceMi}</span><span class="tool-result-value" id="dc-mi">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.distanceM}</span><span class="tool-result-value" id="dc-m">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.distanceNm}</span><span class="tool-result-value" id="dc-nm">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.bearing}</span><span class="tool-result-value" id="dc-bearing">—</span></div>
      <div style="margin-top: var(--space-4);"><button class="btn btn-secondary btn-sm" id="dc-copy" type="button">{t.copyResult}</button></div>
    </div>
  </div>

  <!-- Click-to-measure map container -->
  <div
    id="dc-hint"
    style="margin-top: var(--space-6); padding: var(--space-3) var(--space-4); background: var(--color-bg-tertiary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); font-size: var(--text-sm); display: flex; align-items: center; gap: var(--space-2);"
  >
    <span aria-hidden="true">🖱️</span>
    <span id="dc-hint-text" style="color: var(--color-text-secondary);" set:html={t.hintInit}></span>
  </div>
  <div class="map-container" id="dc-map" style="margin-top: var(--space-4); cursor: crosshair; min-height: 400px;"></div>

  <div class="prose" style="margin-top: var(--space-12); line-height: 1.8;">
    <h2>{t.h2Calc}</h2>
    <p set:html={t.pCalc1}></p>
    <p set:html={t.pCalc2}></p>
    <h2>{t.h2Map}</h2>
    <p set:html={t.pMap1}></p>
  </div>

  <script define:vars={{ tData: t }}>
    let map = null;
    let markerA = null;
    let markerB = null;
    let line = null;
    let clicks = 0;

    const lat1El = document.getElementById('dc-lat1');
    const lng1El = document.getElementById('dc-lng1');
    const lat2El = document.getElementById('dc-lat2');
    const lng2El = document.getElementById('dc-lng2');
    const hintEl = document.getElementById('dc-hint-text');
    const resultEl = document.getElementById('dc-result');

    const pinIcon = (letter, color) => {
      // @ts-ignore
      return L.divIcon({
        html: `<div style="width:26px;height:26px;background:${color};border:3px solid white;border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 2px 8px rgba(0,0,0,0.35);display:flex;align-items:center;justify-content:center;"><span style="transform:rotate(45deg);color:#fff;font-weight:700;font-size:12px;font-family:sans-serif;">${letter}</span></div>`,
        className: '',
        iconSize: [26, 26],
        iconAnchor: [13, 26],
      });
    };

    function setHint(html) {
      if (hintEl) hintEl.innerHTML = html;
    }

    function clearMeasurement() {
      if (markerA && map) { map.removeLayer(markerA); markerA = null; }
      if (markerB && map) { map.removeLayer(markerB); markerB = null; }
      if (line && map) { map.removeLayer(line); line = null; }
      if (resultEl) resultEl.style.display = 'none';
    }

    function placeMarker(which, lat, lng) {
      // @ts-ignore
      const marker = L.marker([lat, lng], {
        icon: which === 'A' ? pinIcon('A', '#00d4ff') : pinIcon('B', '#f59e0b'),
        draggable: true,
      }).addTo(map);
      marker.on('dragend', () => {
        const p = marker.getLatLng();
        updateInput(which, p.lat, p.lng);
        recalculate();
      });
      return marker;
    }

    function updateInput(which, lat, lng) {
      const els = which === 'A' ? [lat1El, lng1El] : [lat2El, lng2El];
      if (els[0]) els[0].value = lat.toFixed(6);
      if (els[1]) els[1].value = lng.toFixed(6);
    }

    function readPoint(which) {
      const latEl = which === 'A' ? lat1El : lat2El;
      const lngEl = which === 'A' ? lng1El : lng2El;
      const lat = parseFloat(latEl?.value ?? '');
      const lng = parseFloat(lngEl?.value ?? '');
      if (isNaN(lat) || isNaN(lng) || Math.abs(lat) > 90 || Math.abs(lng) > 180) return null;
      return [lat, lng];
    }

    function syncMarkersFromInputs(fit = false) {
      const a = readPoint('A');
      const b = readPoint('B');

      if (!a && !b) {
        clearMeasurement();
        clicks = 0;
        setHint(tData.hintInit);
        return;
      }

      if (a) {
        if (markerA) markerA.setLatLng(a);
        else markerA = placeMarker('A', a[0], a[1]);
      } else if (markerA) { map.removeLayer(markerA); markerA = null; }

      if (b) {
        if (markerB) markerB.setLatLng(b);
        else markerB = placeMarker('B', b[0], b[1]);
      } else if (markerB) { map.removeLayer(markerB); markerB = null; }

      if (a && b) {
        drawLineAndFit(a, b, fit);
        showResults(a, b);
        clicks = 2;
        setHint(tData.hintDone);
      } else {
        if (line) { map.removeLayer(line); line = null; }
        if (resultEl) resultEl.style.display = 'none';
        clicks = a ? 1 : 0;
        setHint(a ? tData.hintPointAPlaced : tData.hintInit);
      }
    }

    function drawLineAndFit(a, b, fit = true) {
      if (line) {
        line.setLatLngs([a, b]);
      } else {
        // @ts-ignore
        line = L.polyline([a, b], { color: '#00d4ff', weight: 3, dashArray: '8 6' }).addTo(map);
      }
      if (fit && map) map.fitBounds(line.getBounds(), { padding: [50, 50] });
    }

    function toRad(d) { return d * Math.PI / 180; }
    function toDeg(r) { return r * 180 / Math.PI; }

    function calculateDistance(lat1, lon1, lat2, lon2, unit = 'km') {
      const R = 6371; // km
      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      const d = R * c;
      if (unit === 'mi') return d * 0.621371;
      return d;
    }

    function calculateBearing(lat1, lon1, lat2, lon2) {
      const y = Math.sin(toRad(lon2 - lon1)) * Math.cos(toRad(lat2));
      const x = Math.cos(toRad(lat1)) * Math.sin(toRad(lat2)) -
                Math.sin(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.cos(toRad(lon2 - lon1));
      const brng = toDeg(Math.atan2(y, x));
      return (brng + 360) % 360;
    }

    function bearingToCompass(b) {
      const dirs = ['N', 'NNE', 'NE', 'ENE', 'E', 'ESE', 'SE', 'SSE', 'S', 'SSW', 'SW', 'WSW', 'W', 'WNW', 'NW', 'NNW'];
      return dirs[Math.round(b / 22.5) % 16];
    }

    function showResults(a, b) {
      const km = calculateDistance(a[0], a[1], b[0], b[1], 'km');
      const mi = calculateDistance(a[0], a[1], b[0], b[1], 'mi');
      const bearing = calculateBearing(a[0], a[1], b[0], b[1]);

      const kmEl = document.getElementById('dc-km');
      const miEl = document.getElementById('dc-mi');
      const mEl = document.getElementById('dc-m');
      const nmEl = document.getElementById('dc-nm');
      const brEl = document.getElementById('dc-bearing');

      if (kmEl) kmEl.textContent = km.toFixed(2) + ' km';
      if (miEl) miEl.textContent = mi.toFixed(2) + ' mi';
      if (mEl) mEl.textContent = Math.round(km * 1000).toLocaleString() + ' m';
      if (nmEl) nmEl.textContent = (km / 1.852).toFixed(2) + ' nmi';
      if (brEl) brEl.textContent = `${bearing.toFixed(1)}° (${bearingToCompass(bearing)})`;
      if (resultEl) resultEl.style.display = 'block';
    }

    function recalculate() {
      if (readPoint('A') && readPoint('B')) syncMarkersFromInputs();
    }

    function onMapClick(e) {
      const { lat, lng } = e.latlng;
      if (clicks >= 2) {
        clearMeasurement();
        clicks = 0;
      }

      if (clicks === 0) {
        updateInput('A', lat, lng);
        markerA = placeMarker('A', lat, lng);
        clicks = 1;
        setHint(tData.hintPointAPlaced);
        map.panTo([lat, lng]);
      } else if (clicks === 1) {
        updateInput('B', lat, lng);
        markerB = placeMarker('B', lat, lng);
        const a = [parseFloat(lat1El.value), parseFloat(lng1El.value)];
        const b = [lat, lng];
        drawLineAndFit(a, b);
        showResults(a, b);
        clicks = 2;
        setHint(tData.hintDone);
      }
    }

    function initMap() {
      // @ts-ignore
      if (typeof L === 'undefined') {
        setTimeout(initMap, 200);
        return;
      }
      // @ts-ignore
      map = L.map('dc-map', { scrollWheelZoom: false }).setView([25, 10], 2);
      // @ts-ignore
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);

      // @ts-ignore
      if (typeof window.addMapLocateControl === 'function') {
        // @ts-ignore
        window.addMapLocateControl(map, {
          title: tData.locateTitle || 'Zoom to my current location',
          zoom: 16,
        });
      }

      // @ts-ignore
      map.on('click', (e) => {
        // @ts-ignore
        map.scrollWheelZoom.enable();
        onMapClick(e);
      });
    }

    document.getElementById('dc-gps1')?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert("Geolocation is not supported by your browser");
        return;
      }
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          updateInput('A', pos.coords.latitude, pos.coords.longitude);
          syncMarkersFromInputs();
          if (map) map.setView([pos.coords.latitude, pos.coords.longitude], 10);
        },
        (err) => {
          alert(err.message);
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    });

    document.getElementById('dc-calc')?.addEventListener('click', () => {
      const a = readPoint('A');
      const b = readPoint('B');
      if (!a || !b) {
        alert(tData.alertMissing);
        return;
      }
      syncMarkersFromInputs(true);
    });

    document.getElementById('dc-reset')?.addEventListener('click', () => {
      clearMeasurement();
      [lat1El, lng1El, lat2El, lng2El].forEach((el) => { if (el) el.value = ''; });
      clicks = 0;
      setHint(tData.hintInit);
    });

    document.getElementById('dc-copy')?.addEventListener('click', function () {
      if (!resultEl || resultEl.style.display === 'none') return;
      const val = (id) => document.getElementById(id)?.textContent?.trim() ?? '—';
      const lines = [
        `Distance: ${val('dc-km')} (${val('dc-mi')} / ${val('dc-m')} / ${val('dc-nm')})`,
        `Bearing A→B: ${val('dc-bearing')}`,
        `Point A: ${lat1El.value}, ${lng1El.value}`,
        `Point B: ${lat2El.value}, ${lng2El.value}`,
      ];
      navigator.clipboard.writeText(lines.join('\n')).then(() => {
        const orig = this.textContent;
        this.textContent = '✓ Copied!';
        setTimeout(() => { this.textContent = orig; }, 2000);
      });
    });

    [lat1El, lng1El, lat2El, lng2El].forEach((el) => {
      el?.addEventListener('input', () => syncMarkersFromInputs(false));
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMap);
    } else {
      initMap();
    }
  </script>
</ToolLayout>
