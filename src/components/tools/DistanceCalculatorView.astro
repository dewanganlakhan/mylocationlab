---
/**
 * DistanceCalculatorView — Multilingual Distance Calculator Tool
 * Powers: /tools/distance-calculator/ across en, es, fr, de, pt
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import { defaultLang, type SupportedLang } from '../../i18n/config';

interface Props {
  lang?: SupportedLang | string;
}

const { lang: customLang = defaultLang } = Astro.props;
const lang = (customLang || defaultLang) as SupportedLang;

const translations: Record<string, any> = {
