---

<ToolLayout leaflet toolId="distance-calculator" title={t.title} description={t.description} h1={t.h1} subtitle={t.subtitle} lang={lang}>
  <div class="tool-interface">
    <h3 style="font-size: var(--text-base); margin-bottom: var(--space-2);">{t.pointA}</h3>
    <div style="margin-bottom: var(--space-3); display: flex; gap: 8px;">
      <input type="text" class="input" id="dc-addr1" placeholder="🔍 Search address or city for Point A..." style="flex: 1; font-size: var(--text-sm);" />
      <button class="btn btn-secondary btn-sm" id="dc-addr1-btn" type="button">Find</button>
    </div>
    <div class="grid grid-2" style="margin-bottom: var(--space-4);">
      <div><label class="label">{t.latitude}</label><input type="number" step="any" class="input" id="dc-lat1" placeholder="e.g. 28.6139" /></div>
      <div><label class="label">{t.longitude}</label><input type="number" step="any" class="input" id="dc-lng1" placeholder="e.g. 77.2090" /></div>
    </div>
    <button class="btn btn-ghost btn-sm" id="dc-gps1" type="button" style="margin-bottom: var(--space-6);">{t.useMyLocationA}</button>
    <h3 style="font-size: var(--text-base); margin-bottom: var(--space-2);">{t.pointB}</h3>
    <div style="margin-bottom: var(--space-3); display: flex; gap: 8px;">
      <input type="text" class="input" id="dc-addr2" placeholder="🔍 Search address or city for Point B..." style="flex: 1; font-size: var(--text-sm);" />
      <button class="btn btn-secondary btn-sm" id="dc-addr2-btn" type="button">Find</button>
    </div>
    <div class="grid grid-2" style="margin-bottom: var(--space-4);">
      <div><label class="label">{t.latitude}</label><input type="number" step="any" class="input" id="dc-lat2" placeholder="e.g. 40.7128" /></div>
      <div><label class="label">{t.longitude}</label><input type="number" step="any" class="input" id="dc-lng2" placeholder="e.g. -74.0060" /></div>
    </div>
    <button class="btn btn-primary" id="dc-calc" type="button">{t.calculate}</button>
    <button class="btn btn-ghost" id="dc-reset" type="button" style="margin-left: var(--space-2);">{t.reset}</button>
    <div class="tool-result" id="dc-result" style="display: none; margin-top: var(--space-6);">
      <div class="tool-result-row"><span class="tool-result-label">{t.distanceKm}</span><span class="tool-result-value" id="dc-km" style="color: var(--color-accent-primary);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.distanceMi}</span><span class="tool-result-value" id="dc-mi">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.distanceM}</span><span class="tool-result-value" id="dc-m">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.distanceNm}</span><span class="tool-result-value" id="dc-nm">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.bearing}</span><span class="tool-result-value" id="dc-bearing">—</span></div>
      <div style="margin-top: var(--space-4);"><button class="btn btn-secondary btn-sm" id="dc-copy" type="button">{t.copyResult}</button></div>
    </div>
  </div>

  <!-- Click-to-measure map container -->
  <div
    id="dc-hint"
    style="margin-top: var(--space-6); padding: var(--space-3) var(--space-4); background: var(--color-bg-tertiary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); font-size: var(--text-sm); display: flex; align-items: center; gap: var(--space-2);"
  >
    <span aria-hidden="true">🖱️</span>
    <span id="dc-hint-text" style="color: var(--color-text-secondary);" set:html={t.hintInit}></span>
  </div>
  <div class="map-container" id="dc-map" style="margin-top: var(--space-4); cursor: crosshair; min-height: 400px;"></div>

  <div class="prose" style="margin-top: var(--space-12); line-height: 1.8;">
    <h2>{t.h2Calc}</h2>
    <p set:html={t.pCalc1}></p>
    <p set:html={t.pCalc2}></p>
    <h2>{t.h2Map}</h2>
    <p set:html={t.pMap1}></p>

    <div class="callout-box" style="margin-top: var(--space-6); line-height: 1.8;">
      <p style="margin: 0; font-size: var(--text-sm);">
        {lang === 'fr' ? (
          <>
