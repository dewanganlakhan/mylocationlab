---
/**
 * LatitudeLongitudeView — Multilingual Latitude & Longitude Tool
 * Supports en, es, fr, de, pt with interactive Leaflet map and instant geolocation.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import FAQAccordion from '../FAQAccordion.astro';
import { getLocalizedPath, defaultLang, type SupportedLang } from '../../i18n/config';
import { getToolFaqs, toolFaqTitles } from '../../data/toolFaqs';

interface Props {
  lang?: SupportedLang | string;
}

const { lang: customLang = defaultLang } = Astro.props;
const lang = (customLang || defaultLang) as SupportedLang;
const toolFaqs = getToolFaqs('latitude-longitude', lang);
const faqTitle = toolFaqTitles[lang] || toolFaqTitles.en;

const toolData: Record<string, {
  title: string;
  desc: string;
  h1: string;
  subtitle: string;
  promptText: string;
  searchPlaceholder: string;
  searchBtn: string;
  btnUseLocation: string;
  labelLat: string;
  labelLng: string;
  labelAddr: string;
  btnCopy: string;
  btnShare: string;
  howTitle: string;
  steps: string[];
  underTitle: string;
  underText: string;
  guideLinkText: string;
  glossaryLinkText: string;
}> = {
  en: {
    title: 'Latitude Longitude Finder — Find Lat Long | MyLocationLab',
    desc: 'Find the latitude and longitude of any location. Click on the map or use GPS to get precise lat/lng coordinates.',
    h1: 'Latitude Longitude Finder',
    subtitle: 'Find latitude and longitude for any location by clicking on the map, entering an address, or using your GPS.',
    promptText: 'Detecting your position automatically — or click anywhere on the map below.',
    searchPlaceholder: 'Search address, city, or coordinates...',
    searchBtn: 'Search',
    btnUseLocation: '📍 Use My Location',
    labelLat: 'Latitude',
    labelLng: 'Longitude',
    labelAddr: 'Address',
    btnCopy: '📋 Copy',
    btnShare: '🔗 Share',
    howTitle: 'How to Use This Tool',
    steps: [
      'Click "Use My Location" to find your current latitude and longitude using GPS.',
      'Click anywhere on the map to find the lat/lng of that point.',
      'Copy or share the coordinates using the buttons provided.',
    ],
    underTitle: 'Understanding Latitude and Longitude',
    underText: 'Latitude measures north-south position (-90° to +90°). Longitude measures east-west position (-180° to +180°). Together they uniquely identify any point on Earth.',
    guideLinkText: 'Latitude and Longitude Explained Guide',
    glossaryLinkText: 'Geodesy Glossary',
  },
  es: {
    title: 'Buscador de Latitud y Longitud — Consultar Coordenadas | MyLocationLab',
    desc: 'Encuentra la latitud y longitud de cualquier ubicación. Haz clic en el mapa o usa el GPS para obtener coordenadas exactas.',
    h1: 'Buscador de Latitud y Longitud',
    subtitle: 'Encuentra la latitud y longitud de cualquier punto haciendo clic en el mapa, buscando una dirección o mediante GPS.',
    promptText: 'Detectando tu posición automáticamente — o haz clic en cualquier lugar del mapa inferior.',
    searchPlaceholder: 'Buscar dirección, ciudad o coordenadas...',
    searchBtn: 'Buscar',
    btnUseLocation: '📍 Usar Mi Ubicación',
    labelLat: 'Latitud',
    labelLng: 'Longitud',
    labelAddr: 'Dirección',
    btnCopy: '📋 Copiar',
    btnShare: '🔗 Compartir',
    howTitle: 'Cómo Usar Esta Herramienta',
    steps: [
      'Pulsa "Usar Mi Ubicación" para obtener tu latitud y longitud actuales mediante señal GPS.',
      'Haz clic en cualquier punto del mapa para consultar sus coordenadas geodésicas.',
      'Copia o comparte las coordenadas con los botones de acción rápida.',
    ],
    underTitle: 'Comprender la Latitud y la Longitud',
    underText: 'La latitud mide la posición norte-sur (-90° a +90°). La longitud mide la posición este-oeste (-180° a +180°). Juntas determinan cualquier punto de la Tierra.',
    guideLinkText: 'Guía Explicativa de Latitud y Longitud',
    glossaryLinkText: 'Glosario de Geodesia',
  },
  fr: {
    title: 'Trouver Latitude et Longitude — Coordonnées GPS | MyLocationLab',
    desc: 'Trouvez la latitude et la longitude de n\'importe quel lieu. Cliquez sur la carte ou utilisez le GPS pour obtenir vos coordonnées.',
    h1: 'Trouver Latitude et Longitude',
    subtitle: 'Identifiez la latitude et la longitude de n\'importe quelle position sur la carte ou via votre capteur GPS.',
    promptText: 'Détection automatique de votre position — ou cliquez sur la carte ci-dessous.',
    searchPlaceholder: 'Rechercher une adresse, ville ou coordonnées...',
    searchBtn: 'Rechercher',
    btnUseLocation: '📍 Utiliser Ma Position',
    labelLat: 'Latitude',
    labelLng: 'Longitude',
    labelAddr: 'Adresse',
    btnCopy: '📋 Copier',
    btnShare: '🔗 Partager',
    howTitle: 'Comment Utiliser Cet Outil',
    steps: [
      'Cliquez sur "Utiliser Ma Position" pour acquérir vos coordonnées par satellite.',
      'Cliquez n\'importe où sur la carte pour mesurer la latitude et la longitude précises.',
      'Copiez ou partagez vos coordonnées géographiques instantanément.',
    ],
    underTitle: 'Comprendre la Latitude et la Longitude',
    underText: 'La latitude mesure la position nord-sud (-90° à +90°). La longitude mesure la position est-ouest (-180° à +180°). Ensemble, elles définissent chaque lieu du globe.',
    guideLinkText: 'Guide Explicatif Latitude et Longitude',
    glossaryLinkText: 'Glossaire Géodésique',
  },
  de: {
    title: 'Breitengrad & Längengrad Finder — Koordinaten Ermitteln | MyLocationLab',
    desc: 'Ermitteln Sie Breiten- und Längengrad jedes Standorts. Klicken Sie auf die Karte oder nutzen Sie GPS für präzise Koordinaten.',
    h1: 'Breitengrad & Längengrad Finder',
    subtitle: 'Finden Sie Breiten- und Längengrad jedes beliebigen Ortes durch Klick auf die Karte oder per GPS-Ortung.',
    promptText: 'Standort wird automatisch ermittelt — oder klicken Sie auf die Karte unten.',
    searchPlaceholder: 'Adresse, Stadt oder Koordinaten suchen...',
    searchBtn: 'Suchen',
    btnUseLocation: '📍 Meinen Standort Nutzen',
    labelLat: 'Breitengrad',
    labelLng: 'Längengrad',
    labelAddr: 'Adresse',
    btnCopy: '📋 Kopieren',
    btnShare: '🔗 Teilen',
    howTitle: 'So Nutzen Sie Dieses Tool',
    steps: [
      'Klicken Sie auf "Meinen Standort Nutzen", um Ihre aktuellen Koordinaten per GPS abzurufen.',
      'Klicken Sie auf einen beliebigen Punkt auf der Karte, um dessen Breiten- und Längengrad anzuzeigen.',
      'Kopieren oder teilen Sie die Koordinaten mit den Aktionsschaltflächen.',
    ],
    underTitle: 'Breiten- und Längengrad Verstehen',
    underText: 'Der Breitengrad misst die Nord-Süd-Position (-90° bis +90°). Der Längengrad misst die Ost-West-Position (-180° bis +180°). Zusammen bestimmen sie jeden Punkt der Erde.',
    guideLinkText: 'Ratgeber zu Breiten- und Längengrad',
    glossaryLinkText: 'Geodäsie-Glossar',
  },
  pt: {
    title: 'Localizador de Latitude e Longitude — Coordenadas GPS | MyLocationLab',
    desc: 'Descubra a latitude e longitude de qualquer local. Clique no mapa ou use o GPS para obter coordenadas exatas.',
    h1: 'Localizador de Latitude e Longitude',
    subtitle: 'Encontre latitude e longitude clicando no mapa ou através do sinal de GPS do seu dispositivo.',
    promptText: 'Detectando sua posição automaticamente — ou clique em qualquer ponto do mapa abaixo.',
    searchPlaceholder: 'Buscar endereço, cidade ou coordenadas...',
    searchBtn: 'Buscar',
    btnUseLocation: '📍 Usar Minha Localização',
    labelLat: 'Latitude',
    labelLng: 'Longitude',
    labelAddr: 'Endereço',
    btnCopy: '📋 Copiar',
    btnShare: '🔗 Compartilhar',
    howTitle: 'Como Usar Esta Ferramenta',
    steps: [
      'Clique em "Usar Minha Localização" para obter suas coordenadas por GPS.',
      'Clique em qualquer ponto do mapa para verificar a latitude e longitude.',
      'Copie ou compartilhe as coordenadas nos botões rápidos.',
    ],
    underTitle: 'Entendendo Latitude e Longitude',
    underText: 'A latitude mede a posição norte-sul (-90° a +90°). A longitude mede a posição leste-oeste (-180° a +180°). Juntas, elas definem qualquer ponto da Terra.',
    guideLinkText: 'Guia de Latitude e Longitude',
    glossaryLinkText: 'Glossário de Geodésia',
  },
  hi: {
    title: 'अक्षांश-देशांतर खोजक — Lat Long पाएं | MyLocationLab',
    desc: 'किसी भी स्थान का अक्षांश और देशांतर जानें। नक्शे पर क्लिक करें या GPS से सटीक lat/lng निर्देशांक पाएं।',
    h1: 'अक्षांश-देशांतर खोजक',
    subtitle: 'नक्शे पर क्लिक करके, पता दर्ज करके या अपने GPS के ज़रिए किसी भी स्थान का अक्षांश और देशांतर जानें।',
    promptText: 'आपकी स्थिति अपने आप पहचानी जा रही है — या नीचे नक्शे पर कहीं भी क्लिक करें।',
    searchPlaceholder: 'पता, शहर या निर्देशांक खोजें...',
    searchBtn: 'खोजें',
    btnUseLocation: '📍 मेरा स्थान उपयोग करें',
    labelLat: 'अक्षांश',
    labelLng: 'देशांतर',
    labelAddr: 'पता',
    btnCopy: '📋 कॉपी करें',
    btnShare: '🔗 साझा करें',
    howTitle: 'इस टूल का उपयोग कैसे करें',
    steps: [
      'GPS के ज़रिए अपना वर्तमान अक्षांश और देशांतर जानने के लिए "मेरा स्थान उपयोग करें" पर क्लिक करें।',
      'उस बिंदु का lat/lng जानने के लिए नक्शे पर कहीं भी क्लिक करें।',
      'दिए गए बटनों से निर्देशांक कॉपी करें या साझा करें।',
    ],
    underTitle: 'अक्षांश और देशांतर को समझें',
    underText: 'अक्षांश उत्तर-दक्षिण स्थिति (-90° से +90°) मापता है। देशांतर पूर्व-पश्चिम स्थिति (-180° से +180°) मापता है। दोनों मिलकर पृथ्वी पर किसी भी बिंदु की पहचान करते हैं।',
    guideLinkText: 'अक्षांश और देशांतर विवेचना गाइड',
    glossaryLinkText: 'जियोडेसी शब्दावली',
  },
  id: {
    title: 'Pencari Lintang Bujur — Cek Koordinat GPS | MyLocationLab',
    desc: 'Temukan lintang dan bujur lokasi mana pun. Klik peta atau gunakan GPS untuk mendapatkan koordinat lat/lng yang presisi.',
    h1: 'Pencari Lintang dan Bujur',
    subtitle: 'Temukan lintang dan bujur lokasi mana pun dengan mengklik peta, memasukkan alamat, atau menggunakan GPS Anda.',
    promptText: 'Mendeteksi posisi Anda secara otomatis — atau klik di mana saja pada peta di bawah.',
    searchPlaceholder: 'Cari alamat, kota, atau koordinat...',
    searchBtn: 'Cari',
    btnUseLocation: '📍 Gunakan Lokasi Saya',
    labelLat: 'Lintang',
    labelLng: 'Bujur',
    labelAddr: 'Alamat',
    btnCopy: '📋 Salin',
    btnShare: '🔗 Bagikan',
    howTitle: 'Cara Menggunakan Alat Ini',
    steps: [
      'Klik "Gunakan Lokasi Saya" untuk menemukan lintang dan bujur Anda saat ini melalui GPS.',
      'Klik di mana saja pada peta untuk menemukan lat/lng titik tersebut.',
      'Salin atau bagikan koordinat menggunakan tombol yang tersedia.',
    ],
    underTitle: 'Memahami Lintang dan Bujur',
    underText: 'Lintang mengukur posisi utara-selatan (-90° hingga +90°). Bujur mengukur posisi timur-barat (-180° hingga +180°). Keduanya bersama-sama mengidentifikasi setiap titik di bumi secara unik.',
    guideLinkText: 'Panduan Penjelasan Lintang dan Bujur',
    glossaryLinkText: 'Glosarium Geodesi',
  },
};

const c = toolData[lang] || toolData.en;

const locateTitle = ({
  en: "Zoom to my current location",
  es: "Centrar y ampliar en mi ubicación",
  fr: "Zoomer sur ma position actuelle",
  de: "Auf meinen aktuellen Standort zoomen",
  pt: "Aproximar da minha localização atual",
  hi: "मेरी वर्तमान लोकेशन पर ज़ूम करें",
  id: "Perbesar ke lokasi saya saat ini"
})[lang] || "Zoom to my current location";
---

<ToolLayout
  leaflet
  lang={lang}
  toolId="latitude-longitude"
  title={c.title}
  description={c.desc}
  h1={c.h1}
  subtitle={c.subtitle}
>
  <!-- Search & Action Toolbar Above the Fold -->
  <div class="tool-interface" style="margin-bottom: var(--space-4);">
    <div style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center; justify-content: space-between;">
      <div style="display: flex; gap: var(--space-2); flex: 1; min-width: 280px; align-items: center;">
        <input
          type="text"
          id="ll-search-input"
          class="input"
          placeholder={c.searchPlaceholder}
          style="flex: 1; min-width: 180px; padding: 8px 12px; font-size: var(--text-sm);"
        />
        <button class="btn btn-secondary btn-sm" id="ll-search-btn" type="button">{c.searchBtn}</button>
      </div>
      <div style="display: flex; gap: var(--space-2); align-items: center;">
        <button class="btn btn-primary btn-sm" id="ll-btn" type="button">{c.btnUseLocation}</button>
      </div>
    </div>
    <p id="ll-error" data-nosnippet style="display: none; margin: var(--space-3) 0 0; color: var(--color-accent-error, #ef4444); font-size: var(--text-sm);" role="alert" aria-live="polite"></p>
  </div>

  <!-- Interactive Map Canvas Front and Center Above-the-fold with Zero CLS -->
  <div class="map-container" id="ll-map" data-locate-title={locateTitle} style="min-height: 440px; cursor: crosshair; border-radius: var(--radius-xl); border: 1px solid var(--color-border); box-shadow: var(--shadow-glow);"></div>

  <!-- Coordinates Inspector Card -->
  <div class="tool-result" id="ll-result" style="margin-top: var(--space-4);">
    <div class="tool-result-row">
      <span class="tool-result-label">{c.labelLat}</span>
      <span class="tool-result-value" id="ll-lat" style="color: var(--color-accent-primary);">—</span>
    </div>
    <div class="tool-result-row">
      <span class="tool-result-label">{c.labelLng}</span>
      <span class="tool-result-value" id="ll-lng" style="color: var(--color-accent-primary);">—</span>
    </div>
    <div class="tool-result-row">
      <span class="tool-result-label">{c.labelAddr}</span>
      <span class="tool-result-value" id="ll-addr" style="font-family: var(--font-sans); font-size: var(--text-sm);">—</span>
    </div>
    <div class="action-buttons" style="margin-top: var(--space-4);">
      <button class="btn btn-secondary btn-sm" id="ll-copy" type="button">{c.btnCopy}</button>
      <button class="btn btn-secondary btn-sm" id="ll-share" type="button">{c.btnShare}</button>
    </div>
  </div>

  <div class="prose" style="margin-top: var(--space-12); line-height: 1.8;">
    <h2>{c.howTitle}</h2>
    <ol style="line-height: 1.8; margin-bottom: 2rem;">
      {c.steps.map((step) => (
        <li style="margin-bottom: 0.5rem;" set:html={step} />
      ))}
    </ol>
    <h2>{c.underTitle}</h2>
    <p style="line-height: 1.8; margin-bottom: 1.5rem;">
      {c.underText} <a href={getLocalizedPath('/guides/latitude-and-longitude-explained/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">{c.guideLinkText}</a> {lang === 'en' ? 'or check the' : '•'} <a href={getLocalizedPath('/glossary/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">{c.glossaryLinkText}</a>.
    </p>

    <h2>{lang === 'es' ? 'Paralelos de Latitud vs Meridianos de Longitud' : lang === 'fr' ? 'Parallèles de Latitude vs Méridiens de Longitude' : lang === 'de' ? 'Breitenkreise vs. Längenmeridiane' : lang === 'pt' ? 'Paralelos de Latitude vs Meridianos de Longitude' : lang === 'hi' ? 'अक्षांश समानांतर रेखाएं बनाम देशांतर याम्योत्तर' : lang === 'id' ? 'Garis Paralel Lintang vs Meridian Bujur' : 'Parallels of Latitude vs. Meridians of Longitude'}</h2>
    <p style="line-height: 1.8; margin-bottom: 1.5rem;">{lang === 'es' ? 'Las líneas de latitud rodean el globo horizontalmente paralelas al Ecuador. Los meridianos de longitud convergen en los polos norte y sur geográficos. Esta cuadrícula esférica permite que cada punto de la Tierra tenga una coordenada unívoca en grados decimales.' : lang === 'fr' ? 'Les parallèles de latitude encerclent le globe parallèlement à l\'Équateur. Les méridiens de longitude relient les pôles géographiques. Cette grille sphérique attribue à chaque point une coordonnée angulaire unique.' : lang === 'de' ? 'Breitenkreise verlaufen parallel zum Äquator horizontal um die Erde. Längenmeridiane laufen an den geographischen Polen zusammen. Dieses Netz ermöglicht die weltweite Positionsbestimmung in Dezimalgraden.' : lang === 'pt' ? 'As linhas de latitude circundam o globo paralelamente ao Equador. Os meridianos de longitude convergem nos polos geográficos norte e sul. Essa malha esférica fornece uma identificação unívoca para qualquer local.' : lang === 'hi' ? 'अक्षांश रेखाएं भूमध्य रेखा के समानांतर चलती हैं, जबकि देशांतर रेखाएं दोनों ध्रुवों पर मिलती हैं। यह ग्रिड पृथ्वी के प्रत्येक स्थान को अद्वितीय मान प्रदान करता है।' : lang === 'id' ? 'Garis paralel lintang melingkari bumi sejajar dengan Khatulistiwa, sedangkan garis meridian bujur bertemu di kedua kutub bumi. Kisi koordinat ini memungkinkan setiap jengkal permukaan bumi memiliki koordinat unik.' : 'Lines of latitude circle the globe horizontally parallel to the Equator. Lines of longitude converge at the geographic North and South poles. This spherical grid allows any point on Earth to be uniquely referenced using angular decimal degrees.'}</p>

    <div class="callout-box" style="margin-top: var(--space-6); line-height: 1.8;">
      <p style="margin: 0; font-size: var(--text-sm);">
        {lang === 'fr' ? (
          <>
            <strong>Outils d'exploitation des coordonnées :</strong> Besoin de convertir ces degrés décimaux en DMS maritime ou UTM ? Utilisez notre <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Convertisseur de Coordonnées</a> et lisez le <a href={getLocalizedPath('/comparisons/decimal-degrees-vs-dms/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">comparatif Degrés Décimaux vs DMS</a>. Pour convertir une adresse ou rechercher un point, utilisez le <a href={getLocalizedPath('/tools/geocoding/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Géocodeur</a> et le <a href={getLocalizedPath('/tools/address-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Localisateur d'Adresse</a>. Mesurez les distances avec le <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Calculateur de Distance</a> ou vérifiez le relief avec le <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Localisateur d'Altitude</a>.
          </>
        ) : lang === 'es' ? (
          <>
            <strong>Herramientas para aprovechar sus coordenadas :</strong> ¿Desea convertir estos grados decimales a DMS marítimo o UTM? Utilice nuestro <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Conversor de Coordenadas</a> y consulte la <a href={getLocalizedPath('/comparisons/decimal-degrees-vs-dms/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">comparativa grados decimales vs DMS</a>. Para buscar coordenadas desde una dirección, use el <a href={getLocalizedPath('/tools/geocoding/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Geocodificador</a> y el <a href={getLocalizedPath('/tools/address-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Buscador de Dirección</a>. Mida distancias con la <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Calculadora de Distancia</a> o compruebe la elevación en el <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Buscador de Altitud</a>.
          </>
        ) : lang === 'de' ? (
          <>
            <strong>Werkzeuge zur Weiterverarbeitung :</strong> Rechnen Sie diese Dezimalgrade in nautische GMS oder UTM um mit unserem <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Koordinaten-Konverter</a> und lesen Sie <a href={getLocalizedPath('/comparisons/decimal-degrees-vs-dms/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Dezimalgrad vs. GMS</a>. Zur Adresssuche nutzen Sie den <a href={getLocalizedPath('/tools/geocoding/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Geocoder</a> und den <a href={getLocalizedPath('/tools/address-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Adressen-Finder</a>. Berechnen Sie Großkreisdistanzen mit dem <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Entfernungsrechner</a> oder prüfen Sie Geländehöhen im <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Höhenfinder</a>.
          </>
        ) : lang === 'pt' ? (
          <>
