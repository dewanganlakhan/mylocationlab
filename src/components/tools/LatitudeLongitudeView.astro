  </div>

  <script>
    import GeoLocation from '../../scripts/geolocation.js';
    import Geocoding from '../../scripts/geocoding.js';
    import Sharing from '../../scripts/sharing.js';
    import MapUtils from '../../scripts/map.js';

    const locateTitles: Record<string, string> = {
      en: "Zoom to my current location",
      es: "Centrar y ampliar en mi ubicación",
      fr: "Zoomer sur ma position actuelle",
      de: "Auf meinen aktuellen Standort zoomen",
      pt: "Aproximar da minha localização atual",
      hi: "मेरी वर्तमान लोकेशन पर ज़ूम करें",
      id: "Perbesar ke lokasi saya saat ini"
    };
    const currentDocLang = document.documentElement.lang || 'en';
    const locateTitle = document.getElementById('ll-map')?.getAttribute('data-locate-title') || locateTitles[currentDocLang] || locateTitles.en;

    let lat: number | null = null;
    let lng: number | null = null;
    let map: any = null;
    let marker: any = null;

    function plotOnMap(la: number, ln: number) {
      const L = (window as any).L;
      if (!map || !L) return;
      if (marker) map.removeLayer(marker);
      const icon = L.divIcon({
        html: '<div style="width:18px;height:18px;background:#00d4ff;border:3px solid white;border-radius:50%;box-shadow:0 0 10px rgba(0,212,255,0.4);"></div>',
        className: '',
        iconSize: [18, 18],
        iconAnchor: [9, 9],
      });
      marker = L.marker([la, ln], { icon }).addTo(map);
      map.flyTo([la, ln], 15);
    }

    function showResult(la: number, ln: number) {
      lat = la;
      lng = ln;
      const latEl = document.getElementById('ll-lat');
      const lngEl = document.getElementById('ll-lng');
      const resEl = document.getElementById('ll-result');

      if (latEl) latEl.textContent = la.toFixed(6);
      if (lngEl) lngEl.textContent = ln.toFixed(6);
      if (resEl) resEl.style.display = 'block';

      Geocoding.getShortAddress(la, ln).then((addr: string) => {
        const addrEl = document.getElementById('ll-addr');
        if (addrEl) addrEl.textContent = addr;
      }).catch(() => {});

      if (map) plotOnMap(la, ln);
    }

    const waitL = () => {
      const L = (window as any).L;
      if (typeof L !== 'undefined') {
        map = L.map('ll-map').setView([20, 0], 2);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap',
          maxZoom: 19,
        }).addTo(map);
        map.on('click', (e: any) => showResult(e.latlng.lat, e.latlng.lng));

        MapUtils.addLocateControl(map, {
          title: locateTitle,
          zoom: 16,
          onLocate: (uLat: number, uLng: number) => {
            showResult(uLat, uLng);
          }
        });

        if (lat !== null && lng !== null) {
          plotOnMap(lat, lng);
        }
      } else {
        setTimeout(waitL, 100);
      }
    };
    waitL();

    document.getElementById('ll-btn')?.addEventListener('click', () => {
      const btn = document.getElementById('ll-btn') as HTMLButtonElement;
      const err = document.getElementById('ll-error');
      if (btn) btn.disabled = true;
      if (err) err.style.display = 'none';

      GeoLocation.getCurrentPosition()
        .then((pos: any) => {
          showResult(pos.coords.latitude, pos.coords.longitude);
        })
        .catch((e: any) => {
          if (err) {
            err.textContent = GeoLocation.getErrorMessage(e, document.documentElement.lang);
            err.style.display = 'block';
          }
        })
        .finally(() => {
          if (btn) btn.disabled = false;
        });
    });

    async function searchLocation() {
      const input = document.getElementById('ll-search-input') as HTMLInputElement;
      const q = input?.value?.trim();
      if (!q) return;

      const err = document.getElementById('ll-error');
      if (err) err.style.display = 'none';

      // Check if coordinate format e.g. "48.8584, 2.2945"
      const coordMatch = q.match(/^(-?\d+(\.\d+)?)\s*,\s*(-?\d+(\.\d+)?)$/);
      if (coordMatch) {
        showResult(parseFloat(coordMatch[1]), parseFloat(coordMatch[3]));
        return;
      }

      try {
        const results = await Geocoding.searchAddress(q);
        if (results && results.length > 0) {
          showResult(parseFloat(results[0].lat), parseFloat(results[0].lon));
        } else {
          if (err) {
            err.textContent = 'Location not found. Try a different city, address, or coordinates.';
            err.style.display = 'block';
          }
        }
      } catch (e) {
        if (err) {
          err.textContent = 'Search failed. Please try again.';
          err.style.display = 'block';
        }
      }
    }

    document.getElementById('ll-search-btn')?.addEventListener('click', searchLocation);
    document.getElementById('ll-search-input')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') searchLocation();
    });

    document.getElementById('ll-copy')?.addEventListener('click', function(this: HTMLButtonElement) {
      if (lat === null || lng === null) return;
      navigator.clipboard.writeText(`${lat.toFixed(6)}, ${lng.toFixed(6)}`).then(() => {
        const orig = this.textContent;
        this.textContent = '✓ Copied!';
        setTimeout(() => { this.textContent = orig; }, 2000);
      });
    });

    document.getElementById('ll-share')?.addEventListener('click', () => {
      if (lat === null || lng === null) return;
      Sharing.shareNative({
        title: 'Coordinates',
        text: `Latitude: ${lat.toFixed(6)}, Longitude: ${lng.toFixed(6)}`,
        url: Sharing.getGoogleMapsUrl(lat, lng),
      });
    });
  </script>
</ToolLayout>
