    h3Classifications: "सटीकता वर्गीकरण",
    thRadius: "सटीकता त्रिज्या",
    thRating: "रेटिंग",
    thSource: "सामान्य स्रोत",
    thSuitability: "उपयोग की उपयुक्तता",
    row1Rating: "असाधारण",
    row1Source: "दोहरी आवृत्ति L1/L5 GNSS",
    row1Use: "सटीक मैपिंग, सर्वेक्षण, लेन-स्तरीय नेविगेशन",
    row2Rating: "उच्च",
    row2Source: "मानक मोबाइल GPS / GLONASS",
    row2Use: "मोड़-दर-मोड़ ड्राइविंग, ट्रेकिंग, फ़िटनेस ट्रैकिंग",
    row3Rating: "मध्यम",
    row3Source: "Wi-Fi पोज़िशनिंग (WPS) / इनडोर",
    row3Use: "मोहल्ला-स्तरीय डिलीवरी, लोकल सर्च",
    row4Rating: "कम",
    row4Source: "सेल टावर ट्रायंगुलेशन / IP जियो",
