    h2Improve: "अपने डिवाइस की GPS सटीकता कैसे बढ़ाएं",
    li1: "<strong>Wi-Fi और ब्लूटूथ स्कैनिंग चालू करें:</strong> मोबाइल ऑपरेटिंग सिस्टम आसपास के Wi-Fi राउटर BSSID से प्रारंभिक सैटेलाइट अधिग्रहण तेज़ करते हैं (असिस्टेड GPS)।",
    li2: "<strong>'अर्बन कैनियन' से दूर जाएं:</strong> ऊँची कंक्रीट और कांच की इमारतें सैटेलाइट सिग्नल को परावर्तित करती हैं, जिससे <em>मल्टीपाथ हस्तक्षेप</em> होता है और सटीकता घटती है।",
    li3: "<strong>आंतरिक मैग्नेटोमीटर कैलिब्रेट करें:</strong> सटीक दिशा के लिए अपने डिवाइस को हवा में 8 के आकार में घुमाकर इलेक्ट्रॉनिक कंपास पुनः कैलिब्रेट करें।",
    li4: "<strong>आकाश का खुला दृश्य सुनिश्चित करें:</strong> घनी पत्तियाँ, भूमिगत तहखाने और धातु की संरचनाएँ उच्च-आवृत्ति सैटेलाइट सिग्नल को कमज़ोर करती हैं।",
    h2Related: "संबंधित भू-स्थानिक टूल",
    linkGps: "GPS निर्देशांक खोजक",
    linkGuideAccuracy: "GPS सटीकता बढ़ाने की संपूर्ण गाइड",
    linkComp: "GPS बनाम IP लोकेशन तुलना"
  },
  id: {
    title: "Pemeriksa Akurasi GPS — Uji Presisi Langsung | MyLocationLab",
    description: "Periksa akurasi GPS perangkat Anda secara real-time. Ukur radius presisi horizontal (HDOP), kepercayaan sinyal dalam meter, kecepatan, dan arah kompas.",
    h1: "Pemeriksa Akurasi GPS",
    subtitle: "Pantau akurasi penentuan posisi satelit GNSS perangkat Anda secara real-time, radius presisi horizontal, dan telemetri sensor.",
    btnStart: "🛰️ Mulai Monitor GPS Langsung",
    btnStop: "⏹️ Hentikan Monitor",
    statusStandby: "Siaga",
    statusAcquiring: "Mencari satelit...",
    statusActive: "GNSS Langsung Aktif",
    liveRadiusTitle: "Radius Akurasi Horizontal Langsung",
    awaitingLock: "Menunggu Kunci GPS",
    updatesEverySec: "Pembaruan setiap detik",
    lblHdop: "Perkiraan HDOP",
    lblSpeed: "Kecepatan Darat",
    lblHeading: "Arah Kompas",
    lblAlt: "Ketinggian",
    lblValt: "Akurasi Vertikal",
    lblCoords: "Koordinat Aktif",
    btnCopy: "📋 Salin Snapshot",
    btnCopied: "✅ Tersalin!",
    ratingExceptional: "Akurasi Luar Biasa (Presisi Dual-Band)",
    ratingHigh: "Akurasi Tinggi (Kunci GNSS Standar)",
    ratingModerate: "Akurasi Moderat (Wi-Fi / Multi-sumber)",
    ratingLow: "Presisi Rendah (Seluler / Regional)",
    hdopExcellent: "Sangat Baik",
    hdopGood: "Baik",
    hdopModerate: "Moderat",
    speedStationary: "Stasioner / 0 km/h",
    headingStatic: "Statis (Tanpa Arah)",
    notAvailable: "Tidak Tersedia",
    h2Understanding: "Memahami Akurasi GPS dan Dilution of Precision (DOP)",
    pUnderstanding: "Akurasi geolokasi peramban dan ponsel dinyatakan sebagai <strong>radius keyakinan 95%</strong>. Jika perangkat Anda melaporkan akurasi ±5 meter, ada kemungkinan 95% posisi sebenarnya berada dalam lingkaran radius 5 meter di sekitar koordinat yang dilaporkan.",
    h3Classifications: "Klasifikasi Akurasi",
    thRadius: "Radius Akurasi",
    thRating: "Peringkat",
    thSource: "Sumber Umum",
    thSuitability: "Kecocokan Penggunaan",
    row1Rating: "Luar Biasa",
    row1Source: "GNSS Frekuensi Ganda L1/L5",
    row1Use: "Pemetaan presisi, survei, navigasi tingkat lajur",
    row2Rating: "Tinggi",
    row2Source: "GPS / GLONASS Seluler Standar",
    row2Use: "Navigasi belokan demi belokan, pendakian, pelacakan kebugaran",
    row3Rating: "Moderat",
    row3Source: "Positioning Wi-Fi (WPS) / Dalam Ruangan",
    row3Use: "Pengiriman tingkat lingkungan, pencarian lokal",
    row4Rating: "Rendah",
    row4Source: "Triangulasi Menara Seluler / Geo IP",
    row4Use: "Hanya penemuan regional tingkat kota",
    h2Improve: "Cara Meningkatkan Akurasi GPS Perangkat Anda",
    li1: "<strong>Aktifkan Pemindaian Wi-Fi dan Bluetooth:</strong> Sistem operasi seluler memakai BSSID router Wi-Fi terdekat untuk mempercepat perolehan satelit awal (Assisted GPS).",
    li2: "<strong>Hindari 'Urban Canyon':</strong> Gedung tinggi dari beton dan kaca memantulkan sinyal satelit sehingga menimbulkan <em>interferensi multipath</em> yang menurunkan akurasi.",
    li3: "<strong>Kalibrasi Magnetometer Internal:</strong> Gerakkan perangkat Anda membentuk angka 8 untuk mengalibrasi ulang kompas elektronik agar arah akurat.",
    li4: "<strong>Pastikan Pandangan Langit Bebas Halangan:</strong> Dedaunan lebat, ruang bawah tanah, dan struktur logam melemahkan sinyal gelombang mikro satelit.",
    h2Related: "Alat Geospasial Terkait",
    linkGps: "Pencari Koordinat GPS",
    linkGuideAccuracy: "Panduan Lengkap Meningkatkan Akurasi GPS",
    linkComp: "Perbandingan GPS vs Lokasi IP"
  }
};

const t = translations[lang] || translations.en;
---

<ToolLayout
  toolId="gps-accuracy"
  title={t.title}
  description={t.description}
  h1={t.h1}
  subtitle={t.subtitle}
  lang={lang}
>
  <div class="tool-interface">
    <div class="flex gap-4 flex-wrap" style="margin-bottom: var(--space-6);">
      <button class="btn btn-primary" id="acc-start-btn" type="button">{t.btnStart}</button>
      <button class="btn btn-secondary" id="acc-stop-btn" type="button" style="display: none;">{t.btnStop}</button>
      <span id="acc-status-indicator" style="display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-text-secondary); font-size: var(--text-sm);">
        <span style="width: 10px; height: 10px; border-radius: 50%; background: #64748b;"></span> {t.statusStandby}
      </span>
    </div>

    <!-- Live Accuracy Gauge Card -->
    <div class="card card-highlight" id="acc-card" style="text-align: center; padding: var(--space-8) var(--space-4); margin-bottom: var(--space-6);">
      <span style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent-primary);">{t.liveRadiusTitle}</span>
      
      <div style="font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 900; font-family: var(--font-mono); margin: var(--space-3) 0; color: var(--color-text-heading);">
        ± <span id="acc-val-meters">—</span> <span style="font-size: var(--text-2xl); color: var(--color-accent-primary);">m</span>
        <span style="color: var(--color-text-tertiary); font-size: var(--text-3xl); margin: 0 var(--space-2);">/</span>
        ± <span id="acc-val-feet">—</span> <span style="font-size: var(--text-2xl); color: var(--color-accent-secondary);">ft</span>
      </div>

      <div style="display: flex; justify-content: center; gap: var(--space-3); align-items: center; flex-wrap: wrap;">
        <span class="badge badge-neutral" id="acc-rating-badge">{t.awaitingLock}</span>
        <span style="font-size: var(--text-xs); color: var(--color-text-tertiary);" id="acc-update-time">{t.updatesEverySec}</span>
      </div>

      <!-- Accuracy progress bar -->
      <div style="width: 100%; max-width: 420px; height: 8px; background: var(--color-bg-tertiary); border-radius: var(--radius-full); margin: var(--space-6) auto 0; overflow: hidden; border: 1px solid var(--color-border);">
        <div id="acc-meter-bar" style="width: 0%; height: 100%; background: var(--gradient-primary); transition: width 0.4s ease;"></div>
      </div>
    </div>

    <!-- Sensor Metrics Grid -->
    <div class="location-data-grid" id="acc-grid">
      <div class="location-data-item">
        <span class="location-data-label">{t.lblHdop}</span>
        <span class="location-data-value highlight" id="acc-hdop">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">{t.lblSpeed}</span>
        <span class="location-data-value" id="acc-speed">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">{t.lblHeading}</span>
        <span class="location-data-value" id="acc-heading">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">{t.lblAlt}</span>
        <span class="location-data-value" id="acc-alt">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">{t.lblValt}</span>
        <span class="location-data-value" id="acc-valt">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">{t.lblCoords}</span>
        <span class="location-data-value" id="acc-coords" style="font-size: var(--text-xs);">—</span>
      </div>
    </div>

    <div class="action-buttons" style="margin-top: var(--space-6); display: flex;">
      <button class="btn btn-secondary btn-sm" id="acc-copy" type="button">{t.btnCopy}</button>
    </div>
  </div>

  <div class="prose" style="margin-top: var(--space-12); line-height: 1.8;">
    {t.inShort && (
      <div class="callout-box" style="margin-bottom: var(--space-6); background: var(--color-bg-secondary); border-left: 4px solid var(--color-accent-primary); padding: var(--space-4) var(--space-5); border-radius: var(--radius-md);">
        <p style="margin: 0; font-weight: 500; font-size: var(--text-base); color: var(--color-text-primary); line-height: 1.75;">
          {t.inShort}
        </p>
      </div>
    )}

    {t.howToUseTitle && (
      <div style="margin-bottom: var(--space-10);">
        <h2>📋 {t.howToUseTitle}</h2>
        <div class="step-container" style="margin-top: var(--space-4);">
          {t.howToUseSteps.map((s: any) => (
            <div class="step-card">
              <div class="step-number">{s.step}</div>
              <div class="step-body">
                <h4 class="step-title">{s.title}</h4>
                <p class="step-desc">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {t.workedExampleTitle && (
      <div class="card card-flat" style="margin-bottom: var(--space-10); padding: var(--space-6); background: var(--color-bg-secondary); border-left: 4px solid var(--color-accent-success); border-radius: var(--radius-md);">
        <h3 style="margin-top: 0; margin-bottom: var(--space-2); color: var(--color-text-primary);">🔬 {t.workedExampleTitle}</h3>
        <p style="margin-bottom: var(--space-2); font-size: var(--text-sm); color: var(--color-text-secondary); font-family: var(--font-mono);"><strong>Sample Input:</strong> {t.workedSampleInput}</p>
        <p style="margin-bottom: var(--space-2); font-size: var(--text-sm); color: var(--color-text-primary); font-family: var(--font-mono);"><strong>Measured Output:</strong> {t.workedSampleOutput}</p>
        <p style="margin-bottom: 0; font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.7;">{t.workedSampleExplain}</p>
      </div>
    )}

    <h2>{t.h2Understanding}</h2>
    <p set:html={t.pUnderstanding}></p>

    <h3>{t.h3Classifications}</h3>
    <table>
      <thead>
        <tr>
          <th>{t.thRadius}</th>
          <th>{t.thRating}</th>
          <th>{t.thSource}</th>
          <th>{t.thSuitability}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>&lt; 3 m (10 ft)</td>
          <td><strong style="color: var(--color-accent-success);">{t.row1Rating}</strong></td>
          <td>{t.row1Source}</td>
          <td>{t.row1Use}</td>
        </tr>
        <tr>
          <td>3 - 8 m (10–26 ft)</td>
          <td><strong style="color: var(--color-accent-primary);">{t.row2Rating}</strong></td>
          <td>{t.row2Source}</td>
          <td>{t.row2Use}</td>
        </tr>
        <tr>
          <td>8 - 25 m (26–82 ft)</td>
          <td><strong style="color: var(--color-accent-warning);">{t.row3Rating}</strong></td>
          <td>{t.row3Source}</td>
          <td>{t.row3Use}</td>
        </tr>
        <tr>
          <td>&gt; 25 m (82+ ft)</td>
          <td><strong style="color: var(--color-accent-error);">{t.row4Rating}</strong></td>
          <td>{t.row4Source}</td>
          <td>{t.row4Use}</td>
        </tr>
      </tbody>
    </table>

    {t.limitationsTitle && (
      <div style="margin: var(--space-10) 0;">
        <h2>⚡ {t.limitationsTitle}</h2>
        <div style="display: grid; gap: var(--space-4); margin-top: var(--space-4);">
          {t.limitations.map((l: any) => (
            <div class="card card-flat" style="padding: var(--space-4) var(--space-5); border-left: 3px solid var(--color-accent-warning);">
              <strong style="display: block; color: var(--color-text-primary); margin-bottom: var(--space-1); font-size: var(--text-base);">{l.title}</strong>
              <p style="margin: 0; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.75;">{l.desc}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <h2>{t.h2Improve}</h2>
    <ul>
      <li set:html={t.li1}></li>
      <li set:html={t.li2}></li>
      <li set:html={t.li3}></li>
      <li set:html={t.li4}></li>
    </ul>

    <div class="callout-box" style="margin-top: var(--space-6); line-height: 1.8;">
      <p style="margin: 0; font-size: var(--text-sm);">
        {lang === 'fr' ? (
          <>
            <strong>Diagnostic et calibrage de position :</strong> Si votre rayon d'erreur dépasse 20 mètres, suivez notre protocole étape par étape dans <a href={getLocalizedPath('/guides/improve-gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Comment améliorer la précision du GPS</a> et consultez notre guide de dépannage sur la <a href={getLocalizedPath('/guides/wrong-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">correction d'une position erronée</a>. Comparez les limites des signaux satellite face aux réseaux internet dans notre analyse <a href={getLocalizedPath('/comparisons/gps-vs-ip-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS vs Géolocalisation IP</a>. Pour afficher vos coordonnées exactes avec fix satellite en temps réel, rendez-vous sur le <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Détecteur de Coordonnées GPS</a> ou vérifiez votre altitude avec le <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Localisateur d'Altitude</a>.
          </>
        ) : lang === 'es' ? (
          <>
            <strong>Diagnóstico y calibración de señal :</strong> Si su radio de error supera los 20 metros, aplique las técnicas de nuestro tutorial <a href={getLocalizedPath('/guides/improve-gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Cómo mejorar la precisión GPS</a> y consulte nuestra guía para <a href={getLocalizedPath('/guides/wrong-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">corregir ubicaciones erróneas</a>. Compare las tecnologías satelitales frente a redes en <a href={getLocalizedPath('/comparisons/gps-vs-ip-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS vs Geolocalización IP</a>. Para ver sus coordenadas satelitales en vivo, utilice el <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Buscador de Coordenadas GPS</a> o mida la altura sobre el nivel del mar en el <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Buscador de Altitud</a>.
          </>
        ) : lang === 'de' ? (
          <>
            <strong>Fehlerdiagnose und Empfangsoptimierung :</strong> Liegt Ihr Fehlerradius über 20 Metern, nutzen Sie die Tipps in unserem Leitfaden <a href={getLocalizedPath('/guides/improve-gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS-Genauigkeit verbessern</a> sowie unsere Anleitung zur <a href={getLocalizedPath('/guides/wrong-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Behebung falscher Standorte</a>. Vergleichen Sie Satellitenempfang und Netzwerk-Routing in <a href={getLocalizedPath('/comparisons/gps-vs-ip-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS vs. IP-Standort</a>. Ihre genauen Koordinaten ermitteln Sie mit dem <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS-Koordinaten-Finder</a> und Höhenwerte mit dem <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Höhenfinder</a>.
          </>
        ) : lang === 'pt' ? (
          <>
            <strong>Diagnóstico e calibração de sinal :</strong> Se o raio de incerteza ultrapassar 20 metros, aplique as instruções de <a href={getLocalizedPath('/guides/improve-gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">como melhorar a precisão do GPS</a> e o guia para <a href={getLocalizedPath('/guides/wrong-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">corrigir localização errada</a>. Entenda a diferença entre dados de rede e satélites em <a href={getLocalizedPath('/comparisons/gps-vs-ip-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS vs Localização IP</a>. Para ver coordenadas ao vivo, use o <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Buscador de Coordenadas GPS</a> ou confira a elevação no <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Localizador de Altitude</a>.
          </>
        ) : lang === 'hi' ? (
          <>
            <strong>सिग्नल जांच और सुधार गाइड :</strong> यदि त्रुटि का दायरा 20 मीटर से अधिक है, तो हमारे गाइड <a href={getLocalizedPath('/guides/improve-gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS सटीकता कैसे बढ़ाएं</a> और <a href={getLocalizedPath('/guides/wrong-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">गलत लोकेशन कैसे ठीक करें</a> को पढ़ें। तुलनात्मक विश्लेषण के लिए <a href={getLocalizedPath('/comparisons/gps-vs-ip-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS बनाम IP लोकेशन</a> देखें। सटीक निर्देशांकों के लिए <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS निर्देशांक खोजक</a> और ऊंचाई हेतु <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">ऊंचाई खोजक</a> का उपयोग करें।
          </>
        ) : lang === 'id' ? (
          <>
            <strong>Diagnostik dan Kalibrasi Sinyal :</strong> Jika radius kesalahan melebihi 20 meter, ikuti panduan kami tentang <a href={getLocalizedPath('/guides/improve-gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">cara meningkatkan akurasi GPS</a> dan <a href={getLocalizedPath('/guides/wrong-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">memperbaiki lokasi salah</a>. Pahami batasan jaringan di <a href={getLocalizedPath('/comparisons/gps-vs-ip-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS vs Lokasi IP</a>. Untuk membaca koordinat satelit langsung, gunakan <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Pencari Koordinat GPS</a> atau cek ketinggian di <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Pencari Elevasi</a>.
          </>
        ) : (
          <>
            <strong>Signal Diagnostics & Hardware Calibration:</strong> If your confidence error radius exceeds 20 meters, apply our step-by-step techniques in <a href={getLocalizedPath('/guides/improve-gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">How to Improve GPS Accuracy</a> and troubleshoot in <a href={getLocalizedPath('/guides/wrong-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Fixing Wrong Location Issues</a>. Compare sensor limits against wired internet sockets in our guide to <a href={getLocalizedPath('/comparisons/gps-vs-ip-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS vs IP Location</a>. Check your hardware coordinates on our dedicated <a href={getLocalizedPath('/gps/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">My Location GPS Page</a> or verify true terrain height with the <a href={getLocalizedPath('/tools/elevation-finder/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Elevation Finder</a>.
          </>
        )}
      </p>
    </div>

    <h2>{lang === 'es' ? 'Interferencia por Trayectos Múltiples y Retardo Atmosférico' : lang === 'fr' ? 'Interférences Multi-Trajets et Retards Atmosphériques' : lang === 'de' ? 'Mehrwegeffekte und atmosphärische Verzögerung' : lang === 'pt' ? 'Interferência de Multicaminho e Atraso Atmosférico' : lang === 'hi' ? 'मल्टीपाथ परावर्तन और वायुमंडलीय विलंब' : lang === 'id' ? 'Interferensi Multipath & Keterlambatan Atmosfer' : 'Multipath Interference & Atmospheric Delays'}</h2>
    <p>{lang === 'es' ? 'La degradación de la señal GPS se produce principalmente por dos factores: la refracción electromagnética al cruzar la ionosfera y troposfera, y el rebote de ondas de radio en edificios y masas de agua (trayectos múltiples). Los receptores modernos de doble banda (L1+L5) corrigen ambos efectos simultáneamente.' : lang === 'fr' ? 'La dégradation du signal satellite provient essentiellement de la réfraction dans l\'ionosphère et la troposphère, ainsi que du rebond des ondes sur les structures métalliques ou vitrées (multi-trajets). Les récepteurs modernes bibandes (L1+L5) corrigent ces décalages temporels.' : lang === 'de' ? 'Genauigkeitsverluste entstehen primär durch Brechung in der Ionosphäre sowie durch Signalreflexionen an Bauwerken (Mehrwegeffekt). Dual-Frequenz-Empfänger (L1+L5) filtern diese Fehlerquellen heraus und erzielen Genauigkeiten unterhalb eines Meters.' : lang === 'pt' ? 'A perda de precisão GNSS decorre da refração na ionosfera e troposfera, e da reflexão das ondas em superfícies espelhadas ou metálicas (multicaminho). Receptores de frequência dupla (L1+L5) neutralizam esses atrasos.' : lang === 'hi' ? 'GPS सिग्नल में त्रुटि मुख्य रूप से आयनमंडल में परावर्तन और इमारतों से टकराकर लौटने (मल्टीपाथ) के कारण होती है। आधुनिक डुअल-बैंड (L1+L5) रिसीवर इन दोनों त्रुटियों को दूर करते हैं।' : lang === 'id' ? 'Penurunan akurasi GPS terutama disebabkan oleh pembiasan pada ionosfer dan troposfer, serta pantulan sinyal gelombang mikro pada dinding gedung bertingkat (multipath). Modul dual-band (L1+L5) mampu mengoreksi kedua gangguan tersebut.' : 'GNSS accuracy degradation stems primarily from two phenomena: atmospheric refraction as radio waves traverse the ionosphere and troposphere, and multipath interference caused by satellite signals bouncing off glass, metal, or water surfaces before reaching the antenna. Dual-frequency GNSS chips (L1+L5) compare the two carrier waves to calculate and eliminate atmospheric delays in real time.'}</p>

    <div style="margin-top: var(--space-12);">
      <h2 class="mb-8">{faqTitle}</h2>
      <FAQAccordion items={toolFaqs} />
    </div>

    {t.nextSteps && (
      <div class="card card-flat" style="margin: var(--space-10) 0; padding: var(--space-6); background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
        <h3 style="margin-top: 0; margin-bottom: var(--space-4); font-size: var(--text-lg); display: flex; align-items: center; gap: var(--space-2);">
          <span>🚀</span> {t.nextStepsTitle || "Next Steps"}
        </h3>
        <div style="display: grid; gap: var(--space-3);">
          {t.nextSteps.map((step: any) => (
            <a href={getLocalizedPath(step.href, lang)} class="card card-flat" style="display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-3) var(--space-4); text-decoration: none; border-left: 3px solid var(--color-accent-primary); background: var(--color-bg-card); transition: transform 0.15s ease;">
              <strong style="color: var(--color-text-primary); font-size: var(--text-base);">{step.title} →</strong>
              <span style="color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6;">{step.desc}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="contextual-next-box" style="margin-top: var(--space-8);">
      <h3 class="contextual-next-title">
        <span>{t.h2Related}</span>
      </h3>
      <div class="contextual-next-grid">
        <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{t.linkGps}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Coordenadas y altitud' : lang === 'fr' ? 'Coordonnées et altitude' : lang === 'de' ? 'Koordinaten & Höhe' : 'Live satellite fix'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/guides/improve-gps-accuracy/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{t.linkGuideAccuracy}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Calibración en iOS y Android' : lang === 'fr' ? 'Calibrage iOS et Android' : lang === 'de' ? 'Kalibrierung für Android & iOS' : 'Calibration for iOS & Android'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/guides/wrong-location/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Corregir Ubicación Errónea' : lang === 'fr' ? 'Corriger Position Erronée' : lang === 'de' ? 'Falschen Standort Beheben' : lang === 'pt' ? 'Corrigir Localização Errada' : lang === 'hi' ? 'गलत लोकेशन ठीक करें' : lang === 'id' ? 'Perbaiki Lokasi Salah' : 'Fix Wrong Location Issues'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Solución a errores de GPS' : lang === 'fr' ? 'Résoudre les erreurs GPS' : lang === 'de' ? 'Fehlerursachen beheben' : 'Troubleshoot jumpy pins'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/comparisons/gps-vs-ip-location/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon">⚖️</span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{t.linkComp}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Satélites GNSS vs red IP' : lang === 'fr' ? 'Satellites vs réseau IP' : lang === 'de' ? 'Satelliten vs. IP-Netz' : 'Satellites vs IP networks'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/elevation-finder/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon">⛰️</span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Buscador de Altitud' : lang === 'fr' ? "Localisateur d'Altitude" : lang === 'de' ? 'Höhenfinder' : lang === 'pt' ? 'Localizador de Altitude' : lang === 'hi' ? 'ऊंचाई खोजक' : lang === 'id' ? 'Pencari Elevasi' : 'Elevation Finder'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Altitud sobre nivel del mar' : lang === 'fr' ? 'Altitude au-dessus de la mer' : lang === 'de' ? 'Höhe über dem Meeresspiegel' : 'Height above sea level'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/location/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? '¿Dónde Estoy Ahora?' : lang === 'fr' ? 'Où Suis-Je ?' : lang === 'de' ? 'Wo bin ich gerade?' : lang === 'pt' ? 'Onde Estou Agora?' : lang === 'hi' ? 'मेरी वर्तमान स्थिति' : lang === 'id' ? 'Di Mana Saya Sekarang?' : 'Where Am I Right Now?'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Panel de telemetría completo' : lang === 'fr' ? 'Télémétrie complète en direct' : lang === 'de' ? 'Vollständige Telemetrie' : 'Full real-time telemetry'}</div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <script define:vars={{ tData: t }}>
    let watchId = null;
    const startBtn = document.getElementById('acc-start-btn');
    const stopBtn = document.getElementById('acc-stop-btn');
    const statusIndicator = document.getElementById('acc-status-indicator');
    const valMeters = document.getElementById('acc-val-meters');
    const valFeet = document.getElementById('acc-val-feet');
    const ratingBadge = document.getElementById('acc-rating-badge');
    const updateTime = document.getElementById('acc-update-time');
    const meterBar = document.getElementById('acc-meter-bar');

    const hdopEl = document.getElementById('acc-hdop');
    const speedEl = document.getElementById('acc-speed');
    const headingEl = document.getElementById('acc-heading');
    const altEl = document.getElementById('acc-alt');
    const valtEl = document.getElementById('acc-valt');
    const coordsEl = document.getElementById('acc-coords');

    function startTracking() {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }

      if (statusIndicator) {
        statusIndicator.innerHTML = `<span style="width: 10px; height: 10px; border-radius: 50%; background: #00d4ff; box-shadow: 0 0 8px #00d4ff;"></span> ${tData.statusAcquiring}`;
      }

      watchId = navigator.geolocation.watchPosition(
        (pos) => {
          const acc = pos.coords.accuracy;
          const accFeet = Math.round(acc * 3.28084);
          const roundAcc = Math.round(acc * 10) / 10;

          if (valMeters) valMeters.textContent = String(roundAcc);
          if (valFeet) valFeet.textContent = String(accFeet);
          if (updateTime) updateTime.textContent = `${new Date().toLocaleTimeString()}`;

          if (coordsEl) {
            coordsEl.textContent = `${pos.coords.latitude.toFixed(6)}, ${pos.coords.longitude.toFixed(6)}`;
          }

          if (ratingBadge && meterBar) {
            if (acc <= 4) {
              ratingBadge.textContent = tData.ratingExceptional;
              ratingBadge.className = 'badge badge-success';
              meterBar.style.width = '100%';
              meterBar.style.background = '#10b981';
            } else if (acc <= 10) {
              ratingBadge.textContent = tData.ratingHigh;
              ratingBadge.className = 'badge badge-primary';
              meterBar.style.width = '80%';
              meterBar.style.background = '#00d4ff';
            } else if (acc <= 30) {
              ratingBadge.textContent = tData.ratingModerate;
              ratingBadge.className = 'badge badge-warning';
              meterBar.style.width = '45%';
              meterBar.style.background = '#f59e0b';
            } else {
              ratingBadge.textContent = tData.ratingLow;
              ratingBadge.className = 'badge badge-error';
              meterBar.style.width = '20%';
              meterBar.style.background = '#ef4444';
            }
          }

          if (hdopEl) {
            const hdop = (acc / 4.0).toFixed(2);
            const qual = hdop < 1.5 ? tData.hdopExcellent : hdop < 3 ? tData.hdopGood : tData.hdopModerate;
            hdopEl.textContent = `~${hdop} (${qual})`;
          }

          if (speedEl) {
            if (pos.coords.speed !== null && pos.coords.speed !== undefined) {
              const kmh = (pos.coords.speed * 3.6).toFixed(1);
              const mph = (pos.coords.speed * 2.23694).toFixed(1);
              speedEl.textContent = `${kmh} km/h (${mph} mph)`;
            } else {
              speedEl.textContent = tData.speedStationary;
            }
          }

          if (headingEl) {
            if (pos.coords.heading !== null && pos.coords.heading !== undefined && !isNaN(pos.coords.heading)) {
              const deg = Math.round(pos.coords.heading);
              const dirs = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
              const dir = dirs[Math.round(deg / 45) % 8];
              headingEl.textContent = `${deg}° (${dir})`;
            } else {
              headingEl.textContent = tData.headingStatic;
            }
          }

          if (altEl) {
            if (pos.coords.altitude !== null && pos.coords.altitude !== undefined) {
              altEl.textContent = `${Math.round(pos.coords.altitude)} m (${Math.round(pos.coords.altitude * 3.28084)} ft)`;
            } else {
              altEl.textContent = tData.notAvailable;
            }
          }

          if (valtEl) {
            if (pos.coords.altitudeAccuracy !== null && pos.coords.altitudeAccuracy !== undefined) {
              valtEl.textContent = `± ${Math.round(pos.coords.altitudeAccuracy)} m`;
            } else {
              valtEl.textContent = 'N/A';
            }
          }

          if (statusIndicator) {
            statusIndicator.innerHTML = `<span style="width: 10px; height: 10px; border-radius: 50%; background: #10b981; box-shadow: 0 0 8px #10b981;"></span> ${tData.statusActive}`;
          }
        },
        (err) => {
          if (statusIndicator) {
            statusIndicator.innerHTML = `<span style="width: 10px; height: 10px; border-radius: 50%; background: #ef4444;"></span> ${err.message}`;
          }
        },
        { enableHighAccuracy: true, maximumAge: 1000, timeout: 15000 }
      );

      if (startBtn) startBtn.style.display = 'none';
      if (stopBtn) stopBtn.style.display = 'inline-flex';
    }

    function stopTracking() {
      if (watchId !== null) {
        navigator.geolocation.clearWatch(watchId);
        watchId = null;
      }
      if (startBtn) startBtn.style.display = 'inline-flex';
      if (stopBtn) stopBtn.style.display = 'none';
      if (statusIndicator) {
        statusIndicator.innerHTML = `<span style="width: 10px; height: 10px; border-radius: 50%; background: #64748b;"></span> ${tData.statusStandby}`;
      }
    }

    if (startBtn) startBtn.addEventListener('click', startTracking);
    if (stopBtn) stopBtn.addEventListener('click', stopTracking);

    document.getElementById('acc-copy')?.addEventListener('click', function () {
      const meters = valMeters?.textContent.trim();
      if (!meters || meters === '—') return;
      const t = (id) => document.getElementById(id)?.textContent.trim() || '—';
      const lines = [
        `GPS Accuracy Snapshot — ${new Date().toLocaleString()}`,
        `Accuracy: ± ${meters} m (± ${t('acc-val-feet')} ft)`,
        `Rating: ${t('acc-rating-badge')}`,
        `Coordinates: ${t('acc-coords')}`,
        `HDOP: ${t('acc-hdop')}`,
        `Ground Speed: ${t('acc-speed')}`,
        `Heading: ${t('acc-heading')}`,
        `Altitude: ${t('acc-alt')}`,
        `Vertical Accuracy: ${t('acc-valt')}`,
      ];
      navigator.clipboard.writeText(lines.join('\n')).then(() => {
        const orig = this.textContent;
        this.textContent = tData.btnCopied;
        setTimeout(() => { this.textContent = orig; }, 2000);
      });
    });
  </script>
</ToolLayout>
