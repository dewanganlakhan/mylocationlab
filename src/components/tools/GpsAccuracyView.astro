    btnStart: "🛰️ लाइव GPS मॉनिटर शुरू करें",
    btnStop: "⏹️ मॉनिटर रोकें",
    statusStandby: "स्टैंडबाय",
    statusAcquiring: "सैटेलाइट खोजे जा रहे हैं...",
