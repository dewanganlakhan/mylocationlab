    row2Use: "मोड़-दर-मोड़ ड्राइविंग, ट्रेकिंग, फ़िटनेस ट्रैकिंग",
    row3Rating: "मध्यम",
    row3Source: "Wi-Fi पोज़िशनिंग (WPS) / इनडोर",
    row3Use: "मोहल्ला-स्तरीय डिलीवरी, लोकल सर्च",
    row4Rating: "कम",
    row4Source: "सेल टावर ट्रायंगुलेशन / IP जियो",
    row4Use: "केवल शहर-स्तरीय क्षेत्रीय पहचान",
    h2Improve: "अपने डिवाइस की GPS सटीकता कैसे बढ़ाएं",
    li1: "<strong>Wi-Fi और ब्लूटूथ स्कैनिंग चालू करें:</strong> मोबाइल ऑपरेटिंग सिस्टम आसपास के Wi-Fi राउटर BSSID से प्रारंभिक सैटेलाइट अधिग्रहण तेज़ करते हैं (असिस्टेड GPS)।",
    li2: "<strong>'अर्बन कैनियन' से दूर जाएं:</strong> ऊँची कंक्रीट और कांच की इमारतें सैटेलाइट सिग्नल को परावर्तित करती हैं, जिससे <em>मल्टीपाथ हस्तक्षेप</em> होता है और सटीकता घटती है।",
    li3: "<strong>आंतरिक मैग्नेटोमीटर कैलिब्रेट करें:</strong> सटीक दिशा के लिए अपने डिवाइस को हवा में 8 के आकार में घुमाकर इलेक्ट्रॉनिक कंपास पुनः कैलिब्रेट करें।",
    li4: "<strong>आकाश का खुला दृश्य सुनिश्चित करें:</strong> घनी पत्तियाँ, भूमिगत तहखाने और धातु की संरचनाएँ उच्च-आवृत्ति सैटेलाइट सिग्नल को कमज़ोर करती हैं।",
    h2Related: "संबंधित भू-स्थानिक टूल",
    linkGps: "GPS निर्देशांक खोजक",
    linkGuideAccuracy: "GPS सटीकता बढ़ाने की संपूर्ण गाइड",
    linkComp: "GPS बनाम IP लोकेशन तुलना"
  },
  id: {
    title: "Pemeriksa Akurasi GPS — Uji Presisi Langsung | MyLocationLab",
    description: "Periksa akurasi GPS perangkat Anda secara real-time. Ukur radius presisi horizontal (HDOP), kepercayaan sinyal dalam meter, kecepatan, dan arah kompas.",
    h1: "Pemeriksa Akurasi GPS",
    subtitle: "Pantau akurasi penentuan posisi satelit GNSS perangkat Anda secara real-time, radius presisi horizontal, dan telemetri sensor.",
    btnStart: "🛰️ Mulai Monitor GPS Langsung",
    btnStop: "⏹️ Hentikan Monitor",
    statusStandby: "Siaga",
    statusAcquiring: "Mencari satelit...",
    statusActive: "GNSS Langsung Aktif",
    liveRadiusTitle: "Radius Akurasi Horizontal Langsung",
    awaitingLock: "Menunggu Kunci GPS",
    updatesEverySec: "Pembaruan setiap detik",
    lblHdop: "Perkiraan HDOP",
    lblSpeed: "Kecepatan Darat",
    lblHeading: "Arah Kompas",
    lblAlt: "Ketinggian",
    lblValt: "Akurasi Vertikal",
    lblCoords: "Koordinat Aktif",
    btnCopy: "📋 Salin Snapshot",
    btnCopied: "✅ Tersalin!",
    ratingExceptional: "Akurasi Luar Biasa (Presisi Dual-Band)",
    ratingHigh: "Akurasi Tinggi (Kunci GNSS Standar)",
    ratingModerate: "Akurasi Moderat (Wi-Fi / Multi-sumber)",
    ratingLow: "Presisi Rendah (Seluler / Regional)",
    hdopExcellent: "Sangat Baik",
    hdopGood: "Baik",
    hdopModerate: "Moderat",
    speedStationary: "Stasioner / 0 km/h",
    headingStatic: "Statis (Tanpa Arah)",
    notAvailable: "Tidak Tersedia",
    h2Understanding: "Memahami Akurasi GPS dan Dilution of Precision (DOP)",
    pUnderstanding: "Akurasi geolokasi peramban dan ponsel dinyatakan sebagai <strong>radius keyakinan 95%</strong>. Jika perangkat Anda melaporkan akurasi ±5 meter, ada kemungkinan 95% posisi sebenarnya berada dalam lingkaran radius 5 meter di sekitar koordinat yang dilaporkan.",
    h3Classifications: "Klasifikasi Akurasi",
    thRadius: "Radius Akurasi",
    thRating: "Peringkat",
    thSource: "Sumber Umum",
    thSuitability: "Kecocokan Penggunaan",
    row1Rating: "Luar Biasa",
    row1Source: "GNSS Frekuensi Ganda L1/L5",
    row1Use: "Pemetaan presisi, survei, navigasi tingkat lajur",
    row2Rating: "Tinggi",
    row2Source: "GPS / GLONASS Seluler Standar",
    row2Use: "Navigasi belokan demi belokan, pendakian, pelacakan kebugaran",
    row3Rating: "Moderat",
    row3Source: "Positioning Wi-Fi (WPS) / Dalam Ruangan",
    row3Use: "Pengiriman tingkat lingkungan, pencarian lokal",
    row4Rating: "Rendah",
    row4Source: "Triangulasi Menara Seluler / Geo IP",
    row4Use: "Hanya penemuan regional tingkat kota",
    h2Improve: "Cara Meningkatkan Akurasi GPS Perangkat Anda",
    li1: "<strong>Aktifkan Pemindaian Wi-Fi dan Bluetooth:</strong> Sistem operasi seluler memakai BSSID router Wi-Fi terdekat untuk mempercepat perolehan satelit awal (Assisted GPS).",
    li2: "<strong>Hindari 'Urban Canyon':</strong> Gedung tinggi dari beton dan kaca memantulkan sinyal satelit sehingga menimbulkan <em>interferensi multipath</em> yang menurunkan akurasi.",
    li3: "<strong>Kalibrasi Magnetometer Internal:</strong> Gerakkan perangkat Anda membentuk angka 8 untuk mengalibrasi ulang kompas elektronik agar arah akurat.",
    li4: "<strong>Pastikan Pandangan Langit Bebas Halangan:</strong> Dedaunan lebat, ruang bawah tanah, dan struktur logam melemahkan sinyal gelombang mikro satelit.",
    h2Related: "Alat Geospasial Terkait",
    linkGps: "Pencari Koordinat GPS",
    linkGuideAccuracy: "Panduan Lengkap Meningkatkan Akurasi GPS",
    linkComp: "Perbandingan GPS vs Lokasi IP"
  }
};

const t = translations[lang] || translations.en;
---

<ToolLayout
  toolId="gps-accuracy"
  title={t.title}
  description={t.description}
  h1={t.h1}
  subtitle={t.subtitle}
  lang={lang}
>
  <div class="tool-interface">
    <div class="flex gap-4 flex-wrap" style="margin-bottom: var(--space-6);">
      <button class="btn btn-primary" id="acc-start-btn" type="button">{t.btnStart}</button>
      <button class="btn btn-secondary" id="acc-stop-btn" type="button" style="display: none;">{t.btnStop}</button>
      <span id="acc-status-indicator" style="display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-text-secondary); font-size: var(--text-sm);">
        <span style="width: 10px; height: 10px; border-radius: 50%; background: #64748b;"></span> {t.statusStandby}
      </span>
    </div>

    <!-- Live Accuracy Gauge Card -->
    <div class="card card-highlight" id="acc-card" style="text-align: center; padding: var(--space-8) var(--space-4); margin-bottom: var(--space-6);">
      <span style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent-primary);">{t.liveRadiusTitle}</span>
      
      <div style="font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 900; font-family: var(--font-mono); margin: var(--space-3) 0; color: var(--color-text-heading);">
        ± <span id="acc-val-meters">—</span> <span style="font-size: var(--text-2xl); color: var(--color-accent-primary);">m</span>
        <span style="color: var(--color-text-tertiary); font-size: var(--text-3xl); margin: 0 var(--space-2);">/</span>
        ± <span id="acc-val-feet">—</span> <span style="font-size: var(--text-2xl); color: var(--color-accent-secondary);">ft</span>
      </div>

      <div style="display: flex; justify-content: center; gap: var(--space-3); align-items: center; flex-wrap: wrap;">
        <span class="badge badge-neutral" id="acc-rating-badge">{t.awaitingLock}</span>
        <span style="font-size: var(--text-xs); color: var(--color-text-tertiary);" id="acc-update-time">{t.updatesEverySec}</span>
      </div>

      <!-- Accuracy progress bar -->
      <div style="width: 100%; max-width: 420px; height: 8px; background: var(--color-bg-tertiary); border-radius: var(--radius-full); margin: var(--space-6) auto 0; overflow: hidden; border: 1px solid var(--color-border);">
        <div id="acc-meter-bar" style="width: 0%; height: 100%; background: var(--gradient-primary); transition: width 0.4s ease;"></div>
      </div>
    </div>

    <!-- Sensor Metrics Grid -->
    <div class="location-data-grid" id="acc-grid">
      <div class="location-data-item">
        <span class="location-data-label">{t.lblHdop}</span>
        <span class="location-data-value highlight" id="acc-hdop">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">{t.lblSpeed}</span>
        <span class="location-data-value" id="acc-speed">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">{t.lblHeading}</span>
        <span class="location-data-value" id="acc-heading">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">{t.lblAlt}</span>
        <span class="location-data-value" id="acc-alt">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">{t.lblValt}</span>
        <span class="location-data-value" id="acc-valt">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">{t.lblCoords}</span>
        <span class="location-data-value" id="acc-coords" style="font-size: var(--text-xs);">—</span>
      </div>
    </div>

    <div class="action-buttons" style="margin-top: var(--space-6); display: flex;">
      <button class="btn btn-secondary btn-sm" id="acc-copy" type="button">{t.btnCopy}</button>
    </div>
  </div>

  <div class="prose" style="margin-top: var(--space-12); line-height: 1.8;">
    <h2>{t.h2Understanding}</h2>
    <p set:html={t.pUnderstanding}></p>

    <h3>{t.h3Classifications}</h3>
    <table>
      <thead>
        <tr>
          <th>{t.thRadius}</th>
          <th>{t.thRating}</th>
          <th>{t.thSource}</th>
          <th>{t.thSuitability}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>&lt; 3 m (10 ft)</td>
          <td><strong style="color: var(--color-accent-success);">{t.row1Rating}</strong></td>
          <td>{t.row1Source}</td>
          <td>{t.row1Use}</td>
        </tr>
        <tr>
          <td>3 - 8 m (10–26 ft)</td>
          <td><strong style="color: var(--color-accent-primary);">{t.row2Rating}</strong></td>
          <td>{t.row2Source}</td>
          <td>{t.row2Use}</td>
        </tr>
        <tr>
          <td>8 - 25 m (26–82 ft)</td>
          <td><strong style="color: var(--color-accent-warning);">{t.row3Rating}</strong></td>
          <td>{t.row3Source}</td>
          <td>{t.row3Use}</td>
        </tr>
        <tr>
          <td>&gt; 25 m (82+ ft)</td>
          <td><strong style="color: var(--color-accent-error);">{t.row4Rating}</strong></td>
          <td>{t.row4Source}</td>
          <td>{t.row4Use}</td>
        </tr>
      </tbody>
    </table>

    <h2>{t.h2Improve}</h2>
    <ul>
      <li set:html={t.li1}></li>
      <li set:html={t.li2}></li>
      <li set:html={t.li3}></li>
      <li set:html={t.li4}></li>
    </ul>

    <h2>{t.h2Related}</h2>
    <ul>
      <li><a href={getLocalizedPath('/tools/gps-coordinates/', lang)}>{t.linkGps}</a></li>
      <li><a href={getLocalizedPath('/guides/improve-gps-accuracy/', lang)}>{t.linkGuideAccuracy}</a></li>
      <li><a href={getLocalizedPath('/comparisons/gps-vs-ip-location/', lang)}>{t.linkComp}</a></li>
    </ul>
  </div>

  <script define:vars={{ tData: t }}>
    let watchId = null;
    const startBtn = document.getElementById('acc-start-btn');
    const stopBtn = document.getElementById('acc-stop-btn');
    const statusIndicator = document.getElementById('acc-status-indicator');
    const valMeters = document.getElementById('acc-val-meters');
    const valFeet = document.getElementById('acc-val-feet');
    const ratingBadge = document.getElementById('acc-rating-badge');
    const updateTime = document.getElementById('acc-update-time');
    const meterBar = document.getElementById('acc-meter-bar');

    const hdopEl = document.getElementById('acc-hdop');
    const speedEl = document.getElementById('acc-speed');
    const headingEl = document.getElementById('acc-heading');
    const altEl = document.getElementById('acc-alt');
    const valtEl = document.getElementById('acc-valt');
    const coordsEl = document.getElementById('acc-coords');

    function startTracking() {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }

      if (statusIndicator) {
        statusIndicator.innerHTML = `<span style="width: 10px; height: 10px; border-radius: 50%; background: #00d4ff; box-shadow: 0 0 8px #00d4ff;"></span> ${tData.statusAcquiring}`;
      }

      watchId = navigator.geolocation.watchPosition(
        (pos) => {
          const acc = pos.coords.accuracy;
          const accFeet = Math.round(acc * 3.28084);
          const roundAcc = Math.round(acc * 10) / 10;

          if (valMeters) valMeters.textContent = String(roundAcc);
          if (valFeet) valFeet.textContent = String(accFeet);
          if (updateTime) updateTime.textContent = `${new Date().toLocaleTimeString()}`;

          if (coordsEl) {
            coordsEl.textContent = `${pos.coords.latitude.toFixed(6)}, ${pos.coords.longitude.toFixed(6)}`;
          }

          if (ratingBadge && meterBar) {
            if (acc <= 4) {
              ratingBadge.textContent = tData.ratingExceptional;
              ratingBadge.className = 'badge badge-success';
              meterBar.style.width = '100%';
              meterBar.style.background = '#10b981';
            } else if (acc <= 10) {
              ratingBadge.textContent = tData.ratingHigh;
              ratingBadge.className = 'badge badge-primary';
              meterBar.style.width = '80%';
              meterBar.style.background = '#00d4ff';
            } else if (acc <= 30) {
              ratingBadge.textContent = tData.ratingModerate;
              ratingBadge.className = 'badge badge-warning';
              meterBar.style.width = '45%';
              meterBar.style.background = '#f59e0b';
            } else {
              ratingBadge.textContent = tData.ratingLow;
              ratingBadge.className = 'badge badge-error';
              meterBar.style.width = '20%';
              meterBar.style.background = '#ef4444';
            }
          }

          if (hdopEl) {
            const hdop = (acc / 4.0).toFixed(2);
            const qual = hdop < 1.5 ? tData.hdopExcellent : hdop < 3 ? tData.hdopGood : tData.hdopModerate;
            hdopEl.textContent = `~${hdop} (${qual})`;
          }

          if (speedEl) {
            if (pos.coords.speed !== null && pos.coords.speed !== undefined) {
              const kmh = (pos.coords.speed * 3.6).toFixed(1);
              const mph = (pos.coords.speed * 2.23694).toFixed(1);
              speedEl.textContent = `${kmh} km/h (${mph} mph)`;
            } else {
              speedEl.textContent = tData.speedStationary;
            }
          }

          if (headingEl) {
            if (pos.coords.heading !== null && pos.coords.heading !== undefined && !isNaN(pos.coords.heading)) {
              const deg = Math.round(pos.coords.heading);
              const dirs = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
              const dir = dirs[Math.round(deg / 45) % 8];
              headingEl.textContent = `${deg}° (${dir})`;
            } else {
              headingEl.textContent = tData.headingStatic;
            }
          }

          if (altEl) {
            if (pos.coords.altitude !== null && pos.coords.altitude !== undefined) {
              altEl.textContent = `${Math.round(pos.coords.altitude)} m (${Math.round(pos.coords.altitude * 3.28084)} ft)`;
            } else {
              altEl.textContent = tData.notAvailable;
            }
          }

          if (valtEl) {
            if (pos.coords.altitudeAccuracy !== null && pos.coords.altitudeAccuracy !== undefined) {
              valtEl.textContent = `± ${Math.round(pos.coords.altitudeAccuracy)} m`;
            } else {
              valtEl.textContent = 'N/A';
            }
          }

          if (statusIndicator) {
            statusIndicator.innerHTML = `<span style="width: 10px; height: 10px; border-radius: 50%; background: #10b981; box-shadow: 0 0 8px #10b981;"></span> ${tData.statusActive}`;
          }
        },
        (err) => {
          if (statusIndicator) {
            statusIndicator.innerHTML = `<span style="width: 10px; height: 10px; border-radius: 50%; background: #ef4444;"></span> ${err.message}`;
          }
        },
        { enableHighAccuracy: true, maximumAge: 1000, timeout: 15000 }
      );

      if (startBtn) startBtn.style.display = 'none';
      if (stopBtn) stopBtn.style.display = 'inline-flex';
    }

    function stopTracking() {
      if (watchId !== null) {
        navigator.geolocation.clearWatch(watchId);
        watchId = null;
      }
      if (startBtn) startBtn.style.display = 'inline-flex';
      if (stopBtn) stopBtn.style.display = 'none';
      if (statusIndicator) {
        statusIndicator.innerHTML = `<span style="width: 10px; height: 10px; border-radius: 50%; background: #64748b;"></span> ${tData.statusStandby}`;
      }
    }

    if (startBtn) startBtn.addEventListener('click', startTracking);
    if (stopBtn) stopBtn.addEventListener('click', stopTracking);

    document.getElementById('acc-copy')?.addEventListener('click', function () {
      const meters = valMeters?.textContent.trim();
      if (!meters || meters === '—') return;
      const t = (id) => document.getElementById(id)?.textContent.trim() || '—';
      const lines = [
        `GPS Accuracy Snapshot — ${new Date().toLocaleString()}`,
        `Accuracy: ± ${meters} m (± ${t('acc-val-feet')} ft)`,
        `Rating: ${t('acc-rating-badge')}`,
        `Coordinates: ${t('acc-coords')}`,
        `HDOP: ${t('acc-hdop')}`,
        `Ground Speed: ${t('acc-speed')}`,
        `Heading: ${t('acc-heading')}`,
        `Altitude: ${t('acc-alt')}`,
        `Vertical Accuracy: ${t('acc-valt')}`,
      ];
      navigator.clipboard.writeText(lines.join('\n')).then(() => {
        const orig = this.textContent;
        this.textContent = tData.btnCopied;
        setTimeout(() => { this.textContent = orig; }, 2000);
      });
    });
  </script>
</ToolLayout>
