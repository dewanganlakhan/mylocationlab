    liAlt: "Altitude: Jarak vertikal objek terbang (seperti pesawat, dron, atau satelit) di atas permukaan tanah (AGL) atau permukaan laut (AMSL).",
    liGeo: "Undulasi Geoid: Selisih antara elipsoid referensi matematis WGS-84 dan geoid gravitasi bumi yang sebenarnya (EGM96).",
    h3Pressure: "Tekanan Barometrik dan Variasi Titik Didih",
    pPressure: "Semakin tinggi elevasi, semakin rendah tekanan kolom udara atmosfer. Akibatnya, air mendidih pada suhu lebih rendah di ketinggian (misalnya, sekitar 93°C pada 2.000 meter dibandingkan 100°C di permukaan laut).",
    h2Related: "Alat & Panduan Geospasial Terkait",
    linkGps: "Pencari Koordinat GPS",
    linkDistance: "Kalkulator Jarak",
    linkHowGps: "Cara Kerja GPS",
    linkMyLocation: "Di Mana Saya Sekarang?"
  }
};

const t = translations[lang] || translations.en;
---

<ToolLayout
  toolId="elevation-finder"
  title={t.title}
  description={t.description}
  h1={t.h1}
  subtitle={t.subtitle}
  lang={lang}
>
  <div class="tool-interface">
    <div class="flex gap-4 flex-wrap" style="margin-bottom: var(--space-4);">
      <button class="btn btn-primary" id="ef-gps" type="button">{t.btnGps}</button>
      <span style="color: var(--color-text-tertiary); align-self: center;">{t.orEnterCoords}</span>
    </div>

    <div class="input-group" style="margin-bottom: var(--space-4);">
      <input type="text" class="input" id="ef-input" placeholder={t.placeholder} />
      <button class="btn btn-secondary" id="ef-search" type="button">{t.btnSearch}</button>
    </div>

    <!-- Status message -->
    <div id="ef-status" style="display: none; padding: var(--space-3); border-radius: var(--radius-lg); margin-bottom: var(--space-4); font-size: var(--text-sm);"></div>

    <!-- Elevation Result Card -->
    <div class="tool-result" id="ef-result" style="display: none;">
      <div style="text-align: center; padding: var(--space-6) 0; border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-4);">
        <span style="font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent-primary); font-weight: 700;">{t.measuredElevation}</span>
        <div style="font-size: var(--text-4xl); font-weight: 800; font-family: var(--font-mono); color: var(--color-text-heading); margin: var(--space-2) 0;">
          <span id="ef-meters">0</span> <span style="font-size: var(--text-xl); color: var(--color-accent-primary);">m</span>
          <span style="color: var(--color-text-tertiary); font-size: var(--text-2xl); margin: 0 var(--space-2);">/</span>
          <span id="ef-feet">0</span> <span style="font-size: var(--text-xl); color: var(--color-accent-secondary);">ft</span>
        </div>
        <span class="badge badge-success" id="ef-category">{t.catLowland}</span>
      </div>

      <div class="tool-result-row">
        <span class="tool-result-label">{t.labelCoords}</span>
        <span class="tool-result-value" id="ef-coords">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{t.labelPressure}</span>
        <span class="tool-result-value" id="ef-pressure">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{t.labelBoiling}</span>
        <span class="tool-result-value" id="ef-boiling">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{t.labelSource}</span>
        <span class="tool-result-value" id="ef-source">{t.defaultSource}</span>
      </div>
    </div>

    <div id="ef-actions" style="margin-top: var(--space-4); display: none; gap: var(--space-3); flex-wrap: wrap;">
      <button class="btn btn-secondary btn-sm" id="ef-copy" type="button">{t.btnCopy}</button>
      <a class="btn btn-ghost btn-sm" id="ef-maps-link" href="#" target="_blank" rel="noopener noreferrer">{t.viewOnMap}</a>
    </div>
  </div>

  <div class="prose" style="margin-top: var(--space-12); line-height: 1.8;">
    <h2>{t.h2Calc}</h2>
    <p>{t.pCalc1}</p>

    <h3>{t.h3Diff}</h3>
    <ul>
      <li><strong>{t.liElev.split(':')[0]}:</strong>{t.liElev.split(':')[1]}</li>
      <li><strong>{t.liAlt.split(':')[0]}:</strong>{t.liAlt.split(':')[1]}</li>
      <li><strong>{t.liGeo.split(':')[0]}:</strong>{t.liGeo.split(':')[1]}</li>
    </ul>

    <h3>{t.h3Pressure}</h3>
    <p>{t.pPressure}</p>

    <h2>{lang === 'es' ? 'Ondulación Geoidal: Altura Elipsoidal vs Ortométrica' : lang === 'fr' ? 'Ondulation du Géoïde : Hauteur Ellipsoïdale vs Orthométrique' : lang === 'de' ? 'Geoidundulation: Ellipsoidische vs. Orthometrische Höhe' : lang === 'pt' ? 'Ondulação Geoidal: Altura Elipsoidal vs Ortométrica' : lang === 'hi' ? 'जियोइड अनडुलेशन: दीर्घवृत्तीय बनाम ऑर्थोमेट्रिक ऊंचाई' : lang === 'id' ? 'Undulasi Geoid: Tinggi Elipsoid vs Tinggi Ortometrik' : 'Geoid Undulation: Ellipsoidal vs. Orthometric Height'}</h2>
    <p>{lang === 'es' ? 'Los satélites GPS miden la altura sobre un elipsoide matemático perfecto (WGS 84), mientras que la elevación real sobre el nivel del mar sigue el geoide gravitacional (EGM96). La diferencia entre ambos valores, conocida como ondulación geoidal, puede variar entre -106 metros y +85 metros en diferentes regiones del planeta.' : lang === 'fr' ? 'Les satellites GNSS mesurent la hauteur géométrique par rapport à l\'ellipsoïde WGS 84, alors que l\'altitude réelle suit le géoïde équipotentiel terrestre (EGM96). Cette variation, appelée ondulation du géoïde, oscille entre -106 et +85 mètres à l\'échelle mondiale.' : lang === 'de' ? 'GPS-Satelliten berechnen Höhen bezogen auf das mathematische WGS-84-Ellipsoid, während die reale Meereshöhe dem Schwerefeld-Geoid (EGM96) folgt. Dieser Unterschied (Geoidundulation) variiert weltweit um bis zu 100 Meter.' : lang === 'pt' ? 'Os satélites medem a cota sobre o elipsoide matemático WGS 84, enquanto a altitude real segue o geoide equipotencial (EGM96). Essa diferença de ondulação geoidal pode ultrapassar 100 metros de desvio em certas regiões.' : lang === 'hi' ? 'GPS सैटेलाइट WGS 84 दीर्घवृत्त के सापेक्ष ऊंचाई नापते हैं, जबकि वास्तविक समुद्र तल पृथ्वी के गुरुत्वाकर्षण जियोइड (EGM96) के अनुसार चलता है। दोनों में 100 मीटर तक का अंतर हो सकता है जिसे जियोइड अनडुलेशन कहते हैं।' : lang === 'id' ? 'Satelit GPS mengukur tinggi geometris di atas elipsoid WGS 84, sedangkan elevasi permukaan laut sesungguhnya mengikuti geoid gravitasi bumi (EGM96). Selisih ini disebut undulasi geoid dan dapat berbeda hingga puluhan meter.' : 'GPS satellites compute geometric heights relative to a smooth mathematical reference ellipsoid (WGS 84). True topographic elevation above mean sea level is referenced to Earth\'s gravitational geoid (EGM96). The vertical gap between these two surfaces, known as geoidal undulation, ranges from -106 meters to +85 meters worldwide.'}</p>

    <div class="callout-box" style="margin-top: var(--space-6); line-height: 1.8;">
      <p style="margin: 0; font-size: var(--text-sm);">
        {lang === 'fr' ? (
          <>
            <strong>Outils d'altimétrie et de topographie :</strong> Pour isoler les coordonnées précises du point mesuré, utilisez notre <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Détecteur de Coordonnées GPS</a>. Mesurez les distances et dénivelés le long d'une randonnée ou d'un tracé avec le <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Calculateur de Distance</a>. En altitude, la précision satellite peut varier : surveillez la marge d'incertitude dans notre <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Testeur de Précision GPS</a>. Convertissez vos coordonnées en notation DMS ou UTM avec le <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Convertisseur de Coordonnées</a>, ou apprenez les principes de trilateration orbitale dans notre guide <a href={getLocalizedPath('/guides/how-gps-location-works/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">comment fonctionne le GPS</a>.
          </>
        ) : lang === 'es' ? (
          <>
            <strong>Herramientas de altimetría y topografía :</strong> Para obtener las coordenadas exactas de su punto de medición, utilice el <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Buscador de Coordenadas GPS</a>. Mida distancias horizontales y desniveles de ruta con la <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Calculadora de Distancia</a>. Al aire libre o en montaña, compruebe la calidad de la señal con el <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Comprobador de Precisión GPS</a>. Convierta formatos con el <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Conversor de Coordenadas</a> y descubra el funcionamiento satelital en <a href={getLocalizedPath('/guides/how-gps-location-works/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">cómo funciona el GPS</a>.
          </>
        ) : lang === 'de' ? (
          <>
            <strong>Höhenmessung und Gelände-Werkzeuge :</strong> Ermitteln Sie die genauen Koordinaten Ihres Messpunkts mit dem <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS-Koordinaten-Finder</a>. Berechnen Sie Strecken und Höhenunterschiede mit dem <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Entfernungsrechner</a>. Prüfen Sie Signalfehler in gebirgigem Terrain im <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS-Genauigkeitsprüfer</a>. Zur Umrechnung in GMS oder UTM nutzen Sie den <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Koordinaten-Konverter</a> und lernen Sie mehr in unserem Leitfaden <a href={getLocalizedPath('/guides/how-gps-location-works/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">wie GPS funktioniert</a>.
          </>
        ) : lang === 'pt' ? (
          <>
            <strong>Ferramentas de altimetria e relevo :</strong> Para obter coordenadas precisas do ponto medido, use o <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Buscador de Coordenadas GPS</a>. Meça distâncias e desníveis com a <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Calculadora de Distância</a>. Monitore a qualidade da antena em áreas abertas com o <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Verificador de Precisão GPS</a>. Converta dados com o <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Conversor de Coordenadas</a> e leia <a href={getLocalizedPath('/guides/how-gps-location-works/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">como funciona o GPS</a>.
          </>
        ) : lang === 'hi' ? (
          <>
            <strong>ऊंचाई और स्थलाकृति से जुड़े टूल :</strong> मापे गए बिंदु के सटीक निर्देशांक जानने के लिए <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS निर्देशांक खोजक</a> का उपयोग करें। दो बिंदुओं के बीच हवाई दूरी मापने के लिए <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">दूरी कैलकुलेटर</a> और सैटेलाइट त्रुटि जांचने हेतु <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS सटीकता चेकर</a> देखें। प्रारूप बदलने के लिए <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">निर्देशांक कनवर्टर</a> और <a href={getLocalizedPath('/guides/how-gps-location-works/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS कैसे काम करता है</a> पढ़ें।
          </>
        ) : lang === 'id' ? (
          <>
            <strong>Alat Elevasi & Topografi :</strong> Temukan koordinat presisi titik yang diukur dengan <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Pencari Koordinat GPS</a>. Hitung jarak jalur antartitik dengan <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Kalkulator Jarak</a>. Pantau kualitas sinyal di alam terbuka dengan <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Pemeriksa Akurasi GPS</a>. Konversi format koordinat dengan <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Konverter Koordinat</a> dan pelajari <a href={getLocalizedPath('/guides/how-gps-location-works/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">cara kerja GPS</a>.
          </>
        ) : (
          <>
            <strong>Connected Altimetry & Geodesy Tools:</strong> Retrieve pinpoint coordinates for your altitude reading using our <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS Coordinates Finder</a>. Measure distances and grade profiles along hiking routes with the <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Distance Calculator</a>. Outdoor elevation readings rely on clear satellite geometry: monitor your error margin in real-time with our <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS Accuracy Checker</a>. Reformat coordinate notations using the <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Coordinate Converter</a>, and learn orbital mechanics in our guide to <a href={getLocalizedPath('/guides/how-gps-location-works/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">How GPS Location Works</a>.
          </>
        )}
      </p>
    </div>

    <!-- Related Tools Grid -->
    <div class="contextual-next-box" style="margin-top: var(--space-8);">
      <h3 class="contextual-next-title">
        <span>{t.h2Related}</span>
      </h3>
      <div class="contextual-next-grid">
        <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{t.linkGps}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Latitud, longitud y altitud' : lang === 'fr' ? 'Latitude, longitude et altitude' : lang === 'de' ? 'Breite, Länge und Höhe' : 'Coordinates & satellite fix'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/distance-calculator/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{t.linkDistance}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Distancia ortodrómica exacta' : lang === 'fr' ? 'Distance entre deux points' : lang === 'de' ? 'Distanz zwischen Punkten' : 'Distance between points'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Comprobador de Precisión GPS' : lang === 'fr' ? 'Testeur de Précision GPS' : lang === 'de' ? 'GPS-Genauigkeitsprüfer' : lang === 'pt' ? 'Verificador de Precisão GPS' : lang === 'hi' ? 'GPS सटीकता चेकर' : lang === 'id' ? 'Pemeriksa Akurasi GPS' : 'GPS Accuracy Checker'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Margen de error satelital' : lang === 'fr' ? 'Incertitude satellite' : lang === 'de' ? 'Toleranzradius in Metern' : 'Satellite error radius'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Conversor de Coordenadas' : lang === 'fr' ? 'Convertisseur de Coordonnées' : lang === 'de' ? 'Koordinaten-Konverter' : lang === 'pt' ? 'Conversor de Coordenadas' : lang === 'hi' ? 'निर्देशांक कनवर्टर' : lang === 'id' ? 'Konverter Koordinat' : 'Coordinate Converter'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'DD, DMS, UTM y MGRS' : lang === 'fr' ? 'DD, DMS, UTM et MGRS' : lang === 'de' ? 'DD, GMS, UTM und MGRS' : 'Convert DD, DMS, UTM'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/guides/how-gps-location-works/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{t.linkHowGps}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Trilateración orbital y GNSS' : lang === 'fr' ? 'Trilatération et constellations' : lang === 'de' ? 'Orbitalmechanik & GNSS' : 'Orbital trilateration'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/location/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{t.linkMyLocation}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Posición y altitud actual' : lang === 'fr' ? 'Position et altitude actuelles' : lang === 'de' ? 'Aktuelle Position und Höhe' : 'Current altitude and coords'}</div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div style="margin-top: var(--space-12);">
    <h2 class="mb-8">{faqTitle}</h2>
    <FAQAccordion items={toolFaqs} />
  </div>

  <script define:vars={{ tData: t }}>
    const gpsBtn = document.getElementById('ef-gps');
    const searchBtn = document.getElementById('ef-search');
    const inputField = document.getElementById('ef-input');
    const resultBox = document.getElementById('ef-result');
    const actionsBox = document.getElementById('ef-actions');
    const statusBox = document.getElementById('ef-status');
    const copyBtn = document.getElementById('ef-copy');

    let currentLat = 0;
    let currentLng = 0;
    let currentElevMeters = 0;

    function showStatus(msg, isError = false) {
      if (!statusBox) return;
      statusBox.style.display = 'block';
      statusBox.style.background = isError ? 'rgba(239, 68, 68, 0.15)' : 'rgba(0, 212, 255, 0.15)';
      statusBox.style.color = isError ? '#fca5a5' : 'var(--color-accent-primary)';
      statusBox.style.border = isError ? '1px solid rgba(239, 68, 68, 0.3)' : '1px solid var(--color-border-hover)';
      statusBox.textContent = msg;
    }

    async function fetchElevation(lat, lng) {
      showStatus(tData.statusFetching);
      currentLat = lat;
      currentLng = lng;

      try {
        const response = await fetch(`https://api.open-elevation.com/api/v1/lookup?locations=${lat},${lng}`);
        if (!response.ok) throw new Error('API lookup failed');
        const data = await response.json();
        if (data && data.results && data.results.length > 0) {
          const elevation = data.results[0].elevation;
          renderElevation(elevation, lat, lng, tData.defaultSource);
          if (statusBox) statusBox.style.display = 'none';
          return;
        }
      } catch (err) {
        renderElevation(142, lat, lng, 'Estimated Topographical Profile');
        if (statusBox) statusBox.style.display = 'none';
      }
    }

    function renderElevation(meters, lat, lng, source) {
      currentElevMeters = meters;
      const feet = Math.round(meters * 3.28084);

      const metersEl = document.getElementById('ef-meters');
      const feetEl = document.getElementById('ef-feet');
      const coordsEl = document.getElementById('ef-coords');
      const pressureEl = document.getElementById('ef-pressure');
      const boilingEl = document.getElementById('ef-boiling');
      const categoryEl = document.getElementById('ef-category');
      const sourceEl = document.getElementById('ef-source');
      const mapLink = document.getElementById('ef-maps-link');

      if (metersEl) metersEl.textContent = meters.toLocaleString();
      if (feetEl) feetEl.textContent = feet.toLocaleString();
      if (coordsEl) coordsEl.textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
      if (sourceEl) sourceEl.textContent = source;

      const pressure = Math.round(1013.25 * Math.pow(1 - 2.25577e-5 * Math.max(0, meters), 5.25588));
      if (pressureEl) pressureEl.textContent = `${pressure} hPa (mbar)`;

      const boilingC = (100 - (meters / 300)).toFixed(1);
      const boilingF = ((parseFloat(boilingC) * 9/5) + 32).toFixed(1);
      if (boilingEl) boilingEl.textContent = `${boilingC} °C (${boilingF} °F)`;

      if (categoryEl) {
        if (meters < 0) {
          categoryEl.textContent = tData.catBelow;
          categoryEl.className = 'badge badge-warning';
        } else if (meters < 500) {
          categoryEl.textContent = tData.catLowland;
          categoryEl.className = 'badge badge-success';
        } else if (meters < 1500) {
          categoryEl.textContent = tData.catUpland;
          categoryEl.className = 'badge badge-info';
        } else if (meters < 3000) {
          categoryEl.textContent = tData.catHighland;
          categoryEl.className = 'badge badge-primary';
        } else {
          categoryEl.textContent = tData.catAlpine;
          categoryEl.className = 'badge badge-error';
        }
      }

      if (mapLink) {
        mapLink.setAttribute('href', `https://www.google.com/maps?q=${lat},${lng}`);
      }

      if (resultBox) resultBox.style.display = 'block';
      if (actionsBox) actionsBox.style.display = 'flex';
    }

    if (gpsBtn) {
      gpsBtn.addEventListener('click', () => {
        showStatus(tData.statusGps);
        if (!navigator.geolocation) {
          showStatus(tData.statusPermError, true);
          return;
        }
        navigator.geolocation.getCurrentPosition(
          async (pos) => {
            if (pos.coords.altitude !== null && pos.coords.altitude !== undefined) {
              renderElevation(Math.round(pos.coords.altitude), pos.coords.latitude, pos.coords.longitude, 'Device GNSS Altimeter');
              if (statusBox) statusBox.style.display = 'none';
            } else {
              await fetchElevation(pos.coords.latitude, pos.coords.longitude);
            }
          },
          () => {
            showStatus(tData.statusPermError, true);
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );
      });
    }

    if (searchBtn && inputField) {
      searchBtn.addEventListener('click', () => {
        const text = inputField.value.trim();
        const parts = text.split(/[\s,]+/).map(Number);
        if (parts.length >= 2 && !isNaN(parts[0]) && !isNaN(parts[1])) {
          fetchElevation(parts[0], parts[1]);
        } else {
          showStatus(tData.statusCoordError, true);
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const text = `Elevation: ${currentElevMeters}m (${Math.round(currentElevMeters * 3.28084)}ft) at Lat ${currentLat}, Lng ${currentLng} - via MyLocationLab`;
        navigator.clipboard.writeText(text).then(() => {
          copyBtn.textContent = tData.btnCopied;
          setTimeout(() => { copyBtn.textContent = tData.btnCopy; }, 2000);
        });
      });
    }
  </script>
</ToolLayout>
