---

<ToolLayout
  toolId="location-qr-code"
  title={t.title}
  description={t.description}
  h1={t.h1}
  subtitle={t.subtitle}
  lang={lang}
>
  <div class="tool-interface">
    <div class="grid grid-2" style="gap: var(--space-8); align-items: start;">
      <div>
        <div style="margin-bottom: var(--space-4);">
          <label style="display: block; font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-2);">{t.locSource}</label>
          <div class="flex gap-2">
            <button class="btn btn-primary btn-sm" id="qr-gps-btn" type="button">{t.btnUseGps}</button>
            <button class="btn btn-secondary btn-sm" id="qr-manual-btn" type="button">{t.btnManual}</button>
          </div>
        </div>

        <div class="input-group" style="margin-bottom: var(--space-4);">
          <input type="text" class="input" id="qr-lat" placeholder={t.placeholderLat} value="40.7128" />
          <input type="text" class="input" id="qr-lng" placeholder={t.placeholderLng} value="-74.0060" />
        </div>

        <div style="margin-bottom: var(--space-4);">
          <label style="display: block; font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-2);">{t.labelTargetType}</label>
          <select class="input" id="qr-type" style="cursor: pointer;">
            <option value="google">{t.optGoogle}</option>
            <option value="apple">{t.optApple}</option>
            <option value="geo">{t.optGeo}</option>
            <option value="osm">{t.optOsm}</option>
          </select>
        </div>

        <button class="btn btn-primary" id="qr-generate-btn" type="button" style="width: 100%;">
          {t.btnGenerate}
        </button>
      </div>

      <!-- QR Code Preview Card -->
      <div class="card card-flat" style="text-align: center; padding: var(--space-6);">
        <div id="qr-container" style="background: white; padding: var(--space-4); border-radius: var(--radius-lg); display: inline-block; box-shadow: 0 4px 20px rgba(0,0,0,0.4); margin-bottom: var(--space-4);">
          <img
            id="qr-image"
            alt="Location QR Code"
            width="220"
            height="220"
            style="display: block; width: 220px; height: 220px; aspect-ratio: 1/1;"
          />
        </div>

        <div style="font-size: var(--text-xs); color: var(--color-text-secondary); word-break: break-all; margin-bottom: var(--space-4);" id="qr-encoded-url">
          https://maps.google.com/?q=40.7128,-74.0060
        </div>

        <div class="flex gap-2 justify-center flex-wrap">
          <a class="btn btn-secondary btn-sm" id="qr-download-btn" download="location-qr.png">
            {t.btnDownload}
          </a>
          <button class="btn btn-ghost btn-sm" id="qr-copy-url-btn" type="button">
            {t.btnCopyLink}
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="prose" style="margin-top: var(--space-12); line-height: 1.8;">
    <h2>{t.h2How}</h2>
    <p>{t.pHow}</p>

    <h3>{t.h3Choosing}</h3>
    <ul>
      <li set:html={t.liGoogle}></li>
      <li set:html={t.liApple}></li>
      <li set:html={t.liGeo}></li>
      <li set:html={t.liOsm}></li>
    </ul>

    <h2>{t.h2Cases}</h2>
    <ul>
      <li set:html={t.liCase1}></li>
      <li set:html={t.liCase2}></li>
      <li set:html={t.liCase3}></li>
    </ul>

    <h2>{t.h2Scan}</h2>
    <p>{t.pScan}</p>
    <ul>
      <li>{t.liScan1}</li>
      <li>{t.liScan2}</li>
      <li>{t.liScan3}</li>
    </ul>

    <h2>{t.h2Print}</h2>
    <p>{t.pPrint}</p>

    {t.faqItems && t.faqItems.length > 0 && (
      <div style="margin-top: var(--space-8);">
        <h2>FAQ</h2>
        <FAQAccordion items={t.faqItems} />
      </div>
    )}

    <h2>{t.h2Related}</h2>
    <ul>
      <li><a href={getLocalizedPath('/share-location/', lang)}>{t.linkShare}</a></li>
      <li><a href={getLocalizedPath('/tools/gps-coordinates/', lang)}>{t.linkGps}</a></li>
      <li><a href={getLocalizedPath('/tools/coordinate-converter/', lang)}>{t.linkConverter}</a></li>
    </ul>
  </div>

  <script>
    import QRCode from 'qrcode';

    const latInput = document.getElementById('qr-lat') as HTMLInputElement;
    const lngInput = document.getElementById('qr-lng') as HTMLInputElement;
    const typeSelect = document.getElementById('qr-type') as HTMLSelectElement;
    const generateBtn = document.getElementById('qr-generate-btn');
    const gpsBtn = document.getElementById('qr-gps-btn');
    const qrImg = document.getElementById('qr-image') as HTMLImageElement;
    const encodedUrlEl = document.getElementById('qr-encoded-url');
    const downloadBtn = document.getElementById('qr-download-btn') as HTMLAnchorElement;
    const copyUrlBtn = document.getElementById('qr-copy-url-btn');

    function buildTargetUrl(lat: number, lng: number): string {
      const type = typeSelect ? typeSelect.value : 'google';
      if (type === 'apple') return `https://maps.apple.com/?ll=${lat},${lng}&q=Pin`;
      if (type === 'geo') return `geo:${lat},${lng}`;
      if (type === 'osm') return `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=16/${lat}/${lng}`;
      return `https://maps.google.com/?q=${lat},${lng}`;
    }

    async function updateQR() {
      const lat = parseFloat(latInput?.value ?? '') || 0;
      const lng = parseFloat(lngInput?.value ?? '') || 0;
      const targetUrl = buildTargetUrl(lat, lng);

      if (encodedUrlEl) encodedUrlEl.textContent = targetUrl;

      try {
        const previewUrl = await QRCode.toDataURL(targetUrl, { width: 220, margin: 1, color: { dark: '#0f172a', light: '#ffffff' } });
        if (qrImg) qrImg.src = previewUrl;
        const downloadUrl = await QRCode.toDataURL(targetUrl, { width: 600, margin: 2, color: { dark: '#0f172a', light: '#ffffff' } });
        if (downloadBtn) downloadBtn.href = downloadUrl;
      } catch {
        if (qrImg) qrImg.removeAttribute('src');
      }
    }

    if (generateBtn) generateBtn.addEventListener('click', updateQR);
    if (typeSelect) typeSelect.addEventListener('change', updateQR);

    if (gpsBtn) {
      gpsBtn.addEventListener('click', () => {
        if (!navigator.geolocation) {
          alert('Geolocation is not supported by your browser.');
          return;
        }
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            if (latInput) latInput.value = pos.coords.latitude.toFixed(6);
            if (lngInput) lngInput.value = pos.coords.longitude.toFixed(6);
            updateQR();
          },
          (err) => {
            alert('Could not acquire location: ' + err.message);
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );
      });
    }

    if (copyUrlBtn) {
      copyUrlBtn.addEventListener('click', () => {
        const text = encodedUrlEl ? encodedUrlEl.textContent || '' : '';
        navigator.clipboard.writeText(text).then(() => {
          const orig = copyUrlBtn.textContent;
          copyUrlBtn.textContent = '✅ Copied!';
          setTimeout(() => { copyUrlBtn.textContent = orig; }, 2000);
        });
      });
    }

    updateQR();
  </script>
</ToolLayout>
