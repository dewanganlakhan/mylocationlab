    btnDownload: "💾 Скачать PNG",
    btnCopyLink: "📋 Скопировать ссылку",
    btnCopied: "✅ Скопировано!",
    statusAcquiring: "Поиск спутников GPS...",
    statusUpdated: "📍 Координаты обновлены",
    h2How: "Как работает QR-код локации",
    pHow: "QR-код кодирует координаты широты и долготы в матричный штрихкод, распознаваемый камерой любого современного смартфона.",
    h3Choosing: "Выбор формата ссылки",
    liGoogle: "<strong>Google Maps:</strong> Самый надежный кроссплатформенный вариант для Android и iOS.",
    liApple: "<strong>Apple Maps:</strong> Открывает встроенные карты Apple на устройствах с iOS и macOS.",
    liGeo: "<strong>Geo URI (RFC 5870):</strong> Открытый стандарт IETF, вызывающий системное навигационное приложение.",
    liOsm: "<strong>OpenStreetMap:</strong> Конфиденциальная ссылка на открытые карты.",
    h2Cases: "Примеры использования",
    liCase1: "<strong>Приглашения на мероприятия:</strong> Навигация гостей точно до парковки или входа в банкетный зал.",
    liCase2: "<strong>Таблички на недвижимости:</strong> Быстрый просмотр границ участка потенциальными покупателями.",
    liCase3: "<strong>Туристические маршруты:</strong> Обозначение контрольных точек для безопасности в горах.",
    h2Related: "Связанные инструменты",
    linkShare: "Поделиться локацией",
    linkGps: "Координаты GPS",
    linkConverter: "Конвертер координат",
    h2Scan: "Как отсканировать QR-код",
    pScan: "Специальные приложения не требуются: откройте стандартную камеру телефона и наведите ее на код.",
    liScan1: "Наведите камеру смартфона на QR-код",
    liScan2: "Нажмите на всплывающее уведомление",
    liScan3: "Выберите приложение навигатора",
    h2Print: "Рекомендации по печати",
    pPrint: "Печатайте темным цветом на светлом фоне размером не менее 3х3 см с чистыми полями по краям."
  }
};

const t = translations[lang] || translations.en;
---

<ToolLayout
  toolId="location-qr-code"
  title={t.title}
  description={t.description}
  h1={t.h1}
  subtitle={t.subtitle}
  lang={lang}
>
  <div class="tool-interface">
    <div class="grid grid-2" style="gap: var(--space-8); align-items: start;">
      <div>
        <div style="margin-bottom: var(--space-4);">
          <label style="display: block; font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-2);">{t.locSource}</label>
          <div class="flex gap-2">
            <button class="btn btn-primary btn-sm" id="qr-gps-btn" type="button">{t.btnUseGps}</button>
            <button class="btn btn-secondary btn-sm" id="qr-manual-btn" type="button">{t.btnManual}</button>
          </div>
        </div>

        <div class="input-group" style="margin-bottom: var(--space-4);">
          <input type="text" class="input" id="qr-lat" placeholder={t.placeholderLat} value="40.7128" />
          <input type="text" class="input" id="qr-lng" placeholder={t.placeholderLng} value="-74.0060" />
        </div>

        <div style="margin-bottom: var(--space-4);">
          <label style="display: block; font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-2);">{t.labelTargetType}</label>
          <select class="input" id="qr-type" style="cursor: pointer;">
            <option value="google">{t.optGoogle}</option>
            <option value="apple">{t.optApple}</option>
            <option value="geo">{t.optGeo}</option>
            <option value="osm">{t.optOsm}</option>
          </select>
        </div>

        <button class="btn btn-primary" id="qr-generate-btn" type="button" style="width: 100%;">
          {t.btnGenerate}
        </button>
      </div>

      <!-- QR Code Preview Card -->
      <div class="card card-flat" style="text-align: center; padding: var(--space-6);">
        <div id="qr-container" style="background: white; padding: var(--space-4); border-radius: var(--radius-lg); display: inline-block; box-shadow: 0 4px 20px rgba(0,0,0,0.4); margin-bottom: var(--space-4);">
          <img
            id="qr-image"
            alt="Location QR Code"
            width="220"
            height="220"
            style="display: block; width: 220px; height: 220px; aspect-ratio: 1/1;"
          />
        </div>

        <div style="font-size: var(--text-xs); color: var(--color-text-secondary); word-break: break-all; margin-bottom: var(--space-4);" id="qr-encoded-url">
          https://maps.google.com/?q=40.7128,-74.0060
        </div>

        <div class="flex gap-2 justify-center flex-wrap">
          <a class="btn btn-secondary btn-sm" id="qr-download-btn" download="location-qr.png">
            {t.btnDownload}
          </a>
          <button class="btn btn-ghost btn-sm" id="qr-copy-url-btn" type="button">
            {t.btnCopyLink}
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="prose" style="margin-top: var(--space-12); line-height: 1.8;">
    <h2>{t.h2How}</h2>
    <p>{t.pHow}</p>

    <h3>{t.h3Choosing}</h3>
    <ul>
      <li set:html={t.liGoogle}></li>
      <li set:html={t.liApple}></li>
      <li set:html={t.liGeo}></li>
      <li set:html={t.liOsm}></li>
    </ul>

    <h2>{t.h2Cases}</h2>
    <ul>
      <li set:html={t.liCase1}></li>
      <li set:html={t.liCase2}></li>
      <li set:html={t.liCase3}></li>
    </ul>

    <h2>{t.h2Scan}</h2>
    <p>{t.pScan}</p>
    <ul>
      <li>{t.liScan1}</li>
      <li>{t.liScan2}</li>
      <li>{t.liScan3}</li>
    </ul>

    <h2>{t.h2Print}</h2>
    <p>{t.pPrint}</p>

    <h2>{lang === 'es' ? 'Casos de Uso Óptimos y Comparativa Geo URI vs URLs Web' : lang === 'fr' ? 'Usages Optimaux et Comparatif Geo URI vs URLs Web' : lang === 'de' ? 'Einsatzbereiche & Geo-URI vs. Web-URLs' : lang === 'pt' ? 'Casos de Uso e Comparativo Geo URI vs URLs Web' : lang === 'hi' ? 'उपयोग के क्षेत्र और Geo URI बनाम वेब लिंक' : lang === 'id' ? 'Penggunaan Optimal & Perbandingan Geo URI vs URL Web' : 'Optimal Applications & Geo URI vs. Web URLs'}</h2>
    <p>{lang === 'es' ? 'Los códigos QR de ubicación facilitan el acceso en invitaciones de eventos, carteles inmobiliarios, folletos turísticos e itinerarios de senderismo. La codificación en Geo URI (RFC 5870) permite que aplicaciones cartográficas sin conexión naveguen directamente sin consumir datos móviles.' : lang === 'fr' ? 'Les QR codes de géolocalisation facilitent l\'orientation sur les invitations événementielles, panneaux immobiliers et topo-guides de randonnée. Le protocole ouvert Geo URI (RFC 5870) permet aux applications GPS autonomes d\'ouvrir le repère sans connexion.' : lang === 'de' ? 'Standort-QR-Codes bieten schnellen Zugang auf Einladungen, Flyern und Beschilderungen. Das offene Geo-URI-Format (RFC 5870) ermöglicht Navigations-Apps die Offline-Routenführung ohne mobile Daten.' : lang === 'pt' ? 'QR Codes de geolocalização simplificam o acesso em convites de eventos, placas imobiliárias e guias de trilha. O protocolo Geo URI (RFC 5870) permite que apps de GPS operem em modo offline sem consumir franquia de internet.' : lang === 'hi' ? 'लोकेशन QR कोड शादी के कार्ड, संपत्ति बोर्ड और पर्यटन गाइड में तुरंत नेविगेशन की सुविधा देते हैं। खुला Geo URI मानक बिना इंटरनेट के भी ऑफ़लाइन मैप में रास्ता दिखाता है।' : lang === 'id' ? 'QR Code lokasi mempercepat navigasi pada undangan acara, papan properti, dan brosur wisata alam. Protokol terbuka Geo URI (RFC 5870) memungkinkan aplikasi peta offline membuka titik tanpa kuota internet.' : 'Location QR codes streamline navigation for wedding invitations, real estate signage, trailhead markers, and emergency rendezvous points. Using the open Geo URI standard (RFC 5870) ensures that devices with offline vector maps can navigate directly without cellular connectivity.'}</p>

    <div style="margin-top: var(--space-8);">
      <h2>{faqTitle}</h2>
      <FAQAccordion items={toolFaqs} lang={lang} />
    </div>

    <div class="callout-box" style="margin-top: var(--space-6); line-height: 1.8;">
      <p style="margin: 0; font-size: var(--text-sm);">
        {lang === 'fr' ? (
          <>
            <strong>Partage et géolocalisation connectés :</strong> Pour partager un lien en direct avec vos contacts sans générer de QR code à imprimer, utilisez notre interface de <a href={getLocalizedPath('/share-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Partage de Localisation</a>. Pour extraire les coordonnées précises de votre point, rendez-vous sur le <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Détecteur de Coordonnées GPS</a> ou vérifiez l'adresse correspondante sur <a href={getLocalizedPath('/address/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Mon Adresse Actuelle</a>. Vous pouvez également convertir vos coordonnées en format UTM ou DMS avec le <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Convertisseur de Coordonnées</a> ou calculer la distance d'accès avec le <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Calculateur de Distance</a>.
          </>
        ) : lang === 'es' ? (
          <>
            <strong>Compartir y herramientas conectadas :</strong> Para compartir un enlace directo por WhatsApp o mensaje sin imprimir códigos QR, utilice nuestra herramienta <a href={getLocalizedPath('/share-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Compartir Ubicación</a>. Extraiga las coordenadas exactas de su posición en el <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Buscador de Coordenadas GPS</a> o revise la dirección oficial en <a href={getLocalizedPath('/address/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Mi Dirección Actual</a>. Reformatée coordenadas con el <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Conversor de Coordenadas</a> y mida trayectos con la <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Calculadora de Distancia</a>.
          </>
        ) : lang === 'de' ? (
          <>
            <strong>Standortweitergabe und verbundene Tools :</strong> Wenn Sie einen direkten Link per Messenger teilen möchten, statt einen QR-Code zu drucken, nutzen Sie <a href={getLocalizedPath('/share-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Standort Teilen</a>. Prüfen Sie genaue Satellitendaten im <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS-Koordinaten-Finder</a> oder ermitteln Sie die Postanschrift auf <a href={getLocalizedPath('/address/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Meine Aktuelle Adresse</a>. Für andere Datenformate steht der <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Koordinaten-Konverter</a> bereit und für Entfernungen der <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Entfernungsrechner</a>.
          </>
        ) : lang === 'pt' ? (
          <>
            <strong>Compartilhamento e ferramentas conectadas :</strong> Para enviar um link direto sem precisar imprimir códigos QR, use nossa ferramenta <a href={getLocalizedPath('/share-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Compartilhar Localização</a>. Obtenha as coordenadas do ponto no <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Buscador de Coordenadas GPS</a> ou veja o endereço em <a href={getLocalizedPath('/address/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Meu Endereço Atual</a>. Converta formatos no <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Conversor de Coordenadas</a> e calcule distâncias com a <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Calculadora de Distância</a>.
          </>
        ) : lang === 'hi' ? (
          <>
            <strong>लोकेशन शेयरिंग और संबंधित टूल :</strong> बिना QR कोड प्रिंट किए सीधा लिंक भेजने के लिए हमारे <a href={getLocalizedPath('/share-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">लोकेशन शेयर</a> टूल का उपयोग करें। सटीक निर्देशांकों के लिए <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS निर्देशांक खोजक</a> और सड़क का पता जानने के लिए <a href={getLocalizedPath('/address/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">मेरा वर्तमान पता</a> देखें। प्रारूप बदलने के लिए <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">निर्देशांक कनवर्टर</a> और दूरी हेतु <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">दूरी कैलकुलेटर</a> उपलब्ध हैं।
          </>
        ) : lang === 'id' ? (
          <>
            <strong>Berbagi Lokasi & Alat Terkait :</strong> Untuk mengirimkan tautan langsung lewat obrolan tanpa mencetak QR code, gunakan alat <a href={getLocalizedPath('/share-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Bagikan Lokasi</a> kami. Dapatkan koordinat presisi di <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Pencari Koordinat GPS</a> atau periksa alamat jalan di <a href={getLocalizedPath('/address/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Alamat Saya Sekarang</a>. Konversi format koordinat dengan <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Konverter Koordinat</a> dan hitung rute perjalanan dengan <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Kalkulator Jarak</a>.
          </>
        ) : (
          <>
            <strong>Connected Sharing & Navigation Tools:</strong> To share a live map pin via WhatsApp, SMS, or link without generating a printable barcode, use our direct <a href={getLocalizedPath('/share-location/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Share Location</a> utility. Retrieve pinpoint coordinates in our <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">GPS Coordinates Finder</a> or verify the physical street address at <a href={getLocalizedPath('/address/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">What Is My Current Address?</a>. Reformat coordinate pairs with our <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Coordinate Converter</a>, or calculate driving distances with the <a href={getLocalizedPath('/tools/distance-calculator/', lang)} style="color: var(--color-accent-primary); font-weight: 600;">Distance Calculator</a>.
          </>
        )}
      </p>
    </div>

    <!-- Related Tools Grid -->
    <div class="contextual-next-box" style="margin-top: var(--space-8);">
      <h3 class="contextual-next-title">
        <span>{t.h2Related}</span>
      </h3>
      <div class="contextual-next-grid">
        <a href={getLocalizedPath('/share-location/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{t.linkShare}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Compartir enlace directo en vivo' : lang === 'fr' ? 'Partage de lien en direct' : lang === 'de' ? 'Direkter Live-Link' : 'Direct live sharing link'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{t.linkGps}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Latitud y longitud satelital' : lang === 'fr' ? 'Coordonnées par satellite' : lang === 'de' ? 'Genaue GPS-Koordinaten' : 'Exact GPS coordinates'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/address-finder/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Buscador de Dirección' : lang === 'fr' ? "Localisateur d'Adresse" : lang === 'de' ? 'Adressen-Finder' : lang === 'pt' ? 'Localizador de Endereço' : lang === 'hi' ? 'सड़क पता खोजक' : lang === 'id' ? 'Pencari Alamat' : 'Street Address Finder'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Dirección para el código QR' : lang === 'fr' ? 'Adresse pour le QR code' : lang === 'de' ? 'Adresse für den QR-Code' : 'Address for QR pin'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/address/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Mi Dirección Actual' : lang === 'fr' ? 'Mon Adresse Actuelle' : lang === 'de' ? 'Meine Aktuelle Adresse' : lang === 'pt' ? 'Meu Endereço Atual' : lang === 'hi' ? 'मेरा वर्तमान पता' : lang === 'id' ? 'Alamat Saya Sekarang' : 'What Is My Current Address?'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Dirección física de mi casa' : lang === 'fr' ? 'Adresse physique détectée' : lang === 'de' ? 'Standortadresse des Geräts' : 'Physical device address'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{t.linkConverter}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'DD, DMS, UTM y MGRS' : lang === 'fr' ? 'DD, DMS, UTM et MGRS' : lang === 'de' ? 'DD, GMS, UTM und MGRS' : 'Convert DD, DMS, UTM'}</div>
          </div>
        </a>
        <a href={getLocalizedPath('/tools/distance-calculator/', lang)} class="contextual-link-card">
          <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          <div class="contextual-link-info">
            <div class="contextual-link-title">{lang === 'es' ? 'Calculadora de Distancia' : lang === 'fr' ? 'Calculateur de Distance' : lang === 'de' ? 'Entfernungsrechner' : lang === 'pt' ? 'Calculadora de Distância' : lang === 'hi' ? 'दूरी कैलकुलेटर' : lang === 'id' ? 'Kalkulator Jarak' : 'Distance Calculator'}</div>
            <div class="contextual-link-sub">{lang === 'es' ? 'Distancia hasta este punto QR' : lang === 'fr' ? 'Distance vers ce point QR' : lang === 'de' ? 'Distanz zu diesem QR-Punkt' : 'Distance to this QR pin'}</div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <script>
    import QRCode from 'qrcode';

    const latInput = document.getElementById('qr-lat') as HTMLInputElement;
    const lngInput = document.getElementById('qr-lng') as HTMLInputElement;
    const typeSelect = document.getElementById('qr-type') as HTMLSelectElement;
    const generateBtn = document.getElementById('qr-generate-btn');
    const gpsBtn = document.getElementById('qr-gps-btn');
    const qrImg = document.getElementById('qr-image') as HTMLImageElement;
    const encodedUrlEl = document.getElementById('qr-encoded-url');
    const downloadBtn = document.getElementById('qr-download-btn') as HTMLAnchorElement;
    const copyUrlBtn = document.getElementById('qr-copy-url-btn');

    function buildTargetUrl(lat: number, lng: number): string {
      const type = typeSelect ? typeSelect.value : 'google';
      if (type === 'apple') return `https://maps.apple.com/?ll=${lat},${lng}&q=Pin`;
      if (type === 'geo') return `geo:${lat},${lng}`;
      if (type === 'osm') return `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=16/${lat}/${lng}`;
      return `https://maps.google.com/?q=${lat},${lng}`;
    }

    async function updateQR() {
      const lat = parseFloat(latInput?.value ?? '') || 0;
      const lng = parseFloat(lngInput?.value ?? '') || 0;
      const targetUrl = buildTargetUrl(lat, lng);

      if (encodedUrlEl) encodedUrlEl.textContent = targetUrl;

      try {
        const previewUrl = await QRCode.toDataURL(targetUrl, { width: 220, margin: 1, color: { dark: '#0f172a', light: '#ffffff' } });
        if (qrImg) qrImg.src = previewUrl;
        const downloadUrl = await QRCode.toDataURL(targetUrl, { width: 600, margin: 2, color: { dark: '#0f172a', light: '#ffffff' } });
        if (downloadBtn) downloadBtn.href = downloadUrl;
      } catch {
        if (qrImg) qrImg.removeAttribute('src');
      }
    }

    if (generateBtn) generateBtn.addEventListener('click', updateQR);
    if (typeSelect) typeSelect.addEventListener('change', updateQR);

    if (gpsBtn) {
      gpsBtn.addEventListener('click', () => {
        if (!navigator.geolocation) {
          alert('Geolocation is not supported by your browser.');
          return;
        }
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            if (latInput) latInput.value = pos.coords.latitude.toFixed(6);
            if (lngInput) lngInput.value = pos.coords.longitude.toFixed(6);
            updateQR();
          },
          (err) => {
            alert('Could not acquire location: ' + err.message);
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );
      });
    }

    if (copyUrlBtn) {
      copyUrlBtn.addEventListener('click', () => {
        const text = encodedUrlEl ? encodedUrlEl.textContent || '' : '';
        navigator.clipboard.writeText(text).then(() => {
          const orig = copyUrlBtn.textContent;
          copyUrlBtn.textContent = '✅ Copied!';
          setTimeout(() => { copyUrlBtn.textContent = orig; }, 2000);
        });
      });
    }

    updateQR();
  </script>
</ToolLayout>
