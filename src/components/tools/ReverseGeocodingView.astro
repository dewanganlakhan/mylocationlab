const t = translations[lang] || translations.en;
---

<ToolLayout toolId="reverse-geocoding" title={t.title} description={t.description} h1={t.h1} subtitle={t.subtitle} lang={lang}>
  <div class="tool-interface">
    <div class="grid grid-2" style="margin-bottom: var(--space-4);">
      <div><label class="label">{t.lblLat}</label><input type="number" step="any" class="input" id="rg-lat" placeholder="e.g. 28.6139" /></div>
      <div><label class="label">{t.lblLng}</label><input type="number" step="any" class="input" id="rg-lng" placeholder="e.g. 77.2090" /></div>
    </div>
    <div class="flex gap-3">
      <button class="btn btn-primary" id="rg-btn" type="button">{t.btnConvert}</button>
      <button class="btn btn-secondary" id="rg-gps" type="button">{t.btnGps}</button>
    </div>
    <div class="tool-result" id="rg-result" style="display: none; margin-top: var(--space-6);">
      <div class="tool-result-row"><span class="tool-result-label">{t.labelFull}</span><span class="tool-result-value" id="rg-addr" style="font-family: var(--font-sans); font-size: var(--text-sm);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.labelCity}</span><span class="tool-result-value" id="rg-city" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.labelState}</span><span class="tool-result-value" id="rg-state" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.labelCountry}</span><span class="tool-result-value" id="rg-country" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{t.labelPostcode}</span><span class="tool-result-value" id="rg-zip">—</span></div>
      <div style="margin-top: var(--space-4);"><button class="btn btn-secondary btn-sm" id="rg-copy" type="button">{t.btnCopy}</button></div>
    </div>
  </div>
  <div class="prose" style="margin-top: var(--space-12); line-height: 1.8;">
    <h2>{t.h2What}</h2>
    <p set:html={t.pWhat1}></p>
    <p set:html={t.pWhat2}></p>
    <h3>{t.h3Related}</h3>
    <ul>
      <li><a href={getLocalizedPath('/tools/geocoding/', lang)}>{t.linkGeo}</a></li>
      <li><a href={getLocalizedPath('/tools/address-finder/', lang)}>{t.linkAddr}</a></li>
      <li><a href={getLocalizedPath('/comparisons/geocoding-vs-reverse-geocoding/', lang)}>{t.linkComp}</a></li>
      <li><a href={getLocalizedPath('/glossary/', lang)}>{t.linkGlossary}</a></li>
    </ul>
  </div>

  <script define:vars={{ tData: t }}>
    async function reverseGeo() {
      const lat = parseFloat(document.getElementById('rg-lat').value);
      const lng = parseFloat(document.getElementById('rg-lng').value);
      if (isNaN(lat) || isNaN(lng) || Math.abs(lat) > 90 || Math.abs(lng) > 180) {
        alert(tData.alertInvalid);
        return;
      }
      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`, {
          headers: { 'User-Agent': 'MyLocationLab/1.0' }
        });
        if (!res.ok) throw new Error('Geocoding service unavailable');
        const data = await res.json();
        const addr = data.address || {};

        document.getElementById('rg-addr').textContent = data.display_name || '—';
        document.getElementById('rg-city').textContent = addr.city || addr.town || addr.village || '—';
        document.getElementById('rg-state').textContent = addr.state || '—';
        document.getElementById('rg-country').textContent = addr.country || '—';
        document.getElementById('rg-zip').textContent = addr.postcode || '—';
        document.getElementById('rg-result').style.display = 'block';
      } catch {
        alert(tData.alertUnable);
      }
    }

    document.getElementById('rg-btn')?.addEventListener('click', reverseGeo);

    document.getElementById('rg-copy')?.addEventListener('click', function () {
      const addr = document.getElementById('rg-addr').textContent.trim();
      if (addr && addr !== '—') {
        navigator.clipboard.writeText(addr).then(() => {
          const orig = this.textContent;
          this.textContent = '✓ Copied!';
          setTimeout(() => { this.textContent = orig; }, 2000);
        });
      }
    });

    document.getElementById('rg-gps')?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          document.getElementById('rg-lat').value = pos.coords.latitude.toFixed(6);
          document.getElementById('rg-lng').value = pos.coords.longitude.toFixed(6);
          reverseGeo();
        },
        (err) => {
          alert(err.message);
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    });
  </script>
</ToolLayout>
