const c = translations[lang] || translations.en;
---

<ToolLayout
  lang={lang}
  toolId="coordinate-converter"
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
>
  <div class="tool-interface">
    <label class="label">{c.labelInput}</label>
    <div class="input-group" style="margin-bottom: var(--space-4);">
      <input type="text" class="input" id="cc-input" placeholder={c.placeholder} />
      <button class="btn btn-primary" id="cc-btn" type="button">{c.btnConvert}</button>
    </div>
    <button class="btn btn-ghost btn-sm" id="cc-gps" type="button" style="margin-bottom: var(--space-4);">{c.btnGps}</button>
    <div class="tool-result" id="cc-result" style="display: none;">
      <div class="tool-result-row"><span class="tool-result-label">{c.lblDd}</span><span class="tool-result-value" id="cc-dd" style="color: var(--color-accent-primary);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{c.lblDmsLat}</span><span class="tool-result-value" id="cc-dms-lat">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{c.lblDmsLng}</span><span class="tool-result-value" id="cc-dms-lng">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{c.lblUtm}</span><span class="tool-result-value" id="cc-utm">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{c.lblGeohash}</span><span class="tool-result-value" id="cc-geohash">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">{c.lblPlusCode}</span><span class="tool-result-value" id="cc-pluscode">—</span></div>
    </div>
  </div>

  <div class="prose" style="margin-top: var(--space-12);">
    <h2>{c.h2Formats}</h2>
    <ul>
      <li>{c.fmt1}</li>
      <li>{c.fmt2}</li>
      <li>{c.fmt3}</li>
      <li>{c.fmt4}</li>
      <li>{c.fmt5}</li>
    </ul>
    <p>
      <a href={getLocalizedPath('/comparisons/decimal-degrees-vs-dms/', lang)}>{c.compLinkText} →</a>
    </p>
  </div>

  <script>
    import CoordUtils from '../../scripts/coordinates.js';
    import GeoLocation from '../../scripts/geolocation.js';

    function convert(lat: number, lng: number) {
      const dd = document.getElementById('cc-dd');
      const dmsLat = document.getElementById('cc-dms-lat');
      const dmsLng = document.getElementById('cc-dms-lng');
      const utm = document.getElementById('cc-utm');
      const geohash = document.getElementById('cc-geohash');
      const pluscode = document.getElementById('cc-pluscode');
      const res = document.getElementById('cc-result');

      if (dd) dd.textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
      if (dmsLat) dmsLat.textContent = CoordUtils.formatDMS(lat, true);
      if (dmsLng) dmsLng.textContent = CoordUtils.formatDMS(lng, false);
      try {
        if (utm) utm.textContent = CoordUtils.decimalToUTM(lat, lng).formatted;
      } catch {
        if (utm) utm.textContent = 'N/A';
      }
      if (geohash) geohash.textContent = CoordUtils.encodeGeohash(lat, lng);
      if (pluscode) pluscode.textContent = CoordUtils.encodePlusCode(lat, lng);
      if (res) res.style.display = 'block';
    }

    document.getElementById('cc-btn')?.addEventListener('click', () => {
      const inputEl = document.getElementById('cc-input') as HTMLInputElement;
      if (!inputEl) return;
      const parsed = CoordUtils.parseCoordinates(inputEl.value);
      if (parsed && CoordUtils.isValidCoordinate(parsed.lat, parsed.lng)) {
        convert(parsed.lat, parsed.lng);
      } else {
        alert('Please enter valid coordinates.');
      }
    });

    document.getElementById('cc-gps')?.addEventListener('click', async () => {
      try {
        const pos = await GeoLocation.getCurrentPosition();
        const inputEl = document.getElementById('cc-input') as HTMLInputElement;
        if (inputEl) {
          inputEl.value = `${pos.coords.latitude.toFixed(6)}, ${pos.coords.longitude.toFixed(6)}`;
        }
        convert(pos.coords.latitude, pos.coords.longitude);
      } catch (e: any) {
        alert(GeoLocation.getErrorMessage(e));
      }
    });
  </script>
</ToolLayout>
