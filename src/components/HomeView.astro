  <!-- Homepage Location Logic Script -->
  <script type="application/json" id="home-status" set:html={JSON.stringify(content.s)} />
  <script>
    import GeoLocation from '../scripts/geolocation.js';
    import Geocoding from '../scripts/geocoding.js';
    import Sharing from '../scripts/sharing.js';
    import CoordUtils from '../scripts/coordinates.js';
    import MapUtils from '../scripts/map.js';

    const locateTitles: Record<string, string> = {
      en: "Zoom to my current location",
      es: "Centrar y ampliar en mi ubicación",
      fr: "Zoomer sur ma position actuelle",
      de: "Auf meinen aktuellen Standort zoomen",
      pt: "Aproximar da minha localização atual"
    };
    const currentDocLang = document.documentElement.lang || 'en';
    const locateTitle = document.getElementById('map')?.getAttribute('data-locate-title') || locateTitles[currentDocLang] || locateTitles.en;

    const getBtn = document.getElementById('get-location-btn');
    const statusPill = document.getElementById('telemetry-status-pill');
    const subtext = document.getElementById('telemetry-subtext');
    const privacyBanner = document.getElementById('privacy-banner');
    const bannerText = document.getElementById('banner-text');
    const mapCoordChip = document.getElementById('map-coord-chip');
    const mapStatusChip = document.getElementById('map-status-chip');
    const emergencyCard = document.getElementById('emergency-card');
    const troubleshootPanel = document.getElementById('troubleshoot-panel');
    const accuracyWarning = document.getElementById('accuracy-warning');

    let S: Record<string, string> = {};
    try {
      S = JSON.parse(document.getElementById('home-status')?.textContent || '{}');
    } catch {
      S = {};
    }

    let currentLat: number | null = null;
    let currentLng: number | null = null;
    let currentAccuracy: number = 0;
    let currentAddress: string = '';
    let mapInstance: any = null;
    let markerInstance: any = null;
    let circleInstance: any = null;
    let watchId: number | null = null;

    function setMapStatus(text: string) {
      const el = document.getElementById('map-status-chip-text');
      if (el) el.textContent = text;
    }

    function initMap(lat: number | null, lng: number | null, accuracy: number = 5) {
      const L = (window as any).L;
      if (typeof L === 'undefined') {
        setTimeout(() => initMap(lat, lng, accuracy), 150);
        return;
      }

      if (!mapInstance) {
        mapInstance = L.map('map', { scrollWheelZoom: false, zoomControl: true });

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          maxZoom: 19,
        }).addTo(mapInstance);

        MapUtils.addLocateControl(mapInstance, {
          title: locateTitle,
          zoom: 16,
          onLocate: (uLat, uLng, acc) => {
            currentLat = uLat;
            currentLng = uLng;
            initMap(uLat, uLng, acc);
          }
        });
      }

      if (lat === null || lng === null) {
        mapInstance.setView([20, 0], 2);
        return;
      }

      mapInstance.setView([lat, lng], 16);

      const pulsePinIcon = L.divIcon({
        className: 'custom-gps-marker',
        html: `
          <div class="pulse-marker-wrapper">
            <div class="marker-pulse-wave"></div>
            <div class="marker-core-dot"></div>
          </div>
        `,
        iconSize: [32, 32],
        iconAnchor: [16, 16],
      });

      if (markerInstance) {
        markerInstance.setLatLng([lat, lng]);
      } else {
        markerInstance = L.marker([lat, lng], { icon: pulsePinIcon }).addTo(mapInstance);
      }

      if (circleInstance) {
        circleInstance.setLatLng([lat, lng]);
        circleInstance.setRadius(accuracy);
      } else {
        circleInstance = L.circle([lat, lng], {
          radius: accuracy,
          color: '#2563EB',
          fillColor: '#60A5FA',
          fillOpacity: 0.15,
          weight: 1.5,
        }).addTo(mapInstance);
      }
    }

    function updateFormatDisplays(lat: number, lng: number) {
      const ddEl = document.getElementById('val-dd');
      const dmsEl = document.getElementById('val-dms');
      const plusEl = document.getElementById('val-plus');
      const utmEl = document.getElementById('val-utm');

      const ddStr = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
      const dmsStr = `${CoordUtils.formatDMS(lat, true)}, ${CoordUtils.formatDMS(lng, false)}`;
      const plusStr = CoordUtils.encodePlusCode(lat, lng);
      const utmRes = CoordUtils.decimalToUTM(lat, lng);

      if (ddEl) ddEl.textContent = ddStr;
      if (dmsEl) dmsEl.textContent = dmsStr;
      if (plusEl) plusEl.textContent = plusStr;
      if (utmEl) utmEl.textContent = utmRes?.formatted || '—';

      // Update Time Zone
      const tzEl = document.getElementById('tech-tz');
      if (tzEl) {
        try {
          const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
          const offsetMinutes = -new Date().getTimezoneOffset();
          const sign = offsetMinutes >= 0 ? '+' : '-';
          const hrs = String(Math.floor(Math.abs(offsetMinutes) / 60)).padStart(2, '0');
          const mins = String(Math.abs(offsetMinutes) % 60).padStart(2, '0');
          tzEl.textContent = `${tz} (UTC${sign}${hrs}:${mins})`;
        } catch {
          tzEl.textContent = 'UTC';
        }
      }

      // Update Nearby Services Links
      const nearby = Sharing.getNearbyLinks(lat, lng);
      const setLink = (id: string, url: string) => {
        const el = document.getElementById(id);
        if (el) el.setAttribute('href', url);
      };
      setLink('nearby-hospitals', nearby.hospitals);
      setLink('nearby-police', nearby.police);
      setLink('nearby-pharmacies', nearby.pharmacies);
      setLink('nearby-petrol', nearby.petrol);
      setLink('nearby-atms', nearby.atms);

      // Update Open in Maps button
      const mapsBtn = document.getElementById('open-maps-btn');
      if (mapsBtn) {
        mapsBtn.setAttribute('href', Sharing.getGoogleMapsUrl(lat, lng));
        mapsBtn.removeAttribute('aria-disabled');
      }

      // Update WhatsApp share button
      const waBtn = document.getElementById('whatsapp-share-btn');
      if (waBtn) {
        waBtn.setAttribute('href', Sharing.getWhatsAppUrl(lat, lng, currentAddress));
        waBtn.removeAttribute('aria-disabled');
      }

      // Update Emergency Readout Mode
      const emCoords = document.getElementById('emergency-coords');
      if (emCoords) {
        emCoords.textContent = `Coordinates: ${lat.toFixed(6)}, ${lng.toFixed(6)} (±${Math.round(currentAccuracy)}m)`;
      }
      const emWa = document.getElementById('emergency-wa-btn');
      if (emWa) emWa.setAttribute('href', Sharing.getWhatsAppUrl(lat, lng, currentAddress));
      const emSms = document.getElementById('emergency-sms-btn');
      if (emSms) emSms.setAttribute('href', Sharing.getSmsUrl(lat, lng, currentAddress));
    }

    async function findLocation() {
      if (statusPill) {
        statusPill.textContent = S.acquiring || 'Finding your location…';
        statusPill.className = 'telemetry-status-pill';
      }
      if (subtext) {
        subtext.textContent = S.acquiringSub || 'Connecting to device GPS sensor…';
      }
      if (getBtn) {
        getBtn.style.opacity = '0.75';
        getBtn.style.pointerEvents = 'none';
      }
      if (troubleshootPanel) troubleshootPanel.style.display = 'none';
      if (accuracyWarning) accuracyWarning.style.display = 'none';

      try {
        const position = await GeoLocation.getCurrentPosition();
        const data = GeoLocation.formatPosition(position);
        currentLat = data.latitude;
        currentLng = data.longitude;
        currentAccuracy = data.accuracy;

        const latEl = document.getElementById('data-lat');
        const latDecEl = document.getElementById('data-lat-dec');
        const lngEl = document.getElementById('data-lng');
        const lngDecEl = document.getElementById('data-lng-dec');
        const accEl = document.getElementById('data-accuracy');
        const altEl = document.getElementById('data-altitude');

        if (latEl) latEl.textContent = data.formattedLat;
        if (latDecEl) latDecEl.textContent = `${S.decimal || 'Decimal'}: ${currentLat.toFixed(6)}`;
        if (lngEl) lngEl.textContent = data.formattedLng;
        if (lngDecEl) lngDecEl.textContent = `${S.decimal || 'Decimal'}: ${currentLng.toFixed(6)}`;
        if (accEl) accEl.textContent = (S.meters || '± {m} m').replace('{m}', String(Math.round(data.accuracy)));
        const accSubEl = document.getElementById('data-accuracy-sub');
        if (accSubEl) accSubEl.textContent = S.accuracyDevice || 'Reported by GPS sensor';
        if (altEl) {
          altEl.textContent = data.altitude != null
            ? `${Math.round(data.altitude)} m (${Math.round(data.altitude * 3.28084)} ft)`
            : (S.altitudeNone || 'Not reported');
        }

        // Live speed & heading
        const motionEl = document.getElementById('tech-motion');
        if (motionEl) {
          const spd = data.speed ? `${(data.speed * 3.6).toFixed(1)} km/h` : '0 km/h';
          const hdg = data.heading != null ? `${CoordUtils.bearingToCompass(data.heading)} (${Math.round(data.heading)}°)` : 'Stationary';
          motionEl.textContent = `Speed: ${spd} • Compass: ${hdg}`;
        }

        if (mapCoordChip) {
          mapCoordChip.textContent = `${data.formattedLat}, ${data.formattedLng}`;
        }

        setMapStatus(S.gpsStatus || 'GPS Fixed');

        if (statusPill) {
          statusPill.textContent = S.locked || 'Location found';
          statusPill.className = 'telemetry-status-pill status-fixed';
        }

        if (subtext) {
          subtext.textContent = (S.lockedDetail || '').replace('{m}', String(Math.round(data.accuracy)));
        }

        // Check accuracy threshold (>200m triggers low accuracy warning)
        if (data.accuracy > 200 && accuracyWarning) {
          const warnText = document.getElementById('accuracy-warning-text');
          if (warnText) {
            warnText.textContent = `⚠️ Low Accuracy (±${Math.round(data.accuracy)} m). Your device may be indoors or using Wi-Fi network routing. Step outdoors for direct satellite precision.`;
          }
          accuracyWarning.style.display = 'flex';
        }

        initMap(currentLat, currentLng, data.accuracy);
        updateFormatDisplays(currentLat, currentLng);

        try {
          const address = await Geocoding.reverseGeocode(currentLat, currentLng);
          currentAddress = address.displayName || address.road || '';
          const addrEl = document.getElementById('data-address');
          const cityEl = document.getElementById('data-city');
          const citySubEl = document.getElementById('data-city-sub');
          const stateEl = document.getElementById('data-state-country');
          const stateSubEl = document.getElementById('data-state-sub');

          if (addrEl) addrEl.textContent = address.displayName || address.road || S.addrFallback || 'Resolved location';
          if (cityEl) cityEl.textContent = address.city || address.town || address.village || address.county || S.cityFallback || 'Detected city';
          if (citySubEl) citySubEl.textContent = address.county ? (S.county || 'County: {c}').replace('{c}', address.county) : (S.viaGps || '');
          if (stateEl) {
            const state = address.state || '';
            const country = address.country || '';
            stateEl.textContent = [state, country].filter(Boolean).join(', ') || S.global || '';
          }
          if (stateSubEl) {
            const cc = (address.country_code || '').toUpperCase();
            const region = address.state_district || address.state || '';
            stateSubEl.textContent = cc ? `ISO 3166-1: ${[cc, region].filter(Boolean).join('-')}` : (S.viaGps || '');
          }

          // Emergency display address
          const emAddr = document.getElementById('emergency-address');
          if (emAddr) emAddr.textContent = currentAddress || `${currentLat.toFixed(6)}, ${currentLng.toFixed(6)}`;

          // Update WhatsApp link with address
          const waBtn = document.getElementById('whatsapp-share-btn');
          if (waBtn) waBtn.setAttribute('href', Sharing.getWhatsAppUrl(currentLat, currentLng, currentAddress));

        } catch {
          const citySubEl = document.getElementById('data-city-sub');
          const stateSubEl = document.getElementById('data-state-sub');
          if (citySubEl) citySubEl.textContent = S.addrFail || '';
          if (stateSubEl) stateSubEl.textContent = S.addrFail || '';
        }

        if (privacyBanner) {
          privacyBanner.style.background = '#ecfdf5';
          privacyBanner.style.borderColor = '#a7f3d0';
          privacyBanner.style.color = '#065f46';
        }
        if (bannerText) {
          bannerText.textContent = S.okBanner || 'Location found. We never store your coordinates on our servers.';
        }

      } catch (err: any) {
        // Show Troubleshooting guide
        if (troubleshootPanel) {
          troubleshootPanel.style.display = 'block';
          const errDetails = GeoLocation.getErrorDetails(err, currentDocLang);
          const tTitle = document.getElementById('troubleshoot-title');
          const tDesc = document.getElementById('troubleshoot-desc');
          if (tTitle) {
            tTitle.textContent = errDetails.type === 'denied'
              ? 'Location Permission Blocked'
              : (errDetails.type === 'timeout' ? 'GPS Signal Timed Out' : 'GPS Signal Unavailable');
          }
          if (tDesc) tDesc.textContent = errDetails.message;
        }

        // Automatic fallback to approximate IP location
        await fallbackToIp();
      } finally {
        if (getBtn) {
          getBtn.style.opacity = '1';
          getBtn.style.pointerEvents = 'auto';
        }
      }
    }

    async function fallbackToIp() {
      if (statusPill) {
        statusPill.textContent = S.ipPill || 'Approximate (IP)';
        statusPill.className = 'telemetry-status-pill';
      }
      if (subtext) {
        subtext.textContent = S.ipSub || 'GPS unavailable — showing approximate city-level location from your IP address.';
      }

      try {
        const ipModule = await import('../scripts/ip-location.js');
        const ipData = await ipModule.default.getLocation();
        currentLat = ipData.lat;
        currentLng = ipData.lng;
        currentAccuracy = 10000;
        currentAddress = `${ipData.city || 'Metro area'}, ${ipData.region || ''}, ${ipData.country || ''}`;

        const latEl = document.getElementById('data-lat');
        const latDecEl = document.getElementById('data-lat-dec');
        const lngEl = document.getElementById('data-lng');
        const lngDecEl = document.getElementById('data-lng-dec');
        const addrEl = document.getElementById('data-address');
        const cityEl = document.getElementById('data-city');
        const citySubEl = document.getElementById('data-city-sub');
        const stateEl = document.getElementById('data-state-country');
        const stateSubEl = document.getElementById('data-state-sub');
        const accEl = document.getElementById('data-accuracy');
        const altEl = document.getElementById('data-altitude');

        if (latEl) latEl.textContent = `${Math.abs(currentLat).toFixed(4)}° ${currentLat >= 0 ? 'N' : 'S'}`;
        if (latDecEl) latDecEl.textContent = `${S.decimal || 'Decimal'}: ${currentLat.toFixed(6)}`;
        if (lngEl) lngEl.textContent = `${Math.abs(currentLng).toFixed(4)}° ${currentLng >= 0 ? 'E' : 'W'}`;
        if (lngDecEl) lngDecEl.textContent = `${S.decimal || 'Decimal'}: ${currentLng.toFixed(6)}`;
        if (addrEl) addrEl.textContent = currentAddress;
        if (cityEl) cityEl.textContent = ipData.city || S.cityFallback || 'Detected city';
        if (citySubEl) citySubEl.textContent = S.ipPrecision || 'Approximate (IP-level)';
        if (stateEl) stateEl.textContent = `${ipData.region || ''}, ${ipData.country || ''}`;
        if (stateSubEl) stateSubEl.textContent = ipData.countryCode ? `ISO 3166-1: ${ipData.countryCode}${ipData.regionCode ? '-' + ipData.regionCode : ''}` : '';
        if (accEl) accEl.textContent = '± 10 km (IP)';
        const accSubEl = document.getElementById('data-accuracy-sub');
        if (accSubEl) accSubEl.textContent = S.accuracyIp || 'Estimated from your IP';
        if (altEl) altEl.textContent = S.altitudeIpNone || 'Not available via IP';

        if (mapCoordChip) {
          mapCoordChip.textContent = `${currentLat.toFixed(4)}°, ${currentLng.toFixed(4)}°`;
        }

        setMapStatus(S.ipStatus || 'Approximate (IP)');
        initMap(currentLat, currentLng, 10000);
        updateFormatDisplays(currentLat, currentLng);

        if (bannerText) {
          bannerText.textContent = S.ipBanner || 'Approximate city-level location from your IP address. Nothing is stored on our servers.';
        }
      } catch {
        setMapStatus(S.noFix || 'No location');
        if (bannerText) bannerText.textContent = S.failed || 'Could not get location. Please enable location permissions.';
      }
    }

    // Attach primary listeners
    getBtn?.addEventListener('click', () => findLocation());
    document.getElementById('refresh-btn')?.addEventListener('click', () => findLocation());
    document.getElementById('troubleshoot-retry-btn')?.addEventListener('click', () => findLocation());
    document.getElementById('troubleshoot-ip-btn')?.addEventListener('click', () => fallbackToIp());

    // Emergency Mode Toggle
    const emergencyBtn = document.getElementById('emergency-btn');
    const closeEmergencyBtn = document.getElementById('close-emergency-btn');
    emergencyBtn?.addEventListener('click', () => {
      if (!emergencyCard) return;
      const isHidden = emergencyCard.style.display === 'none';
      emergencyCard.style.display = isHidden ? 'block' : 'none';
      if (isHidden) {
        emergencyCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
    closeEmergencyBtn?.addEventListener('click', () => {
      if (emergencyCard) emergencyCard.style.display = 'none';
    });

    // Emergency Copy
    document.getElementById('emergency-copy-btn')?.addEventListener('click', function(this: HTMLButtonElement) {
      if (!currentLat || !currentLng) return;
      const text = `🚨 EMERGENCY LOCATION:\nI am at: ${currentAddress || 'Exact location'}\nCoordinates: ${currentLat.toFixed(6)}, ${currentLng.toFixed(6)} (Accuracy ±${Math.round(currentAccuracy)}m)\nGoogle Maps: https://www.google.com/maps?q=${currentLat},${currentLng}`;
      navigator.clipboard.writeText(text).then(() => {
        const orig = this.textContent;
        this.textContent = '✓ Copied to clipboard!';
        setTimeout(() => { this.textContent = orig; }, 2000);
      });
    });

    // Check permission state on page load:
    // Only auto-locate if permission is ALREADY granted. NEVER trigger browser prompt on load!
    GeoLocation.checkPermission().then((perm) => {
      if (perm === 'granted') {
        findLocation();
      } else {
        // Safe standby state: initialize world map without prompting
        initMap(null, null);
        setMapStatus(S.ready || 'Ready');
      }
    }).catch(() => {
      initMap(null, null);
    });

    // Format copy buttons
    const wireCopyBtn = (btnId: string, valId: string) => {
      document.getElementById(btnId)?.addEventListener('click', function(this: HTMLButtonElement) {
        const val = document.getElementById(valId)?.textContent?.trim();
        if (!val || val === '—') return;
        navigator.clipboard.writeText(val).then(() => {
          const orig = this.textContent;
          this.textContent = '✓ Copied!';
          setTimeout(() => { this.textContent = orig; }, 1800);
        });
      });
    };
    wireCopyBtn('copy-dd-btn', 'val-dd');
    wireCopyBtn('copy-dms-btn', 'val-dms');
    wireCopyBtn('copy-plus-btn', 'val-plus');
    wireCopyBtn('copy-utm-btn', 'val-utm');

    // Main header copy button
    document.getElementById('copy-coords-btn')?.addEventListener('click', function(this: HTMLButtonElement) {
      if (currentLat === null || currentLng === null) {
        const span = this.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = S.copyNone || 'No location yet';
          setTimeout(() => { span.textContent = original; }, 2000);
        }
        return;
      }
      const coordStr = `${currentLat.toFixed(6)}, ${currentLng.toFixed(6)}`;
      navigator.clipboard.writeText(coordStr).then(() => {
        const span = this.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = S.copied || 'Copied!';
          setTimeout(() => { span.textContent = original; }, 2000);
        }
      });
    });

    // Main share button
    document.getElementById('share-btn')?.addEventListener('click', () => {
      if (currentLat === null || currentLng === null) return;
      Sharing.shareNative({
        title: S.shareTitle || 'My Location',
        text: (S.shareText || 'My location coordinates: {lat}, {lng}')
          .replace('{lat}', currentLat.toFixed(6))
          .replace('{lng}', currentLng.toFixed(6)),
        url: Sharing.getGoogleMapsUrl(currentLat, currentLng),
      });
    });

    // Live Tracking Checkbox
    const liveTrackEl = document.getElementById('live-track-checkbox') as HTMLInputElement;
    liveTrackEl?.addEventListener('change', () => {
      if (liveTrackEl.checked) {
        watchId = GeoLocation.watchPosition((pos) => {
          const p = GeoLocation.formatPosition(pos);
          currentLat = p.latitude;
          currentLng = p.longitude;
          currentAccuracy = p.accuracy;
          initMap(p.latitude, p.longitude, p.accuracy);
          updateFormatDisplays(p.latitude, p.longitude);
        }, (err) => {
          console.warn('Live tracking warning:', err);
        });
      } else if (watchId !== null) {
        GeoLocation.clearWatch(watchId);
        watchId = null;
      }
    });

    // Nominatim / Address lookup toggle
    const nomToggle = document.getElementById('nominatim-toggle') as HTMLInputElement;
    if (nomToggle) {
      nomToggle.checked = Geocoding.isLookupEnabled();
      nomToggle.addEventListener('change', () => {
        Geocoding.setLookupEnabled(nomToggle.checked);
        if (currentLat && currentLng) {
          findLocation();
        }
      });
    }

    // Save Location Local History
    const renderSavedPlaces = () => {
      const block = document.getElementById('saved-places-block');
      const list = document.getElementById('saved-places-list');
      if (!block || !list) return;
      try {
        const history = JSON.parse(localStorage.getItem('myloc_saved_spots') || '[]');
        if (history.length === 0) {
          block.style.display = 'none';
          return;
        }
        block.style.display = 'block';
        list.innerHTML = '';
        history.slice(0, 5).forEach((item: any, idx: number) => {
          const li = document.createElement('li');
          li.style.marginBottom = '6px';
          li.innerHTML = `<span><strong>${item.name || 'Saved Spot'}</strong> (${item.lat.toFixed(4)}, ${item.lng.toFixed(4)}) - <a href="https://www.google.com/maps?q=${item.lat},${item.lng}" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent-primary); text-decoration:underline;">Maps</a></span> <button type="button" data-del="${idx}" style="background:none; border:none; color:var(--color-error); cursor:pointer; margin-left:8px; font-size:11px;">Remove</button>`;
          list.appendChild(li);
        });
        list.querySelectorAll('button[data-del]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const delIdx = parseInt((e.target as HTMLElement).getAttribute('data-del') || '0', 10);
            history.splice(delIdx, 1);
            localStorage.setItem('myloc_saved_spots', JSON.stringify(history));
            renderSavedPlaces();
          });
        });
      } catch {}
    };
    renderSavedPlaces();

    document.getElementById('btn-save-spot')?.addEventListener('click', () => {
      if (!currentLat || !currentLng) return;
      try {
        const history = JSON.parse(localStorage.getItem('myloc_saved_spots') || '[]');
        history.unshift({
          name: currentAddress || 'Saved Place',
          lat: currentLat,
          lng: currentLng,
          date: Date.now()
        });
        localStorage.setItem('myloc_saved_spots', JSON.stringify(history.slice(0, 10)));
        const msg = document.getElementById('save-status-msg');
        if (msg) {
          msg.textContent = '✓ Saved on this device!';
          setTimeout(() => { msg.textContent = ''; }, 2500);
        }
        renderSavedPlaces();
      } catch {}
    });

    // Accuracy Feedback widget
    document.getElementById('feedback-yes')?.addEventListener('click', () => {
      const msg = document.getElementById('feedback-msg');
      if (msg) {
        msg.textContent = '✓ Thank you for letting us know!';
        msg.style.display = 'inline-block';
        msg.style.color = 'var(--color-accent-success)';
      }
    });
    document.getElementById('feedback-no')?.addEventListener('click', () => {
      const msg = document.getElementById('feedback-msg');
      if (msg) {
        msg.innerHTML = '⚠️ Tip: Step outdoors or turn on Wi-Fi for better GPS accuracy. See our <a href="/guides/wrong-location/" style="text-decoration:underline; font-weight:600;">Fixing Wrong Location Guide</a>.';
        msg.style.display = 'inline-block';
        msg.style.color = '#d97706';
      }
    });
  </script>

