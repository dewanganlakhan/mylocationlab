---
/**
 * HomeView — Core Homepage Engine
 * Multilingual implementation supporting en, es, fr, de, pt with dynamic Leaflet telemetry map.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeTranslations } from '../i18n/home';
import { getLocalizedPath, defaultLang, type SupportedLang } from '../i18n/config';

interface Props {
  lang?: SupportedLang | string;
}

const { lang: customLang = defaultLang } = Astro.props;
const lang = (customLang in homeTranslations ? customLang : defaultLang) as SupportedLang;
const content = homeTranslations[lang] || homeTranslations.en;

const locateTitle = ({
  en: "Zoom to my current location",
  es: "Centrar y ampliar en mi ubicación",
  fr: "Zoomer sur ma position actuelle",
  de: "Auf meinen aktuellen Standort zoomen",
  pt: "Aproximar da minha localização atual"
})[lang] || "Zoom to my current location";

const homeFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqSection.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]*>?/gm, ''),
    },
  })),
};
---

<BaseLayout
  leaflet
  lang={lang}
  title={content.metaTitle}
  description={content.metaDesc}
  jsonLd={[homeFaqSchema]}
>
  <!-- Hero Section -->
  <section class="stitch-hero" id="find-location">
    <div class="container">
      <!-- Main Headline -->
      <h1 class="hero-title-stitch">
        {content.heroTitle} <span class="hero-title-highlight">{content.heroTitleHighlight}</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-subtitle-stitch">
        {content.heroSubtitle}
      </p>

      <!-- Action Buttons -->
      <div class="hero-actions-stitch">
        <button class="btn-stitch-primary" id="get-location-btn" type="button">
          <span class="pulse-dot-cyan" ></span>
          <span>{content.btnGetLocation}</span>
        </button>

        <a href={getLocalizedPath('/tools/', lang)} class="btn-stitch-secondary">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
          </svg>
          <span>{content.btnBrowseTools}</span>
        </a>
      </div>

      <!-- Permission Notice Banner -->
      <div class="privacy-banner-stitch" id="privacy-banner">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; color: var(--color-accent-warning);" aria-hidden="true">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span id="banner-text">{content.privacyBanner}</span>
      </div>
    </div>
  </section>

  <!-- Telemetry & Map Card Dashboard -->
  <section class="telemetry-card-wrapper" id="telemetry-section">
    <div class="telemetry-dashboard">
      <!-- Top Bar -->
      <div class="telemetry-top-bar">
        <div class="telemetry-header-info">
          <div class="telemetry-radar-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/>
              <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/>
              <circle cx="12" cy="12" r="2"/>
              <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/>
              <path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"/>
            </svg>
          </div>
          <div class="telemetry-title-block">
            <div class="telemetry-title-badge-row">
              <h2 class="telemetry-heading-title">{content.telemetryTitle}</h2>
              <span class="telemetry-status-pill" id="telemetry-status-pill">{content.s.ready}</span>
            </div>
            <p class="telemetry-subtext" id="telemetry-subtext">{content.telemetrySubtext}</p>
          </div>
        </div>

        <!-- Action Controls -->
        <div class="telemetry-controls">
          <button class="telemetry-ctrl-btn" id="copy-coords-btn" type="button" title={content.btnCopy}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
            </svg>
            <span>{content.btnCopy}</span>
          </button>

          <a class="telemetry-ctrl-btn" id="whatsapp-share-btn" href="#" target="_blank" rel="noopener noreferrer" title="Share via WhatsApp" aria-disabled="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>WhatsApp</span>
          </a>

          <button class="telemetry-ctrl-btn emergency-toggle-btn" id="emergency-btn" type="button" title="Emergency Readout Mode">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span>Emergency Mode</span>
          </button>

          <button class="telemetry-ctrl-btn" id="share-btn" type="button" title={content.btnShare}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="3"/>
              <circle cx="6" cy="12" r="3"/>
              <circle cx="18" cy="19" r="3"/>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
            </svg>
            <span>{content.btnShare}</span>
          </button>

          <a class="telemetry-ctrl-btn" id="open-maps-btn" href="https://www.google.com/maps" target="_blank" rel="noopener noreferrer" title={content.btnOpenMaps} aria-disabled="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
              <line x1="9" y1="3" x2="9" y2="18"/>
              <line x1="15" y1="6" x2="15" y2="21"/>
            </svg>
            <span>{content.btnOpenMaps}</span>
          </a>

          <button class="telemetry-ctrl-btn telemetry-ctrl-icon-btn" id="refresh-btn" type="button" title="Refresh Position">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
              <path d="M3 3v5h5"/>
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
              <path d="M16 16h5v5"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Emergency Mode Card (Triggered by 🚨 button) -->
      <div id="emergency-card" class="emergency-readout-card" style="display: none;">
        <div class="emergency-card-top">
          <div class="emergency-card-badge">Emergency Readout Mode</div>
          <button type="button" class="emergency-close-button" id="close-emergency-btn" aria-label="Close emergency mode">✕ Close</button>
        </div>
        <p class="emergency-instruction">Read this aloud to the emergency dispatcher (112 / 911 / 999):</p>
        <div class="emergency-text-box">
          <div class="emergency-callout-heading">“Current Location:”</div>
          <div class="emergency-location-address" id="emergency-address">Locating your current street address…</div>
          <div class="emergency-location-coords" id="emergency-coords">Coordinates: Awaiting fix</div>
        </div>
        <div class="emergency-action-buttons">
          <button type="button" class="btn btn-primary btn-sm" id="emergency-copy-btn">
            Copy Emergency Text
          </button>
          <a class="btn btn-whatsapp btn-sm" id="emergency-wa-btn" href="#" target="_blank" rel="noopener noreferrer">
            WhatsApp Location
          </a>
          <a class="btn btn-secondary btn-sm" id="emergency-sms-btn" href="#">
            Send via SMS
          </a>
        </div>
      </div>

      <!-- Low Accuracy Warning Banner -->
      <div id="accuracy-warning" class="accuracy-warning-strip" style="display: none;">
        <span class="warning-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
        <span id="accuracy-warning-text">Estimated location (accuracy ±800m). Your device is using Wi-Fi or cellular tower routing. Step outside for satellite GPS precision.</span>
      </div>

      <!-- Troubleshooting Accordion Panel -->
      <div id="troubleshoot-panel" class="troubleshoot-card" style="display: none;">
        <div class="troubleshoot-card-header">
          <span class="troubleshoot-card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg></span>
          <div>
            <h3 class="troubleshoot-heading" id="troubleshoot-title">Location Permission Required</h3>
            <p class="troubleshoot-subtitle" id="troubleshoot-desc">We couldn’t get a GPS fix from your browser. Here is how to enable it:</p>
          </div>
        </div>
        <div class="troubleshoot-steps-accordion">
          <details class="troubleshoot-step-detail" open>
            <summary class="troubleshoot-step-summary">
              <strong>Chrome</strong> (Mobile Android & Desktop)
            </summary>
            <p class="troubleshoot-step-body">Tap the lock or page settings icon next to the website address in your URL bar &rarr; Tap <strong>Permissions / Site Settings</strong> &rarr; Change <strong>Location</strong> to <strong>Allow</strong> &rarr; Refresh this page.</p>
          </details>
          <details class="troubleshoot-step-detail">
            <summary class="troubleshoot-step-summary">
              <strong>Safari</strong> (iPhone & iPad)
            </summary>
            <p class="troubleshoot-step-body">Open iPhone <strong>Settings</strong> &rarr; Tap <strong>Safari</strong> &rarr; <strong>Location</strong> &rarr; Set to <strong>Allow</strong>. Or tap <strong>aA</strong> in Safari's address bar &rarr; Website Settings &rarr; Location &rarr; Allow.</p>
          </details>
          <details class="troubleshoot-step-detail">
            <summary class="troubleshoot-step-summary">
              <strong>Safari & Chrome on Mac / Windows</strong>
            </summary>
            <p class="troubleshoot-step-body">Ensure device system location is ON. On macOS: <strong>System Settings &rarr; Privacy & Security &rarr; Location Services</strong>. On Windows: <strong>Settings &rarr; Privacy & Security &rarr; Location</strong>.</p>
          </details>
        </div>
        <div class="troubleshoot-footer-buttons">
          <button type="button" class="btn-stitch-primary btn-sm" id="troubleshoot-retry-btn">
            Retry GPS
          </button>
          <button type="button" class="btn-stitch-secondary btn-sm" id="troubleshoot-ip-btn">
            Use IP Location
          </button>
        </div>
      </div>

      <!-- Two-Column Telemetry Viewport -->
      <div class="telemetry-viewport-grid">
        <!-- Left Column: Map Container -->
        <div class="telemetry-map-box">
          <div id="map" data-locate-title={locateTitle}></div>

          <!-- Overlay Chips -->
          <div class="map-overlay-chip map-chip-topleft">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            <span>WGS 84 • EPSG:4326</span>
          </div>

          <div class="map-overlay-chip map-chip-botleft">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span id="map-coord-chip">{content.mapWaiting}</span>
          </div>

          <div class="map-overlay-chip map-chip-botright" id="map-status-chip">
            <span class="pulse-dot-emerald"></span>
            <span id="map-status-chip-text">{content.mapStandby}</span>
          </div>
        </div>

        <!-- Right Column: Telemetry Cells -->
        <div class="telemetry-data-cells">
          <!-- Cell 1: Latitude -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">{content.labels.latitude}</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="12" y1="19" x2="12" y2="5"/>
                  <polyline points="5 12 12 5 19 12"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-lat">--</div>
              <div class="telemetry-cell-sub" id="data-lat-dec">{content.labels.waiting}</div>
            </div>
          </div>

          <!-- Cell 2: Longitude -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">{content.labels.longitude}</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="19" y1="12" x2="5" y2="12"/>
                  <polyline points="12 19 5 12 12 5"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-lng">--</div>
              <div class="telemetry-cell-sub" id="data-lng-dec">{content.labels.waiting}</div>
            </div>
          </div>

          <!-- Cell 3: Street Address -->
          <div class="telemetry-cell cell-full">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">{content.labels.streetAddress}</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-address" style="font-size: 16.5px;">{content.labels.resolvingAddress}</div>
              <div class="telemetry-cell-sub">{content.labels.reverseGeocoded}</div>
            </div>
          </div>

          <!-- Cell 4: City -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">{content.labels.city}</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
                  <line x1="9" y1="22" x2="9" y2="22.01"/>
                  <line x1="15" y1="22" x2="15" y2="22.01"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-city">--</div>
              <div class="telemetry-cell-sub" id="data-city-sub">{content.labels.waiting}</div>
            </div>
          </div>

          <!-- Cell 5: State & Country -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">{content.labels.state}</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
                  <line x1="9" y1="3" x2="9" y2="18"/>
                  <line x1="15" y1="6" x2="15" y2="21"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-state-country">--</div>
              <div class="telemetry-cell-sub" id="data-state-sub">{content.labels.waiting}</div>
            </div>
          </div>

          <!-- Cell 6: Accuracy Radius -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">{content.labels.accuracy}</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <circle cx="12" cy="12" r="6"/>
                  <circle cx="12" cy="12" r="2"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value text-emerald" id="data-accuracy">--</div>
              <div class="telemetry-cell-sub" id="data-accuracy-sub">{content.labels.deviceReported}</div>
            </div>
          </div>

          <!-- Cell 7: Elevation / Altitude -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">{content.labels.elevation}</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m8 3 4 8 5-5 5 15H2L8 3z"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-altitude">--</div>
              <div class="telemetry-cell-sub">{content.labels.aboveSeaLevel}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Coordinate Formats Strip -->
      <div class="coordinate-formats-card" id="formats-card">
        <div class="formats-header">
          <div class="formats-title-row">
            <span class="formats-title">Coordinate Formats</span>
            <span class="formats-sub">Copy your exact position in standard navigation and mapping notations</span>
          </div>
        </div>
        <div class="formats-grid">
          <div class="format-cell">
            <div class="format-cell-head">
              <span class="format-badge">Decimal Degrees</span>
              <button type="button" class="format-copy-btn" id="copy-dd-btn" title="Copy Decimal Degrees">Copy</button>
            </div>
            <div class="format-value" id="val-dd">--</div>
          </div>
          <div class="format-cell">
            <div class="format-cell-head">
              <span class="format-badge">DMS (Degrees Minutes Seconds)</span>
              <button type="button" class="format-copy-btn" id="copy-dms-btn" title="Copy DMS">Copy</button>
            </div>
            <div class="format-value" id="val-dms">--</div>
          </div>
          <div class="format-cell">
            <div class="format-cell-head">
              <span class="format-badge">Plus Code (Open Location)</span>
              <button type="button" class="format-copy-btn" id="copy-plus-btn" title="Copy Plus Code">Copy</button>
            </div>
            <div class="format-value" id="val-plus">--</div>
          </div>
          <div class="format-cell">
            <div class="format-cell-head">
              <span class="format-badge">UTM Grid Coordinate</span>
              <button type="button" class="format-copy-btn" id="copy-utm-btn" title="Copy UTM">Copy</button>
            </div>
            <div class="format-value" id="val-utm">--</div>
          </div>
        </div>
      </div>

      <!-- Nearby Services Quick Help -->
      <div class="nearby-services-card" id="nearby-card">
        <div class="nearby-header">
          <span class="nearby-title">Nearby Help & Services</span>
          <span class="nearby-sub">One-tap navigation to critical nearby places in Google Maps</span>
        </div>
        <div class="nearby-chips-grid">
          <a class="nearby-chip" id="nearby-hospitals" href="#" target="_blank" rel="noopener noreferrer">
            
            <span class="nearby-text">Nearby Hospitals</span>
          </a>
          <a class="nearby-chip" id="nearby-police" href="#" target="_blank" rel="noopener noreferrer">
            
            <span class="nearby-text">Police Stations</span>
          </a>
          <a class="nearby-chip" id="nearby-pharmacies" href="#" target="_blank" rel="noopener noreferrer">
            
            <span class="nearby-text">Pharmacies</span>
          </a>
          <a class="nearby-chip" id="nearby-petrol" href="#" target="_blank" rel="noopener noreferrer">
            
            <span class="nearby-text">Fuel / Petrol Pumps</span>
          </a>
          <a class="nearby-chip" id="nearby-atms" href="#" target="_blank" rel="noopener noreferrer">
            
            <span class="nearby-text">ATMs & Cash</span>
          </a>
        </div>
      </div>

      <!-- Advanced Technical Details & Privacy Options -->
      <details class="tech-accordion-box" id="tech-accordion">
        <summary class="tech-accordion-summary">
          <span>Advanced Details, Live Tracking & Privacy Mode</span>
          <span class="tech-accordion-arrow">▾</span>
        </summary>
        <div class="tech-accordion-content">
          <div class="tech-grid">
            <div class="tech-item">
              <span class="tech-label">Detected Time Zone:</span>
              <span class="tech-val" id="tech-tz">--</span>
            </div>
            <div class="tech-item">
              <span class="tech-label">Live Movement / Speed:</span>
              <span class="tech-val" id="tech-motion">--</span>
            </div>
            <div class="tech-item">
              <span class="tech-label">Coordinate Standard:</span>
              <span class="tech-val">WGS 84 (EPSG:4326) • Earth-centered reference</span>
            </div>
            <div class="tech-item">
              <span class="tech-label">Local Device History:</span>
              <button type="button" class="btn btn-secondary btn-xs" id="btn-save-spot" style="display: inline-flex; align-items: center; gap: 4px; margin-top: 4px;">
                 <span>Save this spot</span>
              </button>
              <span id="save-status-msg" style="font-size: 11px; color: var(--color-accent-success); margin-left: 6px;"></span>
            </div>
          </div>

          <div class="tech-options-row">
            <label class="tech-toggle-item">
              <input type="checkbox" id="live-track-checkbox" />
              <span><strong>Live GPS Tracking:</strong> Continuously monitor and update my location as I move</span>
            </label>
            <label class="tech-toggle-item">
              <input type="checkbox" id="nominatim-toggle" checked />
              <span><strong>Resolve Street Address:</strong> Query OpenStreetMap Nominatim for street address (uncheck for strict local coordinate mode without sending queries)</span>
            </label>
          </div>

          <div id="saved-places-block" style="display: none; margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--color-border);">
            <div style="font-size: 13px; font-weight: 700; color: var(--color-text-primary); margin-bottom: 6px;">Saved Places (Stored locally on your device only):</div>
            <ul id="saved-places-list" style="margin: 0; padding-left: 20px; font-size: 13px; color: var(--color-text-secondary);"></ul>
          </div>
        </div>
      </details>

      <!-- Accuracy Feedback -->
      <div class="accuracy-feedback-row" id="feedback-row">
        <span class="feedback-label">Was this location accurate?</span>
        <button type="button" class="feedback-pill-btn" id="feedback-yes">Yes</button>
        <button type="button" class="feedback-pill-btn" id="feedback-no">No, incorrect</button>
        <span class="feedback-msg" id="feedback-msg" style="display: none;"></span>
      </div>
    </div>
  </section>

