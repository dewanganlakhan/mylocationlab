---
/**
 * ToolsPageView — Multilingual /tools/ Engine
 * Renders localized tools directory for en, es, fr, de, pt.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ToolCard from './ToolCard.astro';
import FAQAccordion from './FAQAccordion.astro';
import { tools, toolCategories, getToolsByCategory } from '../data/tools.js';
import { toolsPageTranslations } from '../i18n/toolsPage';
import { useTranslations } from '../i18n/ui';
import { defaultLang, getLocalizedPath, type SupportedLang } from '../i18n/config';

interface Props {
  lang?: SupportedLang | string;
}

const { lang: customLang = defaultLang } = Astro.props;
const lang = (customLang in toolsPageTranslations ? customLang : defaultLang) as SupportedLang;
const content = toolsPageTranslations[lang] || toolsPageTranslations.en;
const t = useTranslations(lang);

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: `${content.pageTitle} ${content.pageTitleAccent}` },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: content.directoryName,
  description: content.directoryDesc,
  itemListElement: tools.map((tool, index) => {
    const locTool = content.tools[tool.id] || tool;
    return {
      '@type': 'ListItem',
      position: index + 1,
      name: locTool.title,
      description: locTool.description,
      url: `https://mylocationlab.com${tool.url}`,
    };
  }),
};
---

<BaseLayout 
  lang={lang}
  title={content.metaTitle} 
  description={content.metaDesc} 
  activeSection="tools"
  jsonLd={[itemListSchema]}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />

    <section class="page-header" style="text-align: center; margin-bottom: var(--space-8);">
      <h1>{content.pageTitle} <span class="text-gradient">{content.pageTitleAccent}</span></h1>
      <p class="page-header-desc" style="max-width: 650px; margin: 0 auto;">
        {content.pageDesc}
      </p>
      <div style="margin-top: var(--space-4);">
        <a href={getLocalizedPath('/glossary/', lang)} class="badge badge-neutral" style="text-decoration: none; font-size: var(--text-sm); padding: var(--space-2) var(--space-4);">
          📖 {t('footer.link.glossary') || 'Explore our Geospatial & GPS Glossary →'}
        </a>
      </div>
    </section>

    {toolCategories.map((cat) => {
      const catTools = getToolsByCategory(cat.id);
      if (catTools.length === 0) return null;
      const categoryName = content.categories[cat.id] || cat.name;

      return (
        <section class="section-sm" style="margin-bottom: var(--space-10);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-6); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-3);">
            <h2 style="font-size: var(--text-2xl); display: flex; align-items: center; gap: var(--space-2); margin: 0;">
              <span style="display: inline-flex; align-items: center; color: var(--color-accent-primary);">
                {cat.id === 'location' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                )}
                {cat.id === 'conversion' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>
                )}
                {cat.id === 'calculation' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
                )}
                {cat.id === 'sharing' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                )}
                {cat.id === 'utility' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                )}
              </span>
              <span>{categoryName}</span>
            </h2>
            <span class="badge badge-neutral">{catTools.length} {catTools.length === 1 ? 'Tool' : 'Tools'}</span>
          </div>
          <div class="grid grid-auto">
            {catTools.map((tool) => {
              const loc = content.tools[tool.id] || tool;
              return (
                <ToolCard
                  title={loc.title}
                  description={loc.description}
                  icon={tool.icon}
                  url={tool.url}
                  lang={lang}
                />
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="section" style="margin-top: var(--space-12);">
      <div class="section-header">
        <h2>{content.faqTitle} <span class="text-gradient">{content.faqTitleAccent}</span></h2>
        <p>{content.faqSubtitle}</p>
      </div>
      <div style="max-width: var(--max-width-narrow); margin: 0 auto;">
        <FAQAccordion items={content.faqItems} />
      </div>
    </section>
  </div>
</BaseLayout>
