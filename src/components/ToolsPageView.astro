---
/**
 * ToolsPageView — Multilingual /tools/ Engine
 * Renders compact, list-based tools directory for en, es, fr, de, pt.
 * All tools visible above the fold on desktop without scrolling.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import FAQAccordion from './FAQAccordion.astro';
import { tools } from '../data/tools.js';
import { toolsPageTranslations } from '../i18n/toolsPage';
import { useTranslations } from '../i18n/ui';
import { defaultLang, getLocalizedPath, type SupportedLang } from '../i18n/config';

interface Props {
  lang?: SupportedLang | string;
}

const { lang: customLang = defaultLang } = Astro.props;
const lang = (customLang in toolsPageTranslations ? customLang : defaultLang) as SupportedLang;
const content = toolsPageTranslations[lang] || toolsPageTranslations.en;
const t = useTranslations(lang);

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: `${content.pageTitle} ${content.pageTitleAccent}` },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: content.directoryName,
  description: content.directoryDesc,
  itemListElement: tools.map((tool, index) => {
    const locTool = content.tools[tool.id] || tool;
    return {
      '@type': 'ListItem',
      position: index + 1,
      name: locTool.title,
      description: locTool.description,
      url: `https://mylocationlab.com${tool.url}`,
    };
  }),
};
---

<BaseLayout 
  lang={lang}
  title={content.metaTitle} 
  description={content.metaDesc} 
  activeSection="tools"
  jsonLd={[itemListSchema]}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />

    <!-- Compact Page Header -->
    <header class="tools-page-header">
      <div class="tools-header-meta">
        <h1>{content.pageTitle} <span class="text-gradient">{content.pageTitleAccent}</span></h1>
        <p class="tools-header-desc">{content.pageDesc}</p>
      </div>
      <a href={getLocalizedPath('/glossary/', lang)} class="tools-glossary-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
          <path d="M6 6h10"/>
          <path d="M6 10h10"/>
        </svg>
        <span>{t('footer.link.glossary') || 'Glossary'}</span>
      </a>
    </header>

    <!-- Compact Tools List Directory: All 10 tools visible without scrolling on desktop -->
    <section class="tools-directory-section" aria-label="Tools Directory">
      <div class="tools-list-grid" role="list">
        {tools.map((tool, index) => {
          const loc = content.tools[tool.id] || tool;
          const categoryName = content.categories[tool.category] || tool.category;
          const numStr = String(index + 1).padStart(2, '0');

          return (
            <a
              href={getLocalizedPath(tool.url, lang)}
              class="tool-list-item"
              role="listitem"
            >
              <div class="tool-list-lead">
                <span class="tool-list-num figure">{numStr}</span>
                <span class="tool-list-title">{loc.title}</span>
              </div>
              <div class="tool-list-tail">
                <span class="tool-list-tag">{categoryName}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tool-list-arrow" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- FAQ Section (Accessible below fold) -->
    <section class="tools-faq-section">
      <div class="section-header">
        <h2>{content.faqTitle} <span class="text-gradient">{content.faqTitleAccent}</span></h2>
        <p>{content.faqSubtitle}</p>
      </div>
      <div style="max-width: var(--max-width-narrow); margin: 0 auto;">
        <FAQAccordion items={content.faqItems} />
      </div>
    </section>
  </div>

  <style>
    :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
    button:active, a:active { transform: translateY(1px); }
    button:disabled, a[aria-disabled="true"] { opacity: 0.5; cursor: not-allowed; }

    h1, h2, h3 {
      overflow-wrap: break-word;
      min-width: 0;
      text-wrap: balance;
    }

    .tools-page-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-4);
      flex-wrap: wrap;
      padding-top: var(--space-2);
      padding-bottom: var(--space-3);
      border-bottom: var(--rule-bar) solid var(--color-rule);
      margin-bottom: var(--space-4);
    }

    .tools-header-meta h1 {
      font-size: var(--text-display);
      line-height: 1.15;
      margin: 0 0 var(--space-1);
      text-align: left;
    }

    .tools-header-desc {
      font-size: var(--text-sm);
      color: var(--color-text-secondary);
      margin: 0;
      max-width: 620px;
      line-height: 1.45;
    }

    .tools-glossary-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      border: var(--rule-hair) solid var(--color-rule);
      border-radius: var(--radius-pill);
      background: var(--color-paper-2);
      color: var(--color-ink);
      font-size: var(--text-xs);
      font-weight: 600;
      text-decoration: none;
      transition: background-color var(--dur-micro) steps(1), border-color var(--dur-micro) steps(1), color var(--dur-micro) steps(1);
      white-space: nowrap;
    }

    .tools-glossary-link:hover {
      background: var(--color-paper-3);
      border-color: var(--color-ink);
      color: var(--color-accent);
    }

    /* Compact 2-column tools list: exactly 5 rows on desktop, completely fits above the fold */
    .tools-directory-section {
      margin-bottom: var(--space-8);
    }

    .tools-list-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2) var(--space-3);
    }

    .tool-list-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding: var(--space-3) var(--space-4);
      background: var(--color-bg-card);
      border: var(--rule-hair) solid var(--color-rule);
      border-radius: var(--radius-card);
      text-decoration: none;
      color: var(--color-ink);
      transition: background-color var(--dur-micro) steps(1), border-color var(--dur-micro) steps(1);
      min-height: 48px;
    }

    .tool-list-item:hover {
      background: var(--color-paper-3);
      border-color: var(--color-ink);
      color: var(--color-ink);
    }

    .tool-list-lead {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      min-width: 0;
    }

    .tool-list-num {
      font-size: var(--text-xs);
      font-weight: 700;
      color: var(--color-muted);
      font-variant-numeric: tabular-nums;
      font-feature-settings: 'tnum' on, 'lnum' on;
      letter-spacing: -0.01em;
      flex-shrink: 0;
    }

    .tool-list-item:hover .tool-list-num {
      color: var(--color-accent);
    }

    .tool-list-title {
      font-family: var(--font-display);
      font-size: var(--text-sm);
      font-weight: 700;
      color: var(--color-text-heading);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .tool-list-tail {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      flex-shrink: 0;
    }

    .tool-list-tag {
      font-size: 11px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: var(--radius-pill);
      background: var(--color-paper-2);
      border: var(--rule-hair) solid var(--color-rule);
      color: var(--color-muted);
      letter-spacing: normal;
      text-transform: none;
      white-space: nowrap;
    }

    .tool-list-arrow {
      color: var(--color-muted);
      transition: transform var(--dur-short) var(--ease-out), color var(--dur-micro) steps(1);
      flex-shrink: 0;
    }

    .tool-list-item:hover .tool-list-arrow {
      transform: translateX(3px);
      color: var(--color-accent);
    }

    .tools-faq-section {
      padding-top: var(--space-8);
      border-top: var(--rule-hair) solid var(--color-rule);
    }

    @media (max-width: 768px) {
      .tools-list-grid {
        grid-template-columns: 1fr;
        gap: var(--space-2);
      }

      .tools-page-header {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-3);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</BaseLayout>
