---
/**
 * MapsView — Multilingual Interactive Maps View
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import AuthorEAT from './AuthorEAT.astro';
import { getLocalizedPath, type SupportedLang, defaultLang } from '../i18n/config';
import { mapsPageTranslations } from '../i18n/mapsPage';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const c = mapsPageTranslations[lang] || mapsPageTranslations.en;

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: c.breadcrumb }
];

const pageUrl = getLocalizedPath('/maps/', lang);
const mapSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: c.metaTitle,
  description: c.metaDescription,
  url: `https://mylocationlab.com${pageUrl}`,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  activeSection="maps"
  leaflet
  jsonLd={[mapSchema]}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />

    <section class="page-header" style="margin-bottom: var(--space-6);">
      <h1>{c.titlePrefix} <span class="text-gradient">{c.titleHighlight}</span></h1>
      <p class="page-header-desc">
        {c.subtitle}
      </p>
    </section>

    <AuthorEAT 
      reviewedBy="MyLocationLab Editorial Team" 
      reviewerTitle={c.eatRole} 
      lastUpdated="September 2026" 
    />

    <!-- Interactive Map Controller Card -->
    <div class="tool-interface" style="margin-bottom: var(--space-6);">
      <div class="flex gap-3 flex-wrap items-center justify-between" style="margin-bottom: var(--space-4);">
        <div class="flex gap-2 flex-wrap items-center" style="flex: 1; min-width: 280px;">
          <input
            type="text"
            id="map-search-input"
            class="input"
            placeholder="🔍 Search address, city, or coordinates to jump..."
            style="flex: 1; min-width: 200px; padding: 6px 12px; font-size: var(--text-sm);"
          />
          <button class="btn btn-secondary btn-sm" id="map-search-btn" type="button">Jump</button>
          <button class="btn btn-primary btn-sm" id="map-locate-btn" type="button">{c.centerBtn}</button>
          <button class="btn btn-ghost btn-sm" id="map-clear-pins" type="button">{c.clearBtn}</button>
        </div>

        <div class="flex gap-2 flex-wrap items-center">
          <span style="font-size: var(--text-xs); color: var(--color-text-secondary);">{c.radiusLabel}</span>
          <select id="map-radius-select" class="input" style="padding: 4px 8px; font-size: var(--text-xs); width: auto;">
            <option value="0">{c.radiusNone}</option>
            <option value="500">500 m (0.31 mi)</option>
            <option value="1000" selected>1,000 m (0.62 mi)</option>
            <option value="5000">5,000 m (3.1 mi)</option>
            <option value="10000">10,000 m (6.2 mi)</option>
          </select>
        </div>
      </div>

      <!-- Live Inspector Bar -->
      <div style="background: var(--color-bg-tertiary); padding: var(--space-3) var(--space-4); border-radius: var(--radius-lg); font-size: var(--text-sm); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-2); border: 1px solid var(--color-border);">
        <div style="display: flex; align-items: center; gap: var(--space-2);">
          <span style="color: var(--color-accent-primary);">{c.selectedPoint}</span>
          <span id="map-coords-display" style="font-family: var(--font-mono); font-weight: 600;">{c.clickPrompt}</span>
        </div>
        <button class="btn btn-ghost btn-xs" id="map-copy-coords" type="button" style="display: none;">{c.copyBtn}</button>
      </div>
    </div>

    <!-- Map Canvas with Strict Min-Height (Zero CLS) -->
    <div 
      class="map-container" 
      id="main-leaflet-map" 
      data-locate-title={c.centerBtn || 'Zoom to my current location'}
      style="width: 100%; min-height: 520px; border-radius: var(--radius-2xl); border: 1px solid var(--color-border); box-shadow: var(--shadow-glow); margin-bottom: var(--space-12);"
    ></div>

    <!-- Educational & Technical Content -->
    <article class="prose" style="max-width: var(--max-width-narrow); margin-bottom: var(--space-16);">
      <h2>{c.h2Projections}</h2>
      <p>{c.pProjections}</p>

      <h3>{c.h3Radius}</h3>
      <p>{c.pRadius}</p>

      <h2>{c.h2Connected}</h2>
      <ul>
        <li><a href={getLocalizedPath('/tools/distance-calculator/', lang)}>{c.tool1Desc}</a></li>
        <li><a href={getLocalizedPath('/tools/address-finder/', lang)}>{c.tool2Desc}</a></li>
        <li><a href={getLocalizedPath('/tools/coordinate-converter/', lang)}>{c.tool3Desc}</a></li>
        <li><a href={getLocalizedPath('/guides/how-gps-location-works/', lang)}>{c.tool4Desc}</a></li>
      </ul>
    </article>
  </div>

  <script>
    import GeoLocation from '../scripts/geolocation.js';
    import MapUtils from '../scripts/map.js';
    import Geocoding from '../scripts/geocoding.js';
    import CoordUtils from '../scripts/coordinates.js';

    let map: any = null;
    let userMarker: any = null;
    let radiusCircle: any = null;
    let selectedMarker: any = null;
    let currentCoords: any = null;

    const coordsDisplay = document.getElementById('map-coords-display');
    const copyBtn = document.getElementById('map-copy-coords');
    const locateBtn = document.getElementById('map-locate-btn');
    const clearBtn = document.getElementById('map-clear-pins');
    const radiusSelect = document.getElementById('map-radius-select') as HTMLSelectElement;

    const locateTitle = document.getElementById('main-leaflet-map')?.getAttribute('data-locate-title') || document.getElementById('map-locate-btn')?.textContent?.trim() || 'Zoom to my current location';

    function initMap() {
      // @ts-ignore
      if (typeof L === 'undefined') {
        setTimeout(initMap, 200);
        return;
      }

      // @ts-ignore
      map = L.map('main-leaflet-map', {
        zoomControl: true,
        scrollWheelZoom: true,
      }).setView([20, 0], 2);

      // @ts-ignore
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);

      MapUtils.addLocateControl(map, {
        title: locateTitle,
        zoom: 16,
        onLocate: () => locateUser(true),
      });

      // Click to pin & inspect coordinates
      map.on('click', (e: any) => {
        const { lat, lng } = e.latlng;
        currentCoords = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;

        if (coordsDisplay) coordsDisplay.textContent = currentCoords;
        if (copyBtn) {
          copyBtn.style.display = 'inline-block';
          copyBtn.textContent = '📋 Copy';
        }

        if (selectedMarker) {
          selectedMarker.setLatLng(e.latlng);
        } else {
          // @ts-ignore
          selectedMarker = L.marker(e.latlng).addTo(map);
        }

        selectedMarker.bindPopup(`<strong>Point:</strong><br>${currentCoords}`).openPopup();
      });

      // Try automatic geo-location
      locateUser(false);
    }

    async function locateUser(zoomIn = true) {
      if (!map) return;
      try {
        const pos = await GeoLocation.getCurrentPosition({ enableHighAccuracy: true });
        const latLng = [pos.latitude, pos.longitude];

        if (userMarker) {
          userMarker.setLatLng(latLng);
        } else {
          // @ts-ignore
          userMarker = L.circleMarker(latLng, {
            radius: 8,
            fillColor: '#3b82f6',
            color: '#ffffff',
            weight: 3,
            opacity: 1,
            fillOpacity: 0.9,
          }).addTo(map);
          userMarker.bindPopup('<strong>📍 Your Location</strong>').openPopup();
        }

        updateRadiusCircle(pos.latitude, pos.longitude);

        if (zoomIn) {
          map.setView(latLng, 14);
        } else {
          map.setView(latLng, 11);
        }
      } catch (e) {
        // Fallback or user declined
      }
    }

    function updateRadiusCircle(lat: number, lng: number) {
      if (!map) return;
      const radius = radiusSelect ? parseInt(radiusSelect.value, 10) : 1000;

      if (radiusCircle) {
        map.removeLayer(radiusCircle);
        radiusCircle = null;
      }

      if (radius > 0) {
        // @ts-ignore
        radiusCircle = L.circle([lat, lng], {
          radius: radius,
          color: '#3b82f6',
          fillColor: '#3b82f6',
          fillOpacity: 0.12,
          weight: 2,
        }).addTo(map);
      }
    }

    if (locateBtn) {
      locateBtn.addEventListener('click', () => locateUser(true));
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (selectedMarker && map) {
          map.removeLayer(selectedMarker);
          selectedMarker = null;
        }
        if (coordsDisplay) coordsDisplay.textContent = 'Click anywhere on the map';
        if (copyBtn) copyBtn.style.display = 'none';
      });
    }

    async function jumpToSearch() {
      const input = document.getElementById('map-search-input') as HTMLInputElement;
      const query = input?.value?.trim();
      if (!query || !map) return;

      // Check if user entered numeric coordinates
      const parsed = CoordUtils.parseCoordinates(query);
      if (parsed && CoordUtils.isValidCoordinate(parsed.lat, parsed.lng)) {
        const latLng = [parsed.lat, parsed.lng];
        map.flyTo(latLng, 14);
        if (selectedMarker) {
          selectedMarker.setLatLng(latLng);
        } else {
          // @ts-ignore
          selectedMarker = L.marker(latLng).addTo(map);
        }
        currentCoords = `${parsed.lat.toFixed(6)}, ${parsed.lng.toFixed(6)}`;
        if (coordsDisplay) coordsDisplay.textContent = currentCoords;
        selectedMarker.bindPopup(`<strong>Point:</strong><br>${currentCoords}`).openPopup();
        return;
      }

      // Forward geocode address or city
      try {
        const results = await Geocoding.forwardGeocode(query);
        if (results && results.length > 0) {
          const first = results[0];
          const latLng = [first.lat, first.lng];
          map.flyTo(latLng, 13);
          if (selectedMarker) {
            selectedMarker.setLatLng(latLng);
          } else {
            // @ts-ignore
            selectedMarker = L.marker(latLng).addTo(map);
          }
          currentCoords = `${first.lat.toFixed(6)}, ${first.lng.toFixed(6)}`;
          if (coordsDisplay) coordsDisplay.textContent = `${first.displayName} (${currentCoords})`;
          selectedMarker.bindPopup(`<strong>${first.displayName}</strong><br>${currentCoords}`).openPopup();
        } else {
          alert('Location not found. Please try entering a different city, address, or coordinates.');
        }
      } catch {
        alert('Unable to search address at this time.');
      }
    }

    document.getElementById('map-search-btn')?.addEventListener('click', jumpToSearch);
    document.getElementById('map-search-input')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        jumpToSearch();
      }
    });

    if (radiusSelect) {
      radiusSelect.addEventListener('change', () => {
        if (userMarker) {
          const latLng = userMarker.getLatLng();
          updateRadiusCircle(latLng.lat, latLng.lng);
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        if (!currentCoords) return;
        navigator.clipboard.writeText(currentCoords).then(() => {
          copyBtn.textContent = '✅ Copied!';
          setTimeout(() => { copyBtn.textContent = '📋 Copy'; }, 2000);
        });
      });
    }

    initMap();
  </script>
</BaseLayout>
