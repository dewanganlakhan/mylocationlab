---
/**
 * LocationFinder — Reusable location detection component
 * Used across all my-location sub-pages with configurable emphasis fields.
 */
import { getLangFromUrl, defaultLang, type SupportedLang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  emphasisField?: string;
  showMap?: boolean;
  showAllFields?: boolean;
  lang?: string;
}

const { emphasisField = '', showMap = true, showAllFields = true, lang: customLang } = Astro.props;
const lang = (customLang || getLangFromUrl(Astro.url)) as SupportedLang;
const t = useTranslations(lang);

const labels: Record<string, any> = {
  en: {
    header: 'Your Location', ready: 'Ready', loading: 'Detecting location...',
    lat: 'Latitude', lng: 'Longitude', address: 'Address', city: 'City',
    state: 'State / Region', country: 'Country', accuracy: 'Accuracy', altitude: 'Altitude',
    copy: 'Copy Coordinates', share: 'Share', openInMaps: 'Open in Maps', refresh: 'Refresh',
    locateTitle: 'Zoom to my current location',
    errBadge: 'Error', tryAgain: 'Try Again', getLoc: 'Get My Location',
    copied: 'Copied!', copyField: 'Copy',
    detectedCity: 'Your Current City',
    detectedState: 'Your Current State / Region',
    detectedCountry: 'Your Current Country',
    detectedAddress: 'Your Current Address',
    copyAddress: 'Copy Full Address',
    shareWhatsApp: 'WhatsApp'
  },
  es: {
    header: 'Su Ubicación', ready: 'Listo', loading: 'Detectando ubicación...',
    lat: 'Latitud', lng: 'Longitud', address: 'Dirección', city: 'Ciudad',
    state: 'Estado / Provincia', country: 'País', accuracy: 'Precisión', altitude: 'Altitud',
    copy: 'Copiar Coordenadas', share: 'Compartir', openInMaps: 'Abrir en Mapas', refresh: 'Actualizar',
    locateTitle: 'Centrar y ampliar en mi ubicación',
    errBadge: 'Error', tryAgain: 'Reintentar', getLoc: 'Obtener Mi Ubicación',
    copied: '¡Copiado!', copyField: 'Copiar',
    detectedCity: 'Su Ciudad Actual',
    detectedState: 'Su Estado o Provincia Actual',
    detectedCountry: 'Su País Actual',
    detectedAddress: 'Su Dirección Actual',
    copyAddress: 'Copiar Dirección Completa',
    shareWhatsApp: 'WhatsApp'
  },
  fr: {
    header: 'Votre Position', ready: 'Prêt', loading: 'Détection de la position...',
    lat: 'Latitude', lng: 'Longitude', address: 'Adresse', city: 'Ville',
    state: 'Région / Département', country: 'Pays', accuracy: 'Précision', altitude: 'Altitude',
    copy: 'Copier Coordennées', share: 'Partager', openInMaps: 'Ouvrir dans Maps', refresh: 'Actualiser',
    locateTitle: 'Zoomer sur ma position actuelle',
    errBadge: 'Erreur', tryAgain: 'Réessayer', getLoc: 'Obtenir Ma Position',
    copied: 'Copié !', copyField: 'Copier',
    detectedCity: 'Votre Ville Actuelle',
    detectedState: 'Votre Région / Département Actuel',
    detectedCountry: 'Votre Pays Actuel',
    detectedAddress: 'Votre Adresse Actuelle',
    copyAddress: 'Copier l\'Adresse Complète',
    shareWhatsApp: 'WhatsApp'
  },
  de: {
    header: 'Ihr Standort', ready: 'Bereit', loading: 'Standort wird ermittelt...',
    lat: 'Breitengrad', lng: 'Längengrad', address: 'Adresse', city: 'Stadt',
    state: 'Bundesland / Region', country: 'Land', accuracy: 'Genauigkeit', altitude: 'Höhe',
    copy: 'Koordinaten kopieren', share: 'Teilen', openInMaps: 'In Karten öffnen', refresh: 'Aktualisieren',
    locateTitle: 'Auf meinen aktuellen Standort zoomen',
    errBadge: 'Fehler', tryAgain: 'Erneut versuchen', getLoc: 'Meinen Standort abrufen',
    copied: 'Kopiert!', copyField: 'Kopieren',
    detectedCity: 'Ihre aktuelle Stadt',
    detectedState: 'Ihr aktuelles Bundesland / Region',
    detectedCountry: 'Ihr aktuelles Land',
    detectedAddress: 'Ihre aktuelle Adresse',
    copyAddress: 'Vollständige Adresse kopieren',
    shareWhatsApp: 'WhatsApp'
  },
  pt: {
    header: 'Sua Localização', ready: 'Pronto', loading: 'Detectando localização...',
    lat: 'Latitude', lng: 'Longitude', address: 'Endereço', city: 'Cidade',
    state: 'Estado', country: 'País', accuracy: 'Precisão', altitude: 'Altitude',
    copy: 'Copiar Coordenadas', share: 'Compartilhar', openInMaps: 'Abrir no Maps', refresh: 'Atualizar',
    locateTitle: 'Aproximar da minha localização atual',
    errBadge: 'Erro', tryAgain: 'Tentar novamente', getLoc: 'Obter Minha Localização',
    copied: 'Copiado!', copyField: 'Copiar',
    detectedCity: 'Sua Cidade Atual',
    detectedState: 'Seu Estado Atual',
    detectedCountry: 'Seu País Atual',
    detectedAddress: 'Seu Endereço Atual',
    copyAddress: 'Copiar Endereço Completo',
    shareWhatsApp: 'WhatsApp'
  },
  hi: {
    header: 'आपकी लोकेशन', ready: 'तैयार', loading: 'लोकेशन पहचानी जा रही है...',
    lat: 'अक्षांश', lng: 'देशांतर', address: 'पता', city: 'शहर',
    state: 'राज्य / क्षेत्र', country: 'देश', accuracy: 'सटीकता', altitude: 'ऊँचाई',
    copy: 'निर्देशांक कॉपी करें', share: 'साझा करें', openInMaps: 'नक्शों में खोलें', refresh: 'रिफ़्रेश',
    locateTitle: 'मेरी वर्तमान लोकेशन पर ज़ूम करें',
    errBadge: 'त्रुटि', tryAgain: 'पुन: प्रयास करें', getLoc: 'मेरी लोकेशन प्राप्त करें',
    copied: 'कॉपी किया गया!', copyField: 'कॉपी करें',
    detectedCity: 'आपका वर्तमान शहर',
    detectedState: 'आपका वर्तमान राज्य / क्षेत्र',
    detectedCountry: 'आपका वर्तमान देश',
    detectedAddress: 'आपका वर्तमान पता',
    copyAddress: 'पूरा पता कॉपी करें',
    shareWhatsApp: 'WhatsApp'
  },
  id: {
    header: 'Lokasi Anda', ready: 'Siap', loading: 'Mendeteksi lokasi...',
    lat: 'Lintang', lng: 'Bujur', address: 'Alamat', city: 'Kota',
    state: 'Provinsi / Wilayah', country: 'Negara', accuracy: 'Akurasi', altitude: 'Ketinggian',
    copy: 'Salin Koordinat', share: 'Bagikan', openInMaps: 'Buka di Peta', refresh: 'Segarkan',
    locateTitle: 'Perbesar ke lokasi saya saat ini',
    errBadge: 'Kesalahan', tryAgain: 'Coba Lagi', getLoc: 'Dapatkan Lokasi Saya',
    copied: 'Tersalin!', copyField: 'Salin',
    detectedCity: 'Kota Anda Saat Ini',
    detectedState: 'Provinsi / Wilayah Anda Saat Ini',
    detectedCountry: 'Negara Anda Saat Ini',
    detectedAddress: 'Alamat Anda Saat Ini',
    copyAddress: 'Salin Alamat Lengkap',
    shareWhatsApp: 'WhatsApp'
  }
};

const l = labels[lang] || labels.en;
---

<div
  class="location-display"
  id="loc-finder"
  data-err-badge={l.errBadge}
  data-try-again={l.tryAgain}
  data-get-loc={l.getLoc}
  data-ready={l.ready}
  data-copied={l.copied}
  data-lang={lang}
  data-emphasis={emphasisField}
  data-share-header={l.detectedAddress || l.address}
>
  <div class="location-display-header">
    <div class="location-display-dot" id="loc-dot" style="background: var(--color-text-tertiary);"></div>
    <span class="location-display-title">{l.header}</span>
    <span class="badge" id="loc-badge" data-nosnippet>{l.ready}</span>
  </div>

  <div id="loc-prompt" style="display: none; text-align: center; padding: var(--space-4) 0;">
    <button class="btn btn-primary btn-lg" id="loc-btn" type="button" style="display: inline-flex; align-items: center; justify-content: center; gap: 8px;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="3 11 22 2 13 21 11 13 3 11" fill="currentColor" stroke="none" />
      </svg>
      <span>{t('hero.btnGetLocation')}</span>
    </button>
  </div>

  <div id="loc-loading" style="display: none; text-align: center; padding: var(--space-4);">
    <div class="spinner" style="margin: 0 auto var(--space-3);"></div>
    <p style="color: var(--color-text-secondary); margin: 0; font-size: var(--text-sm);">{l.loading}</p>
  </div>

  <p
    id="loc-error"
    data-nosnippet
    style="display: none; margin: var(--space-3) 0 0; text-align: center; color: var(--color-accent-error, #ef4444); font-size: var(--text-sm);"
    role="alert"
    aria-live="polite"
  ></p>

  <div id="loc-acc-warn" style="display: none; background: #fffbeb; border: 1px solid #fde68a; color: #92400e; padding: 8px 12px; border-radius: var(--radius-md); font-size: var(--text-xs); margin: var(--space-3) 0; text-align: center;">
    ⚠️ Estimated location (accuracy ±<span id="loc-acc-warn-val"></span>). Step outside for direct GPS satellite precision.
  </div>

  <div id="loc-troubleshoot" style="display: none; margin: var(--space-4) 0; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4); text-align: left; font-size: var(--text-xs);">
    <strong style="color: var(--color-text-primary); display: block; margin-bottom: 6px;">🧭 How to re-enable location permission:</strong>
    <ul style="margin: 0; padding-left: 18px; color: var(--color-text-secondary); line-height: 1.6;">
      <li><strong>Chrome:</strong> Tap lock 🔒 in URL bar &rarr; Permissions &rarr; Location &rarr; Allow &rarr; Refresh.</li>
      <li><strong>Safari (iPhone):</strong> Settings &rarr; Safari &rarr; Location &rarr; Allow (or tap "aA" in address bar).</li>
      <li><strong>Device Settings:</strong> Turn Location Services ON in your phone / computer settings.</li>
    </ul>
    <div style="margin-top: 10px; display: flex; gap: 8px;">
      <button type="button" class="btn btn-primary btn-sm" id="loc-retry-btn">🔄 Retry GPS</button>
      <button type="button" class="btn btn-secondary btn-sm" id="loc-ip-btn">🌐 Use IP Location</button>
    </div>
  </div>

  {emphasisField === 'city' && (
    <div class="emphasis-hero-card" id="emphasis-hero-city" style="display: none;">
      <span class="emphasis-hero-badge">📍 {l.detectedCity}</span>
      <div class="emphasis-hero-val" id="hero-city-val">—</div>
      <p class="emphasis-hero-sub" id="hero-city-sub"></p>
    </div>
  )}
  {emphasisField === 'state' && (
    <div class="emphasis-hero-card" id="emphasis-hero-state" style="display: none;">
      <span class="emphasis-hero-badge">🏛️ {l.detectedState}</span>
      <div class="emphasis-hero-val" id="hero-state-val">—</div>
      <p class="emphasis-hero-sub" id="hero-state-sub"></p>
    </div>
  )}
  {emphasisField === 'country' && (
    <div class="emphasis-hero-card" id="emphasis-hero-country" style="display: none;">
      <span class="emphasis-hero-badge">🌍 {l.detectedCountry}</span>
      <div class="emphasis-hero-val" id="hero-country-val">—</div>
      <p class="emphasis-hero-sub" id="hero-country-sub"></p>
    </div>
  )}
  {emphasisField === 'address' && (
    <div class="emphasis-hero-card" id="emphasis-hero-address" style="display: none;">
      <span class="emphasis-hero-badge">🏠 {l.detectedAddress || l.address}</span>
      <div class="emphasis-hero-val" id="hero-address-val" style="font-size: clamp(1.2rem, 3.2vw, 1.85rem); line-height: 1.35; word-break: break-word;">—</div>
      <p class="emphasis-hero-sub" id="hero-address-sub"></p>
      <div style="margin-top: var(--space-4); display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;">
        <button type="button" class="btn btn-primary btn-sm" id="hero-copy-address-btn" style="display: inline-flex; align-items: center; gap: 6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span id="hero-copy-text">{l.copyAddress || 'Copiar Endereço Completo'}</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm" id="hero-whatsapp-btn" style="display: inline-flex; align-items: center; gap: 6px;">
          <span>📲</span>
          <span>{l.shareWhatsApp || 'WhatsApp'}</span>
        </button>
      </div>
    </div>
  )}

  <div class="location-data-grid" id="loc-data" style="display: none;">
    <div class="location-data-item">
      <div class="location-data-label-row">
        <span class="location-data-label">{l.lat}</span>
        <button type="button" class="field-copy-btn" data-copy-target="loc-lat" title={l.copyField} aria-label={`Copy ${l.lat}`}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        </button>
      </div>
      <span class={`location-data-value ${emphasisField === 'lat' ? 'highlight' : ''}`} id="loc-lat">—</span>
    </div>
    <div class="location-data-item">
      <div class="location-data-label-row">
        <span class="location-data-label">{l.lng}</span>
        <button type="button" class="field-copy-btn" data-copy-target="loc-lng" title={l.copyField} aria-label={`Copy ${l.lng}`}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        </button>
      </div>
      <span class={`location-data-value ${emphasisField === 'lng' ? 'highlight' : ''}`} id="loc-lng">—</span>
    </div>
    {showAllFields && (
      <>
        <div class="location-data-item span-2">
          <div class="location-data-label-row">
            <span class="location-data-label">{l.address}</span>
            <button type="button" class="field-copy-btn" data-copy-target="loc-address" title={l.copyField} aria-label={`Copy ${l.address}`}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </button>
          </div>
          <span class={`location-data-value ${emphasisField === 'address' ? 'highlight' : ''}`} id="loc-address" style="font-family: var(--font-sans); font-size: var(--text-sm);">—</span>
        </div>
        <div class="location-data-item">
          <div class="location-data-label-row">
            <span class="location-data-label">{l.city}</span>
            <button type="button" class="field-copy-btn" data-copy-target="loc-city" title={l.copyField} aria-label={`Copy ${l.city}`}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </button>
          </div>
          <span class={`location-data-value ${emphasisField === 'city' ? 'highlight' : ''}`} id="loc-city" style="font-family: var(--font-sans);">—</span>
        </div>
        <div class="location-data-item">
          <div class="location-data-label-row">
            <span class="location-data-label">{l.state}</span>
            <button type="button" class="field-copy-btn" data-copy-target="loc-state" title={l.copyField} aria-label={`Copy ${l.state}`}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </button>
          </div>
          <span class={`location-data-value ${emphasisField === 'state' ? 'highlight' : ''}`} id="loc-state" style="font-family: var(--font-sans);">—</span>
        </div>
        <div class="location-data-item">
          <div class="location-data-label-row">
            <span class="location-data-label">{l.country}</span>
            <button type="button" class="field-copy-btn" data-copy-target="loc-country" title={l.copyField} aria-label={`Copy ${l.country}`}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </button>
          </div>
          <span class={`location-data-value ${emphasisField === 'country' ? 'highlight' : ''}`} id="loc-country" style="font-family: var(--font-sans);">—</span>
        </div>
      </>
    )}
    <div class="location-data-item">
      <div class="location-data-label-row">
        <span class="location-data-label">{l.accuracy}</span>
        <button type="button" class="field-copy-btn" data-copy-target="loc-accuracy" title={l.copyField} aria-label={`Copy ${l.accuracy}`}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        </button>
      </div>
      <span class="location-data-value" id="loc-accuracy">—</span>
    </div>
    <div class="location-data-item">
      <div class="location-data-label-row">
        <span class="location-data-label">{l.altitude}</span>
        <button type="button" class="field-copy-btn" data-copy-target="loc-altitude" title={l.copyField} aria-label={`Copy ${l.altitude}`}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        </button>
      </div>
      <span class="location-data-value" id="loc-altitude">—</span>
    </div>
  </div>

  <div class="action-buttons" id="loc-actions" style="margin-top: var(--space-6); display: none;">
    <button class="btn btn-secondary btn-sm" id="loc-copy" type="button" style="display: inline-flex; align-items: center; gap: 6px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
      </svg>
      <span>{l.copy}</span>
    </button>
    <button class="btn btn-secondary btn-sm" id="loc-share" type="button" style="display: inline-flex; align-items: center; gap: 6px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="18" cy="5" r="3"/>
        <circle cx="6" cy="12" r="3"/>
        <circle cx="18" cy="19" r="3"/>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
      </svg>
      <span>{l.share}</span>
    </button>
    <a class="btn btn-secondary btn-sm" id="loc-wa" href="#" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 6px;">
      <span>📲</span>
      <span>{l.shareWhatsApp || 'WhatsApp'}</span>
    </a>
    <a class="btn btn-secondary btn-sm" id="loc-maps" href="#" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 6px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
        <line x1="9" y1="3" x2="9" y2="18"/>
        <line x1="15" y1="6" x2="15" y2="21"/>
      </svg>
      <span>{l.openInMaps}</span>
    </a>
    <button class="btn btn-ghost btn-sm" id="loc-refresh" type="button" style="display: inline-flex; align-items: center; gap: 6px;">
      <span>🔄 {l.refresh || 'Refresh'}</span>
    </button>
  </div>
</div>

{showMap && <div class="map-container" id="loc-map" data-locate-title={l.locateTitle} style="margin-top: var(--space-6);"></div>}

<style>
  .location-data-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    margin-bottom: 2px;
  }
  .field-copy-btn {
    background: transparent;
    border: none;
    color: var(--color-text-tertiary);
    cursor: pointer;
    padding: 2px 4px;
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .field-copy-btn:hover {
    color: var(--color-accent-primary);
    background: var(--color-bg-tertiary);
  }
  .emphasis-hero-card {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(14, 165, 233, 0.04) 100%);
    border: 1px solid rgba(37, 99, 235, 0.25);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-5);
    text-align: center;
    margin: var(--space-4) 0 var(--space-6);
  }
  .emphasis-hero-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-primary);
    margin-bottom: var(--space-2);
  }
  .emphasis-hero-val {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    line-height: 1.2;
    margin: var(--space-1) 0 var(--space-2);
  }
  .emphasis-hero-sub {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>

<script>
  import GeoLocation from '../scripts/geolocation.js';
  import Geocoding from '../scripts/geocoding.js';
  import Sharing from '../scripts/sharing.js';
  import MapUtils from '../scripts/map.js';

  const locateTitles: Record<string, string> = {
    en: "Zoom to my current location",
    es: "Centrar y ampliar en mi ubicación",
    fr: "Zoomer sur ma position actuelle",
    de: "Auf meinen aktuellen Standort zoomen",
    pt: "Aproximar da minha localização atual",
    hi: "मेरी वर्तमान लोकेशन पर ज़ूम करें",
    id: "Perbesar ke lokasi saya saat ini"
  };
  const currentDocLang = document.documentElement.lang || 'en';
  const locateTitle = document.getElementById('loc-map')?.getAttribute('data-locate-title') || locateTitles[currentDocLang] || locateTitles.en;

  let cLat = null, cLng = null;

  function ensureMap(lat = null, lng = null, accuracy = 0, zoom = 15) {
    const mapEl = document.getElementById('loc-map');
    if (!mapEl) return;
    const waitL = () => {
      // @ts-ignore
      if (typeof L !== 'undefined') {
        // @ts-ignore
        if (!window._locMap) {
          const center = (lat !== null && lng !== null) ? [lat, lng] : [20, 0];
          const initialZoom = (lat !== null && lng !== null) ? zoom : 2;
          // @ts-ignore
          const m = L.map('loc-map', { scrollWheelZoom: false }).setView(center, initialZoom);
          // @ts-ignore
          window._locMap = m;
          // @ts-ignore
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap',
            maxZoom: 19
          }).addTo(m);

          MapUtils.addLocateControl(m, {
            title: locateTitle,
            zoom: 16,
            onLocate: () => locate(false),
          });
        }

        if (lat !== null && lng !== null) {
          // @ts-ignore
          window._locMap.flyTo([lat, lng], zoom, { animate: true, duration: 1.5 });
          // @ts-ignore
          if (window._locMap._userLocMarker) window._locMap.removeLayer(window._locMap._userLocMarker);
          // @ts-ignore
          if (window._locMap._userLocCircle) window._locMap.removeLayer(window._locMap._userLocCircle);

          // @ts-ignore
          const icon = L.divIcon({ html: '<div class="user-pulse-dot"></div>', className: 'user-pulse-marker', iconSize: [18, 18], iconAnchor: [9, 9] });
          // @ts-ignore
          window._locMap._userLocMarker = L.marker([lat, lng], { icon }).addTo(window._locMap);

          if (accuracy > 0) {
            // @ts-ignore
            window._locMap._userLocCircle = L.circle([lat, lng], {
              radius: accuracy,
              color: '#00d4ff',
              fillColor: '#00d4ff',
              fillOpacity: 0.1,
              weight: 1.5
            }).addTo(window._locMap);
          }
        }
      } else {
        setTimeout(waitL, 100);
      }
    };
    waitL();
  }

  async function locate(isAuto = false) {
    const finderEl = document.getElementById('loc-finder');
    const loading = document.getElementById('loc-loading');
    const prompt = document.getElementById('loc-prompt');
    const errorEl = document.getElementById('loc-error');
    const data = document.getElementById('loc-data');
    const actions = document.getElementById('loc-actions');
    const dot = document.getElementById('loc-dot');
    const badge = document.getElementById('loc-badge');

    if (prompt) prompt.style.display = 'none';
    if (errorEl) errorEl.style.display = 'none';
    if (loading) loading.style.display = 'block';

    try {
      const position = await GeoLocation.getCurrentPosition();
      const pos = GeoLocation.formatPosition(position);
      cLat = pos.latitude;
      cLng = pos.longitude;

      const latEl = document.getElementById('loc-lat');
      const lngEl = document.getElementById('loc-lng');
      const accEl = document.getElementById('loc-accuracy');
      const altEl = document.getElementById('loc-altitude');
      const mapsEl = document.getElementById('loc-maps');

      if (latEl) latEl.textContent = pos.formattedLat;
      if (lngEl) lngEl.textContent = pos.formattedLng;
      if (accEl) accEl.textContent = pos.formattedAccuracy;
      if (altEl) altEl.textContent = pos.altitude ? `${Math.round(pos.altitude)} m` : 'N/A';
      if (mapsEl) mapsEl.setAttribute('href', `https://www.google.com/maps?q=${cLat},${cLng}`);

      try {
        const addr = await Geocoding.reverseGeocode(cLat, cLng);
        const addrEl = document.getElementById('loc-address');
        const cityEl = document.getElementById('loc-city');
        const stateEl = document.getElementById('loc-state');
        const countryEl = document.getElementById('loc-country');

        if (addrEl) addrEl.textContent = addr.displayName || '—';
        if (cityEl) cityEl.textContent = addr.city || addr.town || addr.village || '—';
        if (stateEl) stateEl.textContent = addr.state || '—';
        if (countryEl) countryEl.textContent = addr.country || '—';

        // Populate intent hero cards if present
        const heroCity = document.getElementById('emphasis-hero-city');
        if (heroCity) {
          const val = document.getElementById('hero-city-val');
          const sub = document.getElementById('hero-city-sub');
          if (val) val.textContent = addr.city || addr.town || addr.village || addr.displayName || '—';
          if (sub) sub.textContent = [addr.county, addr.state, addr.country].filter(Boolean).join(', ');
          heroCity.style.display = 'block';
        }

        const heroState = document.getElementById('emphasis-hero-state');
        if (heroState) {
          const val = document.getElementById('hero-state-val');
          const sub = document.getElementById('hero-state-sub');
          if (val) val.textContent = addr.state || '—';
          if (sub) sub.textContent = [addr.country, addr.countryCode ? `(${addr.countryCode})` : ''].filter(Boolean).join(' ');
          heroState.style.display = 'block';
        }

        const heroCountry = document.getElementById('emphasis-hero-country');
        if (heroCountry) {
          const val = document.getElementById('hero-country-val');
          const sub = document.getElementById('hero-country-sub');
          if (val) val.textContent = addr.country || '—';
          if (sub) sub.textContent = addr.countryCode ? `ISO: ${addr.countryCode}` : '';
          heroCountry.style.display = 'block';
        }

        const heroAddress = document.getElementById('emphasis-hero-address');
        if (heroAddress) {
          const val = document.getElementById('hero-address-val');
          const sub = document.getElementById('hero-address-sub');

          const road = addr.road || '';
          const num = addr.houseNumber || '';
          const streetPart = road ? (num ? `${road}, ${num}` : road) : (addr.displayName?.split(',')[0] || '');
          const district = addr.neighbourhood || '';
          const city = addr.city || addr.town || addr.village || '';
          const state = addr.stateCode || addr.state || '';
          const cityState = [city, state].filter(Boolean).join(' - ');
          let rawPostcode = addr.postcode || '';
          if (rawPostcode && addr.countryCode === 'BR' && !rawPostcode.includes('-') && rawPostcode.length === 8) {
            rawPostcode = `${rawPostcode.slice(0, 5)}-${rawPostcode.slice(5)}`;
          }
          const postalLabel = addr.countryCode === 'BR' ? `CEP: ${rawPostcode}` : (addr.countryCode === 'US' ? `ZIP: ${rawPostcode}` : rawPostcode);

          if (val) val.textContent = streetPart || addr.displayName || '—';
          if (sub) {
            const subParts = [district, cityState, rawPostcode ? postalLabel : '', addr.country].filter(Boolean);
            sub.textContent = subParts.join(' • ');
          }
          heroAddress.style.display = 'block';

          // Format full standard address for copy and share
          const fullAddressParts = [];
          if (streetPart) fullAddressParts.push(streetPart);
          if (district) fullAddressParts.push(district);
          if (cityState) fullAddressParts.push(cityState);
          if (rawPostcode) fullAddressParts.push(postalLabel);
          if (addr.country) fullAddressParts.push(addr.country);
          const formattedFullAddress = fullAddressParts.join(', ') || addr.displayName || '';

          const copyBtn = document.getElementById('hero-copy-address-btn');
          if (copyBtn) {
            copyBtn.onclick = function() {
              navigator.clipboard.writeText(formattedFullAddress).then(() => {
                const textSpan = document.getElementById('hero-copy-text');
                if (textSpan) {
                  const orig = textSpan.textContent;
                  textSpan.textContent = '✓ ' + (finderEl?.getAttribute('data-copied') || 'Copied!');
                  setTimeout(() => { textSpan.textContent = orig; }, 2000);
                }
              });
            };
          }

          const waBtn = document.getElementById('hero-whatsapp-btn');
          if (waBtn) {
            waBtn.onclick = function() {
              const shareHeader = finderEl?.getAttribute('data-share-header') || 'My Current Address';
              const textToShare = `📍 ${shareHeader}:\n${formattedFullAddress}\n\nGoogle Maps: https://www.google.com/maps?q=${cLat},${cLng}`;
              const waUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(textToShare)}`;
              window.open(waUrl, '_blank', 'noopener,noreferrer');
            };
          }
        }

      } catch {}

      if (dot) dot.style.background = 'var(--color-accent-success)';
      if (badge) {
        badge.textContent = `± ${pos.formattedAccuracy}`;
        badge.className = 'badge badge-success';
      }
      if (loading) loading.style.display = 'none';
      if (data) data.style.display = 'grid';
      if (actions) actions.style.display = 'flex';

      // Low accuracy warning threshold (>200m)
      const accWarn = document.getElementById('loc-acc-warn');
      const accWarnVal = document.getElementById('loc-acc-warn-val');
      if (pos.accuracy > 200 && accWarn && accWarnVal) {
        accWarnVal.textContent = pos.formattedAccuracy;
        accWarn.style.display = 'block';
      } else if (accWarn) {
        accWarn.style.display = 'none';
      }

      // Update global WhatsApp share link
      const waGlobalBtn = document.getElementById('loc-wa');
      if (waGlobalBtn) {
        waGlobalBtn.setAttribute('href', Sharing.getWhatsAppUrl(cLat, cLng, ''));
      }

      const troubleshoot = document.getElementById('loc-troubleshoot');
      if (troubleshoot) troubleshoot.style.display = 'none';

      ensureMap(cLat, cLng, pos.accuracy, 16);
    } catch (error) {
      if (loading) loading.style.display = 'none';
      if (prompt) prompt.style.display = 'block';

      const troubleshoot = document.getElementById('loc-troubleshoot');

      if (!isAuto) {
        // User explicitly clicked "Get My Location" or "Try Again"
        if (dot) dot.style.background = 'var(--color-accent-error)';
        if (badge) {
          badge.textContent = finderEl?.getAttribute('data-err-badge') || 'Error';
          badge.className = 'badge';
        }
        const btnLabel = document.querySelector('#loc-btn span');
        if (btnLabel) btnLabel.textContent = finderEl?.getAttribute('data-try-again') || 'Try Again';
        if (errorEl) {
          errorEl.textContent = GeoLocation.getErrorMessage(error, currentDocLang);
          errorEl.style.display = 'block';
        }
        if (troubleshoot) troubleshoot.style.display = 'block';
      } else {
        // Silent neutral state on automated initial visit/crawlers
        if (dot) dot.style.background = 'var(--color-text-tertiary)';
        if (badge) {
          badge.textContent = finderEl?.getAttribute('data-ready') || 'Ready';
          badge.className = 'badge';
        }
        if (errorEl) {
          errorEl.style.display = 'none';
        }
        if (troubleshoot) {
          troubleshoot.style.display = 'none';
        }
        const btnLabel = document.querySelector('#loc-btn span');
        if (btnLabel) btnLabel.textContent = finderEl?.getAttribute('data-get-loc') || 'Get My Location';
      }
      ensureMap();
    }
  }

  async function locateIp() {
    try {
      const ipModule = await import('../scripts/ip-location.js');
      const ipData = await ipModule.default.getLocation();
      cLat = ipData.lat;
      cLng = ipData.lng;
      const latEl = document.getElementById('loc-lat');
      const lngEl = document.getElementById('loc-lng');
      const addrEl = document.getElementById('loc-address');
      const cityEl = document.getElementById('loc-city');
      const stateEl = document.getElementById('loc-state');
      const countryEl = document.getElementById('loc-country');
      const accEl = document.getElementById('loc-accuracy');
      const mapsEl = document.getElementById('loc-maps');
      const waEl = document.getElementById('loc-wa');
      const dot = document.getElementById('loc-dot');
      const badge = document.getElementById('loc-badge');
      const data = document.getElementById('loc-data');
      const actions = document.getElementById('loc-actions');
      const prompt = document.getElementById('loc-prompt');
      const errorEl = document.getElementById('loc-error');
      const troubleshoot = document.getElementById('loc-troubleshoot');

      if (latEl) latEl.textContent = `${Math.abs(cLat).toFixed(4)}° ${cLat >= 0 ? 'N' : 'S'}`;
      if (lngEl) lngEl.textContent = `${Math.abs(cLng).toFixed(4)}° ${cLng >= 0 ? 'E' : 'W'}`;
      if (addrEl) addrEl.textContent = `${ipData.city || 'Metro area'}, ${ipData.region || ''}, ${ipData.country || ''}`;
      if (cityEl) cityEl.textContent = ipData.city || '—';
      if (stateEl) stateEl.textContent = ipData.region || '—';
      if (countryEl) countryEl.textContent = ipData.country || '—';
      if (accEl) accEl.textContent = '± 10 km (IP estimate)';
      if (mapsEl) mapsEl.setAttribute('href', Sharing.getGoogleMapsUrl(cLat, cLng));
      if (waEl) waEl.setAttribute('href', Sharing.getWhatsAppUrl(cLat, cLng, `${ipData.city || ''}, ${ipData.country || ''}`));
      if (dot) dot.style.background = '#f59e0b';
      if (badge) {
        badge.textContent = 'Approximate (IP)';
        badge.className = 'badge';
      }
      if (prompt) prompt.style.display = 'none';
      if (errorEl) errorEl.style.display = 'none';
      if (troubleshoot) troubleshoot.style.display = 'none';
      if (data) data.style.display = 'grid';
      if (actions) actions.style.display = 'flex';
      ensureMap(cLat, cLng, 10000, 11);
    } catch (e) {
      console.warn('IP fallback failed:', e);
    }
  }

  document.getElementById('loc-btn')?.addEventListener('click', () => locate(false));
  document.getElementById('loc-refresh')?.addEventListener('click', () => locate(false));
  document.getElementById('loc-retry-btn')?.addEventListener('click', () => locate(false));
  document.getElementById('loc-ip-btn')?.addEventListener('click', locateIp);

  ensureMap();

  (async () => {
    try {
      const perm = await GeoLocation.checkPermission();
      if (perm === 'granted') {
        locate(true);
      } else {
        const p = document.getElementById('loc-prompt');
        if (p) p.style.display = 'block';
      }
    } catch {
      const p = document.getElementById('loc-prompt');
      if (p) p.style.display = 'block';
    }
  })();

  // Granular copy buttons per field
  document.querySelectorAll('.field-copy-btn').forEach(btn => {
    btn.addEventListener('click', function(this: HTMLButtonElement) {
      const targetId = this.getAttribute('data-copy-target');
      if (!targetId) return;
      const targetEl = document.getElementById(targetId);
      const val = targetEl?.textContent?.trim();
      if (!val || val === '—') return;
      navigator.clipboard.writeText(val).then(() => {
        const origHtml = this.innerHTML;
        this.innerHTML = '<span style="font-size: 10px; color: var(--color-accent-success); font-weight: 700;">✓</span>';
        setTimeout(() => { this.innerHTML = origHtml; }, 1800);
      });
    });
  });

  document.getElementById('loc-copy')?.addEventListener('click', function(this: HTMLButtonElement) {
    if (cLat !== null && cLng !== null) {
      Sharing.copyToClipboard(`${cLat}, ${cLng}`, this);
    }
  });

  document.getElementById('loc-share')?.addEventListener('click', () => {
    if (cLat !== null && cLng !== null) {
      Sharing.shareNative({ title: 'My Location', text: `${cLat}, ${cLng}`, url: `https://www.google.com/maps?q=${cLat},${cLng}` });
    }
  });
</script>
