const c = translations[lang] || translations.en;
---

<ContentLayout
  lang={lang}
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
  section="guides"
  sectionLabel={c.sectionLabel}
  readTime="8 min"
  publishDate="2026-09-22"
  modifiedDate="2026-09-22"
>
  <p>{c.p1}</p>
  <p>{c.p2}</p>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.calloutBadge}</span>
      <h3 class="tool-callout-title">{c.calloutTitle}</h3>
      <p class="tool-callout-desc">{c.calloutDesc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/my-location/ip/', lang)} class="btn btn-primary">{c.calloutBtn}</a>
    </div>
  </div>

  <h2>{c.h2HowItWorks}</h2>
  <p>{c.pHowItWorks1}</p>
  <p>{c.pHowItWorks2}</p>

  <div class="step-container">
    <div class="step-card">
      <div class="step-number">1</div>
      <div class="step-body">
        <h4 class="step-title">{c.step1Title}</h4>
        <p class="step-desc">{c.step1Desc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">2</div>
      <div class="step-body">
        <h4 class="step-title">{c.step2Title}</h4>
        <p class="step-desc">{c.step2Desc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">3</div>
      <div class="step-body">
        <h4 class="step-title">{c.step3Title}</h4>
        <p class="step-desc">{c.step3Desc}</p>
      </div>
    </div>
  </div>

  <h2>{c.h2Benchmarks}</h2>
  <p>{c.pBenchmarks}</p>

  <table>
    <thead>
      <tr>
        <th>{c.thGranularity}</th>
        <th>{c.thAccuracy}</th>
        <th>{c.thAssessment}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>Country Level</strong></td>
        <td>{c.countryAcc}</td>
        <td>{c.countryDesc}</td>
      </tr>
      <tr>
        <td><strong>State / Region Level</strong></td>
        <td>{c.stateAcc}</td>
        <td>{c.stateDesc}</td>
      </tr>
      <tr>
        <td><strong>City / Metropolitan Level</strong></td>
        <td>{c.cityAcc}</td>
        <td>{c.cityDesc}</td>
      </tr>
      <tr>
        <td><strong>Postal / ZIP Code Level</strong></td>
        <td>{c.postalAcc}</td>
        <td>{c.postalDesc}</td>
      </tr>
      <tr>
        <td><strong>Street / House Address Level</strong></td>
        <td>{c.streetAcc}</td>
        <td>{c.streetDesc}</td>
      </tr>
    </tbody>
  </table>

  <h2>{c.h2Fails}</h2>
  <p>{c.pFails}</p>
  <ul>
    <li>{c.fail1}</li>
    <li>{c.fail2}</li>
    <li>{c.fail3}</li>
    <li>{c.fail4}</li>
  </ul>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.callout2Badge}</span>
      <h3 class="tool-callout-title">{c.callout2Title}</h3>
      <p class="tool-callout-desc">{c.callout2Desc}</p>
    </div>
    <div class="tool-callout-action">
