const c = translations[lang] || translations.en;
---

<ContentLayout
  lang={lang}
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
  section="guides"
  sectionLabel={lang === 'es' ? 'Guías Prácticas' : lang === 'fr' ? 'Guides Pratiques' : lang === 'de' ? 'Praxis-Leitfäden' : lang === 'pt' ? 'Guias Práticos' : lang === 'hi' ? 'मार्गदर्शिका' : lang === 'id' ? 'Panduan Praktis' : 'Practical Guides'}
  readTime="7 min"
  publishDate="2026-09-15"
  modifiedDate="2026-09-22"
>
  {c.inShort && (
    <div class="callout-box" style="margin-bottom: var(--space-6); background: var(--color-bg-secondary); border-left: 4px solid var(--color-accent-primary); padding: var(--space-4) var(--space-5); border-radius: var(--radius-md);">
      <p style="margin: 0; font-weight: 500; font-size: var(--text-base); color: var(--color-text-primary); line-height: 1.75;">
        {c.inShort}
      </p>
    </div>
  )}

  {c.takeaways && (
    <div class="card card-flat" style="margin-bottom: var(--space-8); padding: var(--space-6); border: 1px solid var(--color-border); background: var(--color-bg-card); border-radius: var(--radius-lg);">
      <h3 style="margin-top: 0; margin-bottom: var(--space-3); font-size: var(--text-lg); display: flex; align-items: center; gap: var(--space-2);">
        <span>📌</span> {c.takeawaysTitle || "Key Takeaways"}
      </h3>
      <ul style="margin: 0; padding-left: var(--space-5); display: flex; flex-direction: column; gap: var(--space-2); color: var(--color-text-secondary); line-height: 1.75;">
        {c.takeaways.map((item: string) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  )}

  <p set:html={localizeHtml(c.pIntro1, lang)}></p>
  <p set:html={localizeHtml(c.pIntro2, lang)}></p>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.calloutBadge}</span>
      <h3 class="tool-callout-title">{c.calloutTitle}</h3>
      <p class="tool-callout-desc">{c.calloutDesc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/ip/', lang)} class="btn btn-primary">{c.calloutBtn}</a>
    </div>
  </div>

  <h2>{c.h2Reasons}</h2>
  
  <div class="step-container">
    <div class="step-card">
      <div class="step-number">1</div>
      <div class="step-body">
        <h4 class="step-title">{c.r1Title}</h4>
        <p class="step-desc" set:html={localizeHtml(c.r1Desc, lang)}></p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">2</div>
      <div class="step-body">
        <h4 class="step-title">{c.r2Title}</h4>
        <p class="step-desc" set:html={localizeHtml(c.r2Desc, lang)}></p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">3</div>
      <div class="step-body">
        <h4 class="step-title">{c.r3Title}</h4>
        <p class="step-desc" set:html={localizeHtml(c.r3Desc, lang)}></p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">4</div>
      <div class="step-body">
        <h4 class="step-title">{c.r4Title}</h4>
        <p class="step-desc" set:html={localizeHtml(c.r4Desc, lang)}></p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">5</div>
      <div class="step-body">
        <h4 class="step-title">{c.r5Title}</h4>
        <p class="step-desc" set:html={localizeHtml(c.r5Desc, lang)}></p>
      </div>
    </div>
  </div>

  <h2>{c.h2Fixes}</h2>

  <h3>{c.h3Chrome}</h3>
  <ol>
    <li>{c.cStep1}</li>
    <li>{c.cStep2}</li>
    <li>{c.cStep3}</li>
    <li>{c.cStep4}</li>
  </ol>

  <h3>{c.h3Safari}</h3>
  <ol>
    <li>{c.sStep1}</li>
    <li>{c.sStep2}</li>
    <li>{c.sStep3}</li>
    <li>{c.sStep4}</li>
  </ol>

  <h3>{c.h3Windows}</h3>
  <ol>
    <li>{c.wStep1}</li>
    <li>{c.wStep2}</li>
    <li>{c.wStep3}</li>
  </ol>

  <h2>{c.h2Router}</h2>
  <p>{c.pRouter1}</p>
  <p set:html={localizeHtml(c.pRouter2, lang)}></p>

  {c.workedExampleTitle && (
    <div class="card card-flat" style="margin: var(--space-8) 0; padding: var(--space-6); background: var(--color-bg-secondary); border-left: 4px solid var(--color-accent-success); border-radius: var(--radius-md);">
      <h3 style="margin-top: 0; margin-bottom: var(--space-2); color: var(--color-text-primary);">🧮 {c.workedExampleTitle}</h3>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); line-height: 1.75;">{c.workedExampleIntro}</p>
      <div style="display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-sm); line-height: 1.75;">
        <div style="padding: var(--space-2) var(--space-3); background: var(--color-bg-tertiary); border-radius: var(--radius-sm); font-family: var(--font-mono);">{c.workedExampleStep1}</div>
        <div style="padding: var(--space-2) var(--space-3); background: var(--color-bg-tertiary); border-radius: var(--radius-sm); font-family: var(--font-mono);">{c.workedExampleStep2}</div>
        <div style="padding: var(--space-2) var(--space-3); background: var(--color-bg-tertiary); border-radius: var(--radius-sm); font-family: var(--font-mono);">{c.workedExampleStep3}</div>
        <div style="padding: var(--space-2) var(--space-3); background: var(--color-bg-tertiary); border-radius: var(--radius-sm); font-family: var(--font-mono);">{c.workedExampleStep4}</div>
      </div>
    </div>
  )}

  {c.commonMistakes && (
    <div style="margin: var(--space-10) 0;">
      <h2>⚠️ {c.commonMistakesTitle || "Common Mistakes"}</h2>
      <div style="display: grid; gap: var(--space-4); margin-top: var(--space-4);">
        {c.commonMistakes.map((m: any) => (
          <div class="card card-flat" style="padding: var(--space-4) var(--space-5); border-left: 3px solid var(--color-accent-warning);">
            <strong style="display: block; color: var(--color-text-primary); margin-bottom: var(--space-1); font-size: var(--text-base);">{m.mistake}</strong>
            <p style="margin: 0; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.75;">{m.explanation}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  {c.faqs && c.faqs.length > 0 && (
    <div style="margin-top: var(--space-10);">
      <h2>❓ FAQ: Wrong Location Fixes</h2>
      <FAQAccordion items={c.faqs} includeSchema={true} lang={lang} />
    </div>
  )}

  {c.nextSteps && (
    <div class="card card-flat" style="margin: var(--space-10) 0; padding: var(--space-6); background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
      <h3 style="margin-top: 0; margin-bottom: var(--space-4); font-size: var(--text-lg); display: flex; align-items: center; gap: var(--space-2);">
        <span>🚀</span> {c.nextStepsTitle || "Next Steps"}
      </h3>
      <div style="display: grid; gap: var(--space-3);">
        {c.nextSteps.map((step: any) => (
          <a href={getLocalizedPath(step.href, lang)} class="card card-flat" style="display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-3) var(--space-4); text-decoration: none; border-left: 3px solid var(--color-accent-primary); background: var(--color-bg-card); transition: transform 0.15s ease;">
            <strong style="color: var(--color-text-primary); font-size: var(--text-base);">{step.title} →</strong>
            <span style="color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6;">{step.desc}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="contextual-next-box">
    <h3 class="contextual-next-title">{c.connectedGuides}</h3>
    <div class="contextual-next-grid">
      <a href={getLocalizedPath('/guides/improve-gps-accuracy/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool1Title}</div>
          <div class="contextual-link-sub">{c.tool1Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/ip-geolocation-accuracy/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool2Title}</div>
          <div class="contextual-link-sub">{c.tool2Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/comparisons/gps-vs-ip-location/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">⚖️</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool3Title}</div>
          <div class="contextual-link-sub">{c.tool3Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/ip/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool4Title}</div>
          <div class="contextual-link-sub">{c.tool4Desc}</div>
        </div>
      </a>
    </div>
  </div>
</ContentLayout>
