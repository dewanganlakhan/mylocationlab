    figStep4: "4. O feixe azul se estreitará imediatamente apontando para o rumo verdadeiro.",
    h2Multipath: "4. Evite o Reflexo de Multicaminho em Ruas Estreitas",
    pMultipath1: "Em centros urbanos com prédios espelhados ('cânions urbanos'), os sinais de satélite ricocheteiam no vidro e concreto antes de atingir o celular.",
    pMultipath2: "Como resolver: Vá até um cruzamento largo ou praça aberta onde o aparelho tenha visão desobstruída do céu.",
    h2Checklist: "5. Checklist Rápido de Otimização",
    thAction: "Ação",
    thBenefit: "Benefício Principal",
    thTime: "Tempo",
    row1: ["Ativar busca Wi-Fi / Bluetooth", "Reduz tempo de captura de minutos para < 2 s", "10 s"],
    row2: ["Ativar 'Localização Precisa'", "Melhora a precisão de ~3 km para < 3 m", "30 s"],
    row3: ["Calibrar bússola em oito (8)", "Elimina erros de rumo e direção", "15 s"],
    row4: ["Remover capas com ímã", "Evita distorção dos sensores magnéticos", "Imediato"],
    row5: ["Ir para área aberta ou praça", "Elimina reflexos em prédios espelhados", "1–2 min"],
    connectedGuides: "🔗 Guias e Diagnósticos Conectados",
    tool1Title: "Corrigir Cidade Errada",
    tool1Desc: "Resolva divergências de VPN e rede",
    tool2Title: "Como Funciona o GPS",
    tool2Desc: "Satélites, trilateração e WGS84",
    tool3Title: "GPS vs Localização IP",
    tool3Desc: "Entenda disparidades de precisão",
    tool4Title: "Descobrir Meu Endereço",
    tool4Desc: "Consulta de rua e CEP em tempo real"
  }
};

const c = translations[lang] || translations.en;
---

<ContentLayout
  lang={lang}
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
  section="guides"
  sectionLabel={lang === 'es' ? 'Guías Educativas' : lang === 'fr' ? 'Guides Pédagogiques' : lang === 'de' ? 'Fachratgeber' : lang === 'pt' ? 'Guias Educativos' : 'Educational Guides'}
  readTime="8 min"
  publishDate="2026-09-15"
  modifiedDate="2026-09-22"
>
  <p>{c.pIntro1}</p>
  <p>{c.pIntro2}</p>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.calloutBadge}</span>
      <h3 class="tool-callout-title">{c.calloutTitle}</h3>
      <p class="tool-callout-desc">{c.calloutDesc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} class="btn btn-primary">{c.calloutBtn}</a>
    </div>
  </div>

  <h2>{c.h2Wifi}</h2>
  <p>{c.pWifi1}</p>
  <ul>
    <li><strong>{c.wifiBullet1}</strong></li>
    <li><strong>{c.wifiBullet2}</strong></li>
  </ul>

  <h2>{c.h2Precise}</h2>
  <p>{c.pPrecise}</p>

  <div class="step-container">
    <div class="step-card">
      <div class="step-number">iOS</div>
      <div class="step-body">
        <h4 class="step-title">{c.iosTitle}</h4>
        <p class="step-desc">{c.iosDesc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">AND</div>
      <div class="step-body">
        <h4 class="step-title">{c.androidTitle}</h4>
        <p class="step-desc">{c.androidDesc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">MAC</div>
      <div class="step-body">
        <h4 class="step-title">{c.macTitle}</h4>
        <p class="step-desc">{c.macDesc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">WIN</div>
      <div class="step-body">
        <h4 class="step-title">{c.winTitle}</h4>
        <p class="step-desc">{c.winDesc}</p>
      </div>
    </div>
  </div>

  <h2>{c.h2Compass}</h2>
  <p>{c.pCompass}</p>
  <h3>{c.h3Fig8}</h3>
  <ol>
    <li>{c.figStep1}</li>
    <li>{c.figStep2}</li>
    <li>{c.figStep3}</li>
    <li>{c.figStep4}</li>
  </ol>

  <h2>{c.h2Multipath}</h2>
  <p>{c.pMultipath1}</p>
  <p>{c.pMultipath2}</p>

  <h2>{c.h2Checklist}</h2>
  <table>
    <thead>
      <tr>
        <th>{c.thAction}</th>
        <th>{c.thBenefit}</th>
        <th>{c.thTime}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>{c.row1[0]}</td>
        <td>{c.row1[1]}</td>
        <td>{c.row1[2]}</td>
      </tr>
      <tr>
        <td>{c.row2[0]}</td>
        <td>{c.row2[1]}</td>
        <td>{c.row2[2]}</td>
      </tr>
      <tr>
        <td>{c.row3[0]}</td>
        <td>{c.row3[1]}</td>
        <td>{c.row3[2]}</td>
      </tr>
      <tr>
        <td>{c.row4[0]}</td>
        <td>{c.row4[1]}</td>
        <td>{c.row4[2]}</td>
      </tr>
      <tr>
        <td>{c.row5[0]}</td>
        <td>{c.row5[1]}</td>
        <td>{c.row5[2]}</td>
      </tr>
    </tbody>
  </table>

  <div class="contextual-next-box">
    <h3 class="contextual-next-title">{c.connectedGuides}</h3>
    <div class="contextual-next-grid">
      <a href={getLocalizedPath('/guides/wrong-location/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🔧</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool1Title}</div>
          <div class="contextual-link-sub">{c.tool1Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/how-gps-location-works/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🛰️</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool2Title}</div>
          <div class="contextual-link-sub">{c.tool2Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/comparisons/gps-vs-ip-location/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">⚖️</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool3Title}</div>
          <div class="contextual-link-sub">{c.tool3Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/my-location/address/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🏠</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool4Title}</div>
          <div class="contextual-link-sub">{c.tool4Desc}</div>
        </div>
      </a>
    </div>
  </div>
</ContentLayout>
