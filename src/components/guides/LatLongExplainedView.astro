    prec4: ["4", "0.0001°", "~ 11.1 मीटर", "अलग प्लॉट या गली पहचानकर्ता"],
    prec5: ["5", "0.00001°", "~ 1.11 मीटर", "दरवाज़े का प्रवेश द्वार, स्मार्टफ़ोन GPS"],
    prec6: ["6", "0.000001°", "~ 11.1 सेमी", "सर्वेक्षण मार्कर, सिविल इंजीनियरिंग स्टेक"],
