const c = translations[lang] || translations.en;
---

<ContentLayout
  lang={lang}
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
  section="guides"
  sectionLabel={lang === 'es' ? 'Guías Educativas' : lang === 'fr' ? 'Guides Pédagogiques' : lang === 'de' ? 'Fachratgeber' : lang === 'pt' ? 'Guias Educativos' : lang === 'hi' ? 'शैक्षिक गाइड' : lang === 'id' ? 'Panduan Edukasi' : 'Educational Guides'}
  readTime="8 min"
  publishDate="2026-09-15"
  modifiedDate="2026-09-22"
>
  <p>{c.pIntro1}</p>
  <p>{c.pIntro2}</p>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.calloutBadge}</span>
      <h3 class="tool-callout-title">{c.calloutTitle}</h3>
      <p class="tool-callout-desc">{c.calloutDesc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/tools/latitude-longitude/', lang)} class="btn btn-primary">{c.calloutBtn}</a>
    </div>
  </div>

  <h2>{c.h2Lat}</h2>
  <p>{c.pLat1}</p>
  <ul>
    <li><strong>{c.latBullet1}</strong></li>
    <li><strong>{c.latBullet2}</strong></li>
    <li><strong>{c.latBullet3}</strong></li>
  </ul>

  <h2>{c.h2Long}</h2>
  <p>{c.pLong1}</p>
  <ul>
    <li><strong>{c.longBullet1}</strong></li>
    <li><strong>{c.longBullet2}</strong></li>
  </ul>

  <h2>{c.h2Formats}</h2>
  <div class="step-container">
    <div class="step-card">
      <div class="step-number">DD</div>
      <div class="step-body">
        <h4 class="step-title">{c.ddTitle}</h4>
        <p class="step-desc">{c.ddDesc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">DMS</div>
      <div class="step-body">
        <h4 class="step-title">{c.dmsTitle}</h4>
        <p class="step-desc">{c.dmsDesc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">UTM</div>
      <div class="step-body">
        <h4 class="step-title">{c.utmTitle}</h4>
        <p class="step-desc">{c.utmDesc}</p>
      </div>
    </div>
  </div>

  <h2>{c.h2Precision}</h2>
  <p>{c.pPrecision}</p>

  <table>
    <thead>
      <tr>
        <th>{c.thPlaces}</th>
        <th>{c.thFraction}</th>
        <th>{c.thGround}</th>
        <th>{c.thScale}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>{c.prec0[0]}</strong></td>
        <td>{c.prec0[1]}</td>
        <td>{c.prec0[2]}</td>
        <td>{c.prec0[3]}</td>
      </tr>
      <tr>
        <td><strong>{c.prec1[0]}</strong></td>
        <td>{c.prec1[1]}</td>
        <td>{c.prec1[2]}</td>
        <td>{c.prec1[3]}</td>
      </tr>
      <tr>
        <td><strong>{c.prec2[0]}</strong></td>
        <td>{c.prec2[1]}</td>
        <td>{c.prec2[2]}</td>
        <td>{c.prec2[3]}</td>
      </tr>
      <tr>
        <td><strong>{c.prec3[0]}</strong></td>
        <td>{c.prec3[1]}</td>
        <td>{c.prec3[2]}</td>
        <td>{c.prec3[3]}</td>
      </tr>
      <tr>
        <td><strong>{c.prec4[0]}</strong></td>
        <td>{c.prec4[1]}</td>
        <td>{c.prec4[2]}</td>
        <td>{c.prec4[3]}</td>
      </tr>
      <tr>
        <td><strong>{c.prec5[0]}</strong></td>
        <td>{c.prec5[1]}</td>
        <td>{c.prec5[2]}</td>
        <td>{c.prec5[3]}</td>
      </tr>
      <tr>
        <td><strong>{c.prec6[0]}</strong></td>
        <td>{c.prec6[1]}</td>
        <td>{c.prec6[2]}</td>
        <td>{c.prec6[3]}</td>
      </tr>
    </tbody>
  </table>

  <blockquote>
    <strong>{c.ruleOfThumb}</strong>
  </blockquote>

  <div class="contextual-next-box">
    <h3 class="contextual-next-title">{c.connectedGuides}</h3>
    <div class="contextual-next-grid">
      <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🧭</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool1Title}</div>
          <div class="contextual-link-sub">{c.tool1Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/utm-coordinates-and-datums/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🗺️</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool2Title}</div>
          <div class="contextual-link-sub">{c.tool2Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/tools/distance-calculator/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">📏</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool3Title}</div>
          <div class="contextual-link-sub">{c.tool3Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/how-gps-location-works/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">📡</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool4Title}</div>
          <div class="contextual-link-sub">{c.tool4Desc}</div>
        </div>
      </a>
    </div>
  </div>
</ContentLayout>
