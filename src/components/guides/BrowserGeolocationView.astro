const c = translations[lang] || translations.en;
---

<ContentLayout
  lang={lang}
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
  section="guides"
  sectionLabel={c.sectionLabel}
  readTime="9 min"
  publishDate="2026-09-22"
  modifiedDate="2026-09-22"
>
  <p>{c.p1}</p>
  <p>{c.p2}</p>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.calloutBadge}</span>
      <h3 class="tool-callout-title">{c.calloutTitle}</h3>
      <p class="tool-callout-desc">{c.calloutDesc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} class="btn btn-primary">{c.calloutBtn}</a>
    </div>
  </div>

  <h2>{c.h2Architecture}</h2>
  <p>{c.pArchitecture}</p>

  <div class="step-container">
    <div class="step-card">
      <div class="step-number">1</div>
      <div class="step-body">
        <h4 class="step-title"><code>{c.step1Title}</code></h4>
        <p class="step-desc">{c.step1Desc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">2</div>
      <div class="step-body">
        <h4 class="step-title"><code>{c.step2Title}</code></h4>
        <p class="step-desc">{c.step2Desc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">3</div>
      <div class="step-body">
        <h4 class="step-title"><code>{c.step3Title}</code></h4>
        <p class="step-desc">{c.step3Desc}</p>
      </div>
    </div>
  </div>

  <h2>{c.h2Implementation}</h2>
  <p>{c.pImplementation}</p>

  <pre><code>{`// Check browser support
if ('geolocation' in navigator) {
  const options = {
    enableHighAccuracy: true, // Request GPS hardware rather than IP lookup
    timeout: 10000,           // Maximum wait time of 10 seconds
    maximumAge: 0             // Do not return cached coordinates
  };

  function successCallback(position) {
    const { latitude, longitude, accuracy, altitude, heading, speed } = position.coords;
    console.log(\`Latitude: \${latitude}, Longitude: \${longitude}\`);
    console.log(\`Accuracy radius: \${accuracy} meters\`);
  }

  function errorCallback(error) {
    switch(error.code) {
      case error.PERMISSION_DENIED:
        console.error("User denied Geolocation permission.");
        break;
      case error.POSITION_UNAVAILABLE:
        console.error("Location information is unavailable (weak GPS/Wi-Fi signal).");
        break;
      case error.TIMEOUT:
        console.error("The request to get user location timed out.");
        break;
    }
  }

  navigator.geolocation.getCurrentPosition(successCallback, errorCallback, options);
} else {
  console.warn("Geolocation API is not supported in this browser.");
}`}</code></pre>

  <h2>{c.h2Options}</h2>
  <table>
    <thead>
      <tr>
        <th>{c.thOption}</th>
        <th>{c.thType}</th>
        <th>{c.thDefault}</th>
        <th>{c.thImpact}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>enableHighAccuracy</code></td>
        <td>Boolean</td>
        <td><code>false</code></td>
        <td>{c.highAccDesc}</td>
      </tr>
      <tr>
        <td><code>timeout</code></td>
        <td>Positive integer (ms)</td>
        <td><code>Infinity</code></td>
        <td>{c.timeoutDesc}</td>
      </tr>
      <tr>
        <td><code>maximumAge</code></td>
        <td>Positive integer (ms)</td>
        <td><code>0</code></td>
        <td>{c.maxAgeDesc}</td>
      </tr>
    </tbody>
  </table>

  <h2>{c.h2Security}</h2>
  <ul>
    <li>{c.sec1}</li>
    <li>{c.sec2}</li>
    <li>{c.sec3}</li>
  </ul>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.callout2Badge}</span>
      <h3 class="tool-callout-title">{c.callout2Title}</h3>
      <p class="tool-callout-desc">{c.callout2Desc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} class="btn btn-primary">{c.callout2Btn}</a>
    </div>
  </div>

  <div class="contextual-next-box">
    <h3 class="contextual-next-title">{c.connectedTitle}</h3>
    <div class="contextual-next-grid">
      <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🎯</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool1Title}</div>
          <div class="contextual-link-sub">{c.tool1Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/how-to-fake-or-mock-location/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🧪</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool2Title}</div>
          <div class="contextual-link-sub">{c.tool2Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/how-gps-location-works/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🛰️</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool3Title}</div>
          <div class="contextual-link-sub">{c.tool3Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/wrong-location/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🔧</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool4Title}</div>
          <div class="contextual-link-sub">{c.tool4Desc}</div>
        </div>
      </a>
    </div>
  </div>
</ContentLayout>
