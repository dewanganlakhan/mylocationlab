const c = translations[lang] || translations.en;
---

<ContentLayout
  lang={lang}
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
  section="guides"
  sectionLabel={lang === 'es' ? 'Guías Prácticas' : lang === 'fr' ? 'Guides Pratiques' : lang === 'de' ? 'Praxis-Leitfäden' : lang === 'pt' ? 'Guias Práticos' : lang === 'hi' ? 'मार्गदर्शिका' : lang === 'id' ? 'Panduan Praktis' : 'Practical Guides'}
  readTime="8 min"
  publishDate="2026-09-15"
  modifiedDate="2026-09-22"
>
  {c.inShort && (
    <div class="card card-flat" style="margin-bottom: var(--space-6); padding: var(--space-5); border-left: 4px solid var(--color-accent-primary); background: var(--color-bg-secondary); border-radius: var(--radius-md);">
      <p style="margin: 0; font-size: var(--text-base); line-height: 1.75; color: var(--color-text-primary); font-weight: 500;">
        {c.inShort}
      </p>
    </div>
  )}

  {c.takeaways && (
    <div class="card card-flat" style="margin-bottom: var(--space-8); padding: var(--space-6); background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
      <h3 style="margin-top: 0; margin-bottom: var(--space-3); font-size: var(--text-lg); display: flex; align-items: center; gap: var(--space-2);">
        <span>💡</span> {c.takeawaysTitle || "Key Takeaways"}
      </h3>
      <ul style="margin: 0; padding-left: var(--space-5); display: flex; flex-direction: column; gap: var(--space-2); line-height: 1.75; color: var(--color-text-secondary);">
        {c.takeaways.map((item: string) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  )}

  <p set:html={localizeHtml(c.p1, lang)}></p>
  <p set:html={localizeHtml(c.p2, lang)}></p>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.calloutBadge}</span>
      <h3 class="tool-callout-title">{c.calloutTitle}</h3>
      <p class="tool-callout-desc">{c.calloutDesc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} class="btn btn-primary">{c.calloutBtn}</a>
    </div>
  </div>

  <h2>{c.h2Architecture}</h2>
  <p>{c.pArchitecture}</p>

  <div class="step-container">
    <div class="step-card">
      <div class="step-number">1</div>
      <div class="step-body">
        <h4 class="step-title">{c.step1Title}</h4>
        <p class="step-desc">{c.step1Desc}</p>
      </div>
    </div>
    <div class="step-card">
      <div class="step-number">2</div>
      <div class="step-body">
        <h4 class="step-title">{c.step2Title}</h4>
        <p class="step-desc">{c.step2Desc}</p>
      </div>
    </div>
    <div class="step-card">
      <div class="step-number">3</div>
      <div class="step-body">
        <h4 class="step-title">{c.step3Title}</h4>
        <p class="step-desc">{c.step3Desc}</p>
      </div>
    </div>
  </div>

  <h2>{c.h2Implementation}</h2>
  <p>{c.pImplementation}</p>

  <div class="code-preview" style="background: var(--color-bg-secondary); padding: var(--space-4); border-radius: var(--radius-md); font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.6; overflow-x: auto; border: 1px solid var(--color-border); margin: var(--space-4) 0;">
    <pre><code>{`// Production Geolocation Pattern
const options = {
  enableHighAccuracy: true,
  timeout: 10000,
  maximumAge: 0
};

function success(pos) {
  const { latitude, longitude, accuracy, altitude, speed } = pos.coords;
  console.log(\`Position: \${latitude}, \${longitude} (±\${accuracy}m)\`);
}

function error(err) {
  switch(err.code) {
    case err.PERMISSION_DENIED:
      console.warn("User denied geolocation permission.");
      break;
    case err.POSITION_UNAVAILABLE:
      console.warn("Location information unavailable.");
      break;
    case err.TIMEOUT:
      console.warn("Location request timed out.");
      break;
  }
}

if ("geolocation" in navigator) {
  navigator.geolocation.getCurrentPosition(success, error, options);
}`}</code></pre>
  </div>

  <h2>{c.h2Options}</h2>
  <table class="data-table">
    <thead>
      <tr>
        <th>{c.thOption}</th>
        <th>{c.thType}</th>
        <th>{c.thDefault}</th>
        <th>{c.thImpact}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>enableHighAccuracy</code></td>
        <td>Boolean</td>
        <td><code>false</code></td>
        <td>{c.highAccDesc}</td>
      </tr>
      <tr>
        <td><code>timeout</code></td>
        <td>Positive integer (ms)</td>
        <td><code>Infinity</code></td>
        <td>{c.timeoutDesc}</td>
      </tr>
      <tr>
        <td><code>maximumAge</code></td>
        <td>Positive integer (ms)</td>
        <td><code>0</code></td>
        <td>{c.maxAgeDesc}</td>
      </tr>
    </tbody>
  </table>

  <h2>{c.h2Security}</h2>
  <ul style="line-height: 1.75; color: var(--color-text-secondary); display: flex; flex-direction: column; gap: var(--space-2);">
    <li>{c.sec1}</li>
    <li>{c.sec2}</li>
    <li>{c.sec3}</li>
  </ul>

  {c.workedExampleTitle && (
    <div class="card card-flat" style="margin: var(--space-8) 0; padding: var(--space-6); background: var(--color-bg-secondary); border-left: 4px solid var(--color-accent-success); border-radius: var(--radius-md);">
      <h3 style="margin-top: 0; margin-bottom: var(--space-2); color: var(--color-text-primary);">💻 {c.workedExampleTitle}</h3>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4); line-height: 1.75;">{c.workedExampleIntro}</p>
      <div style="display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-sm); line-height: 1.6; font-family: var(--font-mono); background: var(--color-bg-tertiary); padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm);">
        <div>{c.workedExampleStep1}</div>
        <div style="padding-left: var(--space-4);">{c.workedExampleStep2}</div>
        <div style="padding-left: var(--space-4);">{c.workedExampleStep3}</div>
        <div style="padding-left: var(--space-4);">{c.workedExampleStep4}</div>
        <div>{c.workedExampleStep5}</div>
      </div>
    </div>
  )}

  {c.commonMistakesTitle && (
    <div style="margin: var(--space-10) 0;">
      <h2>⚠️ {c.commonMistakesTitle}</h2>
      <div style="display: grid; gap: var(--space-4); margin-top: var(--space-4);">
        {c.commonMistakes.map((m: any) => (
          <div class="card card-flat" style="padding: var(--space-4) var(--space-5); border-left: 3px solid var(--color-accent-warning);">
            <strong style="display: block; color: var(--color-text-primary); margin-bottom: var(--space-1); font-size: var(--text-base);">{m.mistake}</strong>
            <p style="margin: 0; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.75;">{m.explanation}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  {c.faqs && (
    <div style="margin: var(--space-10) 0;">
      <h2>❓ Frequently Asked Questions</h2>
      <FAQAccordion items={c.faqs} lang={lang} />
    </div>
  )}

  {c.nextSteps && (
    <div class="card card-flat" style="margin: var(--space-10) 0; padding: var(--space-6); background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
      <h3 style="margin-top: 0; margin-bottom: var(--space-4); font-size: var(--text-lg); display: flex; align-items: center; gap: var(--space-2);">
        <span>🚀</span> {c.nextStepsTitle || "Next Steps"}
      </h3>
      <div style="display: grid; gap: var(--space-3);">
        {c.nextSteps.map((step: any) => (
          <a href={getLocalizedPath(step.href, lang)} class="card card-flat" style="display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-3) var(--space-4); text-decoration: none; border-left: 3px solid var(--color-accent-primary); background: var(--color-bg-card); transition: transform 0.15s ease;">
            <strong style="color: var(--color-text-primary); font-size: var(--text-base);">{step.title} →</strong>
            <span style="color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6;">{step.desc}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.callout2Badge}</span>
      <h3 class="tool-callout-title">{c.callout2Title}</h3>
      <p class="tool-callout-desc">{c.callout2Desc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} class="btn btn-primary">{c.callout2Btn}</a>
    </div>
  </div>

  <div class="contextual-next-box">
    <h3 class="contextual-next-title">{c.connectedTitle}</h3>
    <div class="contextual-next-grid">
      <a href={getLocalizedPath('/tools/gps-accuracy/', lang)} class="contextual-link-card">
