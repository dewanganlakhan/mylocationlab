      { title: "अक्षांश और देशांतर गाइड", href: "/guides/latitude-and-longitude-explained/", desc: "भूगणितीय कोणीय प्रणाली के आधारभूत नियम सीखें।" },
      { title: "दशमलव डिग्री बनाम DMS", href: "/comparisons/decimal-degrees-vs-dms/", desc: "विभिन्न निर्देशांक प्रारूपों की तुलना समझें।" }
    ],

    connectedGuides: "🔗 जुड़े मार्गदर्शक और उपकरण",
    tool1Title: "निर्देशांक परिवर्तक",
    tool1Desc: "UTM, DD और DMS",
    tool2Title: "अक्षांश और देशांतर",
