    faqs: [
      { question: "Mengapa surveyor lebih memilih UTM dibanding lintang dan bujur?", answer: "Karena angka UTM bersatuan meter datar, memungkinkan perhitungan luas dan jarak dengan rumus Pythagoras tanpa trigonometri bola." },
      { question: "Bagaimana cara memetakan Kutub Utara dan Selatan?", answer: "UTM berakhir di 80°S dan 84°N. Wilayah kutub dipetakan dengan proyeksi Universal Polar Stereographic (UPS)." },
      { question: "Apa kaitan antara MGRS dan UTM?", answer: "MGRS adalah sistem kisi militer yang memecah zona UTM menjadi kotak-kotak 100 km dengan kode dua huruf." }
    ],

    nextStepsTitle: "Langkah Berikutnya",
    nextSteps: [
      { title: "Konverter Koordinat UTM", href: "/tools/coordinate-converter/", desc: "Ubah angka UTM menjadi Derajat Desimal dan DMS seketika." },
      { title: "Panduan Lintang dan Bujur", href: "/guides/latitude-and-longitude-explained/", desc: "Pahami dasar sistem koordinat sudut bumi." },
      { title: "Derajat Desimal vs DMS", href: "/comparisons/decimal-degrees-vs-dms/", desc: "Ketahui kelebihan format desimal pada perangkat lunak." }
    ],

    connectedGuides: "🔗 Panduan & Alat Terkait",
    tool1Title: "Konverter Koordinat",
    tool1Desc: "UTM, DD & DMS",
    tool2Title: "Lintang & Bujur",
    tool2Desc: "Dasar geodesi",
    tool3Title: "Desimal vs DMS",
