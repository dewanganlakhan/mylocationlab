const c = translations[lang] || translations.en;
---

<ContentLayout
  lang={lang}
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
  section="guides"
  sectionLabel={c.sectionLabel}
  readTime="9 min"
  publishDate="2026-09-22"
  modifiedDate="2026-09-22"
>
  <p>{c.p1}</p>
  <p>{c.p2}</p>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.calloutBadge}</span>
      <h3 class="tool-callout-title">{c.calloutTitle}</h3>
      <p class="tool-callout-desc">{c.calloutDesc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/tools/coordinate-converter/', lang)} class="btn btn-primary">{c.calloutBtn}</a>
    </div>
  </div>

  <h2>{c.h2WhatIsUtm}</h2>
  <p>{c.pUtm1}</p>

  <h3>{c.h3Zones}</h3>
  <p>{c.pZones}</p>
  <ul>
    <li>{c.zoneLi1}</li>
    <li>{c.zoneLi2}</li>
    <li>{c.zoneLi3}</li>
  </ul>

  <h2>{c.h2EastingNorthing}</h2>
  <p>{c.pEastingNorthing}</p>

  <div class="step-container">
    <div class="step-card">
      <div class="step-number">E</div>
      <div class="step-body">
        <h4 class="step-title">{c.eastingTitle}</h4>
        <p class="step-desc">{c.eastingDesc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">N</div>
      <div class="step-body">
        <h4 class="step-title">{c.northingTitle}</h4>
        <p class="step-desc">{c.northingDesc}</p>
      </div>
    </div>
  </div>

  <h2>{c.h2Datums}</h2>
  <p>{c.pDatums}</p>

  <table>
    <thead>
      <tr>
        <th>{c.thDatum}</th>
        <th>{c.thModel}</th>
        <th>{c.thCoverage}</th>
        <th>{c.thFrame}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
