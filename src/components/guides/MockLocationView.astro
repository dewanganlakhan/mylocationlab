    </div>
  </div>

  <h2>{c.h2Android}</h2>
  <p>{c.pAndroid}</p>
  <ol>
    <li>{c.and1}</li>
    <li>{c.and2}</li>
    <li>{c.and3}</li>
    <li>{c.and4}</li>
  </ol>

  <h2>{c.h2Ios}</h2>
