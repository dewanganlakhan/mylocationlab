    tool3Title: "GPS प्राइवेसी और सुरक्षा",
    tool3Desc: "ट्रैकिंग से सुरक्षा",
    tool4Title: "GPS निर्देशांक फ़ाइंडर",
    tool4Desc: "सटीक अक्षांश/देशांतर देखें"
  },
  id: {
