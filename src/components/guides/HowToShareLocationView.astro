const c = translations[lang] || translations.en;
---

<ContentLayout
  lang={lang}
  title={c.title}
  description={c.description}
  h1={c.h1}
  subtitle={c.subtitle}
  section="guides"
  sectionLabel={c.sectionLabel}
  readTime="7 min"
  publishDate="2026-09-22"
  modifiedDate="2026-09-22"
>
  <p>{c.p1}</p>
  <p>{c.p2}</p>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.calloutBadge}</span>
      <h3 class="tool-callout-title">{c.calloutTitle}</h3>
      <p class="tool-callout-desc">{c.calloutDesc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/share-location/', lang)} class="btn btn-primary">{c.calloutBtn}</a>
    </div>
  </div>

  <h2>{c.h2Apple}</h2>
  <p>{c.pApple}</p>

  <div class="step-container">
    <div class="step-card">
      <div class="step-number">1</div>
      <div class="step-body">
        <h4 class="step-title">{c.step1Title}</h4>
        <p class="step-desc">{c.step1Desc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">2</div>
      <div class="step-body">
        <h4 class="step-title">{c.step2Title}</h4>
        <p class="step-desc">{c.step2Desc}</p>
      </div>
    </div>
  </div>

  <h2>{c.h2Android}</h2>
  <p>{c.pAndroid}</p>

  <div class="step-container">
    <div class="step-card">
      <div class="step-number">1</div>
      <div class="step-body">
        <h4 class="step-title">{c.step3Title}</h4>
        <p class="step-desc">{c.step3Desc}</p>
      </div>
    </div>

    <div class="step-card">
      <div class="step-number">2</div>
      <div class="step-body">
        <h4 class="step-title">{c.step4Title}</h4>
        <p class="step-desc">{c.step4Desc}</p>
      </div>
    </div>
  </div>

  <h2>{c.h2Messaging}</h2>
  <p>{c.pMessaging}</p>
  <ul>
    <li>{c.msgLi1}</li>
    <li>{c.msgLi2}</li>
  </ul>

  <h2>{c.h2Qr}</h2>
  <p>{c.pQr}</p>

  <div class="tool-callout">
    <div class="tool-callout-content">
      <span class="tool-callout-badge">{c.callout2Badge}</span>
      <h3 class="tool-callout-title">{c.callout2Title}</h3>
      <p class="tool-callout-desc">{c.callout2Desc}</p>
    </div>
    <div class="tool-callout-action">
      <a href={getLocalizedPath('/tools/location-qr-code/', lang)} class="btn btn-primary">{c.callout2Btn}</a>
    </div>
  </div>

  <h2>{c.h2Privacy}</h2>
  <p>{c.pPrivacy}</p>
  <ul>
    <li>{c.privLi1}</li>
    <li>{c.privLi2}</li>
    <li>{c.privLi3}</li>
  </ul>

  <div class="contextual-next-box">
    <h3 class="contextual-next-title">{c.connectedTitle}</h3>
    <div class="contextual-next-grid">
      <a href={getLocalizedPath('/share-location/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🔗</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool1Title}</div>
          <div class="contextual-link-sub">{c.tool1Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/tools/location-qr-code/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">📱</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool2Title}</div>
          <div class="contextual-link-sub">{c.tool2Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/guides/gps-privacy-and-security/', lang)} class="contextual-link-card">
        <span class="contextual-link-icon">🔒</span>
        <div class="contextual-link-info">
          <div class="contextual-link-title">{c.tool3Title}</div>
          <div class="contextual-link-sub">{c.tool3Desc}</div>
        </div>
      </a>
      <a href={getLocalizedPath('/tools/gps-coordinates/', lang)} class="contextual-link-card">
