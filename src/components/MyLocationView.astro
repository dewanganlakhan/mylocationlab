    border-collapse: collapse;
    margin: 0;
    font-size: var(--text-sm);
  }

  .table-responsive th,
  .table-responsive td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  .table-responsive th {
    background: var(--color-bg-tertiary);
