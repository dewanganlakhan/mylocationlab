---
/**
 * MyLocationView — Unified Multilingual /my-location/ Engine
 * Supports en, es, fr, de, pt, hi, id with interactive Leaflet map,
 * instant hardware telemetry (DD & DMS), contextual linking, and zero-CLS layout stability.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SiloNav from './SiloNav.astro';
import FAQAccordion from './FAQAccordion.astro';
import AuthorEAT from './AuthorEAT.astro';
import { myLocationTranslations } from '../i18n/myLocation';
import { useTranslations } from '../i18n/ui';
import { getLocalizedPath, defaultLang, type SupportedLang } from '../i18n/config';

interface Props {
  lang?: SupportedLang | string;
}

const { lang: customLang = defaultLang } = Astro.props;
const lang = (customLang in myLocationTranslations ? customLang : defaultLang) as SupportedLang;
const content = myLocationTranslations[lang] || myLocationTranslations.en;
const t = useTranslations(lang);

const stepBadgePrefix: Record<SupportedLang, string> = {
  en: 'Step',
  es: 'Paso',
  fr: 'Étape',
  de: 'Schritt',
  pt: 'Passo',
  hi: 'चरण',
  id: 'Langkah',
};
const badgePrefix = stepBadgePrefix[lang] || 'Step';

const locateTitles: Record<string, string> = {
  en: "Zoom to my current location",
  es: "Centrar y ampliar en mi ubicación",
  fr: "Zoomer sur ma position actuelle",
  de: "Auf meinen aktuellen Standort zoomen",
  pt: "Aproximar da minha localização atual",
  hi: "मेरी वर्तमान लोकेशन पर ज़ूम करें",
  id: "Perbesar ke lokasi saya saat ini"
};
const locateTitle = locateTitles[lang] || locateTitles.en;

const currentPath = getLocalizedPath('/location/', lang);

const breadcrumbs = [
  { label: t('common.home'), href: getLocalizedPath('/', lang) },
  { label: `${content.pageTitle} ${content.pageTitleAccent}` },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('common.home'),
      item: `https://mylocationlab.com${getLocalizedPath('/', lang)}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: `${content.pageTitle} ${content.pageTitleAccent}`,
      item: `https://mylocationlab.com${currentPath}`,
    },
  ],
};

const myLocFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]*>?/gm, ''),
    },
  })),
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${content.pageTitle} ${content.pageTitleAccent}`,
  url: `https://mylocationlab.com${currentPath}`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript and HTML5 Geolocation API',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const connectedToolsList = [
  {
    icon: '📍',
    href: '/tools/gps-coordinates/',
    title: {
      en: 'GPS Coordinates Finder',
      es: 'Buscador de Coordenadas GPS',
      fr: 'Localisateur de Coordonnées GPS',
      de: 'GPS-Koordinaten-Finder',
      pt: 'Buscador de Coordenadas GPS',
      hi: 'GPS निर्देशांक खोजक',
      id: 'Pencari Koordinat GPS',
    },
    desc: {
      en: 'Find exact latitude, longitude, and elevation with satellite lock.',
      es: 'Obtenga latitud, longitud y altitud exactas vía satélite.',
      fr: 'Trouvez latitude, longitude et altitude par satellite.',
      de: 'Genaue Breiten-, Längengrade und Höhe via Satellit ermitteln.',
      pt: 'Obtenha latitude, longitude e altitude exatas via satélite.',
      hi: 'सैटेलाइट से सटीक अक्षांश, देशांतर और ऊंचाई प्राप्त करें।',
      id: 'Dapatkan lintang, bujur, dan ketinggian akurat via satelit.',
    },
  },
  {
    icon: '🌐',
    href: '/tools/latitude-longitude/',
    title: {
      en: 'Latitude Longitude Finder',
      es: 'Buscador de Latitud y Longitud',
      fr: 'Détecteur de Latitude et Longitude',
      de: 'Breiten- und Längengrad-Finder',
      pt: 'Localizador de Latitude e Longitude',
      hi: 'अक्षांश और देशांतर खोजक',
      id: 'Pencari Lintang dan Bujur',
    },
    desc: {
      en: 'Inspect hemispheric parallels and meridians on an interactive map.',
      es: 'Explore paralelos y meridianos en un mapa interactivo.',
      fr: 'Explorez parallèles et méridiens sur une carte interactive.',
      de: 'Parallelen und Meridiane auf einer interaktiven Karte erkunden.',
      pt: 'Explore paralelos e meridianos em um mapa interativo.',
