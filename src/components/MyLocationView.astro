      en: 'Location QR Code Generator',
      es: 'Generador de Código QR de Ubicación',
      fr: 'Générateur de QR Code de Localisation',
      de: 'Standort-QR-Code-Generator',
      pt: 'Gerador de QR Code de Localização',
      hi: 'लोकेशन QR कोड जनरेटर',
      id: 'Generator QR Code Lokasi',
    },
    desc: {
      en: 'Create instant scannable QR pins for Apple Maps, Google Maps, or geo URIs.',
      es: 'Cree códigos QR para abrir coordenadas en Google Maps o Apple Maps.',
      fr: 'Créez des QR codes pour ouvrir votre position sur Google ou Apple Maps.',
      de: 'QR-Codes für Google Maps, Apple Maps oder Geo-URIs erzeugen.',
      pt: 'Crie códigos QR para abrir pontos no Google Maps ou Apple Maps.',
      hi: 'Google Maps और Apple Maps के लिए स्कैन करने योग्य QR कोड बनाएं।',
      id: 'Buat kode QR instan untuk Google Maps, Apple Maps, atau geo URI.',
