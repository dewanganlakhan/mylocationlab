      de: 'Vorwärts-Geocoder',
      pt: 'Geocodificador Direto',
      hi: 'फ़ॉरवर्ड जियोकोडर',
      id: 'Forward Geocoder',
    },
    desc: {
      en: 'Search any landmark, city, or address to retrieve GPS coordinates.',
      es: 'Busque cualquier dirección o punto para obtener coordenadas GPS.',
      fr: 'Recherchez une adresse ou un lieu pour obtenir ses coordonnées.',
      de: 'Adresse oder Ort suchen und GPS-Koordinaten abrufen.',
      pt: 'Pesquise qualquer endereço ou local para obter coordenadas GPS.',
      hi: 'किसी भी पते या स्थान के नाम से GPS निर्देशांक प्राप्त करें।',
      id: 'Cari alamat atau tempat untuk mendapatkan koordinat GPS.',
    },
  },
  {
    icon: '🔀',
    href: '/tools/coordinate-converter/',
    title: {
      en: 'Coordinate Converter',
      es: 'Conversor de Coordenadas',
      fr: 'Convertisseur de Coordonnées',
      de: 'Koordinaten-Konverter',
      pt: 'Conversor de Coordenadas',
      hi: 'निर्देशांक कनवर्टर',
      id: 'Konverter Koordinat',
    },
    desc: {
      en: 'Convert seamlessly between DD, DMS, UTM, MGRS, and Plus Codes.',
      es: 'Convierta entre grados decimales, DMS, UTM, MGRS y Plus Codes.',
      fr: 'Basculez entre degrés décimaux, DMS, UTM, MGRS et Plus Codes.',
      de: 'Konvertieren zwischen Dezimalgrad, DMS, UTM, MGRS und Plus Codes.',
      pt: 'Converta entre graus decimais, DMS, UTM, MGRS e Plus Codes.',
      hi: 'दशमलव डिग्री, DMS, UTM, MGRS और Plus Code में बदलें।',
      id: 'Konversi antara derajat desimal, DMS, UTM, MGRS, dan Plus Code.',
    },
  },
  {
    icon: '📏',
    href: '/tools/distance-calculator/',
    title: {
      en: 'Distance Calculator',
      es: 'Calculadora de Distancia',
      fr: 'Calculateur de Distance',
      de: 'Entfernungsrechner',
      pt: 'Calculadora de Distância',
      hi: 'दूरी कैलकुलेटर',
      id: 'Kalkulator Jarak',
    },
    desc: {
      en: 'Measure exact straight-line and great-circle range between two points.',
      es: 'Mida la distancia ortodrómica exacta entre dos puntos del mapa.',
      fr: 'Mesurez la distance orthodromique exacte entre deux points.',
      de: 'Genaue Großkreis-Distanz zwischen zwei Punkten berechnen.',
      pt: 'Meça a distância ortodrômica exata entre dois pontos do mapa.',
      hi: 'मानचित्र पर दो बिंदुओं के बीच सटीक हवाई दूरी मापें।',
      id: 'Ukur jarak garis lurus lingkaran besar antara dua titik.',
    },
  },
  {
    icon: '⛰️',
    href: '/tools/elevation-finder/',
    title: {
      en: 'Elevation & Altitude Finder',
      es: 'Buscador de Altitud y Elevación',
      fr: "Localisateur d'Élévation et d'Altitude",
      de: 'Höhenfinder & Höhenmesser',
      pt: 'Localizador de Altitude e Elevação',
      hi: 'ऊंचाई और एल्टीट्यूड खोजक',
      id: 'Pencari Elevasi & Ketinggian',
    },
    desc: {
      en: 'Query vertical ground elevation above sea level for any coordinate.',
      es: 'Consulte la altitud sobre el nivel del mar para cualquier punto.',
      fr: "Consultez l'altitude au-dessus du niveau de la mer en tout point.",
