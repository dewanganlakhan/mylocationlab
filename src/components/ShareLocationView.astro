---
/**
 * ShareLocationView — Multilingual Share Location Page View
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import AuthorEAT from './AuthorEAT.astro';
import { getLocalizedPath, type SupportedLang, defaultLang } from '../i18n/config';
import { shareLocationTranslations } from '../i18n/shareLocation';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const c = shareLocationTranslations[lang] || shareLocationTranslations.en;

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: c.breadcrumb }
];

const pageUrl = getLocalizedPath('/share-location/', lang);
const shareSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: c.metaTitle,
  description: c.metaDescription,
  url: `https://mylocationlab.com${pageUrl}`,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const relatedTools = [
  {
    title: lang === 'es' ? 'Código QR de Ubicación' : lang === 'fr' ? 'Code QR de Localisation' : lang === 'de' ? 'Standort QR-Code' : lang === 'pt' ? 'QR Code de Localização' : lang === 'hi' ? 'लोकेशन QR कोड' : lang === 'id' ? 'QR Code Lokasi' : 'Location QR Code',
    sub: lang === 'es' ? 'Comparte tu posición mediante escaneo físico' : lang === 'fr' ? 'Partage instantané par scan mobile' : lang === 'de' ? 'Teilen per Smartphone-Scan' : lang === 'pt' ? 'Compartilhe por escaneamento móvel' : lang === 'hi' ? 'मोबाइल स्कैन के जरिए शेयर करें' : lang === 'id' ? 'Bagikan lewat pemindaian cepat' : 'Generate printable scan codes for physical sharing',
    href: getLocalizedPath('/tools/location-qr-code/', lang),
    icon: '📱'
  },
  {
    title: lang === 'es' ? 'Buscador de Coordenadas GPS' : lang === 'fr' ? 'Coordonnées GPS' : lang === 'de' ? 'GPS-Koordinaten' : lang === 'pt' ? 'Coordenadas GPS' : lang === 'hi' ? 'GPS निर्देशांक खोजक' : lang === 'id' ? 'Pencari Koordinat GPS' : 'GPS Coordinates Finder',
    sub: lang === 'es' ? 'Latitud y longitud precisas de hardware' : lang === 'fr' ? 'Latitude et longitude brutes précises' : lang === 'de' ? 'Präzise Hardware-Breite und Länge' : lang === 'pt' ? 'Latitude e longitude de precisão' : lang === 'hi' ? 'सटीक हार्डवेयर अक्षांश व देशांतर' : lang === 'id' ? 'Lintang dan bujur akurat' : 'Extract high-accuracy hardware latitude and longitude',
    href: getLocalizedPath('/tools/gps-coordinates/', lang),
    icon: '🛰️'
  },
  {
    title: lang === 'es' ? '¿Cuál es Mi Dirección?' : lang === 'fr' ? 'Quelle est Mon Adresse ?' : lang === 'de' ? 'Was ist meine Adresse?' : lang === 'pt' ? 'Qual é o Meu Endereço?' : lang === 'hi' ? 'मेरा पता क्या है?' : lang === 'id' ? 'Apa Alamat Saya?' : 'What Is My Address?',
    sub: lang === 'es' ? 'Geocodificación inversa a calle y portal' : lang === 'fr' ? 'Résolution postale exacte de votre position' : lang === 'de' ? 'Automatische Straßen- und Hausnummer-Erkennung' : lang === 'pt' ? 'Resolução de endereço postal exato' : lang === 'hi' ? 'सटीक डाक पता और सड़क पहचान' : lang === 'id' ? 'Resolusi alamat jalan lengkap' : 'Translate your coordinates to an exact postal street address',
    href: getLocalizedPath('/my-location/address/', lang),
    icon: '🏠'
  },
  {
    title: lang === 'es' ? 'Calculadora de Distancia' : lang === 'fr' ? 'Calculateur de Distance' : lang === 'de' ? 'Entfernungsrechner' : lang === 'pt' ? 'Calculadora de Distância' : lang === 'hi' ? 'दूरी कैलकुलेटर' : lang === 'id' ? 'Kalkulator Jarak' : 'Distance Calculator',
    sub: lang === 'es' ? 'Calcula distancia geodésica entre dos puntos' : lang === 'fr' ? 'Mesurez la distance orthodromique' : lang === 'de' ? 'Luftlinie und geodesischer Abstand' : lang === 'pt' ? 'Distância geodésica entre pontos' : lang === 'hi' ? 'दो बिंदुओं के बीच भूगणितीय दूरी' : lang === 'id' ? 'Ukur jarak geodesik dua titik' : 'Calculate great-circle geodesic distance to any destination',
    href: getLocalizedPath('/tools/distance-calculator/', lang),
    icon: '📏'
  },
  {
    title: lang === 'es' ? 'Conversor de Coordenadas' : lang === 'fr' ? 'Convertisseur de Coordonnées' : lang === 'de' ? 'Koordinaten-Konverter' : lang === 'pt' ? 'Conversor de Coordenadas' : lang === 'hi' ? 'कोऑर्डिनेट कनवर्टर' : lang === 'id' ? 'Konverter Koordinat' : 'Coordinate Converter',
    sub: lang === 'es' ? 'Conversión bidireccional DD, DMS y UTM' : lang === 'fr' ? 'Conversion instantanée DD, DMS et UTM' : lang === 'de' ? 'Schnelle Umrechnung von DD, DMS und UTM' : lang === 'pt' ? 'Conversão rápida DD, DMS e UTM' : lang === 'hi' ? 'DD, DMS और UTM में लाइव रूपांतरण' : lang === 'id' ? 'Konversi cepat DD, DMS, dan UTM' : 'Convert live positions between DD, DMS, and UTM standards',
    href: getLocalizedPath('/tools/coordinate-converter/', lang),
    icon: '🧭'
  },
  {
    title: lang === 'es' ? 'Comprobador de Precisión GPS' : lang === 'fr' ? 'Vérificateur de Précision GPS' : lang === 'de' ? 'GPS-Genauigkeitsprüfer' : lang === 'pt' ? 'Verificador de Precisão GPS' : lang === 'hi' ? 'GPS सटीकता चेकर' : lang === 'id' ? 'Pemeriksa Akurasi GPS' : 'GPS Accuracy Checker',
    sub: lang === 'es' ? 'Verifica el radio de error y constelaciones' : lang === 'fr' ? 'Inspectez le rayon de précision de vos capteurs' : lang === 'de' ? 'Überprüfen Sie den Genauigkeitsradius' : lang === 'pt' ? 'Inspecione o raio de incerteza do GPS' : lang === 'hi' ? 'सेंसर का अनिश्चितता दायरा जांचें' : lang === 'id' ? 'Periksa radius ketidakpastian perangkat' : 'Inspect device sensor confidence radius and signal strength',
    href: getLocalizedPath('/tools/gps-accuracy/', lang),
    icon: '🎯'
  }
];
---

<BaseLayout
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  activeSection="resources"
  jsonLd={[shareSchema]}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />

    <section class="page-header" style="text-align: center; margin-bottom: var(--space-8);">
      <h1>{c.titlePrefix} <span class="text-gradient">{c.titleHighlight}</span></h1>
      <p class="page-header-desc" style="max-width: 650px; margin: 0 auto;">
        {c.subtitle}
      </p>
    </section>

    <AuthorEAT 
      lang={lang}
      reviewedBy="MyLocationLab Editorial Team" 
      reviewerTitle={c.eatRole} 
      lastUpdated="September 2026" 
    />

    <div class="tool-interface" style="max-width: var(--max-width-narrow); margin: 0 auto var(--space-12);"
      data-status-requesting={c.statusRequesting}
      data-status-acquired={c.statusAcquired}
      data-btn-refresh={c.btnRefresh}
      data-copied-link={c.copiedLink}
      data-copy-link={c.copyLinkBtn}
      data-copied-coords={c.copiedCoords}
      data-copy-coords={c.copyCoordsBtn}
    >
      <div style="text-align: center; margin-bottom: var(--space-6);">
        <button class="btn btn-primary btn-lg" id="sl-gps-btn" type="button">
          {c.getShareBtn}
        </button>
        <p id="sl-status" style="font-size: var(--text-xs); color: var(--color-text-secondary); margin-top: var(--space-2);">
          {c.statusInitial}
        </p>
      </div>

      <!-- Sharing Container -->
      <div id="sl-results" style="display: none;">
        <!-- Location details snippet -->
        <div class="card card-flat" style="padding: var(--space-4); margin-bottom: var(--space-6); background: var(--color-bg-tertiary);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2);">
            <span style="font-size: var(--text-xs); color: var(--color-accent-primary); font-weight: 700;">{c.coordsLabel}</span>
            <span class="badge badge-success" id="sl-accuracy-badge">{c.accuracyLabel}</span>
          </div>
          <div id="sl-coords-text" style="font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 700; color: var(--color-text-heading); margin-bottom: var(--space-2);">
            —
          </div>
          <div id="sl-address-text" style="font-size: var(--text-sm); color: var(--color-text-secondary);">
            {c.resolvingAddr}
          </div>
        </div>

        <!-- Share Actions Grid -->
        <h3 style="font-size: var(--text-base); margin-bottom: var(--space-3); color: var(--color-text-heading);">{c.shareOptions}</h3>
        <div class="grid grid-2" style="gap: var(--space-3); margin-bottom: var(--space-6);">
          <button class="btn btn-secondary" id="sl-copy-link-btn" type="button">
            {c.copyLinkBtn}
          </button>
          <button class="btn btn-secondary" id="sl-copy-coords-btn" type="button">
            {c.copyCoordsBtn}
          </button>
          <a class="btn btn-secondary" id="sl-whatsapp-btn" href="#" target="_blank" rel="noopener noreferrer">
            {c.shareWhatsApp}
          </a>
          <a class="btn btn-secondary" id="sl-sms-btn" href="#">
            {c.shareSms}
          </a>
          <a class="btn btn-secondary" id="sl-google-maps" href="#" target="_blank" rel="noopener noreferrer">
            {c.openGoogle}
          </a>
          <a class="btn btn-secondary" id="sl-apple-maps" href="#" target="_blank" rel="noopener noreferrer">
            {c.openApple}
          </a>
        </div>

        <div style="text-align: center; border-top: 1px solid var(--color-border); padding-top: var(--space-4);">
          <a href={getLocalizedPath('/tools/location-qr-code/', lang)} class="btn btn-ghost btn-sm">
            {c.needQrBtn}
          </a>
        </div>
      </div>
    </div>

    <!-- Educational & Privacy Prose -->
    <article class="prose" style="max-width: var(--max-width-narrow); margin: 0 auto var(--space-12);">
      <h2>{c.h2How}</h2>
      <p>{c.pHow1}</p>
      <p>{c.pHow2}</p>

      <h2>{c.h2When}</h2>
      <ul>
        <li><strong>{c.when1Title}</strong> {c.when1Desc}</li>
        <li><strong>{c.when2Title}</strong> {c.when2Desc}</li>
        <li><strong>{c.when3Title}</strong> {c.when3Desc}</li>
      </ul>
    </article>

    <!-- Contextual Internal Linking to Related Tools -->
    <div class="contextual-next-box" style="margin-bottom: var(--space-16);">
      <h3 style="margin-top: 0; margin-bottom: var(--space-2);">
        {lang === 'es' ? '🔗 Herramientas Geográficas Conectadas' :
         lang === 'fr' ? '🔗 Outils Géographiques Connectés' :
         lang === 'de' ? '🔗 Verbundene Geotools & Rechner' :
         lang === 'pt' ? '🔗 Ferramentas Geográficas Conectadas' :
         lang === 'hi' ? '🔗 जुड़े हुए भौगोलिक उपकरण' :
         lang === 'id' ? '🔗 Alat Geografis Terhubung' :
         '🔗 Connected Geolocation Utilities'}
      </h3>
      <p style="font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: var(--space-4);">
        {lang === 'es' ? 'Explora más herramientas para convertir, medir y verificar tus datos de posicionamiento:' :
         lang === 'fr' ? 'Découvrez d\'autres utilitaires pour convertir, mesurer et vérifier votre position :' :
         lang === 'de' ? 'Entdecken Sie weitere Tools zur Koordinatenumrechnung, Distanzmessung und Fehlerprüfung:' :
         lang === 'pt' ? 'Explore mais ferramentas para converter, medir e verificar seus dados de posicionamento:' :
         lang === 'hi' ? 'अपने स्थान डेटा को परिवर्तित, मापने और जांचने के लिए अन्य टूल देखें:' :
         lang === 'id' ? 'Jelajahi lebih banyak alat untuk mengonversi, mengukur, dan memverifikasi data posisi Anda:' :
         'Explore complementary tools to inspect, format, measure, and verify your coordinates:'}
      </p>
      <div class="contextual-next-grid">
        {relatedTools.map((tool) => (
          <a href={tool.href} class="contextual-link-card">
            <span class="contextual-link-icon">{tool.icon}</span>
            <div class="contextual-link-info">
              <div class="contextual-link-title">{tool.title}</div>
              <div class="contextual-link-sub">{tool.sub}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <script>
    import GeoLocation from '../scripts/geolocation.js';
    import Geocoding from '../scripts/geocoding.js';

    const container = document.querySelector('.tool-interface');
    const msgRequesting = container?.getAttribute('data-status-requesting') || 'Requesting browser GPS permission...';
    const msgAcquired = container?.getAttribute('data-status-acquired') || 'Location successfully acquired!';
    const btnRefreshTxt = container?.getAttribute('data-btn-refresh') || '🔄 Refresh Position';
    const copiedLinkTxt = container?.getAttribute('data-copied-link') || '✅ Copied Link!';
    const copyLinkOriginal = container?.getAttribute('data-copy-link') || '📋 Copy Map Link';
    const copiedCoordsTxt = container?.getAttribute('data-copied-coords') || '✅ Copied Coordinates!';
    const copyCoordsOriginal = container?.getAttribute('data-copy-coords') || '📐 Copy Coordinates';

    const gpsBtn = document.getElementById('sl-gps-btn');
    const statusEl = document.getElementById('sl-status');
    const resultsBox = document.getElementById('sl-results');
    const coordsEl = document.getElementById('sl-coords-text');
    const addressEl = document.getElementById('sl-address-text');
    const accuracyBadge = document.getElementById('sl-accuracy-badge');

    const copyLinkBtn = document.getElementById('sl-copy-link-btn');
    const copyCoordsBtn = document.getElementById('sl-copy-coords-btn');
    const whatsappBtn = document.getElementById('sl-whatsapp-btn');
    const smsBtn = document.getElementById('sl-sms-btn');
    const googleBtn = document.getElementById('sl-google-maps');
    const appleBtn = document.getElementById('sl-apple-maps');

    let currentLat = 0;
    let currentLng = 0;
    let shareUrl = '';

    if (gpsBtn) {
      gpsBtn.addEventListener('click', async () => {
        gpsBtn.textContent = '...';
        if (statusEl) statusEl.textContent = msgRequesting;

        try {
          const pos = await GeoLocation.getCurrentPosition({ enableHighAccuracy: true });
          currentLat = pos.latitude;
          currentLng = pos.longitude;

          shareUrl = `https://maps.google.com/?q=${currentLat.toFixed(6)},${currentLng.toFixed(6)}`;

          if (coordsEl) coordsEl.textContent = `${currentLat.toFixed(6)}, ${currentLng.toFixed(6)}`;
          if (accuracyBadge) accuracyBadge.textContent = `±${Math.round(pos.accuracy)}m`;

          if (resultsBox) resultsBox.style.display = 'block';
          if (statusEl) statusEl.textContent = msgAcquired;
          gpsBtn.textContent = btnRefreshTxt;

          // Set links
          if (googleBtn) googleBtn.setAttribute('href', `https://maps.google.com/?q=${currentLat},${currentLng}`);
          if (appleBtn) appleBtn.setAttribute('href', `https://maps.apple.com/?ll=${currentLat},${currentLng}&q=My%20Location`);
          
          const shareText = `Here is my current location: https://maps.google.com/?q=${currentLat.toFixed(6)},${currentLng.toFixed(6)}`;
          if (whatsappBtn) whatsappBtn.setAttribute('href', `https://api.whatsapp.com/send?text=${encodeURIComponent(shareText)}`);
          if (smsBtn) smsBtn.setAttribute('href', `sms:?body=${encodeURIComponent(shareText)}`);

          // Reverse geocode for address display
          try {
            const addr = await Geocoding.reverseGeocode(currentLat, currentLng);
            if (addressEl) addressEl.textContent = addr.displayName || 'Address resolved';
          } catch (e) {
            if (addressEl) addressEl.textContent = `${currentLat.toFixed(6)}, ${currentLng.toFixed(6)}`;
          }
        } catch (err: any) {
          if (statusEl) statusEl.textContent = `Error: ${err.message || 'Location access denied'}`;
          gpsBtn.textContent = '📍 Try Again';
        }
      });
    }

    if (copyLinkBtn) {
      copyLinkBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(shareUrl).then(() => {
          copyLinkBtn.textContent = copiedLinkTxt;
          setTimeout(() => { copyLinkBtn.textContent = copyLinkOriginal; }, 2000);
        });
      });
    }

    if (copyCoordsBtn) {
      copyCoordsBtn.addEventListener('click', () => {
        const text = `${currentLat.toFixed(6)}, ${currentLng.toFixed(6)}`;
        navigator.clipboard.writeText(text).then(() => {
          copyCoordsBtn.textContent = copiedCoordsTxt;
          setTimeout(() => { copyCoordsBtn.textContent = copyCoordsOriginal; }, 2000);
        });
      });
    }
  </script>
</BaseLayout>
