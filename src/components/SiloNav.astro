---
/**
 * SiloNav — Compact silo quick-nav strip
 * A slim, single-row chip strip that keeps the internal silo interlinking
 * (every hub + spoke link) without pushing the page's main tool/content
 * below the fold. Replaces the old boxed "Geospatial Utilities & Tools" card.
 */
import { myLocationSubNav, toolsNav, guidesNav, comparisonsNav } from '../data/navigation.js';

interface Props {
  silo: 'my-location' | 'tools' | 'guides' | 'comparisons' | 'maps';
  currentPath?: string;
  title?: string;
}

const { silo, currentPath = Astro.url.pathname, title } = Astro.props;

let items: { label: string; href: string; icon?: string }[] = [];
let siloTitle = '';
let siloHubHref = '';
let hubLabel = 'All';

if (silo === 'my-location') {
  siloTitle = 'Related Location Tools';
  siloHubHref = '/my-location/';
  hubLabel = 'Where Am I';
  items = myLocationSubNav;
} else if (silo === 'tools') {
  siloTitle = 'Geospatial Utilities & Tools';
  siloHubHref = '/tools/';
  hubLabel = 'All Tools';
  items = toolsNav;
} else if (silo === 'guides') {
  siloTitle = 'Location Guides & Tutorials';
  siloHubHref = '/guides/';
  hubLabel = 'All Guides';
  items = guidesNav;
} else if (silo === 'comparisons') {
  siloTitle = 'Accuracy & Tech Comparisons';
  siloHubHref = '/comparisons/';
  hubLabel = 'All Comparisons';
  items = comparisonsNav;
}
---

{items.length > 0 && (
  <nav class="quicknav" aria-label={`${title || siloTitle} quick links`}>
    <a href={siloHubHref} class="quicknav-hub">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="3" width="7" height="7" rx="1.5"/>
        <rect x="3" y="14" width="7" height="7" rx="1.5"/>
        <rect x="14" y="14" width="7" height="7" rx="1.5"/>
      </svg>
      <span>{hubLabel}</span>
    </a>
    <span class="quicknav-divider" aria-hidden="true"></span>
    <div class="quicknav-track">
      {items.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href) && currentPath.length === item.href.length);
        return (
          <a href={item.href} class={`quicknav-chip ${isActive ? 'active' : ''}`} aria-current={isActive ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })}
    </div>
  </nav>
)}

<style>
  .quicknav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-1) 0 var(--space-4);
    min-width: 0;
  }

  .quicknav-hub {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding: 7px 13px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--color-accent-primary);
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .quicknav-hub:hover {
    border-color: var(--color-accent-primary);
  }

  .quicknav-divider {
    width: 1px;
    height: 18px;
    background: var(--color-border);
    flex-shrink: 0;
  }

  .quicknav-track {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    min-width: 0;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .quicknav-track::-webkit-scrollbar {
    display: none;
  }

  .quicknav-chip {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    color: var(--color-text-secondary);
    background: var(--color-bg-tertiary);
    border: 1px solid transparent;
    transition: all var(--transition-fast);
  }

  .quicknav-chip:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-card);
    border-color: var(--color-border);
  }

  .quicknav-chip.active {
    background: var(--gradient-primary);
    color: var(--color-btn-primary-text);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .quicknav-track {
      mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 24px), transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 24px), transparent);
    }
  }
</style>

<script>
  // Bring the current page's chip into view so the active state is never
  // hidden past the scroll edge on narrow screens.
  const track = document.querySelector('.quicknav-track');
  const activeChip = track?.querySelector('.quicknav-chip.active');
  if (track && activeChip) {
    const trackRect = track.getBoundingClientRect();
    const chipRect = activeChip.getBoundingClientRect();
    const offset = chipRect.left - trackRect.left;
    track.scrollTo({ left: Math.max(0, offset - 24), behavior: 'instant' });
  }
</script>
