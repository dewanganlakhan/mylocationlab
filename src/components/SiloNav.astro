---
/**
 * SiloNav — Compact silo quick-nav strip
 * A slim, single-row chip strip that keeps the internal silo interlinking
 * (every hub + spoke link) without pushing the page's main tool/content
 * below the fold. Replaces the old boxed "Geospatial Utilities & Tools" card.
 */
import { myLocationSubNav, toolsNav, guidesNav, comparisonsNav, localizedNavLabels } from '../data/navigation.js';
import { getLangFromUrl, getLocalizedPath, type SupportedLang } from '../i18n/config';

interface Props {
  silo?: 'my-location' | 'tools' | 'guides' | 'comparisons' | 'maps';
  currentSection?: string;
  currentPath?: string;
  title?: string;
  lang?: string;
}

const { silo: propSilo, currentSection, currentPath = Astro.url.pathname, title, lang: customLang } = Astro.props;
const silo = propSilo || (currentSection as any);
const lang = (customLang || getLangFromUrl(Astro.url)) as SupportedLang;

// Localized labels for the chips; falls back to the English array label.
const navLabels = localizedNavLabels as Record<string, Partial<Record<string, string>>>;
const chipLabel = (href: string, fallback: string) => navLabels[href]?.[lang] || fallback;

// Per-silo section title + hub label per language (en holds the current strings).
const siloCopy: Record<string, Record<string, { siloTitle: string; hubLabel: string }>> = {
  'my-location': {
    en: { siloTitle: 'Related Location Tools', hubLabel: 'Where Am I' },
    es: { siloTitle: 'Herramientas de Ubicación Relacionadas', hubLabel: '¿Dónde Estoy?' },
    fr: { siloTitle: 'Outils de Localisation Associés', hubLabel: 'Où Suis-Je ?' },
    de: { siloTitle: 'Verwandte Standort-Tools', hubLabel: 'Wo Bin Ich?' },
    pt: { siloTitle: 'Ferramentas de Localização Relacionadas', hubLabel: 'Onde Estou?' },
    hi: { siloTitle: 'संबंधित लोकेशन टूल्स', hubLabel: 'मैं कहाँ हूँ' },
    id: { siloTitle: 'Alat Lokasi Terkait', hubLabel: 'Saya di Mana' },
  },
  tools: {
    en: { siloTitle: 'Geospatial Utilities & Tools', hubLabel: 'All Tools' },
    es: { siloTitle: 'Utilidades y Herramientas Geoespaciales', hubLabel: 'Todas las Herramientas' },
    fr: { siloTitle: 'Utilitaires et Outils Géospatiaux', hubLabel: 'Tous les Outils' },
    de: { siloTitle: 'Geodaten-Utilities & Tools', hubLabel: 'Alle Tools' },
    pt: { siloTitle: 'Utilitários e Ferramentas Geoespaciais', hubLabel: 'Todas as Ferramentas' },
    hi: { siloTitle: 'भू-स्थानिक यूटिलिटीज़ और टूल्स', hubLabel: 'सभी टूल्स' },
    id: { siloTitle: 'Utilitas & Alat Geospasial', hubLabel: 'Semua Alat' },
  },
  guides: {
    en: { siloTitle: 'Location Guides & Tutorials', hubLabel: 'All Guides' },
    es: { siloTitle: 'Guías y Tutoriales de Ubicación', hubLabel: 'Todas las Guías' },
    fr: { siloTitle: 'Guides et Tutoriels de Localisation', hubLabel: 'Tous les Guides' },
    de: { siloTitle: 'Standort-Guides & Tutorials', hubLabel: 'Alle Guides' },
    pt: { siloTitle: 'Guias e Tutoriais de Localização', hubLabel: 'Todos os Guias' },
    hi: { siloTitle: 'लोकेशन गाइड और ट्यूटोरियल', hubLabel: 'सभी गाइड' },
    id: { siloTitle: 'Panduan & Tutorial Lokasi', hubLabel: 'Semua Panduan' },
  },
  comparisons: {
    en: { siloTitle: 'Accuracy & Tech Comparisons', hubLabel: 'All Comparisons' },
    es: { siloTitle: 'Comparativas de Precisión y Tecnología', hubLabel: 'Todas las Comparativas' },
    fr: { siloTitle: 'Comparatifs de Précision et Technologie', hubLabel: 'Tous les Comparatifs' },
    de: { siloTitle: 'Genauigkeits- & Tech-Vergleiche', hubLabel: 'Alle Vergleiche' },
    pt: { siloTitle: 'Comparações de Precisão e Tecnologia', hubLabel: 'Todas as Comparações' },
    hi: { siloTitle: 'सटीकता और टेक तुलना', hubLabel: 'सभी तुलनाएं' },
    id: { siloTitle: 'Perbandingan Akurasi & Teknologi', hubLabel: 'Semua Perbandingan' },
  },
};

let items: { label: string; href: string; icon?: string }[] = [];
let siloKey: string | null = null;
let siloTitle = '';
let siloHubHref = '';
let hubLabel = 'All';

if (silo === 'my-location') {
  siloKey = 'my-location';
  siloHubHref = '/my-location/';
  items = myLocationSubNav;
} else if (silo === 'tools') {
  siloKey = 'tools';
  siloHubHref = '/tools/';
  items = toolsNav;
} else if (silo === 'guides') {
  siloKey = 'guides';
  siloHubHref = '/guides/';
  items = guidesNav;
} else if (silo === 'comparisons') {
  siloKey = 'comparisons';
  siloHubHref = '/comparisons/';
  items = comparisonsNav;
}

const copy = (siloKey && siloCopy[siloKey]?.[lang]) || (siloKey && siloCopy[siloKey]?.en) || null;
if (copy) {
  siloTitle = copy.siloTitle;
  hubLabel = copy.hubLabel;
}
---

{items.length > 0 && (
  <nav class="quicknav" aria-label={`${title || siloTitle} quick links`}>
    <a href={getLocalizedPath(siloHubHref, lang)} class="quicknav-hub">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="3" width="7" height="7" rx="1.5"/>
        <rect x="3" y="14" width="7" height="7" rx="1.5"/>
        <rect x="14" y="14" width="7" height="7" rx="1.5"/>
      </svg>
      <span>{hubLabel}</span>
    </a>
    <span class="quicknav-divider" aria-hidden="true"></span>
    <ul class="quicknav-track quicknav-list" role="list">
      {items.map((item) => {
        const itemLocalizedHref = getLocalizedPath(item.href, lang);
        const isActive = currentPath === itemLocalizedHref || currentPath === item.href;
        return (
          <li role="listitem">
            <a href={itemLocalizedHref} class={`quicknav-chip ${isActive ? 'active' : ''}`} aria-current={isActive ? 'page' : undefined}>
              {chipLabel(item.href, item.label)}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
)}

<style>
  .quicknav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-1) 0 var(--space-4);
    min-width: 0;
  }

  .quicknav-hub {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding: 7px 13px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--color-accent-primary);
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .quicknav-hub:hover {
    border-color: var(--color-accent-primary);
  }

  .quicknav-divider {
    width: 1px;
    height: 18px;
    background: var(--color-border);
    flex-shrink: 0;
  }

  .quicknav-track {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    min-width: 0;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .quicknav-track::-webkit-scrollbar {
    display: none;
  }

  .quicknav-chip {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    color: var(--color-text-secondary);
    background: var(--color-bg-tertiary);
    border: 1px solid transparent;
    transition: all var(--transition-fast);
  }

  .quicknav-chip:hover {
    color: var(--color-text-primary);
    background: var(--color-bg-card);
    border-color: var(--color-border);
  }

  .quicknav-chip.active {
    background: var(--gradient-primary);
    color: var(--color-btn-primary-text);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .quicknav-track {
      mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 24px), transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 24px), transparent);
    }
  }
</style>

<script>
  // Bring the current page's chip into view so the active state is never
  // hidden past the scroll edge on narrow screens.
  const track = document.querySelector('.quicknav-track');
  const activeChip = track?.querySelector('.quicknav-chip.active');
  if (track && activeChip) {
    const trackRect = track.getBoundingClientRect();
    const chipRect = activeChip.getBoundingClientRect();
    const offset = chipRect.left - trackRect.left;
    track.scrollTo({ left: Math.max(0, offset - 24), behavior: 'instant' });
  }
</script>
