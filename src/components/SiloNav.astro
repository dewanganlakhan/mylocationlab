---
/**
 * SiloNav — Sidebar navigation list for content/guide/comparison pages
 * Displays a clean vertical list of guides, comparisons, or tools with active state indicators.
 */
import { myLocationSubNav, toolsNav, guidesNav, comparisonsNav, localizedNavLabels } from '../data/navigation.js';
import { getLangFromUrl, getLocalizedPath, type SupportedLang } from '../i18n/config';

interface Props {
  silo?: 'my-location' | 'tools' | 'guides' | 'comparisons' | 'maps';
  currentSection?: string;
  currentPath?: string;
  title?: string;
  lang?: string;
}

const { silo: propSilo, currentSection, currentPath = Astro.url.pathname, title, lang: customLang } = Astro.props;
const silo = propSilo || (currentSection as any);
const lang = (customLang || getLangFromUrl(Astro.url)) as SupportedLang;

// Localized labels for the chips; falls back to the English array label.
const navLabels = localizedNavLabels as Record<string, Partial<Record<string, string>>>;
const chipLabel = (href: string, fallback: string) => navLabels[href]?.[lang] || fallback;

// Per-silo section title + hub label per language
const siloCopy: Record<string, Record<string, { siloTitle: string; hubLabel: string }>> = {
  'my-location': {
    en: { siloTitle: 'Related Location Tools', hubLabel: 'All Location Tools' },
    es: { siloTitle: 'Herramientas de Ubicación', hubLabel: 'Todas las Herramientas' },
    fr: { siloTitle: 'Outils de Localisation', hubLabel: 'Tous les Outils' },
    de: { siloTitle: 'Verwandte Standort-Tools', hubLabel: 'Alle Tools' },
    pt: { siloTitle: 'Ferramentas de Localização', hubLabel: 'Todas as Ferramentas' },
    hi: { siloTitle: 'संबंधित लोकेशन टूल्स', hubLabel: 'सभी टूल्स' },
    id: { siloTitle: 'Alat Lokasi Terkait', hubLabel: 'Semua Alat' },
  },
  tools: {
    en: { siloTitle: 'Geospatial Tools', hubLabel: 'All Tools' },
    es: { siloTitle: 'Herramientas Geoespaciales', hubLabel: 'Todas las Herramientas' },
    fr: { siloTitle: 'Outils Géospatiaux', hubLabel: 'Tous les Outils' },
    de: { siloTitle: 'Geodaten-Tools', hubLabel: 'Alle Tools' },
    pt: { siloTitle: 'Ferramentas Geoespaciais', hubLabel: 'Todas as Ferramentas' },
    hi: { siloTitle: 'भू-स्थानिक टूल्स', hubLabel: 'सभी टूल्स' },
    id: { siloTitle: 'Alat Geospasial', hubLabel: 'Semua Alat' },
  },
  guides: {
    en: { siloTitle: 'All Guides & Tutorials', hubLabel: 'Browse Guides' },
    es: { siloTitle: 'Guías y Tutoriales', hubLabel: 'Ver Guías' },
    fr: { siloTitle: 'Guides et Tutoriels', hubLabel: 'Tous les Guides' },
    de: { siloTitle: 'Guides & Tutorials', hubLabel: 'Alle Guides' },
    pt: { siloTitle: 'Guias e Tutoriais', hubLabel: 'Ver Guias' },
    hi: { siloTitle: 'सभी गाइड और ट्यूटोरियल', hubLabel: 'गाइड देखें' },
    id: { siloTitle: 'Semua Panduan', hubLabel: 'Lihat Panduan' },
  },
  comparisons: {
    en: { siloTitle: 'Tech Comparisons', hubLabel: 'All Comparisons' },
    es: { siloTitle: 'Comparativas Técnicas', hubLabel: 'Todas las Comparativas' },
    fr: { siloTitle: 'Comparatifs Techniques', hubLabel: 'Tous les Comparatifs' },
    de: { siloTitle: 'Tech-Vergleiche', hubLabel: 'Alle Vergleiche' },
    pt: { siloTitle: 'Comparações Técnicas', hubLabel: 'Todas as Comparações' },
    hi: { siloTitle: 'तकनीकी तुलनाएं', hubLabel: 'सभी तुलनाएं' },
    id: { siloTitle: 'Perbandingan Teknis', hubLabel: 'Semua Perbandingan' },
  },
};

let items: { label: string; href: string; icon?: string }[] = [];
let siloKey: string | null = null;
let siloTitle = '';
let siloHubHref = '';
let hubLabel = 'All';

if (silo === 'my-location') {
  siloKey = 'my-location';
  siloHubHref = '/location/';
  items = myLocationSubNav;
} else if (silo === 'tools') {
  siloKey = 'tools';
  siloHubHref = '/tools/';
  items = toolsNav;
} else if (silo === 'guides') {
  siloKey = 'guides';
  siloHubHref = '/guides/';
  items = guidesNav;
} else if (silo === 'comparisons') {
  siloKey = 'comparisons';
  siloHubHref = '/comparisons/';
  items = comparisonsNav;
}

const copy = (siloKey && siloCopy[siloKey]?.[lang]) || (siloKey && siloCopy[siloKey]?.en) || null;
if (copy) {
  siloTitle = copy.siloTitle;
  hubLabel = copy.hubLabel;
}
---

{items.length > 0 && (
  <nav class="sidebar-nav-card" aria-label={`${title || siloTitle} links`}>
    <div class="sidebar-nav-header">
      <h4 class="sidebar-nav-title">{title || siloTitle}</h4>
      <a href={getLocalizedPath(siloHubHref, lang)} class="sidebar-nav-hub-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1.5"/>
          <rect x="14" y="3" width="7" height="7" rx="1.5"/>
          <rect x="3" y="14" width="7" height="7" rx="1.5"/>
          <rect x="14" y="14" width="7" height="7" rx="1.5"/>
        </svg>
        <span>{hubLabel}</span>
      </a>
    </div>

    <ul class="sidebar-nav-list" role="list">
      {items.map((item) => {
        const itemLocalizedHref = getLocalizedPath(item.href, lang);
        const isActive = currentPath === itemLocalizedHref || currentPath === item.href;
        return (
          <li role="listitem">
            <a
              href={itemLocalizedHref}
              class={`sidebar-nav-item ${isActive ? 'active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              <span class="sidebar-nav-bullet" aria-hidden="true"></span>
              <span class="sidebar-nav-label">{chipLabel(item.href, item.label)}</span>
              {isActive && (
                <span class="sidebar-nav-active-pill" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
)}

<style>
  .sidebar-nav-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.03);
  }

  .sidebar-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-nav-title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .sidebar-nav-hub-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent-primary);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: all var(--dur-short) var(--ease-out);
    white-space: nowrap;
  }

  .sidebar-nav-hub-badge:hover {
    background: var(--color-bg-card-hover);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .sidebar-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sidebar-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    border: 1px solid transparent;
    transition: all var(--dur-short) var(--ease-out);
    line-height: 1.4;
  }

  .sidebar-nav-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-border);
    flex-shrink: 0;
    transition: all var(--dur-short) var(--ease-out);
  }

  .sidebar-nav-item:hover {
    background: var(--color-bg-card-hover);
    border-color: rgba(14, 165, 233, 0.2);
    color: var(--color-accent-primary);
    transform: translateX(3px);
  }

  .sidebar-nav-item:hover .sidebar-nav-bullet {
    background: var(--color-accent-primary);
    transform: scale(1.3);
  }

  .sidebar-nav-item.active {
    background: rgba(14, 165, 233, 0.08);
    border-color: rgba(14, 165, 233, 0.25);
    color: var(--color-accent-primary);
    font-weight: 600;
  }

  .sidebar-nav-item.active .sidebar-nav-bullet {
    background: var(--color-accent-primary);
    box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.2);
  }

  .sidebar-nav-label {
    flex: 1;
    min-width: 0;
  }

  .sidebar-nav-active-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent-primary);
    flex-shrink: 0;
  }
</style>
