---
/**
 * SiloNav — Internal SILO Architecture Navigation Bar
 * Provides semantic internal linking between parent silo and related spoke pages.
 */
import { myLocationSubNav, toolsNav, guidesNav, comparisonsNav } from '../data/navigation.js';

interface Props {
  silo: 'my-location' | 'tools' | 'guides' | 'comparisons' | 'maps';
  currentPath?: string;
  title?: string;
}

const { silo, currentPath = Astro.url.pathname, title } = Astro.props;

let items: { label: string; href: string; icon?: string }[] = [];
let siloTitle = '';
let siloHubHref = '';

if (silo === 'my-location') {
  siloTitle = 'Related Location Tools';
  siloHubHref = '/my-location/';
  items = myLocationSubNav;
} else if (silo === 'tools') {
  siloTitle = 'Geospatial Utilities & Tools';
  siloHubHref = '/tools/';
  items = toolsNav;
} else if (silo === 'guides') {
  siloTitle = 'Location Guides & Tutorials';
  siloHubHref = '/guides/';
  items = guidesNav;
} else if (silo === 'comparisons') {
  siloTitle = 'Accuracy & Tech Comparisons';
  siloHubHref = '/comparisons/';
  items = comparisonsNav;
}
---

{items.length > 0 && (
  <nav class="silo-nav-container" aria-label={`${title || siloTitle} Navigation`} style="margin: var(--space-4) 0 var(--space-6); padding: var(--space-4); background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-xl);">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-3); flex-wrap: wrap; gap: var(--space-2);">
      <span style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent-primary);">
        {title || siloTitle}
      </span>
      <a href={siloHubHref} style="font-size: var(--text-xs); color: var(--color-text-secondary); text-decoration: none; font-weight: 500;">
        View All →
      </a>
    </div>

    <div class="silo-nav-links" style="display: flex; gap: var(--space-2); overflow-x: auto; padding-bottom: var(--space-1); scrollbar-width: thin;">
      {items.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href) && currentPath.length === item.href.length);
        return (
          <a
            href={item.href}
            class={`badge ${isActive ? 'badge-primary' : 'badge-neutral'}`}
            style={`text-decoration: none; padding: var(--space-2) var(--space-3); font-size: var(--text-xs); white-space: nowrap; border-radius: var(--radius-md); transition: all var(--transition-fast); ${
              isActive
                ? 'background: var(--gradient-primary); color: var(--color-btn-primary-text); font-weight: 700;'
                : 'background: var(--color-bg-tertiary); color: var(--color-text-secondary); border: 1px solid var(--color-border);'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>
  </nav>
)}
