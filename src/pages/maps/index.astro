---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorEAT from '../../components/AuthorEAT.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Interactive Maps' }
];

const mapSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Interactive Fullscreen Location Map',
  description: 'Interactive location map with live GPS tracking, coordinate picker, radius circles, and cartographic layer controls.',
  url: 'https://mylocationlab.com/maps/',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout
  title="Interactive Location Map — Live GPS View | MyLocationLab"
  description="Interactive fullscreen map of your location: switch layers, inspect coordinates by click, draw radius circles, measure distances."
  activeSection="maps"
  leaflet
  jsonLd={[mapSchema]}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />

    <section class="page-header" style="margin-bottom: var(--space-6);">
      <h1>Interactive Location <span class="text-gradient">Map</span></h1>
      <p class="page-header-desc">
        Explore your live GPS position, inspect latitude and longitude by clicking anywhere, and visualize distance radius circles.
      </p>
    </section>

    <AuthorEAT 
      reviewedBy="MyLocationLab Editorial Team" 
      reviewerTitle="Geospatial Content Reviewer" 
      lastUpdated="September 2026" 
    />

    <!-- Interactive Map Controller Card -->
    <div class="tool-interface" style="margin-bottom: var(--space-6);">
      <div class="flex gap-3 flex-wrap items-center justify-between" style="margin-bottom: var(--space-4);">
        <div class="flex gap-2 flex-wrap">
          <button class="btn btn-primary btn-sm" id="map-locate-btn" type="button">📍 Center on My Location</button>
          <button class="btn btn-secondary btn-sm" id="map-clear-pins" type="button">🧹 Clear Markers</button>
        </div>

        <div class="flex gap-2 flex-wrap items-center">
          <span style="font-size: var(--text-xs); color: var(--color-text-secondary);">Radius Circle:</span>
          <select id="map-radius-select" class="input" style="padding: 4px 8px; font-size: var(--text-xs); width: auto;">
            <option value="0">None</option>
            <option value="500">500 meters (0.31 mi)</option>
            <option value="1000" selected>1,000 meters (0.62 mi)</option>
            <option value="5000">5,000 meters (3.1 mi)</option>
            <option value="10000">10,000 meters (6.2 mi)</option>
          </select>
        </div>
      </div>

      <!-- Live Inspector Bar -->
      <div style="background: var(--color-bg-tertiary); padding: var(--space-3) var(--space-4); border-radius: var(--radius-lg); font-size: var(--text-sm); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-2); border: 1px solid var(--color-border);">
        <div style="display: flex; align-items: center; gap: var(--space-2);">
          <span style="color: var(--color-accent-primary);">📌 Selected Point:</span>
          <span id="map-coords-display" style="font-family: var(--font-mono); font-weight: 600;">Click anywhere on the map</span>
        </div>
        <button class="btn btn-ghost btn-xs" id="map-copy-coords" type="button" style="display: none;">📋 Copy</button>
      </div>
    </div>

    <!-- Map Canvas with Strict Min-Height (Zero CLS) -->
    <div 
      class="map-container" 
      id="main-leaflet-map" 
      style="width: 100%; min-height: 520px; border-radius: var(--radius-2xl); border: 1px solid var(--color-border); box-shadow: var(--shadow-glow); margin-bottom: var(--space-12);"
    ></div>

    <!-- Educational & Technical Content -->
    <article class="prose" style="max-width: var(--max-width-narrow); margin-bottom: var(--space-16);">
      <h2>Understanding Web Cartography and Map Projections</h2>
      <p>
        Modern online interactive maps utilize the <strong>Web Mercator projection (EPSG:3857)</strong>. 
        While your device's GNSS hardware collects coordinates in <strong>WGS-84 (EPSG:4326)</strong> ellipsoidal coordinates (degrees of latitude and longitude), the browser dynamically projects these spherical coordinates onto a planar 2D Mercator grid divided into 256x256 pixel raster or vector tiles.
      </p>

      <h3>How Radius Geofences Function</h3>
      <p>
        When you enable radius circles on this map, we compute a planar circle using the <strong>Haversine geodesic equation</strong>. 
        Because the Mercator projection stretches higher latitudes towards the poles (known as Mercator distortion), 
        a visual circle rendered on the screen represents a true geodesic radius on the curved surface of the Earth.
      </p>

      <h2>Explore Connected Geospatial Tools</h2>
      <ul>
        <li><a href="/tools/distance-calculator/">Distance Calculator</a> — Measure exact point-to-point distances across Earth.</li>
        <li><a href="/tools/address-finder/">Street Address Finder</a> — Convert any map coordinate into a street address.</li>
        <li><a href="/tools/coordinate-converter/">Coordinate Converter</a> — Convert decimal degrees into DMS or UTM.</li>
        <li><a href="/guides/how-gps-location-works/">How GPS Works</a> — Learn about satellite constellations and atomic clocks.</li>
      </ul>
    </article>
  </div>

  <script>
    import GeoLocation from '../../scripts/geolocation.js';

    let map = null;
    let userMarker = null;
    let radiusCircle = null;
    let selectedMarker = null;
    let currentCoords = null;

    const coordsDisplay = document.getElementById('map-coords-display');
    const copyBtn = document.getElementById('map-copy-coords');
    const locateBtn = document.getElementById('map-locate-btn');
    const clearBtn = document.getElementById('map-clear-pins');
    const radiusSelect = document.getElementById('map-radius-select') as HTMLSelectElement;

    function initMap() {
      // @ts-ignore
      if (typeof L === 'undefined') {
        setTimeout(initMap, 200);
        return;
      }

      // @ts-ignore
      map = L.map('main-leaflet-map', { scrollWheelZoom: false }).setView([20, 0], 2);

      // @ts-ignore
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);

      // Enable scroll-wheel zoom only after deliberate interaction with the map,
      // so page scrolling over the full-width map isn't hijacked.
      // @ts-ignore
      map.on('click', (e: any) => {
        // @ts-ignore
        map.scrollWheelZoom.enable();
        const { lat, lng } = e.latlng;
        setPoint(lat, lng);
      });
    }

    function setPoint(lat: number, lng: number) {
      currentCoords = { lat, lng };
      if (coordsDisplay) {
        coordsDisplay.textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
      }
      if (copyBtn) copyBtn.style.display = 'inline-flex';

      // Update marker
      if (selectedMarker) {
        selectedMarker.setLatLng([lat, lng]);
      } else {
        // @ts-ignore
        selectedMarker = L.marker([lat, lng]).addTo(map);
      }

      updateRadius(lat, lng);
    }

    function updateRadius(lat: number, lng: number) {
      const radiusMeters = parseInt(radiusSelect.value) || 0;
      if (radiusCircle) {
        map.removeLayer(radiusCircle);
        radiusCircle = null;
      }

      if (radiusMeters > 0) {
        // @ts-ignore
        radiusCircle = L.circle([lat, lng], {
          radius: radiusMeters,
          color: '#00d4ff',
          fillColor: '#00d4ff',
          fillOpacity: 0.15,
          weight: 2,
        }).addTo(map);
      }
    }

    async function getUserLocation() {
      try {
        const pos = await GeoLocation.getCurrentPosition({ enableHighAccuracy: true });
        const { latitude, longitude } = pos;

        map.setView([latitude, longitude], 15);
        setPoint(latitude, longitude);

        if (userMarker) {
          userMarker.setLatLng([latitude, longitude]);
        } else {
          // @ts-ignore
          userMarker = L.circleMarker([latitude, longitude], {
            radius: 8,
            fillColor: '#10b981',
            color: '#ffffff',
            weight: 2,
            opacity: 1,
            fillOpacity: 0.9,
          }).addTo(map).bindPopup('Your Current Location').openPopup();
        }
      } catch (err) {
        // Auto-detect failed (denied/unavailable): keep the world view — the
        // "Center on My Location" button stays available for a manual retry.
        if (!locateBtn.dataset.autoFailed) {
          locateBtn.dataset.autoFailed = '1';
        }
      }
    }

    if (locateBtn) locateBtn.addEventListener('click', () => getUserLocation());

    // Auto-center on the user once the map has initialized — no click needed.
    // If permission is already denied, the world view stays and the button
    // above remains for a manual retry.
    (async () => {
      while (!map) await new Promise((r) => setTimeout(r, 200));
      if (await GeoLocation.checkPermission() !== 'denied') {
        getUserLocation();
      }
    })();

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (selectedMarker) {
          map.removeLayer(selectedMarker);
          selectedMarker = null;
        }
        if (radiusCircle) {
          map.removeLayer(radiusCircle);
          radiusCircle = null;
        }
        if (coordsDisplay) coordsDisplay.textContent = 'Click anywhere on the map';
        if (copyBtn) copyBtn.style.display = 'none';
      });
    }

    if (radiusSelect) {
      radiusSelect.addEventListener('change', () => {
        if (currentCoords) {
          updateRadius(currentCoords.lat, currentCoords.lng);
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        if (currentCoords) {
          const text = `${currentCoords.lat.toFixed(6)}, ${currentCoords.lng.toFixed(6)}`;
          navigator.clipboard.writeText(text).then(() => {
            copyBtn.textContent = '✅ Copied!';
            setTimeout(() => { copyBtn.textContent = '📋 Copy'; }, 2000);
          });
        }
      });
    }

    document.addEventListener('DOMContentLoaded', initMap);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initMap();
    }
  </script>
</BaseLayout>
