---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout toolId="reverse-geocoding" title="Reverse Geocoder — Coordinates to Address | MyLocationLab" description="Convert GPS coordinates to a street address. Enter latitude and longitude to find the corresponding postal address." h1="Reverse Geocoder" subtitle="Convert GPS coordinates into a human-readable street address. Enter any lat/lng to find its address.">
  <div class="tool-interface">
    <div class="grid grid-2" style="margin-bottom: var(--space-4);">
      <div><label class="label">Latitude</label><input type="number" step="any" class="input" id="rg-lat" placeholder="e.g. 28.6139" /></div>
      <div><label class="label">Longitude</label><input type="number" step="any" class="input" id="rg-lng" placeholder="e.g. 77.2090" /></div>
    </div>
    <div class="flex gap-3"><button class="btn btn-primary" id="rg-btn" type="button">Convert to Address</button><button class="btn btn-secondary" id="rg-gps" type="button">📍 Use My Location</button></div>
    <div class="tool-result" id="rg-result" style="display: none; margin-top: var(--space-6);">
      <div class="tool-result-row"><span class="tool-result-label">Full Address</span><span class="tool-result-value" id="rg-addr" style="font-family: var(--font-sans); font-size: var(--text-sm);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">City</span><span class="tool-result-value" id="rg-city" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">State</span><span class="tool-result-value" id="rg-state" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">Country</span><span class="tool-result-value" id="rg-country" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">Postcode</span><span class="tool-result-value" id="rg-zip">—</span></div>
    </div>
  </div>
  <div class="prose" style="margin-top: var(--space-12);">
    <h2>What Is Reverse Geocoding?</h2>
    <p><strong>Reverse geocoding</strong> is the process of converting geographic coordinates (latitude and longitude) into a human-readable address. It's the opposite of regular geocoding, which converts addresses to coordinates.</p>
    <p>This tool uses OpenStreetMap's Nominatim API to match your coordinates to the nearest known address in their comprehensive global database.</p>
    <h3>Related Tools & Guides</h3>
    <ul>
      <li><a href="/tools/geocoding/">Geocoder (Address to Coordinates)</a></li>
      <li><a href="/tools/address-finder/">Street Address Finder</a></li>
      <li><a href="/comparisons/geocoding-vs-reverse-geocoding/">Geocoding vs Reverse Geocoding Technical Comparison</a></li>
      <li><a href="/glossary/">Geodesy Glossary</a></li>
    </ul>
  </div>
  <script>
    import GeoLocation from '../../scripts/geolocation.js';
    import Geocoding from '../../scripts/geocoding.js';

    async function reverseGeo() {
      const lat = parseFloat(document.getElementById('rg-lat').value);
      const lng = parseFloat(document.getElementById('rg-lng').value);
      if (isNaN(lat) || isNaN(lng)) { alert('Please enter valid coordinates.'); return; }
      try {
        const addr = await Geocoding.reverseGeocode(lat, lng);
        document.getElementById('rg-addr').textContent = addr.displayName || '—';
        document.getElementById('rg-city').textContent = addr.city || '—';
        document.getElementById('rg-state').textContent = addr.state || '—';
        document.getElementById('rg-country').textContent = addr.country || '—';
        document.getElementById('rg-zip').textContent = addr.postcode || '—';
        document.getElementById('rg-result').style.display = 'block';
      } catch { alert('Unable to reverse geocode these coordinates.'); }
    }

    document.getElementById('rg-btn')?.addEventListener('click', reverseGeo);
    document.getElementById('rg-gps')?.addEventListener('click', async () => {
      try {
        const pos = await GeoLocation.getCurrentPosition();
        document.getElementById('rg-lat').value = pos.coords.latitude.toFixed(6);
        document.getElementById('rg-lng').value = pos.coords.longitude.toFixed(6);
        reverseGeo();
      } catch (e) { alert(GeoLocation.getErrorMessage(e)); }
    });
  </script>
</ToolLayout>
