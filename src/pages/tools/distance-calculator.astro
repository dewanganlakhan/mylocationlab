---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout leaflet toolId="distance-calculator" title="Distance Calculator — Between Two Points | MyLocationLab" description="Calculate the exact distance between two GPS coordinates or locations. Click two points on the map to measure. Uses the Haversine formula for accurate results." h1="Distance Calculator" subtitle="Click two points on the map, or enter coordinates, to measure the distance between them anywhere on Earth.">
  <div class="tool-interface">
    <h3 style="font-size: var(--text-base); margin-bottom: var(--space-4);">Point A</h3>
    <div class="grid grid-2" style="margin-bottom: var(--space-4);">
      <div><label class="label">Latitude</label><input type="number" step="any" class="input" id="dc-lat1" placeholder="e.g. 28.6139" /></div>
      <div><label class="label">Longitude</label><input type="number" step="any" class="input" id="dc-lng1" placeholder="e.g. 77.2090" /></div>
    </div>
    <button class="btn btn-ghost btn-sm" id="dc-gps1" type="button" style="margin-bottom: var(--space-6);">📍 Use My Location for Point A</button>
    <h3 style="font-size: var(--text-base); margin-bottom: var(--space-4);">Point B</h3>
    <div class="grid grid-2" style="margin-bottom: var(--space-4);">
      <div><label class="label">Latitude</label><input type="number" step="any" class="input" id="dc-lat2" placeholder="e.g. 40.7128" /></div>
      <div><label class="label">Longitude</label><input type="number" step="any" class="input" id="dc-lng2" placeholder="e.g. -74.0060" /></div>
    </div>
    <button class="btn btn-primary" id="dc-calc" type="button">Calculate Distance</button>
    <button class="btn btn-ghost" id="dc-reset" type="button" style="margin-left: var(--space-2);">Reset</button>
    <div class="tool-result" id="dc-result" style="display: none; margin-top: var(--space-6);">
      <div class="tool-result-row"><span class="tool-result-label">Distance (km)</span><span class="tool-result-value" id="dc-km" style="color: var(--color-accent-primary);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">Distance (miles)</span><span class="tool-result-value" id="dc-mi">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">Distance (meters)</span><span class="tool-result-value" id="dc-m">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">Distance (nautical miles)</span><span class="tool-result-value" id="dc-nm">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">Bearing from A to B</span><span class="tool-result-value" id="dc-bearing">—</span></div>
    </div>
  </div>

  <!-- Click-to-measure map (always visible) -->
  <div
    id="dc-hint"
    style="margin-top: var(--space-6); padding: var(--space-3) var(--space-4); background: var(--color-bg-tertiary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); font-size: var(--text-sm); display: flex; align-items: center; gap: var(--space-2);"
  >
    <span aria-hidden="true">🖱️</span>
    <span id="dc-hint-text" style="color: var(--color-text-secondary);">Click on the map below to place <strong>Point A</strong>, then click again for <strong>Point B</strong> — the distance line appears automatically.</span>
  </div>
  <div class="map-container" id="dc-map" style="margin-top: var(--space-4); cursor: crosshair;"></div>

  <div class="prose" style="margin-top: var(--space-12);">
    <h2>How Distance Is Calculated</h2>
    <p>This tool uses the <strong>Haversine formula</strong> to calculate the great-circle distance between two points on a sphere. This gives the shortest distance between two points on the Earth's surface, following the curvature of the Earth.</p>
    <p>The Haversine formula accounts for the spherical shape of Earth, making it significantly more accurate than simple Euclidean distance for long distances.</p>
    <h2>Measure Distance by Clicking the Map</h2>
    <p>Click anywhere on the map to drop <strong>Point A</strong>, then click again for <strong>Point B</strong>. A line is drawn between the two points and the distance is calculated instantly — no button press needed. You can also drag either marker to fine-tune the measurement, or type coordinates directly into the fields above.</p>
  </div>
  <script>
    import GeoLocation from '../../scripts/geolocation.js';
    import CoordUtils from '../../scripts/coordinates.js';

    let map = null;
    let markerA = null;
    let markerB = null;
    let line = null;
    let clicks = 0; // 0 = awaiting A, 1 = awaiting B, 2 = measurement complete

    const lat1El = document.getElementById('dc-lat1') as HTMLInputElement;
    const lng1El = document.getElementById('dc-lng1') as HTMLInputElement;
    const lat2El = document.getElementById('dc-lat2') as HTMLInputElement;
    const lng2El = document.getElementById('dc-lng2') as HTMLInputElement;
    const hintEl = document.getElementById('dc-hint-text');
    const resultEl = document.getElementById('dc-result');

    const pinIcon = (letter: string, color: string) => {
      // @ts-ignore
      return L.divIcon({
        html: `<div style="width:26px;height:26px;background:${color};border:3px solid white;border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 2px 8px rgba(0,0,0,0.35);display:flex;align-items:center;justify-content:center;"><span style="transform:rotate(45deg);color:#fff;font-weight:700;font-size:12px;font-family:sans-serif;">${letter}</span></div>`,
        className: '',
        iconSize: [26, 26],
        iconAnchor: [13, 26],
      });
    };

    function setHint(html: string) {
      if (hintEl) hintEl.innerHTML = html;
    }

    function clearMeasurement() {
      if (markerA) { map.removeLayer(markerA); markerA = null; }
      if (markerB) { map.removeLayer(markerB); markerB = null; }
      if (line) { map.removeLayer(line); line = null; }
      if (resultEl) resultEl.style.display = 'none';
    }

    function placeMarker(which: 'A' | 'B', lat: number, lng: number) {
      const draggable = true;
      // @ts-ignore
      const marker = L.marker([lat, lng], {
        icon: which === 'A' ? pinIcon('A', '#00d4ff') : pinIcon('B', '#f59e0b'),
        draggable,
      }).addTo(map);
      marker.on('dragend', () => {
        const p = marker.getLatLng();
        updateInput(which, p.lat, p.lng);
        recalculate();
      });
      return marker;
    }

    function updateInput(which: 'A' | 'B', lat: number, lng: number) {
      const els = which === 'A' ? [lat1El, lng1El] : [lat2El, lng2El];
      if (els[0]) els[0].value = lat.toFixed(6);
      if (els[1]) els[1].value = lng.toFixed(6);
    }

    function readPoint(which: 'A' | 'B'): [number, number] | null {
      const latEl = which === 'A' ? lat1El : lat2El;
      const lngEl = which === 'A' ? lng1El : lng2El;
      const lat = parseFloat(latEl?.value ?? '');
      const lng = parseFloat(lngEl?.value ?? '');
      if (isNaN(lat) || isNaN(lng) || Math.abs(lat) > 90 || Math.abs(lng) > 180) return null;
      return [lat, lng];
    }

    function syncMarkersFromInputs(fit = false) {
      const a = readPoint('A');
      const b = readPoint('B');

      if (!a && !b) {
        clearMeasurement();
        clicks = 0;
        setHint('Click on the map below to place <strong>Point A</strong>, then click again for <strong>Point B</strong> — the distance line appears automatically.');
        return;
      }

      // Point A
      if (a) {
        if (markerA) markerA.setLatLng(a);
        else markerA = placeMarker('A', a[0], a[1]);
      } else if (markerA) { map.removeLayer(markerA); markerA = null; }

      // Point B
      if (b) {
        if (markerB) markerB.setLatLng(b);
        else markerB = placeMarker('B', b[0], b[1]);
      } else if (markerB) { map.removeLayer(markerB); markerB = null; }

      if (a && b) {
        drawLineAndFit(a, b, fit);
        showResults(a, b);
        clicks = 2;
        setHint('Measurement ready — drag a marker to fine-tune, or <strong>click the map</strong> to start a new measurement.');
      } else {
        if (line) { map.removeLayer(line); line = null; }
        if (resultEl) resultEl.style.display = 'none';
        clicks = a ? 1 : 0;
        setHint(a
          ? 'Point A placed — now <strong>click the map</strong> (or enter coordinates) to set <strong>Point B</strong>.'
          : 'Click on the map below to place <strong>Point A</strong>, then click again for <strong>Point B</strong> — the distance line appears automatically.');
      }
    }

    function drawLineAndFit(a: [number, number], b: [number, number], fit = true) {
      if (line) {
        line.setLatLngs([a, b]);
      } else {
        // @ts-ignore
        line = L.polyline([a, b], { color: '#00d4ff', weight: 3, dashArray: '8 6' }).addTo(map);
      }
      if (fit) map.fitBounds(line.getBounds(), { padding: [50, 50] });
    }

    function showResults(a: [number, number], b: [number, number]) {
      const km = CoordUtils.calculateDistance(a[0], a[1], b[0], b[1], 'km');
      const mi = CoordUtils.calculateDistance(a[0], a[1], b[0], b[1], 'mi');
      const bearing = CoordUtils.calculateBearing(a[0], a[1], b[0], b[1]);

      document.getElementById('dc-km').textContent = km.toFixed(2) + ' km';
      document.getElementById('dc-mi').textContent = mi.toFixed(2) + ' mi';
      document.getElementById('dc-m').textContent = Math.round(km * 1000).toLocaleString() + ' m';
      document.getElementById('dc-nm').textContent = (km / 1.852).toFixed(2) + ' nmi';
      document.getElementById('dc-bearing').textContent = `${bearing.toFixed(1)}° (${CoordUtils.bearingToCompass(bearing)})`;
      if (resultEl) resultEl.style.display = 'block';
    }

    function recalculate() {
      if (readPoint('A') && readPoint('B')) syncMarkersFromInputs();
    }

    // Map click: first click sets A, second sets B (auto-distance), third starts over.
    function onMapClick(e: any) {
      const { lat, lng } = e.latlng;

      if (clicks >= 2) {
        clearMeasurement();
        clicks = 0;
      }

      if (clicks === 0) {
        updateInput('A', lat, lng);
        markerA = placeMarker('A', lat, lng);
        clicks = 1;
        setHint('Point A placed — now <strong>click again</strong> to place <strong>Point B</strong> and see the distance.');
        map.panTo([lat, lng]);
      } else if (clicks === 1) {
        updateInput('B', lat, lng);
        markerB = placeMarker('B', lat, lng);
        const a: [number, number] = [parseFloat(lat1El.value), parseFloat(lng1El.value)];
        const b: [number, number] = [lat, lng];
        drawLineAndFit(a, b);
        showResults(a, b);
        clicks = 2;
        setHint('Measurement ready — drag a marker to fine-tune, or <strong>click the map</strong> to start a new measurement.');
      }
    }

    function initMap() {
      // @ts-ignore
      if (typeof L === 'undefined') {
        setTimeout(initMap, 200);
        return;
      }
      // @ts-ignore
      map = L.map('dc-map', { scrollWheelZoom: false }).setView([25, 10], 2);
      // @ts-ignore
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);
      // @ts-ignore
      map.on('click', (e: any) => {
        // @ts-ignore
        map.scrollWheelZoom.enable();
        onMapClick(e);
      });
    }

    document.getElementById('dc-gps1')?.addEventListener('click', async () => {
      try {
        const pos = await GeoLocation.getCurrentPosition();
        updateInput('A', pos.coords.latitude, pos.coords.longitude);
        syncMarkersFromInputs();
        map.setView([pos.coords.latitude, pos.coords.longitude], 10);
      } catch (e) {
        alert(GeoLocation.getErrorMessage(e));
      }
    });

    document.getElementById('dc-calc')?.addEventListener('click', () => {
      const a = readPoint('A');
      const b = readPoint('B');
      if (!a || !b) {
        alert('Please enter valid coordinates for both points, or click two spots on the map.');
        return;
      }
      syncMarkersFromInputs(true);
    });

    document.getElementById('dc-reset')?.addEventListener('click', () => {
      clearMeasurement();
      [lat1El, lng1El, lat2El, lng2El].forEach((el) => { if (el) el.value = ''; });
      clicks = 0;
      setHint('Click on the map below to place <strong>Point A</strong>, then click again for <strong>Point B</strong> — the distance line appears automatically.');
    });

    [lat1El, lng1El, lat2El, lng2El].forEach((el) => {
      el?.addEventListener('input', syncMarkersFromInputs);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMap);
    } else {
      initMap();
    }
  </script>
</ToolLayout>
