---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout leaflet toolId="latitude-longitude" title="Latitude Longitude Finder — Find Lat Long | MyLocationLab" description="Find the latitude and longitude of any location. Click on the map or use GPS to get precise lat/lng coordinates." h1="Latitude Longitude Finder" subtitle="Find latitude and longitude for any location by clicking on the map, entering an address, or using your GPS.">

  <div class="tool-interface">
    <div style="text-align: center; padding: var(--space-4) 0;" id="ll-prompt" >
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4);">Detecting your position automatically — or click anywhere on the map below.</p>
      <button class="btn btn-primary btn-lg" id="ll-btn" type="button">📍 Use My Location</button>
      <p id="ll-error" style="display: none; margin: var(--space-3) 0 0; color: var(--color-accent-error, #ef4444); font-size: var(--text-sm);"></p>
    </div>

    <div class="tool-result" id="ll-result" style="display: none;">
      <div class="tool-result-row">
        <span class="tool-result-label">Latitude</span>
        <span class="tool-result-value" id="ll-lat" style="color: var(--color-accent-primary);">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">Longitude</span>
        <span class="tool-result-value" id="ll-lng" style="color: var(--color-accent-primary);">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">Address</span>
        <span class="tool-result-value" id="ll-addr" style="font-family: var(--font-sans); font-size: var(--text-sm);">—</span>
      </div>
      <div class="action-buttons" style="margin-top: var(--space-4);">
        <button class="btn btn-secondary btn-sm" id="ll-copy" type="button">📋 Copy</button>
        <button class="btn btn-secondary btn-sm" id="ll-share" type="button">🔗 Share</button>
      </div>
    </div>
  </div>

  <div class="map-container" id="ll-map" style="margin-top: var(--space-6); cursor: crosshair;"></div>

  <div class="prose" style="margin-top: var(--space-12);">
    <h2>How to Use This Tool</h2>
    <ol>
      <li><strong>Click "Use My Location"</strong> to find your current latitude and longitude using GPS.</li>
      <li><strong>Click anywhere on the map</strong> to find the lat/lng of that point.</li>
      <li><strong>Copy or share</strong> the coordinates using the buttons provided.</li>
    </ol>
    <h2>Understanding Latitude and Longitude</h2>
    <p>Latitude measures north-south position (-90° to +90°). Longitude measures east-west position (-180° to +180°). Together they uniquely identify any point on Earth. Read our complete <a href="/guides/latitude-and-longitude-explained/">Latitude and Longitude Explained Guide</a> or check the <a href="/glossary/">Geodesy Glossary</a>.</p>
  </div>

  <script>
    import GeoLocation from '../../scripts/geolocation.js';
    import Geocoding from '../../scripts/geocoding.js';
    import Sharing from '../../scripts/sharing.js';

    let lat = null, lng = null, map = null, marker = null;

    function showResult(la, ln) {
      lat = la; lng = ln;
      document.getElementById('ll-lat').textContent = la.toFixed(6);
      document.getElementById('ll-lng').textContent = ln.toFixed(6);
      document.getElementById('ll-result').style.display = 'block';

      Geocoding.getShortAddress(la, ln).then(addr => {
        document.getElementById('ll-addr').textContent = addr;
      }).catch(() => {});

      if (map) {
        if (marker) map.removeLayer(marker);
        const icon = L.divIcon({ html: '<div style="width:18px;height:18px;background:#00d4ff;border:3px solid white;border-radius:50%;box-shadow:0 0 10px rgba(0,212,255,0.4);"></div>', className: '', iconSize: [18,18], iconAnchor: [9,9] });
        marker = L.marker([la, ln], { icon }).addTo(map);
        map.flyTo([la, ln], 14);
      }
    }

    // Init map
    const waitL = () => {
      if (typeof L !== 'undefined') {
        map = L.map('ll-map').setView([20, 0], 2);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(map);
        map.on('click', (e) => showResult(e.latlng.lat, e.latlng.lng));
      } else setTimeout(waitL, 100);
    };
    waitL();

    async function locateMe() {
      const promptEl = document.getElementById('ll-prompt');
      const errorEl = document.getElementById('ll-error');
      promptEl.style.display = 'none';
      if (errorEl) errorEl.style.display = 'none';
      try {
        const pos = await GeoLocation.getCurrentPosition();
        showResult(pos.coords.latitude, pos.coords.longitude);
      } catch (e) {
        promptEl.style.display = 'block';
        if (errorEl) {
          errorEl.textContent = GeoLocation.getErrorMessage(e);
          errorEl.style.display = 'block';
        }
      }
    }

    document.getElementById('ll-btn')?.addEventListener('click', locateMe);

    // Auto-detect on page load so no click is needed; fall back to the button
    // if permission was already denied.
    (async () => {
      if (await GeoLocation.checkPermission() === 'denied') {
        document.getElementById('ll-prompt').style.display = 'block';
        return;
      }
      locateMe();
    })();

    document.getElementById('ll-copy')?.addEventListener('click', function() {
      if (lat) Sharing.copyToClipboard(`${lat.toFixed(6)}, ${lng.toFixed(6)}`, this);
    });

    document.getElementById('ll-share')?.addEventListener('click', () => {
      if (lat) Sharing.shareNative({ title: 'Coordinates', text: `${lat.toFixed(6)}, ${lng.toFixed(6)}`, url: `https://www.google.com/maps?q=${lat},${lng}` });
    });
  </script>
</ToolLayout>
