---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout leaflet toolId="address-finder" title="Address Finder — Any Location's Address | MyLocationLab" description="Find the street address for your current location or any GPS coordinates. Reverse geocode coordinates to a full postal address." h1="Address Finder" subtitle="Find the full street address for your current position or any coordinates using reverse geocoding.">
  <div class="tool-interface">
    <div class="flex gap-4 flex-wrap" style="margin-bottom: var(--space-4);">
      <button class="btn btn-primary" id="af-gps" type="button">📍 Use My Location</button>
      <span style="color: var(--color-text-tertiary); align-self: center;">or enter coordinates:</span>
    </div>
    <div class="input-group" style="margin-bottom: var(--space-4);">
      <input type="text" class="input" id="af-input" placeholder="Enter coordinates (e.g., 28.6139, 77.2090)" />
      <button class="btn btn-secondary" id="af-search" type="button">Find Address</button>
    </div>
    <div class="tool-result" id="af-result" style="display: none;">
      <div class="tool-result-row"><span class="tool-result-label">Full Address</span><span class="tool-result-value" id="af-full" style="font-family: var(--font-sans); font-size: var(--text-sm);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">Street</span><span class="tool-result-value" id="af-street" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">City</span><span class="tool-result-value" id="af-city" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">State</span><span class="tool-result-value" id="af-state" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">Postcode</span><span class="tool-result-value" id="af-zip">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">Country</span><span class="tool-result-value" id="af-country" style="font-family: var(--font-sans);">—</span></div>
      <div class="tool-result-row"><span class="tool-result-label">Coordinates</span><span class="tool-result-value" id="af-coords">—</span></div>
    </div>
    <div id="af-actions" style="margin-top: var(--space-4); display: none;">
      <button class="btn btn-secondary btn-sm" id="af-copy" type="button">📋 Copy Address</button>
    </div>
  </div>
  <div class="map-container" id="af-map" style="margin-top: var(--space-6); display: none;"></div>
  <div class="prose" style="margin-top: var(--space-12);">
    <h2>How Address Finding Works</h2>
    <p>This tool uses <strong>reverse geocoding</strong> — the process of converting GPS coordinates into a human-readable address. Your coordinates are matched against OpenStreetMap's comprehensive address database to find the nearest known address.</p>
    <p>The accuracy depends on the mapping data available in your area. Urban areas typically have complete street-level address data, while rural areas may only return a general location description.</p>
    <h3>Related Tools</h3>
    <ul>
      <li><a href="/tools/reverse-geocoding/">Reverse Geocoder</a> — Convert any coordinates to an address</li>
      <li><a href="/tools/geocoding/">Geocoder</a> — Convert an address to coordinates</li>
      <li><a href="/my-location/address/">My Address</a></li>
    </ul>
  </div>
  <script>
    import GeoLocation from '../../scripts/geolocation.js';
    import Geocoding from '../../scripts/geocoding.js';
    import CoordUtils from '../../scripts/coordinates.js';
    import Sharing from '../../scripts/sharing.js';

    let currentAddress = '';

    async function findAddress(lat, lng) {
      try {
        const addr = await Geocoding.reverseGeocode(lat, lng);
        currentAddress = addr.displayName;
        document.getElementById('af-full').textContent = addr.displayName || '—';
        document.getElementById('af-street').textContent = [addr.houseNumber, addr.road].filter(Boolean).join(' ') || '—';
        document.getElementById('af-city').textContent = addr.city || '—';
        document.getElementById('af-state').textContent = addr.state || '—';
        document.getElementById('af-zip').textContent = addr.postcode || '—';
        document.getElementById('af-country').textContent = `${addr.country} (${addr.countryCode})`;
        document.getElementById('af-coords').textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
        document.getElementById('af-result').style.display = 'block';
        document.getElementById('af-actions').style.display = 'block';

        const mapEl = document.getElementById('af-map');
        mapEl.style.display = 'block';
        const waitL = () => {
          if (typeof L !== 'undefined') {
            if (window._afMap) window._afMap.remove();
            window._afMap = L.map('af-map').setView([lat, lng], 16);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(window._afMap);
            L.marker([lat, lng]).addTo(window._afMap).bindPopup(addr.displayName).openPopup();
          } else setTimeout(waitL, 100);
        };
        waitL();
      } catch { alert('Unable to find address for these coordinates.'); }
    }

    document.getElementById('af-gps')?.addEventListener('click', async () => {
      try {
        const pos = await GeoLocation.getCurrentPosition();
        findAddress(pos.coords.latitude, pos.coords.longitude);
      } catch (e) { alert(GeoLocation.getErrorMessage(e)); }
    });

    document.getElementById('af-search')?.addEventListener('click', () => {
      const val = document.getElementById('af-input').value;
      const parsed = CoordUtils.parseCoordinates(val);
      if (parsed && CoordUtils.isValidCoordinate(parsed.lat, parsed.lng)) {
        findAddress(parsed.lat, parsed.lng);
      } else { alert('Please enter valid coordinates (e.g., 28.6139, 77.2090)'); }
    });

    document.getElementById('af-copy')?.addEventListener('click', function() {
      if (currentAddress) Sharing.copyToClipboard(currentAddress, this);
    });
  </script>
</ToolLayout>
