---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  toolId="gps-accuracy"
  title="GPS Accuracy Checker — Test Live Location Precision | MyLocationLab"
  description="Check your device's live GPS accuracy in real-time. Measure horizontal dilution of precision (HDOP), signal confidence radius in meters, speed, and heading."
  h1="GPS Accuracy Checker"
  subtitle="Monitor your device's real-time GNSS satellite positioning accuracy, horizontal precision radius, and sensor telemetry."
>
  <div class="tool-interface">
    <div class="flex gap-4 flex-wrap" style="margin-bottom: var(--space-6);">
      <button class="btn btn-primary" id="acc-start-btn" type="button">🛰️ Start Live GPS Monitor</button>
      <button class="btn btn-secondary" id="acc-stop-btn" type="button" style="display: none;">⏹️ Stop Monitor</button>
      <span id="acc-status-indicator" style="display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-text-secondary); font-size: var(--text-sm);">
        <span style="width: 10px; height: 10px; border-radius: 50%; background: #64748b;"></span> Standby
      </span>
    </div>

    <!-- Live Accuracy Gauge Card -->
    <div class="card card-highlight" id="acc-card" style="text-align: center; padding: var(--space-8) var(--space-4); margin-bottom: var(--space-6);">
      <span style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent-primary);">Live Horizontal Accuracy Radius</span>
      
      <div style="font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 900; font-family: var(--font-mono); margin: var(--space-3) 0; color: var(--color-text-heading);">
        ± <span id="acc-val-meters">—</span> <span style="font-size: var(--text-2xl); color: var(--color-accent-primary);">m</span>
        <span style="color: var(--color-text-tertiary); font-size: var(--text-3xl); margin: 0 var(--space-2);">/</span>
        ± <span id="acc-val-feet">—</span> <span style="font-size: var(--text-2xl); color: var(--color-accent-secondary);">ft</span>
      </div>

      <div style="display: flex; justify-content: center; gap: var(--space-3); align-items: center; flex-wrap: wrap;">
        <span class="badge badge-neutral" id="acc-rating-badge">Awaiting GPS Lock</span>
        <span style="font-size: var(--text-xs); color: var(--color-text-tertiary);" id="acc-update-time">Updates every second</span>
      </div>

      <!-- Accuracy progress bar -->
      <div style="width: 100%; max-width: 420px; height: 8px; background: var(--color-bg-tertiary); border-radius: var(--radius-full); margin: var(--space-6) auto 0; overflow: hidden; border: 1px solid var(--color-border);">
        <div id="acc-meter-bar" style="width: 0%; height: 100%; background: var(--gradient-primary); transition: width 0.4s ease;"></div>
      </div>
    </div>

    <!-- Sensor Metrics Grid -->
    <div class="location-data-grid" id="acc-grid">
      <div class="location-data-item">
        <span class="location-data-label">Estimated HDOP</span>
        <span class="location-data-value highlight" id="acc-hdop">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">Ground Speed</span>
        <span class="location-data-value" id="acc-speed">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">Compass Heading</span>
        <span class="location-data-value" id="acc-heading">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">Altitude</span>
        <span class="location-data-value" id="acc-alt">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">Vertical Accuracy</span>
        <span class="location-data-value" id="acc-valt">—</span>
      </div>
      <div class="location-data-item">
        <span class="location-data-label">Active Coordinates</span>
        <span class="location-data-value" id="acc-coords" style="font-size: var(--text-xs);">—</span>
      </div>
    </div>
  </div>

  <div class="prose" style="margin-top: var(--space-12);">
    <h2>Understanding GPS Accuracy & Dilution of Precision (DOP)</h2>
    <p>
      Browser and smartphone geolocation accuracy is expressed as a <strong>95% confidence radius</strong>. If your device reports an accuracy of ±5 meters, there is a 95% probability that your true geographic position lies within a circle of 5 meters around the reported coordinates.
    </p>

    <h3>Accuracy Classifications</h3>
    <table>
      <thead>
        <tr>
          <th>Accuracy Radius</th>
          <th>Rating</th>
          <th>Typical Source</th>
          <th>Use Case Suitability</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>&lt; 3 meters (10 ft)</td>
          <td><strong style="color: var(--color-accent-success);">Exceptional</strong></td>
          <td>Dual-Frequency L1/L5 GNSS</td>
          <td>Precision mapping, surveying, lane-level navigation</td>
        </tr>
        <tr>
          <td>3 to 8 meters (10–26 ft)</td>
          <td><strong style="color: var(--color-accent-primary);">High</strong></td>
          <td>Standard Mobile GPS / GLONASS</td>
          <td>Turn-by-turn driving, hiking, fitness tracking</td>
        </tr>
        <tr>
          <td>8 to 25 meters (26–82 ft)</td>
          <td><strong style="color: var(--color-accent-warning);">Moderate</strong></td>
          <td>Wi-Fi Positioning (WPS) / Indoor</td>
          <td>Neighborhood-level delivery, local search</td>
        </tr>
        <tr>
          <td>&gt; 25 meters (82+ ft)</td>
          <td><strong style="color: var(--color-accent-error);">Low</strong></td>
          <td>Cell Tower Triangulation / IP Geo</td>
          <td>City-level regional discovery only</td>
        </tr>
      </tbody>
    </table>

    <h2>How to Improve Your Device's GPS Accuracy</h2>
    <ul>
      <li><strong>Enable Wi-Fi and Bluetooth Scanning:</strong> Mobile operating systems (iOS and Android) use nearby Wi-Fi router BSSIDs to dramatically accelerate initial satellite acquisition (Assisted GPS).</li>
      <li><strong>Step Away from "Urban Canyons":</strong> Tall concrete and glass skyscrapers reflect satellite radio waves, creating <em>multipath interference</em> that degrades positional precision.</li>
      <li><strong>Calibrate the Internal Magnetometer:</strong> Wave your mobile device in a figure-8 motion to recalibrate the electronic compass for accurate heading bearings.</li>
      <li><strong>Ensure Unobstructed Sky View:</strong> Thick tree foliage, subterranean tunnels, and metal car roofs attenuate 1.5 GHz satellite signals.</li>
    </ul>

    <h2>Related Geospatial Tools</h2>
    <ul>
      <li><a href="/tools/gps-coordinates/">GPS Coordinates Finder</a> — View latitude, longitude, and elevation.</li>
      <li><a href="/guides/improve-gps-accuracy/">Comprehensive Guide to Improving GPS Accuracy</a> — Deep-dive tutorial.</li>
      <li><a href="/comparisons/gps-vs-ip-location/">GPS vs. IP Location Comparison</a> — Accuracy comparison analysis.</li>
    </ul>
  </div>

  <script>
    let watchId = null;
    const startBtn = document.getElementById('acc-start-btn');
    const stopBtn = document.getElementById('acc-stop-btn');
    const statusIndicator = document.getElementById('acc-status-indicator');
    const valMeters = document.getElementById('acc-val-meters');
    const valFeet = document.getElementById('acc-val-feet');
    const ratingBadge = document.getElementById('acc-rating-badge');
    const updateTime = document.getElementById('acc-update-time');
    const meterBar = document.getElementById('acc-meter-bar');

    const hdopEl = document.getElementById('acc-hdop');
    const speedEl = document.getElementById('acc-speed');
    const headingEl = document.getElementById('acc-heading');
    const altEl = document.getElementById('acc-alt');
    const valtEl = document.getElementById('acc-valt');
    const coordsEl = document.getElementById('acc-coords');

    function startTracking() {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }

      if (statusIndicator) {
        statusIndicator.innerHTML = '<span style="width: 10px; height: 10px; border-radius: 50%; background: #00d4ff; box-shadow: 0 0 8px #00d4ff;"></span> Acquiring satellites...';
      }

      watchId = navigator.geolocation.watchPosition(
        (pos) => {
          const acc = pos.coords.accuracy;
          const accFeet = Math.round(acc * 3.28084);
          const roundAcc = Math.round(acc * 10) / 10;

          if (valMeters) valMeters.textContent = String(roundAcc);
          if (valFeet) valFeet.textContent = String(accFeet);
          if (updateTime) updateTime.textContent = `Updated ${new Date().toLocaleTimeString()}`;

          if (coordsEl) {
            coordsEl.textContent = `${pos.coords.latitude.toFixed(6)}, ${pos.coords.longitude.toFixed(6)}`;
          }

          // Rating and meter bar
          if (ratingBadge && meterBar) {
            if (acc <= 4) {
              ratingBadge.textContent = 'Exceptional Accuracy (Dual-Band Precision)';
              ratingBadge.className = 'badge badge-success';
              meterBar.style.width = '100%';
              meterBar.style.background = '#10b981';
            } else if (acc <= 10) {
              ratingBadge.textContent = 'High Accuracy (Standard GNSS Lock)';
              ratingBadge.className = 'badge badge-primary';
              meterBar.style.width = '80%';
              meterBar.style.background = '#00d4ff';
            } else if (acc <= 30) {
              ratingBadge.textContent = 'Moderate Accuracy (Wi-Fi / Multi-source)';
              ratingBadge.className = 'badge badge-warning';
              meterBar.style.width = '45%';
              meterBar.style.background = '#f59e0b';
            } else {
              ratingBadge.textContent = 'Low Precision (Cellular / Regional)';
              ratingBadge.className = 'badge badge-error';
              meterBar.style.width = '20%';
              meterBar.style.background = '#ef4444';
            }
          }

          // HDOP estimate: Accuracy ≈ HDOP * User Equivalent Range Error (approx 4.0m)
          if (hdopEl) {
            const hdop = (acc / 4.0).toFixed(2);
            hdopEl.textContent = `~${hdop} (${hdop < 1.5 ? 'Excellent' : hdop < 3 ? 'Good' : 'Moderate'})`;
          }

          // Speed
          if (speedEl) {
            if (pos.coords.speed !== null && pos.coords.speed !== undefined) {
              const kmh = (pos.coords.speed * 3.6).toFixed(1);
              const mph = (pos.coords.speed * 2.23694).toFixed(1);
              speedEl.textContent = `${kmh} km/h (${mph} mph)`;
            } else {
              speedEl.textContent = 'Stationary / 0 km/h';
            }
          }

          // Heading
          if (headingEl) {
            if (pos.coords.heading !== null && pos.coords.heading !== undefined && !isNaN(pos.coords.heading)) {
              const deg = Math.round(pos.coords.heading);
              const dirs = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
              const dir = dirs[Math.round(deg / 45) % 8];
              headingEl.textContent = `${deg}° (${dir})`;
            } else {
              headingEl.textContent = 'Static (No Heading)';
            }
          }

          // Altitude
          if (altEl) {
            if (pos.coords.altitude !== null && pos.coords.altitude !== undefined) {
              altEl.textContent = `${Math.round(pos.coords.altitude)} m (${Math.round(pos.coords.altitude * 3.28084)} ft)`;
            } else {
              altEl.textContent = 'Not Available';
            }
          }

          // Vertical accuracy
          if (valtEl) {
            if (pos.coords.altitudeAccuracy !== null && pos.coords.altitudeAccuracy !== undefined) {
              valtEl.textContent = `± ${Math.round(pos.coords.altitudeAccuracy)} m`;
            } else {
              valtEl.textContent = 'N/A';
            }
          }

          if (statusIndicator) {
            statusIndicator.innerHTML = '<span style="width: 10px; height: 10px; border-radius: 50%; background: #10b981; box-shadow: 0 0 8px #10b981;"></span> Live GNSS Active';
          }
        },
        (err) => {
          if (statusIndicator) {
            statusIndicator.innerHTML = `<span style="width: 10px; height: 10px; border-radius: 50%; background: #ef4444;"></span> ${err.message}`;
          }
        },
        { enableHighAccuracy: true, maximumAge: 1000, timeout: 15000 }
      );

      if (startBtn) startBtn.style.display = 'none';
      if (stopBtn) stopBtn.style.display = 'inline-flex';
    }

    function stopTracking() {
      if (watchId !== null) {
        navigator.geolocation.clearWatch(watchId);
        watchId = null;
      }
      if (startBtn) startBtn.style.display = 'inline-flex';
      if (stopBtn) stopBtn.style.display = 'none';
      if (statusIndicator) {
        statusIndicator.innerHTML = '<span style="width: 10px; height: 10px; border-radius: 50%; background: #64748b;"></span> Standby';
      }
    }

    if (startBtn) startBtn.addEventListener('click', startTracking);
    if (stopBtn) stopBtn.addEventListener('click', stopTracking);
  </script>
</ToolLayout>
