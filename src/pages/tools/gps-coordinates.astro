---
import ToolLayout from '../../layouts/ToolLayout.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const faqItems = [
  { question: 'How do I find my GPS coordinates?', answer: 'Click the "Find My GPS Coordinates" button above. Your browser will request location permission. Once granted, your exact latitude and longitude will be displayed in decimal degrees format, along with accuracy and altitude data.' },
  { question: 'What format are the GPS coordinates in?', answer: 'By default, coordinates are shown in <strong>decimal degrees</strong> (DD) format, which is the most widely used format for digital applications. You can use our <a href="/tools/coordinate-converter/">Coordinate Converter</a> to convert to DMS, UTM, or other formats.' },
  { question: 'How accurate are the GPS coordinates?', answer: 'Accuracy depends on your device and environment. Modern smartphones provide 3-5 meter accuracy outdoors. Indoors, accuracy may drop to 10-50 meters. The accuracy radius is shown alongside your coordinates.' },
];
---

<ToolLayout leaflet toolId="gps-coordinates" title="GPS Coordinates Finder — Exact Location | MyLocationLab" description="Find your exact GPS coordinates instantly. Get your current latitude, longitude, accuracy, and altitude from GPS satellites." h1="GPS Coordinates Finder" subtitle="Get your precise GPS coordinates in real-time. Shows latitude, longitude, accuracy, and altitude from satellite signals.">

  <div class="tool-interface">
    <div style="text-align: center; padding: var(--space-4) 0;" id="gps-prompt">
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4);">Click below to detect your GPS coordinates.</p>
      <button class="btn btn-primary btn-lg" id="gps-btn" type="button">📍 Find My GPS Coordinates</button>
    </div>

    <div id="gps-loading" style="display: none; text-align: center; padding: var(--space-6);">
      <div class="spinner" style="margin: 0 auto var(--space-3);"></div>
      <p style="color: var(--color-text-secondary); margin: 0;">Connecting to GPS satellites...</p>
    </div>

    <div class="tool-result" id="gps-result" style="display: none;">
      <div class="tool-result-row">
        <span class="tool-result-label">Latitude</span>
        <span class="tool-result-value" id="gps-lat" style="color: var(--color-accent-primary);">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">Longitude</span>
        <span class="tool-result-value" id="gps-lng" style="color: var(--color-accent-primary);">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">Latitude (DMS)</span>
        <span class="tool-result-value" id="gps-lat-dms">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">Longitude (DMS)</span>
        <span class="tool-result-value" id="gps-lng-dms">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">Accuracy</span>
        <span class="tool-result-value" id="gps-acc">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">Altitude</span>
        <span class="tool-result-value" id="gps-alt">—</span>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">Timestamp</span>
        <span class="tool-result-value" id="gps-time" style="font-size: var(--text-sm);">—</span>
      </div>
    </div>

    <div class="action-buttons" id="gps-actions" style="margin-top: var(--space-4); display: none;">
      <button class="btn btn-secondary btn-sm" id="gps-copy" type="button">📋 Copy Coordinates</button>
      <button class="btn btn-secondary btn-sm" id="gps-share" type="button">🔗 Share</button>
      <a class="btn btn-secondary btn-sm" id="gps-maps" href="#" target="_blank" rel="noopener noreferrer">🗺️ Open in Maps</a>
      <button class="btn btn-ghost btn-sm" id="gps-refresh" type="button">🔄 Refresh</button>
    </div>
  </div>

  <div class="map-container" id="gps-map" style="margin-top: var(--space-6); display: none;"></div>

  <!-- Content -->
  <div class="prose" style="margin-top: var(--space-12);">
    <h2>How the GPS Coordinates Finder Works</h2>
    <p>This tool uses your device's built-in GPS receiver to determine your exact position using satellite signals. When you click "Find My GPS Coordinates," your browser's Geolocation API requests a position fix from your device's location hardware.</p>
    <p>The GPS system works by triangulating signals from multiple satellites orbiting Earth at approximately 20,200 km altitude. Your device needs signals from at least 4 satellites to calculate a precise 3D position (latitude, longitude, and altitude).</p>

    <h2>Understanding the Results</h2>
    <ul>
      <li><strong>Latitude & Longitude</strong> — Your exact position in decimal degrees and DMS format</li>
      <li><strong>Accuracy</strong> — The estimated error radius. A lower number means higher precision</li>
      <li><strong>Altitude</strong> — Your height above sea level (WGS84 ellipsoid), when available</li>
    </ul>

    <h2>Tips for Better GPS Accuracy</h2>
    <ol>
      <li>Go outdoors with a clear view of the sky</li>
      <li>Wait 10-30 seconds for the GPS to lock on to more satellites</li>
      <li>Enable "High Accuracy" mode in your device's location settings</li>
      <li>Avoid areas near tall buildings or dense tree cover</li>
    </ol>
    <p>For more details, read our guide on <a href="/guides/improve-gps-accuracy/">how to improve GPS accuracy</a>.</p>
  </div>

  <div style="margin-top: var(--space-12);"><h2 class="mb-8">FAQ</h2><FAQAccordion items={faqItems} /></div>

  <script>
    import GeoLocation from '../../scripts/geolocation.js';
    import CoordUtils from '../../scripts/coordinates.js';
    import Sharing from '../../scripts/sharing.js';

    let lat = null, lng = null;

    async function findGPS() {
      const prompt = document.getElementById('gps-prompt');
      const loading = document.getElementById('gps-loading');
      const result = document.getElementById('gps-result');
      const actions = document.getElementById('gps-actions');
      const mapEl = document.getElementById('gps-map');

      prompt.style.display = 'none';
      loading.style.display = 'block';
      result.style.display = 'none';

      try {
        const position = await GeoLocation.getCurrentPosition();
        const pos = GeoLocation.formatPosition(position);
        lat = pos.latitude;
        lng = pos.longitude;

        document.getElementById('gps-lat').textContent = pos.formattedLat;
        document.getElementById('gps-lng').textContent = pos.formattedLng;
        document.getElementById('gps-lat-dms').textContent = CoordUtils.formatDMS(lat, true);
        document.getElementById('gps-lng-dms').textContent = CoordUtils.formatDMS(lng, false);
        document.getElementById('gps-acc').textContent = pos.formattedAccuracy;
        document.getElementById('gps-alt').textContent = pos.altitude ? `${pos.altitude.toFixed(1)} m` : 'Not available';
        document.getElementById('gps-time').textContent = new Date(pos.timestamp).toLocaleString();
        document.getElementById('gps-maps').href = `https://www.google.com/maps?q=${lat},${lng}`;

        loading.style.display = 'none';
        result.style.display = 'block';
        actions.style.display = 'flex';
        mapEl.style.display = 'block';

        const waitL = () => {
          if (typeof L !== 'undefined') {
            const m = L.map('gps-map').setView([lat, lng], 16);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(m);
            const icon = L.divIcon({ html: '<div style="width:18px;height:18px;background:#00d4ff;border:3px solid white;border-radius:50%;box-shadow:0 0 10px rgba(0,212,255,0.4);"></div>', className: '', iconSize: [18,18], iconAnchor: [9,9] });
            L.marker([lat, lng], { icon }).addTo(m);
            if (pos.accuracy > 0) L.circle([lat, lng], { radius: pos.accuracy, color: '#00d4ff', fillColor: '#00d4ff', fillOpacity: 0.08, weight: 1 }).addTo(m);
          } else setTimeout(waitL, 100);
        };
        waitL();
      } catch (error) {
        loading.style.display = 'none';
        prompt.style.display = 'block';
        alert(GeoLocation.getErrorMessage(error));
      }
    }

    document.getElementById('gps-btn')?.addEventListener('click', findGPS);
    document.getElementById('gps-refresh')?.addEventListener('click', findGPS);
    document.getElementById('gps-copy')?.addEventListener('click', function() {
      if (lat) Sharing.copyToClipboard(`${lat}, ${lng}`, this);
    });
    document.getElementById('gps-share')?.addEventListener('click', () => {
      if (lat) Sharing.shareNative({ title: 'GPS Coordinates', text: `${lat}, ${lng}`, url: `https://www.google.com/maps?q=${lat},${lng}` });
    });
  </script>
</ToolLayout>
