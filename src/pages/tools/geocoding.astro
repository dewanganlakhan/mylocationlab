---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout toolId="geocoding" title="Geocoder — Address to Coordinates | MyLocationLab" description="Convert any address, city, or place name into GPS coordinates. Find the exact latitude and longitude for any location." h1="Geocoder" subtitle="Convert any address, city, or place name into GPS coordinates (latitude and longitude).">
  <div class="tool-interface">
    <label class="label">Enter an address, city, or place name</label>
    <div class="input-group" style="margin-bottom: var(--space-4);">
      <input type="text" class="input" id="gc-input" placeholder="e.g. Eiffel Tower, Paris" />
      <button class="btn btn-primary" id="gc-btn" type="button">Find Coordinates</button>
    </div>
    <div id="gc-results" style="display: none;">
      <h3 style="font-size: var(--text-base); margin-bottom: var(--space-4);">Results</h3>
      <div id="gc-list"></div>
    </div>
  </div>
  <div class="map-container" id="gc-map" style="margin-top: var(--space-6); display: none;"></div>
  <div class="prose" style="margin-top: var(--space-12);">
    <h2>What Is Geocoding?</h2>
    <p><strong>Geocoding</strong> (also called forward geocoding) converts human-readable addresses into geographic coordinates. Enter any address, city name, landmark, or place — the tool will return the corresponding latitude and longitude.</p>
    <h3>Related Tools & Guides</h3>
    <ul>
      <li><a href="/tools/reverse-geocoding/">Reverse Geocoder (Coordinates to Address)</a></li>
      <li><a href="/tools/address-finder/">Street Address Finder</a></li>
      <li><a href="/comparisons/geocoding-vs-reverse-geocoding/">Forward vs Reverse Geocoding Comparison</a></li>
      <li><a href="/glossary/">Geodesy Glossary</a></li>
    </ul>
  </div>
  <script>
    import Geocoding from '../../scripts/geocoding.js';
    import Sharing from '../../scripts/sharing.js';

    document.getElementById('gc-btn')?.addEventListener('click', async () => {
      const query = document.getElementById('gc-input').value.trim();
      if (!query) { alert('Please enter an address or place name.'); return; }
      try {
        const results = await Geocoding.forwardGeocode(query);
        const list = document.getElementById('gc-list');
        const container = document.getElementById('gc-results');
        list.innerHTML = '';
        if (results.length === 0) { list.innerHTML = '<p style="color: var(--color-text-tertiary);">No results found.</p>'; container.style.display = 'block'; return; }
        results.forEach(r => {
          const div = document.createElement('div');
          div.className = 'tool-result';
          div.style.marginBottom = 'var(--space-3)';
          div.style.cursor = 'pointer';
          div.innerHTML = `<div class="tool-result-row"><span class="tool-result-label">Location</span><span class="tool-result-value" style="font-family:var(--font-sans);font-size:var(--text-sm);">${r.displayName}</span></div><div class="tool-result-row"><span class="tool-result-label">Coordinates</span><span class="tool-result-value" style="color:var(--color-accent-primary);">${r.lat.toFixed(6)}, ${r.lng.toFixed(6)}</span></div>`;
          div.addEventListener('click', () => {
            Sharing.copyToClipboard(`${r.lat.toFixed(6)}, ${r.lng.toFixed(6)}`);
            Sharing.showToast('Coordinates copied!');
            const mapEl = document.getElementById('gc-map');
            mapEl.style.display = 'block';
            if (typeof L !== 'undefined') {
              if (window._gcMap) window._gcMap.remove();
              window._gcMap = L.map('gc-map').setView([r.lat, r.lng], 14);
              L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(window._gcMap);
              L.marker([r.lat, r.lng]).addTo(window._gcMap).bindPopup(r.displayName).openPopup();
            }
          });
          list.appendChild(div);
        });
        container.style.display = 'block';
      } catch { alert('Geocoding failed. Please try again.'); }
    });

    document.getElementById('gc-input')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') document.getElementById('gc-btn')?.click();
    });
  </script>
</ToolLayout>
