        <td>15 seconds</td>
      </tr>
      <tr>
        <td>Remove Magnetic Phone Cases</td>
        <td>Prevents internal magnetometer sensor distortion</td>
        <td>Instant</td>
      </tr>
      <tr>
        <td>Move to Open Sky / Intersection</td>
        <td>Eliminates multipath reflection in urban canyons</td>
        <td>1–2 minutes</td>
      </tr>
    </tbody>
  </table>

