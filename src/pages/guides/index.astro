---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiloNav from '../../components/SiloNav.astro';
import { guidesNav } from '../../data/navigation.js';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Guides & Knowledge Base' }
];

const guidesList = [
  {
    title: 'How GPS Location Works: Satellites, Trilateration & WGS 84',
    description: 'Learn the underlying physics and orbital geometry behind satellite navigation. Discover how atomic clocks and radio signals calculate your position on Earth.',
    url: '/guides/how-gps-location-works/',
    icon: '📡',
    readTime: '7 min read',
    category: 'Technology'
  },
  {
    title: 'How to Improve GPS Accuracy on Mobile & Desktop',
    description: 'Practical, step-by-step guide to achieving sub-5-meter positional accuracy on iPhone, Android, and PC browsers. Overcome urban canyons and multipath errors.',
    url: '/guides/improve-gps-accuracy/',
    icon: '🎯',
    readTime: '6 min read',
    category: 'Optimization'
  },
  {
    title: 'Why Is My Location Wrong? (And How to Fix It)',
    description: 'Troubleshoot why your device shows you in another city or country. Fix ISP IP routing mismatches, cached Wi-Fi BSSID positions, and VPN conflicts.',
    url: '/guides/wrong-location/',
    icon: '🔧',
    readTime: '8 min read',
    category: 'Troubleshooting'
  },
  {
    title: 'Latitude and Longitude Explained: Coordinate Systems & Datums',
    description: 'A complete beginner-to-advanced primer on parallels of latitude, the Prime Meridian, decimal degrees, DMS notation, and the WGS 84 ellipsoidal standard.',
    url: '/guides/latitude-and-longitude-explained/',
    icon: '🌐',
    readTime: '6 min read',
    category: 'Fundamentals'
  }
];

const hubSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Geolocation & GPS Educational Guides Hub',
  description: 'Comprehensive technical and practical guides on GPS satellite technology, accuracy tuning, and spatial troubleshooting.',
  url: 'https://mylocationlab.netlify.app/guides/',
};
---

<BaseLayout
  title="Geolocation & GPS Guides — Technical Knowledge Base | MyLocationLab"
  description="Master GPS technology, learn how to calibrate your device's accuracy, fix wrong location issues, and understand latitude and longitude coordinate systems."
  activeSection="guides"
  jsonLd={[hubSchema]}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />
    <SiloNav silo="guides" title="Educational Guides Silo" />

    <section class="page-header" style="text-align: center; margin-bottom: var(--space-10);">
      <h1>Geolocation <span class="text-gradient">Guides & Knowledge</span></h1>
      <p class="page-header-desc" style="max-width: 680px; margin: 0 auto;">
        In-depth technical tutorials, accuracy optimization manuals, and geodesy primers written by geospatial engineers.
      </p>
    </section>

    <div class="grid grid-2" style="gap: var(--space-6); margin-bottom: var(--space-16);">
      {guidesList.map((guide) => (
        <a href={guide.url} class="card" style="text-decoration: none; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
              <span style="font-size: 2rem;">{guide.icon}</span>
              <span class="badge badge-primary">{guide.category}</span>
            </div>
            <h2 style="font-size: var(--text-xl); color: var(--color-text-heading); margin-bottom: var(--space-3); line-height: 1.4;">
              {guide.title}
            </h2>
            <p style="font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.7; margin-bottom: var(--space-4);">
              {guide.description}
            </p>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: var(--text-xs); color: var(--color-text-tertiary); border-top: 1px solid var(--color-border); padding-top: var(--space-3);">
            <span>⏱️ {guide.readTime}</span>
            <span style="color: var(--color-accent-primary); font-weight: 600;">Read Full Guide →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
