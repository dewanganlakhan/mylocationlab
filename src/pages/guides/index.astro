---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiloNav from '../../components/SiloNav.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Educational Guides & Knowledge Hub' }
];

const guideCategories = [
  {
    category: '🛰️ Satellite Physics & Geodesy Foundations',
    description: 'Fundamental principles of global satellite navigation, spherical geometry, and coordinate reference models.',
    guides: [
      {
        title: 'How GPS Location Works: Satellites, Trilateration & WGS 84',
        description: 'Understand how atomic clocks, orbital ephemeris, relativistic time dilation, and 3D trilateration compute sub-meter coordinates.',
        url: '/guides/how-gps-location-works/',
        icon: '🛰️',
        readTime: '9 min read',
        tag: 'Hardware Physics'
      },
      {
        title: 'Latitude & Longitude Explained: Complete Geodesy Guide',
        description: 'Master the global coordinate grid, degrees, minutes, seconds, decimal degree precision tables, and antipodes.',
        url: '/guides/latitude-and-longitude-explained/',
        icon: '🌐',
        readTime: '8 min read',
        tag: 'GIS Foundations'
      },
      {
        title: 'UTM Coordinates & Geodetic Datums: WGS84, NAD83, ETRS89',
        description: 'Metric coordinate projections, 60 longitudinal zones, false easting/northing offsets, and continental tectonic datums.',
        url: '/guides/utm-coordinates-and-datums/',
        icon: '🗺️',
        readTime: '9 min read',
        tag: 'Surveying Standards'
      }
    ]
  },
  {
    category: '⚡ Accuracy Optimization & Troubleshooting',
    description: 'Actionable techniques to calibrate hardware sensors, troubleshoot wrong locations, and overcome signal interference.',
    guides: [
      {
        title: 'How to Improve GPS Accuracy on iPhone, Android & Desktop',
        description: 'Step-by-step techniques to eliminate multipath interference, calibrate compass sensors, and optimize device GNSS performance.',
        url: '/guides/improve-gps-accuracy/',
        icon: '⚡',
        readTime: '8 min read',
        tag: 'Calibration'
      },
      {
        title: 'Why Is My Location Wrong? Complete Troubleshooting Guide',
        description: 'Fix inaccurate location readings caused by VPNs, stale Wi-Fi router BSSID databases, and ISP proxy routing.',
        url: '/guides/wrong-location/',
        icon: '🔧',
        readTime: '8 min read',
        tag: 'Troubleshooting'
      },
      {
        title: 'IP Geolocation Accuracy: How GeoIP Works & Why It Fails',
        description: 'How GeoIP providers (MaxMind, DB-IP) map IP addresses to cities and why IP lookups are statistically non-physical.',
        url: '/guides/ip-geolocation-accuracy/',
        icon: '📡',
        readTime: '8 min read',
        tag: 'Network GeoIP'
      }
    ]
  },
  {
    category: '🔒 Privacy, Web Development & Testing',
    description: 'Developer integration guides, mock location testing, and security blueprints for location data privacy.',
    guides: [
      {
        title: 'HTML5 Geolocation API: Web Developer & User Guide',
        description: 'Implement navigator.geolocation in JavaScript with high accuracy flags, timeout handling, and permissions policies.',
        url: '/guides/browser-geolocation-api-guide/',
        icon: '💻',
        readTime: '9 min read',
        tag: 'Developer Guide'
      },
      {
        title: 'How to Share Your Location Safely: Complete Guide',
        description: 'Share live movement or static coordinates on iPhone, Android, WhatsApp, Google Maps, and browser QR codes safely.',
        url: '/guides/how-to-share-location/',
        icon: '🔗',
        readTime: '7 min read',
        tag: 'Safety & Sharing'
      },
      {
        title: 'GPS Privacy & Security: Who Tracks Your Location & How to Stop It',
        description: 'Audit app permissions, strip photo EXIF geotags, and defend against background cellular and ad beacon tracking.',
        url: '/guides/gps-privacy-and-security/',
        icon: '🔒',
        readTime: '8 min read',
        tag: 'Privacy Defense'
      },
      {
        title: 'How Mock Locations Work: Testing & Spoofing GPS for Developers',
        description: 'Simulate coordinates using Android Mock Locations, Xcode GPX route playback, and Chrome DevTools sensor overrides.',
        url: '/guides/how-to-fake-or-mock-location/',
        icon: '🧪',
        readTime: '8 min read',
        tag: 'QA Testing'
      }
    ]
  }
];

const hubSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Geolocation & GPS Educational Guides Hub | MyLocationLab',
  description: 'Comprehensive technical and practical guides on GPS satellite technology, geodesy, accuracy tuning, and spatial troubleshooting.',
  url: 'https://mylocationlab.com/guides/',
};
---

<BaseLayout
  title="GPS & Geolocation Guides Hub | MyLocationLab"
  description="Master GPS technology, calibrate your device's accuracy, troubleshoot wrong locations, learn geodesy coordinate models, and discover developer tools."
  activeSection="guides"
  jsonLd={[hubSchema]}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />
    <SiloNav silo="guides" title="Location Guides & Tutorials" />

    <section class="page-header" style="text-align: center; margin-bottom: var(--space-12);">
      <span class="badge badge-primary" style="margin-bottom: var(--space-3);">Geospatial Knowledge Base</span>
      <h1>Geolocation <span class="text-gradient">Guides & Knowledge</span></h1>
      <p class="page-header-desc" style="max-width: 740px; margin: 0 auto;">
        Authoritative technical tutorials, accuracy optimization manuals, and geodesy primers written by geospatial engineers.
      </p>
    </section>

    <!-- Category Sections -->
    <div style="display: flex; flex-direction: column; gap: var(--space-16); margin-bottom: var(--space-20);">
      {guideCategories.map((section) => (
        <div>
          <div style="margin-bottom: var(--space-6);">
            <h2 style="font-size: var(--text-2xl); color: var(--color-text-heading); margin-bottom: var(--space-2);">
              {section.category}
            </h2>
            <p style="font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: 0;">
              {section.description}
            </p>
          </div>

          <div class="grid grid-auto" style="gap: var(--space-6);">
            {section.guides.map((guide) => (
              <a href={guide.url} class="guide-card">
                <div>
                  <div class="guide-card-header">
                    <span class="guide-card-icon">{guide.icon}</span>
                    <span class="badge badge-neutral">{guide.tag}</span>
                  </div>
                  <h3 class="guide-card-title">{guide.title}</h3>
                  <p class="guide-card-desc">{guide.description}</p>
                </div>
                <div>
                  <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border); padding-top: var(--space-3); margin-top: var(--space-2);">
                    <span class="guide-card-readtime">⏱️ {guide.readTime}</span>
                    <span class="guide-card-footer">Read Guide →</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Quick Tools CTA Strip -->
    <section class="card card-highlight" style="padding: var(--space-8); text-align: center; margin-bottom: var(--space-16);">
      <h2 style="font-size: var(--text-2xl); margin-bottom: var(--space-3);">Ready to Put Knowledge into Practice?</h2>
      <p style="max-width: 620px; margin: 0 auto var(--space-6); color: var(--color-text-secondary);">
        Explore our complete suite of free geospatial tools to find coordinates, measure distances, look up elevations, and convert formats.
      </p>
      <div style="display: flex; justify-content: center; gap: var(--space-4); flex-wrap: wrap;">
        <a href="/tools/gps-coordinates/" class="btn btn-primary">🛰️ GPS Coordinates Finder</a>
        <a href="/tools/coordinate-converter/" class="btn btn-secondary">🧭 Coordinate Converter</a>
        <a href="/tools/elevation-finder/" class="btn btn-secondary">⛰️ Elevation Finder</a>
        <a href="/tools/" class="btn btn-ghost">Browse All Tools →</a>
      </div>
    </section>
  </div>
</BaseLayout>
