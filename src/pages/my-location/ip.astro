---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import SiloNav from '../../components/SiloNav.astro';

const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'My Location', href: '/my-location/' }, { label: 'IP Location' }];

const faqItems = [
  { question: 'What is an IP address?', answer: 'An IP (Internet Protocol) address is a unique numerical identifier assigned to your device when connected to the internet. It acts like a digital return address for web traffic.' },
  { question: 'How accurate is IP-based location?', answer: 'IP location is typically accurate to the city or region level (1-50 km). It cannot pinpoint your exact street address. For precise location, use our <a href="/my-location/gps/">GPS coordinates tool</a>.' },
  { question: 'Why does my IP location show a different city?', answer: 'Your IP is assigned by your ISP, and its registered location might be their regional office or routing center, not your physical address. A VPN or proxy will also change your apparent location. See our <a href="/guides/wrong-location/">guide to fixing wrong location</a>.' },
  { question: 'Can anyone track me by my IP address?', answer: 'An IP address reveals your approximate city and ISP, but NOT your name, street address, or exact location. Websites use it to show localized content, not to track individuals.' },
];
---

<BaseLayout leaflet title="My IP Location — Check Your IP Address | MyLocationLab" description="Find your current location based on your IP address. View your public IP, ISP, city, region, country, and approximate coordinates." activeSection="my-location">
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />
    <SiloNav silo="my-location" title="Related Location Tools" />
    <section class="page-header">
      <h1>My IP <span class="text-gradient">Location</span></h1>
      <p class="page-header-desc">See your location as determined by your IP address. No GPS required — this shows where the internet thinks you are.</p>
    </section>

    <!-- IP Location Card -->
    <div class="location-display" id="ip-card">
      <div class="location-display-header">
        <div class="location-display-dot" id="ip-dot" style="background: var(--color-text-tertiary);"></div>
        <span class="location-display-title">Your IP Location</span>
        <span class="badge" id="ip-badge">Loading...</span>
      </div>

      <div id="ip-loading" style="text-align: center; padding: var(--space-6);">
        <div class="spinner" style="margin: 0 auto var(--space-3);"></div>
        <p style="color: var(--color-text-secondary); margin: 0; font-size: var(--text-sm);">Detecting your IP location...</p>
      </div>

      <div class="location-data-grid" id="ip-data" style="display: none;">
        <div class="location-data-item">
          <span class="location-data-label">IP Address</span>
          <span class="location-data-value highlight" id="ip-address">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">Latitude</span>
          <span class="location-data-value" id="ip-lat">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">Longitude</span>
          <span class="location-data-value" id="ip-lng">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">City</span>
          <span class="location-data-value" id="ip-city" style="font-family: var(--font-sans);">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">Region</span>
          <span class="location-data-value" id="ip-region" style="font-family: var(--font-sans);">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">Country</span>
          <span class="location-data-value" id="ip-country" style="font-family: var(--font-sans);">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">Timezone</span>
          <span class="location-data-value" id="ip-tz" style="font-family: var(--font-sans);">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">ISP</span>
          <span class="location-data-value" id="ip-isp" style="font-family: var(--font-sans); font-size: var(--text-sm);">—</span>
        </div>
      </div>

      <div class="action-buttons" id="ip-actions" style="margin-top: var(--space-6); display: none;">
        <button class="btn btn-secondary btn-sm" id="ip-copy" type="button">📋 Copy IP</button>
        <a class="btn btn-secondary btn-sm" id="ip-maps" href="#" target="_blank" rel="noopener noreferrer">🗺️ Open in Maps</a>
      </div>
    </div>

    <div class="map-container" id="ip-map" style="margin-top: var(--space-6); display: none;"></div>

    <section class="section">
      <div class="prose" style="max-width: var(--max-width-narrow);">
        <h2>What Is IP Geolocation?</h2>
        <p>IP geolocation determines your approximate location based on your <strong>IP address</strong> — the numerical label assigned to your internet connection by your Internet Service Provider (ISP). Unlike GPS, it doesn't require any device sensors or user permission.</p>
        <p>IP location databases map IP address ranges to geographic locations. While not as precise as GPS, it's useful as a fallback when GPS is unavailable, or for quickly identifying your approximate location without any permissions.</p>
        <h2>Limitations</h2>
        <ul>
          <li><strong>Accuracy</strong> — Typically city-level only (1-50 km error)</li>
          <li><strong>VPN/Proxy</strong> — Shows the server's location, not yours</li>
          <li><strong>Mobile Networks</strong> — May show the carrier's hub city, not your actual city</li>
          <li><strong>Corporate Networks</strong> — May show the company headquarters location</li>
        </ul>
        <h3>Related Pages</h3>
        <ul>
          <li><a href="/comparisons/gps-vs-ip-location/">GPS vs IP Location Comparison</a></li>
          <li><a href="/my-location/gps/">My GPS Coordinates</a> — Accurate satellite positioning</li>
          <li><a href="/guides/wrong-location/">Why Is My Location Wrong? (Troubleshooting)</a></li>
          <li><a href="/glossary/">Geodesy &amp; Network Glossary</a></li>
        </ul>
      </div>
    </section>

    <section class="section">
      <div style="max-width: var(--max-width-narrow);"><h2 class="mb-8">FAQ</h2><FAQAccordion items={faqItems} /></div>
    </section>
  </div>

  <script>
    import IpLocation from '../../scripts/ip-location.js';
    import Sharing from '../../scripts/sharing.js';

    (async () => {
      const loading = document.getElementById('ip-loading');
      const data = document.getElementById('ip-data');
      const actions = document.getElementById('ip-actions');
      const mapEl = document.getElementById('ip-map');
      const dot = document.getElementById('ip-dot');
      const badge = document.getElementById('ip-badge');

      try {
        const loc = await IpLocation.getLocation();

        document.getElementById('ip-address').textContent = loc.ip;
        document.getElementById('ip-lat').textContent = loc.lat?.toFixed(4) || '—';
        document.getElementById('ip-lng').textContent = loc.lng?.toFixed(4) || '—';
        document.getElementById('ip-city').textContent = loc.city || '—';
        document.getElementById('ip-region').textContent = loc.region || '—';
        document.getElementById('ip-country').textContent = `${loc.country} (${loc.countryCode})`;
        document.getElementById('ip-tz').textContent = loc.timezone || '—';
        document.getElementById('ip-isp').textContent = loc.isp || '—';
        document.getElementById('ip-maps').href = `https://www.google.com/maps?q=${loc.lat},${loc.lng}`;

        dot.style.background = 'var(--color-accent-success)';
        badge.textContent = `Source: ${loc.source}`;
        badge.className = 'badge badge-success';

        loading.style.display = 'none';
        data.style.display = 'grid';
        actions.style.display = 'flex';
        mapEl.style.display = 'block';

        // Map
        const waitL = () => {
          if (typeof L !== 'undefined') {
            const m = L.map('ip-map').setView([loc.lat, loc.lng], 10);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(m);
            L.marker([loc.lat, loc.lng]).addTo(m).bindPopup(`IP Location: ${loc.city}, ${loc.country}`).openPopup();
            L.circle([loc.lat, loc.lng], { radius: 5000, color: '#f59e0b', fillColor: '#f59e0b', fillOpacity: 0.08, weight: 1 }).addTo(m);
          } else setTimeout(waitL, 100);
        };
        waitL();

      } catch (error) {
        loading.innerHTML = '<p style="color: var(--color-accent-error);">Unable to detect IP location. Please try again later.</p>';
        dot.style.background = 'var(--color-accent-error)';
        badge.textContent = 'Error';
      }
    })();

    document.getElementById('ip-copy')?.addEventListener('click', function() {
      const ip = document.getElementById('ip-address')?.textContent;
      if (ip && ip !== '—') Sharing.copyToClipboard(ip, this);
    });
  </script>
</BaseLayout>
