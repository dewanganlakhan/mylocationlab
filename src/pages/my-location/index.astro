---
/**
 * /my-location/ — Primary SEO landing page
 * Targets: my location, where am i, what is my location, current location
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import SiloNav from '../../components/SiloNav.astro';
import AuthorEAT from '../../components/AuthorEAT.astro';
import { myLocationSubNav } from '../../data/navigation.js';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'My Location' },
];

const faqItems = [
  { question: 'How do I find my current location?', answer: 'Click the <strong>"Get My Location"</strong> button on this page. Your browser will ask for permission to access your location. Once granted, your exact GPS coordinates, address, city, state, and country will be displayed instantly.' },
  { question: 'Why does my browser ask for location permission?', answer: 'For your privacy, browsers require explicit permission before sharing your location with any website. This is a security feature — your location is only shared when you actively allow it. You can revoke permission at any time in your browser settings.' },
  { question: 'What information does "My Location" show?', answer: 'We show your <strong>latitude and longitude coordinates</strong>, full street address (via reverse geocoding), city, state/region, country, GPS accuracy radius, altitude (if available), and your position on an interactive map.' },
  { question: 'Is GPS location the same as IP location?', answer: 'No. GPS location uses satellite signals and is accurate to 3-10 meters. IP location uses your internet address and is typically only accurate to the city level (1-50 km). <a href="/comparisons/gps-vs-ip-location/">Learn more about GPS vs IP location</a>.' },
];

const myLocFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]*>?/gm, ''),
    },
  })),
};
---

<BaseLayout leaflet
  title="My Location — Find Where I Am Right Now | MyLocationLab"
  description="Find your current location instantly with GPS coordinates, full address, city, state, and country. See your exact position on an interactive map."
  activeSection="my-location"
  jsonLd={[myLocFaqSchema]}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />
    <SiloNav silo="my-location" title="Related Location Tools" />

    <section class="page-header">
      <h1>My <span class="text-gradient">Location</span></h1>
      <p class="page-header-desc">
        Find your exact current location with GPS coordinates, full address, and interactive map.
        Your location is processed entirely in your browser — we never store your data.
      </p>
    </section>

    <AuthorEAT 
      reviewedBy="MyLocationLab Editorial Team" 
      reviewerTitle="Geospatial Content Reviewer" 
      lastUpdated="September 2026" 
    />

    <!-- Location Finder -->
    <div class="location-display" id="location-card">
      <div class="location-display-header">
        <div class="location-display-dot" id="status-dot" style="background: var(--color-text-tertiary);"></div>
        <span class="location-display-title">Your Current Location</span>
        <span class="badge" id="status-badge">Ready</span>
      </div>

      <div style="text-align: center; padding: var(--space-6) 0;">
        <button class="btn btn-primary btn-lg" id="get-location-btn" type="button">
          📍 Get My Location
        </button>
      </div>

      <div id="location-loading" style="display: none; text-align: center; padding: var(--space-6);">
        <div class="spinner" style="margin: 0 auto var(--space-4);"></div>
        <p style="color: var(--color-text-secondary); margin: 0;">Detecting your location...</p>
      </div>

      <div class="location-data-grid" id="location-data" style="display: none;">
        <div class="location-data-item">
          <span class="location-data-label">Latitude</span>
          <span class="location-data-value highlight" id="data-lat">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">Longitude</span>
          <span class="location-data-value highlight" id="data-lng">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">Full Address</span>
          <span class="location-data-value" id="data-address" style="font-family: var(--font-sans); font-size: var(--text-sm);">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">City</span>
          <span class="location-data-value" id="data-city" style="font-family: var(--font-sans);">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">State / Region</span>
          <span class="location-data-value" id="data-state" style="font-family: var(--font-sans);">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">Country</span>
          <span class="location-data-value" id="data-country" style="font-family: var(--font-sans);">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">Accuracy</span>
          <span class="location-data-value" id="data-accuracy">—</span>
        </div>
        <div class="location-data-item">
          <span class="location-data-label">Altitude</span>
          <span class="location-data-value" id="data-altitude">—</span>
        </div>
      </div>

      <div class="action-buttons" id="action-buttons" style="margin-top: var(--space-6); display: none;">
        <button class="btn btn-secondary btn-sm" id="copy-coords-btn" type="button">📋 Copy Coordinates</button>
        <button class="btn btn-secondary btn-sm" id="share-btn" type="button">🔗 Share</button>
        <a class="btn btn-secondary btn-sm" id="open-maps-btn" href="#" target="_blank" rel="noopener noreferrer">🗺️ Open in Maps</a>
      </div>
    </div>

    <div class="map-container" id="map" style="margin-top: var(--space-6); display: none;"></div>

    <!-- Sub-pages Navigation -->
    <section class="section">
      <h2 class="mb-8">Explore Your Location <span class="text-gradient">Details</span></h2>
      <div class="grid grid-auto-sm">
        {myLocationSubNav.filter(n => n.href !== '/my-location/').map(item => (
          <a href={item.href} class="tool-card">
            <h3 class="tool-card-title" style="font-size: var(--text-base);">{item.label}</h3>
          </a>
        ))}
      </div>
    </section>

    <!-- Content -->
    <section class="section">
      <div class="prose" style="max-width: var(--max-width-narrow);">
        <h2>What Does "My Location" Show?</h2>
        <p>
          When you click "Get My Location," we use your browser's built-in Geolocation API to determine your
          exact position. The data shown includes:
        </p>
        <ul>
          <li><strong>GPS Coordinates</strong> — Your precise latitude and longitude in decimal degrees format</li>
          <li><strong>Full Address</strong> — Street address determined by reverse geocoding your coordinates</li>
          <li><strong>City, State, Country</strong> — Administrative boundaries you're located within</li>
          <li><strong>Accuracy Radius</strong> — How precise the GPS reading is (lower = better)</li>
          <li><strong>Altitude</strong> — Your elevation above sea level (when available from GPS)</li>
          <li><strong>Interactive Map</strong> — Visual representation of your position with zoom controls</li>
        </ul>

        <h2>How We Determine Your Location</h2>
        <p>
          Your location is determined using a combination of technologies available in your device:
        </p>
        <ul>
          <li><strong>GPS</strong> — Satellite-based positioning, most accurate (3-5m outdoors)</li>
          <li><strong>Wi-Fi Positioning</strong> — Uses nearby Wi-Fi networks, good for indoor use (15-40m)</li>
          <li><strong>Cell Tower Triangulation</strong> — Uses mobile network signals (100-300m)</li>
          <li><strong>IP Geolocation</strong> — Fallback using your internet address (city-level accuracy)</li>
        </ul>
        <p>
          All processing happens on your device. We never store, transmit, or log your location data.
          Learn more about <a href="/guides/how-gps-location-works/">how GPS location works</a>.
        </p>

        <h2>Related Tools</h2>
        <p>
          Need more from your location data? Try these tools:
        </p>
        <ul>
          <li><a href="/tools/gps-coordinates/">GPS Coordinates Finder</a> — Get precise GPS coordinates</li>
          <li><a href="/tools/address-finder/">Address Finder</a> — Find your full street address</li>
          <li><a href="/tools/coordinate-converter/">Coordinate Converter</a> — Convert between DMS, UTM, and more</li>
          <li><a href="/tools/distance-calculator/">Distance Calculator</a> — Measure distance between two points</li>
          <li><a href="/tools/gps-accuracy/">GPS Accuracy Checker</a> — Monitor your GPS signal quality</li>
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div style="max-width: var(--max-width-narrow);">
        <h2 class="mb-8">Frequently Asked Questions</h2>
        <FAQAccordion items={faqItems} />
      </div>
    </section>
  </div>

  <script>
    import GeoLocation from '../../scripts/geolocation.js';
    import Geocoding from '../../scripts/geocoding.js';
    import Sharing from '../../scripts/sharing.js';

    let currentLat = null, currentLng = null;

    document.getElementById('get-location-btn')?.addEventListener('click', async () => {
      const loading = document.getElementById('location-loading');
      const data = document.getElementById('location-data');
      const actions = document.getElementById('action-buttons');
      const mapEl = document.getElementById('map');
      const dot = document.getElementById('status-dot');
      const badge = document.getElementById('status-badge');

      loading.style.display = 'block';
      data.style.display = 'none';

      try {
        const position = await GeoLocation.getCurrentPosition();
        const pos = GeoLocation.formatPosition(position);
        currentLat = pos.latitude;
        currentLng = pos.longitude;

        document.getElementById('data-lat').textContent = pos.formattedLat;
        document.getElementById('data-lng').textContent = pos.formattedLng;
        document.getElementById('data-accuracy').textContent = pos.formattedAccuracy;
        document.getElementById('data-altitude').textContent = pos.altitude ? `${Math.round(pos.altitude)} m` : 'N/A';
        document.getElementById('open-maps-btn').href = Sharing.getGoogleMapsUrl(currentLat, currentLng);

        try {
          const addr = await Geocoding.reverseGeocode(currentLat, currentLng);
          document.getElementById('data-address').textContent = addr.displayName || '—';
          document.getElementById('data-city').textContent = addr.city || '—';
          document.getElementById('data-state').textContent = addr.state || '—';
          document.getElementById('data-country').textContent = addr.country || '—';
        } catch { /* gracefully degrade */ }

        dot.style.background = 'var(--color-accent-success)';
        badge.textContent = `± ${pos.formattedAccuracy}`;
        badge.className = 'badge badge-success';

        loading.style.display = 'none';
        data.style.display = 'grid';
        actions.style.display = 'flex';
        mapEl.style.display = 'block';

        // Map
        const waitForLeaflet = () => {
          if (typeof L !== 'undefined') {
            const map = L.map('map').setView([currentLat, currentLng], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              attribution: '&copy; OpenStreetMap',
              maxZoom: 19,
            }).addTo(map);
            const icon = L.divIcon({
              html: '<div style="width:20px;height:20px;background:#00d4ff;border:3px solid white;border-radius:50%;box-shadow:0 0 12px rgba(0,212,255,0.5);"></div>',
              className: '',
              iconSize: [20, 20],
              iconAnchor: [10, 10],
            });
            L.marker([currentLat, currentLng], { icon }).addTo(map);
            if (pos.accuracy > 0) {
              L.circle([currentLat, currentLng], { radius: pos.accuracy, color: '#00d4ff', fillColor: '#00d4ff', fillOpacity: 0.08, weight: 1 }).addTo(map);
            }
          } else {
            setTimeout(waitForLeaflet, 100);
          }
        };
        waitForLeaflet();

      } catch (error) {
        loading.style.display = 'none';
        dot.style.background = 'var(--color-accent-error)';
        badge.textContent = 'Error';
        badge.className = 'badge badge-warning';
        alert(GeoLocation.getErrorMessage(error));
      }
    });

    document.getElementById('copy-coords-btn')?.addEventListener('click', function() {
      if (currentLat) Sharing.copyToClipboard(`${currentLat}, ${currentLng}`, this);
    });

    document.getElementById('share-btn')?.addEventListener('click', () => {
      if (currentLat) Sharing.shareNative({ title: 'My Location', text: `${currentLat}, ${currentLng}`, url: Sharing.getGoogleMapsUrl(currentLat, currentLng) });
    });
  </script>
</BaseLayout>
