  <!-- Homepage Location Logic Script -->
  <script>
    import GeoLocation from '../scripts/geolocation.js';
    import Geocoding from '../scripts/geocoding.js';
    import Sharing from '../scripts/sharing.js';

    const getBtn = document.getElementById('get-location-btn');
    const statusPill = document.getElementById('telemetry-status-pill');
    const subtext = document.getElementById('telemetry-subtext');
    const privacyBanner = document.getElementById('privacy-banner');
    const bannerText = document.getElementById('banner-text');
    const mapCoordChip = document.getElementById('map-coord-chip');
    const mapStatusChip = document.getElementById('map-status-chip');

    let currentLat = null;
    let currentLng = null;
    let mapInstance = null;
    let markerInstance = null;
    let circleInstance = null;

    function setMapStatus(text) {
      const el = document.getElementById('map-status-chip-text');
      if (el) el.textContent = text;
    }

    function initMap(lat, lng, accuracy = 5) {
      if (typeof window.L === 'undefined') {
        setTimeout(() => initMap(lat, lng, accuracy), 150);
        return;
      }

      if (!mapInstance) {
        mapInstance = window.L.map('map', { scrollWheelZoom: false, zoomControl: true });

        window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          maxZoom: 19,
        }).addTo(mapInstance);
      }

      // No fix yet: neutral world view, no pin, no accuracy circle
      if (lat === null || lng === null) {
        mapInstance.setView([25, 5], 2);
        return;
      }

      const zoom = accuracy >= 10000 ? 10 : accuracy >= 1000 ? 12 : 15;
      mapInstance.setView([lat, lng], zoom);

      // Update or create custom pinpoint marker
      const pinIcon = window.L.divIcon({
        html: `<div style="width:22px;height:22px;background:#2563EB;border:3.5px solid #FFFFFF;border-radius:50%;box-shadow:0 0 14px rgba(37,99,235,0.6);position:relative;">
                 <div style="position:absolute;inset:-6px;border-radius:50%;border:2px solid #38BDF8;animation:radarBeaconPing 2s infinite;"></div>
               </div>`,
        className: 'custom-loc-pin',
        iconSize: [22, 22],
        iconAnchor: [11, 11],
      });

      if (markerInstance) {
        markerInstance.setLatLng([lat, lng]);
      } else {
        markerInstance = window.L.marker([lat, lng], { icon: pinIcon }).addTo(mapInstance);
      }

      if (circleInstance) {
        circleInstance.setLatLng([lat, lng]);
        circleInstance.setRadius(accuracy);
      } else {
        circleInstance = window.L.circle([lat, lng], {
          radius: accuracy,
          color: '#2563EB',
          fillColor: '#38BDF8',
          fillOpacity: 0.12,
          weight: 1.5,
          opacity: 0.5,
        }).addTo(mapInstance);
      }
    }

    // Initialize neutral world map on load (no location acquired yet)
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initMap(null, null));
    } else {
      initMap(null, null);
    }

    async function findLocation() {
      if (statusPill) {
        statusPill.textContent = 'ACQUIRING GNSS...';
        statusPill.className = 'telemetry-status-pill';
      }
      if (subtext) {
        subtext.textContent = 'Querying browser positioning hardware and GNSS satellites...';
      }
      if (getBtn) {
        getBtn.style.opacity = '0.75';
        getBtn.style.pointerEvents = 'none';
      }

      try {
        const position = await GeoLocation.getCurrentPosition();
        const data = GeoLocation.formatPosition(position);
        currentLat = data.latitude;
        currentLng = data.longitude;

        // Update telemetry values
        const latEl = document.getElementById('data-lat');
        const latDecEl = document.getElementById('data-lat-dec');
        const lngEl = document.getElementById('data-lng');
        const lngDecEl = document.getElementById('data-lng-dec');
        const accEl = document.getElementById('data-accuracy');
        const altEl = document.getElementById('data-altitude');

        if (latEl) latEl.textContent = data.formattedLat;
        if (latDecEl) latDecEl.textContent = `Decimal: ${currentLat.toFixed(6)}`;
        if (lngEl) lngEl.textContent = data.formattedLng;
        if (lngDecEl) lngEl.textContent = `Decimal: ${currentLng.toFixed(6)}`;
        if (accEl) accEl.textContent = `± ${Math.round(data.accuracy)} meters`;
        const accSubEl = document.getElementById('data-accuracy-sub');
        if (accSubEl) accSubEl.textContent = 'Reported by your device';
        if (altEl) {
          altEl.textContent = data.altitude != null
            ? `${Math.round(data.altitude)} m (${Math.round(data.altitude * 3.28084)} ft)`
            : 'Not reported by device';
        }

        if (mapCoordChip) {
          mapCoordChip.textContent = `${data.formattedLat}, ${data.formattedLng}`;
        }

        setMapStatus('GNSS FIXED');

        if (statusPill) {
          statusPill.textContent = 'GNSS LOCKED';
          statusPill.className = 'telemetry-status-pill status-fixed';
        }

        if (subtext) {
          subtext.textContent = `High precision fix acquired with ${Math.round(data.accuracy)}m confidence.`;
        }

        // Update Google Maps Link
        const mapsBtn = document.getElementById('open-maps-btn');
        if (mapsBtn) {
          mapsBtn.setAttribute('href', Sharing.getGoogleMapsUrl(currentLat, currentLng));
          mapsBtn.removeAttribute('aria-disabled');
        }

        // Update Map view
        initMap(currentLat, currentLng, data.accuracy);

        // Reverse Geocode
        try {
          const address = await Geocoding.reverseGeocode(currentLat, currentLng);
          const addrEl = document.getElementById('data-address');
          const cityEl = document.getElementById('data-city');
          const citySubEl = document.getElementById('data-city-sub');
          const stateEl = document.getElementById('data-state-country');
          const stateSubEl = document.getElementById('data-state-sub');

          if (addrEl) addrEl.textContent = address.displayName || address.road || 'Resolved GPS Location';
          if (cityEl) cityEl.textContent = address.city || address.town || address.village || address.county || 'Detected City';
          if (citySubEl) citySubEl.textContent = address.county ? `County: ${address.county}` : 'Resolved via GPS';
          if (stateEl) {
            const state = address.state || '';
            const country = address.country || '';
            stateEl.textContent = [state, country].filter(Boolean).join(', ') || 'Global';
          }
          if (stateSubEl) {
            const cc = (address.country_code || '').toUpperCase();
            const region = address.state_district || address.state || '';
            stateSubEl.textContent = cc ? `ISO 3166-1: ${[cc, region].filter(Boolean).join('-')}` : 'Resolved via GPS';
          }
        } catch {
          // Geocode failed silently, coordinates are still authoritative
          const citySubEl = document.getElementById('data-city-sub');
          const stateSubEl = document.getElementById('data-state-sub');
          if (citySubEl) citySubEl.textContent = 'Address lookup unavailable';
          if (stateSubEl) stateSubEl.textContent = 'Address lookup unavailable';
        }

        if (privacyBanner) {
          privacyBanner.style.background = '#ecfdf5';
          privacyBanner.style.borderColor = '#a7f3d0';
          privacyBanner.style.color = '#065f46';
        }
        if (bannerText) {
          bannerText.textContent = 'Location acquired successfully. Zero-Data Retention • 100% In-Browser.';
        }

      } catch (err) {
        // Fallback to IP Geolocation
        if (statusPill) {
          statusPill.textContent = 'IP FALLBACK';
          statusPill.className = 'telemetry-status-pill';
        }
        if (subtext) {
          subtext.textContent = 'GPS permission denied or unavailable. Resolving approximate IP location.';
        }

        try {
          const ipModule = await import('../scripts/ip-location.js');
          const ipData = await ipModule.default.getLocation();
          currentLat = ipData.lat;
          currentLng = ipData.lng;

          const latEl = document.getElementById('data-lat');
          const latDecEl = document.getElementById('data-lat-dec');
          const lngEl = document.getElementById('data-lng');
          const lngDecEl = document.getElementById('data-lng-dec');
          const addrEl = document.getElementById('data-address');
          const cityEl = document.getElementById('data-city');
          const citySubEl = document.getElementById('data-city-sub');
          const stateEl = document.getElementById('data-state-country');
          const stateSubEl = document.getElementById('data-state-sub');
          const accEl = document.getElementById('data-accuracy');
          const altEl = document.getElementById('data-altitude');

          if (latEl) latEl.textContent = `${Math.abs(currentLat).toFixed(4)}° ${currentLat >= 0 ? 'N' : 'S'}`;
          if (latDecEl) latDecEl.textContent = `Decimal: ${currentLat.toFixed(6)}`;
          if (lngEl) lngEl.textContent = `${Math.abs(currentLng).toFixed(4)}° ${currentLng >= 0 ? 'E' : 'W'}`;
          if (lngDecEl) lngDecEl.textContent = `Decimal: ${currentLng.toFixed(6)}`;
          if (addrEl) addrEl.textContent = `${ipData.city || 'Metro Area'}, ${ipData.region || ''}, ${ipData.country || ''}`;
          if (cityEl) cityEl.textContent = ipData.city || 'Detected City';
          if (citySubEl) citySubEl.textContent = 'Approximate (IP-level precision)';
          if (stateEl) stateEl.textContent = `${ipData.region || ''}, ${ipData.country || ''}`;
          if (stateSubEl) stateSubEl.textContent = ipData.countryCode ? `ISO 3166-1: ${ipData.countryCode}${ipData.regionCode ? '-' + ipData.regionCode : ''}` : 'Approximate (IP-level precision)';
          if (accEl) accEl.textContent = '± 10 km (IP)';
          const accSubEl = document.getElementById('data-accuracy-sub');
          if (accSubEl) accSubEl.textContent = 'Estimate from your IP address';
          if (altEl) altEl.textContent = 'Not available from IP';

          if (mapCoordChip) {
            mapCoordChip.textContent = `${currentLat.toFixed(4)}°, ${currentLng.toFixed(4)}°`;
          }

          setMapStatus('IP LOCATION');

          const mapsBtn = document.getElementById('open-maps-btn');
          if (mapsBtn) {
            mapsBtn.setAttribute('href', Sharing.getGoogleMapsUrl(currentLat, currentLng));
            mapsBtn.removeAttribute('aria-disabled');
          }

          initMap(currentLat, currentLng, 10000);

          if (bannerText) {
            bannerText.textContent = 'Approximate location resolved from your IP address. Zero-Data Retention • 100% In-Browser.';
          }
        } catch {
          setMapStatus('NO FIX');
          if (bannerText) bannerText.textContent = 'Location query failed. Please ensure location permissions are enabled.';
        }
      } finally {
        if (getBtn) {
          getBtn.style.opacity = '1';
          getBtn.style.pointerEvents = 'auto';
        }
      }
    }

    // Button Events
    getBtn?.addEventListener('click', findLocation);
    document.getElementById('refresh-btn')?.addEventListener('click', findLocation);

    document.getElementById('copy-coords-btn')?.addEventListener('click', function() {
      if (currentLat === null || currentLng === null) {
        const span = this.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = 'No fix yet';
          setTimeout(() => { span.textContent = original; }, 2000);
        }
        return;
      }
      const coordStr = `${currentLat.toFixed(6)}, ${currentLng.toFixed(6)}`;
      navigator.clipboard.writeText(coordStr).then(() => {
        const span = this.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = original; }, 2000);
        }
      });
    });

    document.getElementById('share-btn')?.addEventListener('click', () => {
      if (currentLat === null || currentLng === null) return;
      Sharing.shareNative({
        title: 'My Location',
        text: `My location coordinates: ${currentLat.toFixed(6)}, ${currentLng.toFixed(6)}`,
        url: Sharing.getGoogleMapsUrl(currentLat, currentLng),
      });
    });
  </script>
</BaseLayout>
