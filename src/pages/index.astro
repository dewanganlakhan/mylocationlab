---
/**
 * Homepage — Stitch GeoPrecision System "Where Am I Right Now?"
 * Pixel-accurate implementation of Stitch screen d994ff0a3e084110a50cdfaacd7790e7
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const faqItems = [
  {
    question: 'What is my current location?',
    answer: 'Click the <strong>"Get My Location"</strong> button above to instantly acquire your precise device telemetry via the W3C Geolocation API. We calculate your exact latitude, longitude, reverse-geocoded street address, administrative boundary, and 95% confidence radius on an interactive vector map.',
  },
  {
    question: 'How does this site find my location?',
    answer: 'We interface directly with your browser\'s native <strong>HTML5 Geolocation API</strong>. Your device synthesizes multi-constellation GNSS (GPS, GLONASS, Galileo, BeiDou), Wi-Fi BSSID trilateration, cellular tower IDs, and barometric altimeters to achieve high-precision coordinates.',
  },
  {
    question: 'Is my location data private?',
    answer: '<strong>100% In-Browser & Zero-Data Retention.</strong> Your coordinates and telemetry are computed locally on your client machine. Coordinates are never transmitted to or recorded on our backend servers, ensuring complete geospatial confidentiality.',
  },
  {
    question: 'Why is my location wrong?',
    answer: 'When GNSS satellite signals are obstructed indoors or in dense urban canyons, your operating system defaults to Wi-Fi positioning or ISP network routing nodes. Moving near an unobstructed window or switching on hardware location services immediately improves precision.',
  },
  {
    question: 'Can I find my location without GPS?',
    answer: 'Yes. In the absence of GNSS hardware, our engine initiates client-side IP-based resolver queries and local network geocoding to resolve your city-level geographic boundary within 15 to 40 kilometers.',
  },
];

const homeFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]*>?/gm, ''),
    },
  })),
};
---

<BaseLayout leaflet
  title="Where Am I? Find My Location Instantly | MyLocationLab"
  description="Instantly find your current location: GPS coordinates, address, city, and map. 100% private, works in your browser, no app needed."
  jsonLd={[homeFaqSchema]}
>
  <!-- Hero Section -->
  <section class="stitch-hero" id="find-location">
    <div class="container">
      <!-- Free GPS Location Finder Badge -->
      <div class="hero-pill-badge">
        <span class="pulse-dot-cyan"></span>
        <span>Free GPS Location Finder</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title-stitch">
        Where Am I <span class="hero-title-highlight">Right Now?</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-subtitle-stitch">
        Instantly find your current GPS location, coordinates, address, and see it on an interactive map. No app needed.
      </p>

      <!-- Action Buttons -->
      <div class="hero-actions-stitch">
        <button class="btn-stitch-primary" id="get-location-btn" type="button">
          <span class="pulse-dot-cyan" style="background: #ffffff;"></span>
          <span>Get My Location</span>
        </button>

        <a href="/tools/" class="btn-stitch-secondary">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
          </svg>
          <span>Browse Tools</span>
        </a>
      </div>

      <!-- Permission Notice Banner -->
      <div class="privacy-banner-stitch" id="privacy-banner">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; color: #d97706;">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span id="banner-text">Please allow location access when your browser asks for permission. Zero-Data Retention • 100% In-Browser</span>
      </div>
    </div>
  </section>

  <!-- Telemetry & Map Card Dashboard -->
  <section class="telemetry-card-wrapper" id="telemetry-section">
    <div class="telemetry-dashboard">
      <!-- Top Bar -->
      <div class="telemetry-top-bar">
        <div class="telemetry-header-info">
          <div class="telemetry-radar-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/>
              <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/>
              <circle cx="12" cy="12" r="2"/>
              <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/>
              <path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"/>
            </svg>
          </div>
          <div class="telemetry-title-block">
            <div class="telemetry-title-badge-row">
              <h2 class="telemetry-heading-title">Active GPS Telemetry</h2>
              <span class="telemetry-status-pill" id="telemetry-status-pill">READY TO ACQUIRE</span>
            </div>
            <p class="telemetry-subtext" id="telemetry-subtext">Click 'Get My Location' to initiate high-precision browser positioning.</p>
          </div>
        </div>

        <!-- Action Controls -->
        <div class="telemetry-controls">
          <button class="telemetry-ctrl-btn" id="copy-coords-btn" type="button" title="Copy Coordinates">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
            </svg>
            <span>Copy Coordinates</span>
          </button>

          <button class="telemetry-ctrl-btn" id="share-btn" type="button" title="Share Location">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"/>
              <circle cx="6" cy="12" r="3"/>
              <circle cx="18" cy="19" r="3"/>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
            </svg>
            <span>Share Location</span>
          </button>

          <a class="telemetry-ctrl-btn" id="open-maps-btn" href="https://www.google.com/maps" target="_blank" rel="noopener noreferrer" title="Open in Google Maps" aria-disabled="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
              <line x1="9" y1="3" x2="9" y2="18"/>
              <line x1="15" y1="6" x2="15" y2="21"/>
            </svg>
            <span>Open in Maps</span>
          </a>

          <button class="telemetry-ctrl-btn telemetry-ctrl-icon-btn" id="refresh-btn" type="button" title="Refresh Position">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
              <path d="M3 3v5h5"/>
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
              <path d="M16 16h5v5"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Two-Column Telemetry Viewport -->
      <div class="telemetry-viewport-grid">
        <!-- Left Column: Map Container -->
        <div class="telemetry-map-box">
          <div id="map"></div>

          <!-- Overlay Chips -->
          <div class="map-overlay-chip map-chip-topleft">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            <span>WGS 84 • EPSG:4326</span>
          </div>

          <div class="map-overlay-chip map-chip-botleft">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span id="map-coord-chip">Awaiting location fix</span>
          </div>

          <div class="map-overlay-chip map-chip-botright" id="map-status-chip">
            <span class="pulse-dot-emerald"></span>
            <span id="map-status-chip-text">STANDBY</span>
          </div>
        </div>

        <!-- Right Column: 7 Telemetry Metrics Cells -->
        <div class="telemetry-data-cells">
          <!-- Cell 1: Latitude -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">LATITUDE</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="19" x2="12" y2="5"/>
                  <polyline points="5 12 12 5 19 12"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-lat">—</div>
              <div class="telemetry-cell-sub" id="data-lat-dec">Waiting for fix</div>
            </div>
          </div>

          <!-- Cell 2: Longitude -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">LONGITUDE</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="19" y1="12" x2="5" y2="12"/>
                  <polyline points="12 19 5 12 12 5"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-lng">—</div>
              <div class="telemetry-cell-sub" id="data-lng-dec">Waiting for fix</div>
            </div>
          </div>

          <!-- Cell 3: Street Address (Full Width) -->
          <div class="telemetry-cell cell-full">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">STREET ADDRESS</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-address" style="font-size: 16.5px;">Click "Get My Location" to resolve your address</div>
              <div class="telemetry-cell-sub">Reverse Geocoded via OpenStreetMap Nominatim</div>
            </div>
          </div>

          <!-- Cell 4: City -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">CITY</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
                  <line x1="9" y1="22" x2="9" y2="22.01"/>
                  <line x1="15" y1="22" x2="15" y2="22.01"/>
                  <line x1="9" y1="6" x2="9" y2="6.01"/>
                  <line x1="15" y1="6" x2="15" y2="6.01"/>
                  <line x1="9" y1="10" x2="9" y2="10.01"/>
                  <line x1="15" y1="10" x2="15" y2="10.01"/>
                  <line x1="9" y1="14" x2="9" y2="14.01"/>
                  <line x1="15" y1="14" x2="15" y2="14.01"/>
                  <line x1="9" y1="18" x2="9" y2="18.01"/>
                  <line x1="15" y1="18" x2="15" y2="18.01"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-city">—</div>
              <div class="telemetry-cell-sub" id="data-city-sub">Detected after location fix</div>
            </div>
          </div>

          <!-- Cell 5: State & Country -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">STATE & COUNTRY</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                  <line x1="4" y1="22" x2="4" y2="15"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-state-country">—</div>
              <div class="telemetry-cell-sub" id="data-state-sub">Detected after location fix</div>
            </div>
          </div>

          <!-- Cell 6: Accuracy Radius -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">ACCURACY RADIUS</span>
              <span class="telemetry-cell-icon" style="color: #10b981;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <circle cx="12" cy="12" r="6"/>
                  <circle cx="12" cy="12" r="2"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value text-emerald" id="data-accuracy">—</div>
              <div class="telemetry-cell-sub" id="data-accuracy-sub">Reported by your device</div>
            </div>
          </div>

          <!-- Cell 7: Elevation / Altitude -->
          <div class="telemetry-cell">
            <div class="telemetry-cell-top">
              <span class="telemetry-cell-label">ELEVATION / ALTITUDE</span>
              <span class="telemetry-cell-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m8 3 4 8 5-5 5 15H2L8 3z"/>
                </svg>
              </span>
            </div>
            <div>
              <div class="telemetry-cell-value" id="data-altitude">—</div>
              <div class="telemetry-cell-sub">Above Mean Sea Level</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Explore Your Location Details -->
  <section class="section" id="location-details" style="padding-top: 0;">
    <div class="container">
      <div class="stitch-section-header">
        <span class="section-subtag-stitch">DETAILED BREAKDOWNS</span>
        <h2 class="section-title-stitch">Explore Your <span class="accent">Location Details</span></h2>
        <p class="section-desc-stitch">Dive deeper into specific aspects of your current location.</p>
      </div>

      <div class="stitch-grid-4">
        <!-- 1. My GPS Coordinates -->
        <a href="/my-location/gps/" class="stitch-card">
          <div class="card-squircle-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/>
              <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/>
              <circle cx="12" cy="12" r="2"/>
              <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/>
              <path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"/>
            </svg>
          </div>
          <h3 class="stitch-card-title">My GPS Coordinates</h3>
          <p class="stitch-card-text">View your precise GPS position data.</p>
          <span class="stitch-card-link">Inspect GPS Data &rarr;</span>
        </a>

        <!-- 2. My Coordinates -->
        <a href="/my-location/coordinates/" class="stitch-card">
          <div class="card-squircle-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
            </svg>
          </div>
          <h3 class="stitch-card-title">My Coordinates</h3>
          <p class="stitch-card-text">Get coordinates in multiple formats.</p>
          <span class="stitch-card-link">Explore Formats &rarr;</span>
        </a>

        <!-- 3. My Latitude & Longitude -->
        <a href="/my-location/latitude-longitude/" class="stitch-card">
          <div class="card-squircle-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="2 2 22 22 2 22 2 2"/>
              <line x1="6" y1="18" x2="6" y2="18.01"/>
              <line x1="10" y1="18" x2="10" y2="18.01"/>
              <line x1="14" y1="18" x2="14" y2="18.01"/>
            </svg>
          </div>
          <h3 class="stitch-card-title">My Latitude &amp; Longitude</h3>
          <p class="stitch-card-text">Exact lat/lng with map position.</p>
          <span class="stitch-card-link">Check Lat/Lng &rarr;</span>
        </a>

        <!-- 4. My Address -->
        <a href="/my-location/address/" class="stitch-card">
          <div class="card-squircle-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <h3 class="stitch-card-title">My Address</h3>
          <p class="stitch-card-text">Find your full street address.</p>
          <span class="stitch-card-link">Resolve Address &rarr;</span>
        </a>

        <!-- 5. My City -->
        <a href="/my-location/city/" class="stitch-card">
          <div class="card-squircle-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
              <line x1="9" y1="22" x2="9" y2="22.01"/>
              <line x1="15" y1="22" x2="15" y2="22.01"/>
              <line x1="9" y1="6" x2="9" y2="6.01"/>
              <line x1="15" y1="6" x2="15" y2="6.01"/>
              <line x1="9" y1="10" x2="9" y2="10.01"/>
              <line x1="15" y1="10" x2="15" y2="10.01"/>
            </svg>
          </div>
          <h3 class="stitch-card-title">My City</h3>
          <p class="stitch-card-text">What city are you currently in?</p>
          <span class="stitch-card-link">View City Info &rarr;</span>
        </a>

        <!-- 6. My State -->
        <a href="/my-location/state/" class="stitch-card">
          <div class="card-squircle-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
              <line x1="9" y1="3" x2="9" y2="18"/>
              <line x1="15" y1="6" x2="15" y2="21"/>
            </svg>
          </div>
          <h3 class="stitch-card-title">My State</h3>
          <p class="stitch-card-text">Find your current state or region.</p>
          <span class="stitch-card-link">View State Boundary &rarr;</span>
        </a>

        <!-- 7. My Country -->
        <a href="/my-location/country/" class="stitch-card">
          <div class="card-squircle-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <h3 class="stitch-card-title">My Country</h3>
          <p class="stitch-card-text">What country are you in right now?</p>
          <span class="stitch-card-link">View Country Data &rarr;</span>
        </a>

        <!-- 8. My IP Location -->
        <a href="/my-location/ip/" class="stitch-card">
          <div class="card-squircle-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="stitch-card-title">My IP Location</h3>
          <p class="stitch-card-text">Location based on your IP address.</p>
          <span class="stitch-card-link">Resolve IP Geolocation &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Section: Location Tools -->
  <section class="section" id="location-tools" style="background: var(--color-bg-primary); padding-top: var(--space-12);">
    <div class="container">
      <div class="stitch-section-header">
        <span class="section-subtag-stitch">UTILITY SUITE</span>
        <h2 class="section-title-stitch">Location <span class="accent">Tools</span></h2>
        <p class="section-desc-stitch">Free location utilities to find, convert, measure, and share coordinates.</p>
      </div>

      <div class="stitch-grid-4">
        <!-- Tool 1: GPS Coordinates Finder -->
        <a href="/tools/gps-coordinates/" class="stitch-card">
          <div class="card-squircle-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
