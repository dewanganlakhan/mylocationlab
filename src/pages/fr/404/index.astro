---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalizedPath, type SupportedLang } from '../../../i18n/config';

const lang = 'fr' as SupportedLang;

const quickLinks = [
  { href: getLocalizedPath('/', lang), label: 'Find My Location', desc: 'Instant GPS coordinates, address, and map' },
  { href: getLocalizedPath('/tools/', lang), label: 'All Location Tools', desc: 'Geocoding, distance, converters, and more' },
  { href: getLocalizedPath('/guides/', lang), label: 'GPS Guides', desc: 'Accuracy fixes, privacy, and how GPS works' },
  { href: getLocalizedPath('/sitemap/', lang), label: 'HTML Sitemap', desc: 'Complete directory of every page' },
];
---

<BaseLayout
  lang={lang}
  title="Page Not Found (404) | MyLocationLab"
  description="The page you are looking for does not exist."
  noindex={true}
>
  <div class="container" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: var(--space-16) var(--space-4);">
    <div style="max-width: 640px; text-align: center;">
      <div style="font-family: var(--font-mono); font-size: clamp(4rem, 12vw, 7rem); font-weight: 700; line-height: 1; background: var(--gradient-primary); -webkit-background-clip: text; background-clip: text; color: transparent; margin-bottom: var(--space-2);">404</div>
      <h1 style="font-size: var(--text-2xl); margin-bottom: var(--space-3);">This Coordinate Is Off the Map</h1>
      <p style="color: var(--color-text-secondary); margin-bottom: var(--space-8);">
        The page you're looking for doesn't exist or may have moved.
      </p>

      <div style="display: grid; gap: var(--space-3); text-align: left; margin-bottom: var(--space-8);">
        {quickLinks.map((link) => (
          <a href={link.href} class="card card-flat" style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-4) var(--space-5); text-decoration: none;">
            <span>
              <span style="display: block; font-weight: 600; color: var(--color-text-primary);">{link.label}</span>
              <span style="display: block; font-size: var(--text-sm); color: var(--color-text-tertiary);">{link.desc}</span>
            </span>
            <span style="color: var(--color-accent-primary); font-weight: 700;" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <a href={getLocalizedPath('/', lang)} class="btn btn-primary">← Back to Home</a>
    </div>
  </div>
</BaseLayout>
