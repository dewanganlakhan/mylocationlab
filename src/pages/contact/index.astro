---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact Support' }
];

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact MyLocationLab Support & Editorial Team',
  description: 'Submit feedback, report a coordinate or geocoder bug, or get in touch with our geospatial engineering team.',
  url: 'https://mylocationlab.com/contact/',
};
---

<BaseLayout
  title="Contact Us — Support & Feedback | MyLocationLab"
  description="Have a question, feedback, or a coordinate bug report? Contact the MyLocationLab engineering and editorial team."
  activeSection="contact"
  jsonLd={[contactSchema]}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />

    <section class="page-header" style="text-align: center; margin-bottom: var(--space-8);">
      <h1>Contact <span class="text-gradient">Our Team</span></h1>
      <p class="page-header-desc" style="max-width: 650px; margin: 0 auto;">
        We welcome bug reports from developers, feedback on coordinate accuracy, and suggestions for new geospatial tools.
      </p>
    </section>

    <div class="grid grid-2" style="max-width: var(--max-width-narrow); margin: 0 auto var(--space-16); gap: var(--space-8); align-items: start;">
      <!-- Contact Details -->
      <div class="card card-flat" style="padding: var(--space-6);">
        <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-4); color: var(--color-text-heading);">Direct Inquiries</h2>
        
        <div style="margin-bottom: var(--space-4);">
          <div style="font-size: var(--text-xs); color: var(--color-accent-primary); font-weight: 700; text-transform: uppercase;">Technical Support &amp; Bugs</div>
          <div style="font-size: var(--text-base); color: var(--color-text-primary); font-family: var(--font-mono); margin-top: var(--space-1);">
            support@mylocationlab.com
          </div>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <div style="font-size: var(--text-xs); color: var(--color-accent-primary); font-weight: 700; text-transform: uppercase;">Editorial &amp; Geodesy Research</div>
          <div style="font-size: var(--text-base); color: var(--color-text-primary); font-family: var(--font-mono); margin-top: var(--space-1);">
            editorial@mylocationlab.com
          </div>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <div style="font-size: var(--text-xs); color: var(--color-accent-primary); font-weight: 700; text-transform: uppercase;">Data Privacy Officer</div>
          <div style="font-size: var(--text-base); color: var(--color-text-primary); font-family: var(--font-mono); margin-top: var(--space-1);">
            privacy@mylocationlab.com
          </div>
        </div>

        <hr style="border-color: var(--color-border); margin: var(--space-6) 0;" />
        
        <p style="font-size: var(--text-xs); color: var(--color-text-tertiary); line-height: 1.6; margin: 0;">
          ⏰ Response Time: Inquiries are reviewed by our engineering and editorial team within 24–48 business hours.
        </p>
      </div>

      <!-- Interactive Feedback Form -->
      <div class="card card-highlight" style="padding: var(--space-6);">
        <h2 style="font-size: var(--text-xl); margin-bottom: var(--space-4); color: var(--color-text-heading);">Send a Message</h2>
        
        <form id="contact-form">
          <div style="margin-bottom: var(--space-4);">
            <label for="cf-name" style="display: block; font-size: var(--text-xs); font-weight: 600; margin-bottom: var(--space-1); color: var(--color-text-secondary);">Your Name</label>
            <input type="text" id="cf-name" class="input" placeholder="e.g. Alex Morgan" required style="width: 100%;" />
          </div>

          <div style="margin-bottom: var(--space-4);">
            <label for="cf-email" style="display: block; font-size: var(--text-xs); font-weight: 600; margin-bottom: var(--space-1); color: var(--color-text-secondary);">Email Address</label>
            <input type="email" id="cf-email" class="input" placeholder="alex@example.com" required style="width: 100%;" />
          </div>

          <div style="margin-bottom: var(--space-4);">
            <label for="cf-topic" style="display: block; font-size: var(--text-xs); font-weight: 600; margin-bottom: var(--space-1); color: var(--color-text-secondary);">Topic</label>
            <select class="input" id="cf-topic" style="width: 100%; cursor: pointer;">
              <option value="bug">Report a Coordinate / Geocoding Bug</option>
              <option value="tool">Suggest a New Location Tool</option>
              <option value="privacy">Privacy or Data Query</option>
              <option value="editorial">Editorial / Content Correction</option>
              <option value="other">General Feedback</option>
            </select>
          </div>

          <div style="margin-bottom: var(--space-4);">
            <label for="cf-message" style="display: block; font-size: var(--text-xs); font-weight: 600; margin-bottom: var(--space-1); color: var(--color-text-secondary);">Your Message</label>
            <textarea class="input" id="cf-message" rows="4" placeholder="Describe the issue, include coordinate details or browser information..." required style="width: 100%; resize: vertical;"></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%;">
            ✉️ Submit Message
          </button>
          <p style="font-size: var(--text-xs); color: var(--color-text-tertiary); margin: var(--space-3) 0 0;">
            Submitting opens your email app with the message pre-filled to <strong>support@mylocationlab.com</strong> — nothing is sent or stored by this website.
          </p>
        </form>

        <div id="contact-success" style="display: none; text-align: center; padding: var(--space-6) 0;">
          <div style="font-size: 2.5rem; margin-bottom: var(--space-2);">✅</div>
          <h3 style="font-size: var(--text-lg); margin-bottom: var(--space-1);">Your Email App Should Be Opening</h3>
          <p style="font-size: var(--text-sm); color: var(--color-text-secondary);">We've pre-filled your message to <strong>support@mylocationlab.com</strong> — just press send. If nothing opened, you can email us directly at that address.</p>
          <button type="button" class="btn btn-secondary btn-sm" id="contact-reopen" style="margin-top: var(--space-4);">← Edit My Message</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successBox = document.getElementById('contact-success');
    const SUPPORT_EMAIL = 'support@mylocationlab.com';

    const topicLabels: Record<string, string> = {
      bug: 'Bug Report',
      tool: 'Tool Suggestion',
      privacy: 'Privacy Query',
      editorial: 'Content Correction',
      other: 'General Feedback',
    };

    if (form && successBox) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (document.getElementById('cf-name') as HTMLInputElement).value.trim();
        const email = (document.getElementById('cf-email') as HTMLInputElement).value.trim();
        const topic = (document.getElementById('cf-topic') as HTMLSelectElement).value;
        const message = (document.getElementById('cf-message') as HTMLTextAreaElement).value.trim();

        const subject = `[${topicLabels[topic] || 'Feedback'}] Message from ${name || 'MyLocationLab visitor'}`;
        const body = `Name: ${name}\nReply-to: ${email}\nTopic: ${topicLabels[topic] || topic}\n\n${message}\n`;

        window.location.href = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        form.style.display = 'none';
        successBox.style.display = 'block';
      });

      document.getElementById('contact-reopen')?.addEventListener('click', () => {
        successBox.style.display = 'none';
        form.style.display = 'block';
      });
    }
  </script>
</BaseLayout>
