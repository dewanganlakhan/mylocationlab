---
/**
 * ToolLayout — Layout for location tool pages
 * The tool renders immediately after a compact title (above the fold on
 * mobile and desktop, like inchcalculator). Breadcrumbs, related-tool
 * links, and E-E-A-T review block surround the tool without delaying it.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedTools from '../components/RelatedTools.astro';
import AuthorEAT from '../components/AuthorEAT.astro';
import { getLangFromUrl, getLocalizedPath, defaultLang, type SupportedLang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  toolId: string;
  h1: string;
  subtitle?: string;
  canonical?: string;
  jsonLd?: object | object[];
  leaflet?: boolean;
  lang?: string;
}

const {
  title,
  description,
  toolId,
  h1,
  subtitle,
  canonical,
  jsonLd,
  leaflet,
  lang: customLang,
} = Astro.props;

const lang = (customLang || getLangFromUrl(Astro.url)) as SupportedLang;
const t = useTranslations(lang);

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: t('nav.tools'), href: '/tools/' },
  { label: h1 },
];

const localizedToolUrl = `https://mylocationlab.com${getLocalizedPath(`/tools/${toolId}/`, lang)}`;

// Rich WebApplication schema
const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: h1,
  description: description,
  url: localizedToolUrl,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All (Web Browser, iOS, Android, macOS, Windows, Linux)',
  browserRequirements: 'Requires HTML5 Geolocation API support',
  softwareVersion: '2.4.0',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  creator: {
    '@type': 'Organization',
    name: 'MyLocationLab',
    url: 'https://mylocationlab.com',
  },
};

const allJsonLd = jsonLd
  ? Array.isArray(jsonLd) ? [toolSchema, ...jsonLd] : [toolSchema, jsonLd]
  : [toolSchema];
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  activeSection="tools"
  canonical={canonical}
  jsonLd={allJsonLd}
  leaflet={leaflet}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />

    <header class="page-header page-header-tight">
      <h1>{h1}</h1>
      {subtitle && <p class="page-header-desc">{subtitle}</p>}
    </header>

    <div class="content-layout">
      <div class="content-main">
        <slot />
      </div>
      <aside class="content-sidebar">
        <RelatedTools currentToolId={toolId} lang={lang} />
        <AuthorEAT 
          reviewedBy="MyLocationLab Technical Team"
          reviewerTitle="GIS & Geospatial Specialist"
          lastUpdated="September 2026"
        />
      </aside>
    </div>
  </div>
</BaseLayout>
