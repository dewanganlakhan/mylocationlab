---
/**
 * ToolLayout — Layout for location tool pages
 * The tool renders immediately after a compact title (above the fold on
 * mobile and desktop, like inchcalculator). Breadcrumbs, related-tool
 * links, and E-E-A-T review block surround the tool without delaying it.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedTools from '../components/RelatedTools.astro';
import AuthorEAT from '../components/AuthorEAT.astro';

interface Props {
  title: string;
  description: string;
  toolId: string;
  h1: string;
  subtitle?: string;
  canonical?: string;
  jsonLd?: object | object[];
  leaflet?: boolean;
}

const { title, description, toolId, h1, subtitle, canonical, jsonLd, leaflet } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: h1 },
];

// Rich WebApplication schema
const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: h1,
  description: description,
  url: `https://mylocationlab.com/tools/${toolId}/`,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All (Web Browser, iOS, Android, macOS, Windows, Linux)',
  browserRequirements: 'Requires HTML5 Geolocation API support',
  softwareVersion: '2.4.0',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  creator: {
    '@type': 'Organization',
    name: 'MyLocationLab',
    url: 'https://mylocationlab.com',
  },
};

const allJsonLd = jsonLd
  ? Array.isArray(jsonLd) ? [toolSchema, ...jsonLd] : [toolSchema, jsonLd]
  : [toolSchema];
---

<BaseLayout
  title={title}
  description={description}
  activeSection="tools"
  canonical={canonical}
  jsonLd={allJsonLd}
  leaflet={leaflet}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />

    <header class="page-header page-header-tight">
      <h1>{h1}</h1>
      {subtitle && <p class="page-header-desc">{subtitle}</p>}
    </header>

    <div class="content-layout">
      <div class="content-main">
        <slot />
      </div>
      <aside class="content-sidebar">
        <RelatedTools currentToolId={toolId} />
        <div class="related-tools">
          <h4 class="related-tools-title">Keep Exploring</h4>
          <a href="/my-location/" class="related-tool-item">
            <span class="related-tool-icon">🎯</span>
            <span class="related-tool-name">Where Am I Right Now?</span>
          </a>
          <a href="/guides/" class="related-tool-item">
            <span class="related-tool-icon">📚</span>
            <span class="related-tool-name">GPS &amp; Location Guides</span>
          </a>
          <a href="/comparisons/" class="related-tool-item">
            <span class="related-tool-icon">⚖️</span>
            <span class="related-tool-name">GPS vs IP, DD vs DMS</span>
          </a>
          <a href="/maps/" class="related-tool-item">
            <span class="related-tool-icon">🗺️</span>
            <span class="related-tool-name">Interactive Location Map</span>
          </a>
        </div>
      </aside>
    </div>

    <AuthorEAT
      reviewedBy="MyLocationLab Editorial Team"
      reviewerTitle="Geospatial Content Reviewer"
      lastUpdated="September 2026"
    />
  </div>
</BaseLayout>
