---
/**
 * ContentLayout — Layout for articles, guides, FAQ, glossary, and comparisons
 * Optimized for reading with prose styles, SiloNav, E-E-A-T credentials, and Article/TechArticle schema.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorEAT from '../components/AuthorEAT.astro';
import SiloNav from '../components/SiloNav.astro';
import { getLangFromUrl, getLocalizedPath, languages, defaultLang, type SupportedLang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  h1: string;
  subtitle?: string;
  section: string;
  sectionLabel: string;
  canonical?: string;
  jsonLd?: object | object[];
  publishDate?: string;
  modifiedDate?: string;
  readTime?: string;
  authorName?: string;
  authorRole?: string;
  lang?: string;
}

const {
  title, description, h1, subtitle,
  section, sectionLabel,
  canonical, jsonLd,
  publishDate = '2026-09-15',
  modifiedDate = '2026-09-15',
  readTime = '6 min',
  authorName = 'MyLocationLab Editorial Team',
  authorRole = 'Geospatial Content Reviewer',
  lang: customLang,
} = Astro.props;

const lang = (customLang || getLangFromUrl(Astro.url)) as SupportedLang;
const t = useTranslations(lang);
const siteUrl = 'https://mylocationlab.com';
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath === '/' ? '/' : (rawPath.endsWith('/') ? rawPath : `${rawPath}/`);
const pageCanonical = canonical || `${siteUrl}${normalizedPath}`;

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: sectionLabel, href: `/${section}/` },
  { label: h1 },
];

const metaLabels: Record<SupportedLang, { published: string; updated: string; read: string }> = {
  en: { published: 'Published', updated: 'Updated', read: 'read' },
  es: { published: 'Publicado', updated: 'Actualizado', read: 'de lectura' },
  fr: { published: 'Publié', updated: 'Mis à jour', read: 'de lecture' },
  de: { published: 'Veröffentlicht', updated: 'Aktualisiert', read: 'Lesezeit' },
  pt: { published: 'Publicado', updated: 'Atualizado', read: 'de leitura' },
  hi: { published: 'प्रकाशित', updated: 'अपडेटेड', read: 'पठन' },
  id: { published: 'Diterbitkan', updated: 'Diperbarui', read: 'waktu baca' },
};
const currentLabels = metaLabels[lang] || metaLabels.en;

const activeLangConfig = languages[lang] || languages.en;

// Rich TechArticle schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${pageCanonical}#article`,
  headline: h1,
  description: description,
  url: pageCanonical,
  datePublished: publishDate,
  dateModified: modifiedDate,
  inLanguage: activeLangConfig.locale,
  author: {
    '@type': 'Organization',
    name: authorName,
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'MyLocationLab',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageCanonical,
  },
  proficiencyLevel: 'Beginner',
  articleSection: sectionLabel,
};

const allJsonLd = jsonLd
  ? Array.isArray(jsonLd) ? [articleSchema, ...jsonLd] : [articleSchema, jsonLd]
  : [articleSchema];
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  activeSection={section}
  canonical={pageCanonical}
  jsonLd={allJsonLd}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />

    <div class="content-layout">
      <!-- Main Content Column -->
      <article class="content-main" itemscope itemtype="https://schema.org/TechArticle">
        <header class="article-header">
          <h1 itemprop="headline">{h1}</h1>

          {subtitle && (
            <p class="article-subtitle" itemprop="description">{subtitle}</p>
          )}

          <div class="article-meta-badge">
            <span class="badge badge-primary">{sectionLabel}</span>
            <span class="article-read-time">{readTime} {currentLabels.read}</span>
          </div>

          <div class="article-byline">
            <div class="byline-author">
              <span class="byline-avatar" aria-hidden="true">ML</span>
              <div class="byline-meta-col">
                <span class="byline-name" itemprop="author">{authorName}</span>
                <span class="byline-role">{authorRole}</span>
              </div>
            </div>
            <div class="byline-dates">
              <span class="byline-date-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <span class="byline-date-label">{currentLabels.published}:</span>
                <time datetime={publishDate} itemprop="datePublished">{publishDate}</time>
              </span>
              {modifiedDate !== publishDate && (
                <span class="byline-date-item">
                  <span class="byline-date-dot" aria-hidden="true">•</span>
                  <span class="byline-date-label">{currentLabels.updated}:</span>
                  <time datetime={modifiedDate} itemprop="dateModified">{modifiedDate}</time>
                </span>
              )}
            </div>
          </div>
        </header>

        <div class="article-body prose" itemprop="articleBody">
          <slot />
        </div>

        <!-- E-E-A-T Reviewer Badge at bottom of every article -->
        <AuthorEAT
          lang={lang}
          reviewedBy={authorName}
          reviewerTitle={authorRole}
          lastUpdated={modifiedDate}
        />
      </article>

      <!-- Sidebar -->
      <aside class="content-sidebar">
        <SiloNav currentSection={section} currentPath={normalizedPath} lang={lang} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .article-header {
    margin-bottom: var(--space-4);
  }

  .article-header h1 {
    font-size: var(--text-display);
    line-height: 1.25;
    letter-spacing: -0.025em;
    font-weight: 800;
    text-align: left;
    margin-inline: 0;
    margin-bottom: var(--space-3);
    max-width: 100%;
    color: var(--color-text-heading);
  }

  .article-subtitle {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    max-width: 760px;
  }

  .article-meta-badge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .article-read-time {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-tertiary);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .article-byline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .byline-author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .byline-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.15), rgba(99, 102, 241, 0.15));
    border: 1px solid rgba(14, 165, 233, 0.3);
    color: var(--color-accent-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .byline-meta-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .byline-name {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-heading);
    line-height: 1.3;
  }

  .byline-role {
    display: block;
    font-size: 11.5px;
    color: var(--color-text-tertiary);
    line-height: 1.3;
  }

  .byline-dates {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--color-text-tertiary);
    flex-wrap: wrap;
  }

  .byline-date-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .byline-date-dot {
    margin: 0 4px;
    opacity: 0.5;
  }

  .byline-date-label {
    font-weight: 500;
  }
</style>
