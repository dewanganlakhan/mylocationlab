---
/**
 * ContentLayout — Layout for articles, guides, FAQ, glossary, and comparisons
 * Optimized for reading with prose styles, SiloNav, E-E-A-T credentials, and Article/TechArticle schema.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorEAT from '../components/AuthorEAT.astro';
import SiloNav from '../components/SiloNav.astro';
import { getLangFromUrl, getLocalizedPath, languages, defaultLang, type SupportedLang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  h1: string;
  subtitle?: string;
  section: string;
  sectionLabel: string;
  canonical?: string;
  jsonLd?: object | object[];
  publishDate?: string;
  modifiedDate?: string;
  readTime?: string;
  authorName?: string;
  authorRole?: string;
  lang?: string;
}

const {
  title, description, h1, subtitle,
  section, sectionLabel,
  canonical, jsonLd,
  publishDate = '2026-09-15',
  modifiedDate = '2026-09-15',
  readTime = '6 min',
  authorName = 'MyLocationLab Editorial Team',
  authorRole = 'Geospatial Content Reviewer',
  lang: customLang,
} = Astro.props;

const lang = (customLang || getLangFromUrl(Astro.url)) as SupportedLang;
const t = useTranslations(lang);
const siteUrl = 'https://mylocationlab.com';
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath === '/' ? '/' : (rawPath.endsWith('/') ? rawPath : `${rawPath}/`);
const pageCanonical = canonical || `${siteUrl}${normalizedPath}`;

const breadcrumbs = [
  { label: t('common.home'), href: '/' },
  { label: sectionLabel, href: `/${section}/` },
  { label: h1 },
];

const metaLabels: Record<SupportedLang, { published: string; updated: string; read: string }> = {
  en: { published: 'Published', updated: 'Updated', read: 'read' },
  es: { published: 'Publicado', updated: 'Actualizado', read: 'de lectura' },
  fr: { published: 'Publié', updated: 'Mis à jour', read: 'de lecture' },
  de: { published: 'Veröffentlicht', updated: 'Aktualisiert', read: 'Lesezeit' },
  pt: { published: 'Publicado', updated: 'Atualizado', read: 'de leitura' },
  hi: { published: 'प्रकाशित', updated: 'अपडेटेड', read: 'पठन' },
  id: { published: 'Diterbitkan', updated: 'Diperbarui', read: 'waktu baca' },
};
const currentLabels = metaLabels[lang] || metaLabels.en;

const activeLangConfig = languages[lang] || languages.en;

// Rich TechArticle schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${pageCanonical}#article`,
  headline: h1,
  description: description,
  url: pageCanonical,
  datePublished: publishDate,
  dateModified: modifiedDate,
  inLanguage: activeLangConfig.locale,
  author: {
    '@type': 'Organization',
    name: authorName,
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'MyLocationLab',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageCanonical,
  },
  proficiencyLevel: 'Beginner',
  articleSection: sectionLabel,
};

const allJsonLd = jsonLd
  ? Array.isArray(jsonLd) ? [articleSchema, ...jsonLd] : [articleSchema, jsonLd]
  : [articleSchema];
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  activeSection={section}
  canonical={pageCanonical}
  jsonLd={allJsonLd}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} lang={lang} />

    <div class="content-layout">
      <!-- Main Content Column -->
      <article class="content-main" itemscope itemtype="https://schema.org/TechArticle">
        <header class="article-header">
          <h1 itemprop="headline">{h1}</h1>

          {subtitle && (
            <p class="article-subtitle" itemprop="description">{subtitle}</p>
          )}

          <div class="article-meta-badge">
            <span class="badge badge-primary">{sectionLabel}</span>
            <span class="article-read-time">{readTime} {currentLabels.read}</span>
          </div>

          <div class="article-byline">
            <div class="byline-author">
              <span class="byline-avatar">ML</span>
              <div>
                <span class="byline-name" itemprop="author">{authorName}</span>
                <span class="byline-role">{authorRole}</span>
              </div>
            </div>
            <div class="byline-dates">
              <time datetime={publishDate} itemprop="datePublished">{currentLabels.published}: {publishDate}</time>
              {modifiedDate !== publishDate && (
                <time datetime={modifiedDate} itemprop="dateModified">{currentLabels.updated}: {modifiedDate}</time>
              )}
            </div>
          </div>
        </header>

        <div class="article-body prose" itemprop="articleBody">
          <slot />
        </div>

        <!-- E-E-A-T Reviewer Badge at bottom of every article -->
        <AuthorEAT
          lang={lang}
          reviewedBy={authorName}
          reviewerTitle={authorRole}
          lastUpdated={modifiedDate}
        />
      </article>

      <!-- Sidebar -->
      <aside class="content-sidebar">
        <SiloNav currentSection={section} currentPath={normalizedPath} lang={lang} />
      </aside>
    </div>
  </div>
</BaseLayout>
