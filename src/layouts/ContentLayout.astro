---
/**
 * ContentLayout — Layout for articles, guides, FAQ, glossary, and comparisons
 * Optimized for reading with prose styles, SiloNav, E-E-A-T credentials, and Article/TechArticle schema.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorEAT from '../components/AuthorEAT.astro';
import SiloNav from '../components/SiloNav.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  subtitle?: string;
  section: string;
  sectionLabel: string;
  canonical?: string;
  jsonLd?: object | object[];
  publishDate?: string;
  modifiedDate?: string;
  readTime?: string;
  authorName?: string;
  authorRole?: string;
}

const {
  title, description, h1, subtitle,
  section, sectionLabel,
  canonical, jsonLd,
  publishDate = '2026-09-15',
  modifiedDate = '2026-09-15',
  readTime = '6 min',
  authorName = 'MyLocationLab Editorial Team',
  authorRole = 'Geospatial Content Reviewer',
} = Astro.props;

const siteUrl = 'https://mylocationlab.com';
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath === '/' ? '/' : (rawPath.endsWith('/') ? rawPath : `${rawPath}/`);
const pageCanonical = canonical || `${siteUrl}${normalizedPath}`;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: sectionLabel, href: `/${section}/` },
  { label: h1 },
];

// Rich TechArticle schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${pageCanonical}#article`,
  headline: h1,
  description: description,
  url: pageCanonical,
  datePublished: publishDate,
  dateModified: modifiedDate,
  inLanguage: 'en-US',
  author: {
    '@type': 'Person',
    name: authorName,
    jobTitle: authorRole,
    worksFor: {
      '@type': 'Organization',
      name: 'MyLocationLab',
      url: siteUrl,
    },
  },
  publisher: {
    '@type': 'Organization',
    name: 'MyLocationLab',
    url: siteUrl,
    logo: `${siteUrl}/favicon.svg`,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageCanonical,
  },
};

const allJsonLd = jsonLd
  ? Array.isArray(jsonLd) ? [articleSchema, ...jsonLd] : [articleSchema, jsonLd]
  : [articleSchema];

const isSilo = ['guides', 'comparisons', 'my-location', 'tools'].includes(section);
---

<BaseLayout
  title={title}
  description={description}
  activeSection={section}
  canonical={pageCanonical}
  ogType="article"
  jsonLd={allJsonLd}
>
  <div class="container">
    <Breadcrumbs items={breadcrumbs} />

    {isSilo && (
      <SiloNav 
        silo={section as any} 
        title={sectionLabel} 
      />
    )}

    <div class="page-header" style="text-align: left; max-width: var(--max-width-narrow); margin: var(--space-8) 0 var(--space-4);">
      <span class="badge badge-primary" style="margin-bottom: var(--space-3);">{sectionLabel}</span>
      <h1 style="font-size: var(--text-4xl); line-height: 1.25; margin-bottom: var(--space-3);">{h1}</h1>
      {subtitle && <p class="page-header-desc" style="font-size: var(--text-lg); line-height: 1.6; color: var(--color-text-secondary); margin: 0;">{subtitle}</p>}
    </div>

    <AuthorEAT 
      reviewedBy={authorName} 
      reviewerTitle={authorRole} 
      lastUpdated={modifiedDate} 
      readTime={readTime} 
    />

    <article class="prose" style="max-width: var(--max-width-narrow); margin: 0 0 var(--space-16); font-size: var(--text-base); line-height: 1.8;">
      <slot />
    </article>
  </div>
</BaseLayout>

